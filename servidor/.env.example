# Copia este archivo como .env y rellena los valores. No subas .env a ningún repositorio.

PORT=3000
# Pon "production" en el VPS: activa la cookie solo por HTTPS.
# Solo admite development, test o production, en minúsculas; cualquier otro valor (también vacío)
# detiene el servidor al arrancar, para que una errata no deje producción con protecciones de desarrollo.
NODE_ENV=development
# Proxies delante del servidor: 0 sin proxy; loopback con nginx en el mismo equipo (recomendado: solo
# se cree X-Forwarded-For si la conexión viene de 127.0.0.1 o ::1); o el número de proxies si están en
# otros equipos. Ojo: loopback confía en CUALQUIER proceso de este equipo que pueda conectar con el
# servidor, no solo en nginx; no protege por sí solo frente a un proceso local malicioso. Todos los
# límites de peticiones (cuentas y playground) cuentan por cliente a partir de este valor:
#   - Menor que el real: todas las visitas parecen venir del proxy y comparten un único cupo.
#   - Mayor que el real: cualquiera puede falsear su dirección con X-Forwarded-For y saltarse los límites.
# Solo admite 0, loopback o un entero de 1 a 10 sin ceros a la izquierda; cualquier otro valor detiene
# el servidor al arrancar. En los límites del playground y del inicio de sesión con Google o GitHub,
# las direcciones IPv6 cuentan por bloque /56, porque cambiar de dirección dentro de él es trivial, y
# también por bloque /48 (cuatro veces el cupo de un cliente). Una red /48 compartida (una
# universidad, una empresa) reparte ese cupo de red entre todas sus personas, como ya ocurre con una
# sola IPv4 detrás de un NAT. Los contadores están en memoria: se
# pierden al reiniciar y no se comparten entre varias instancias.
TRUST_PROXY=0
# Dirección en la que escucha el servidor. Vacía: todas las interfaces (lo de siempre, útil en local).
# Con nginx en el mismo equipo, 127.0.0.1: así solo se llega al servidor desde este equipo, aunque el
# cortafuegos dejara el puerto abierto. Solo admite una dirección IP, no un nombre: tampoco localhost,
# que Node puede resolver a ::1 y entonces no atendería a un nginx que apunte a 127.0.0.1.
LISTEN_HOST=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nexora
DB_PASSWORD=
DB_NAME=nexora

# Dirección pública de la web, sin barra final. Con ella se forman las URL de retorno de OAuth:
#   {PUBLIC_URL}/api/auth/google/callback
#   {PUBLIC_URL}/api/auth/github/callback
PUBLIC_URL=http://localhost:3000

# Inicio de sesión con Google y GitHub. Si un par se deja vacío, ese proveedor queda desactivado.
# Google: https://console.cloud.google.com/apis/credentials (ID de cliente de OAuth, tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth Apps > New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Playground (ejecución de código NEXORA desde la web) ---
# Guía completa: nexora/docs/playground.md
#
# Solo el valor exacto "true" (en minúsculas) activa la API del playground. Sin definir, vacía o
# "false", queda desactivada y responde 503. Cualquier otro valor ("True", "1"...) impide arrancar
# el servidor.
# Se deja en "false" hasta completar la comprobación del aislamiento (nexora/docs/playground.md,
# "Comprobar el aislamiento"). Para usarlo en tu equipo, ponlo en "true" en tu servidor/.env.
PLAYGROUND_ENABLED=false
# Python del entorno virtual donde está instalado el intérprete. Por defecto, nexora/.venv.
#NEXORA_PYTHON=/srv/nexora/nexora/.venv/bin/python
# Orden completa que arranca el worker, como lista JSON. Sustituye a NEXORA_PYTHON.
# Para ejecutar cada programa en un contenedor sin red (recomendado en un servidor público):
# Es la única orden de contenedor admitida: "docker","run", cada una de estas opciones exactamente
# una vez y con este valor (en cualquier orden) y, al final, la imagen local "nexora-worker". Lo
# único que puedes cambiar es añadirle una etiqueta ("nexora-worker:0.6.0"). "--pull","never"
# impide que Docker la descargue: si no está en este equipo, cada ejecución falla. Cualquier otra
# orden con docker, podman o "{container}" impide arrancar el servidor, aunque el playground esté
# desactivado. Ver "Formato de la orden de contenedor" en nexora/docs/playground.md.
# "{container}" es un marcador: el servidor lo sustituye en cada ejecución por un nombre único
# (nexora-pg- y un UUID) para poder eliminar ese contenedor si no termina bien.
#PLAYGROUND_WORKER_COMMAND=["docker","run","--rm","-i","--init","--pull","never","--name","{container}","--network","none","--read-only","--cap-drop","ALL","--security-opt","no-new-privileges","--pids-limit","32","--memory","256m","--memory-swap","256m","--cpus","0.5","--user","65534:65534","--tmpfs","/tmp:rw,size=1m,noexec","nexora-worker"]
# Límites de una petición.
PLAYGROUND_MAX_CODE_BYTES=65536
PLAYGROUND_TIMEOUT_MS=2000
PLAYGROUND_MAX_OUTPUT_BYTES=65536
PLAYGROUND_MAX_TEXT_CHARS=262144
# Memoria del worker en MiB. Solo la aplica el sistema operativo en Linux y macOS.
PLAYGROUND_MEMORY_MB=512
# Límites del servicio: programas a la vez, peticiones en espera y peticiones por cliente.
PLAYGROUND_MAX_CONCURRENT=4
PLAYGROUND_MAX_QUEUE=8
PLAYGROUND_RATE_LIMIT=30
PLAYGROUND_RATE_WINDOW_MS=60000
# Otros orígenes que pueden llamar a la API, separados por comas. Vacío: solo el propio sitio.
PLAYGROUND_ALLOWED_ORIGINS=
