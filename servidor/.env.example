# Copia este archivo como .env y rellena los valores. No subas .env a ningún repositorio.

PORT=3000
# Pon "production" en el VPS: activa la cookie solo por HTTPS.
NODE_ENV=development
# Número de proxies delante del servidor (1 si usas nginx como proxy inverso).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nexora
DB_PASSWORD=
DB_NAME=nexora

# Dirección pública de la web, sin barra final. Con ella se forman las URL de retorno de OAuth:
#   {PUBLIC_URL}/api/auth/google/callback
#   {PUBLIC_URL}/api/auth/github/callback
PUBLIC_URL=http://localhost:3000

# Inicio de sesión con Google y GitHub. Si un par se deja vacío, ese proveedor queda desactivado.
# Google: https://console.cloud.google.com/apis/credentials (ID de cliente de OAuth, tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth Apps > New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Playground (ejecución de código NEXORA desde la web) ---
# Guía completa: nexora/docs/playground.md
#
# "false" desactiva la API del playground (responde 503). Desactívalo en un servidor público
# mientras el worker no se ejecute aislado en un contenedor.
PLAYGROUND_ENABLED=true
# Python del entorno virtual donde está instalado el intérprete. Por defecto, nexora/.venv.
#NEXORA_PYTHON=/srv/nexora/nexora/.venv/bin/python
# Orden completa que arranca el worker, como lista JSON. Sustituye a NEXORA_PYTHON.
# Para ejecutar cada programa en un contenedor sin red (recomendado en un servidor público):
#PLAYGROUND_WORKER_COMMAND=["docker","run","--rm","-i","--network","none","--read-only","--cap-drop","ALL","--security-opt","no-new-privileges","--pids-limit","32","--memory","256m","--memory-swap","256m","--cpus","0.5","--user","65534:65534","--tmpfs","/tmp:rw,size=1m,noexec","nexora-worker"]
# Límites de una petición.
PLAYGROUND_MAX_CODE_BYTES=65536
PLAYGROUND_TIMEOUT_MS=2000
PLAYGROUND_MAX_OUTPUT_BYTES=65536
PLAYGROUND_MAX_TEXT_CHARS=262144
# Memoria del worker en MiB. Solo la aplica el sistema operativo en Linux y macOS.
PLAYGROUND_MEMORY_MB=512
# Límites del servicio: programas a la vez, peticiones en espera y peticiones por cliente.
PLAYGROUND_MAX_CONCURRENT=4
PLAYGROUND_MAX_QUEUE=8
PLAYGROUND_RATE_LIMIT=30
PLAYGROUND_RATE_WINDOW_MS=60000
# Otros orígenes que pueden llamar a la API, separados por comas. Vacío: solo el propio sitio.
PLAYGROUND_ALLOWED_ORIGINS=
