#!/bin/bash
# Orden forzada de la clave SSH de nexora-deploy (authorized_keys: command="/opt/nexora/bin/nexora-deploy").
# La clave del CI solo puede hacer lo que admite este script; la orden pedida llega en SSH_ORIGINAL_COMMAND.
#
#   stage <sha>      Recibe la versión (tar.gz) por la entrada estándar y la activa en staging.
#   verified <sha>   El CI ha comprobado staging desde fuera: <sha> queda marcada como verificada.
#   promote <sha>    Activa en producción <sha>, solo si es la que está en staging y está verificada.
#   status           Muestra qué versión hay en cada entorno.
#
# Activar = enlazar current a la versión, migrar la base, reiniciar el servicio y comprobar
# /api/health. Si algo falla, vuelve a la versión anterior y termina con error.

set -euo pipefail
umask 022

ROOT=/opt/nexora
RELEASES="$ROOT/releases"
KEEP=5

fail() { echo "nexora-deploy: $*" >&2; exit 1; }

read -r action sha extra <<< "${SSH_ORIGINAL_COMMAND:-${*:-}}" || true
[ -z "${extra:-}" ] || fail "demasiados argumentos"

check_sha() { [[ "${sha:-}" =~ ^[0-9a-f]{40}$ ]] || fail "se esperaba un commit de 40 caracteres hexadecimales"; }

port_of() {
  case "$1" in
    staging) echo 3101 ;;
    production) echo 3100 ;;
    *) fail "entorno desconocido: $1" ;;
  esac
}

current_of() { readlink "$ROOT/$1/current" 2>/dev/null | xargs -r basename; }

healthy() {
  local port=$1 i
  for i in $(seq 1 30); do
    if curl -fsS --max-time 2 "http://127.0.0.1:$port/api/health" > /dev/null 2>&1; then return 0; fi
    sleep 1
  done
  return 1
}

link_current() {
  local env=$1 target=$2
  ln -sfn "$RELEASES/$target" "$ROOT/$env/current.new"
  mv -T "$ROOT/$env/current.new" "$ROOT/$env/current"
}

activate() {
  local env=$1 target=$2 port previous
  port=$(port_of "$env")
  previous=$(current_of "$env" || true)
  [ -f "$RELEASES/$target/REVISION" ] || fail "la versión $target no está en el servidor"

  link_current "$env" "$target"
  if sudo -n /usr/bin/systemctl start "nexora-migrate@$env.service" \
    && sudo -n /usr/bin/systemctl restart "nexora@$env.service" \
    && healthy "$port"; then
    echo "$env: activa $target"
    return 0
  fi

  echo "$env: $target no arranca; vuelvo a ${previous:-ninguna}" >&2
  if [ -n "$previous" ]; then
    link_current "$env" "$previous"
    sudo -n /usr/bin/systemctl restart "nexora@$env.service" || true
  else
    # Primera versión del entorno: no queda ninguna activa.
    sudo -n /usr/bin/systemctl stop "nexora@$env.service" || true
    rm -f "$ROOT/$env/current"
  fi
  return 1
}

# Borra las versiones viejas que no usa ningún entorno; se quedan las $KEEP más recientes.
prune() {
  local in_use dir
  in_use="$(current_of staging || true) $(current_of production || true)"
  ls -1t "$RELEASES" | tail -n +$((KEEP + 1)) | while read -r dir; do
    [[ " $in_use " == *" $dir "* ]] && continue
    rm -rf -- "${RELEASES:?}/$dir"
  done
}

case "${action:-}" in
  stage)
    check_sha
    rm -f "$ROOT/staging/verified"
    if [ ! -f "$RELEASES/$sha/REVISION" ]; then
      tmp=$(mktemp -d "$RELEASES/.incoming.XXXXXX")
      trap 'rm -rf -- "$tmp"' EXIT
      tar -xzf - -C "$tmp" --no-same-owner --no-same-permissions
      [ "$(cat "$tmp/REVISION" 2>/dev/null)" = "$sha" ] || fail "REVISION no coincide con $sha"
      chmod -R a+rX "$tmp"
      mv -T "$tmp" "$RELEASES/$sha"
      trap - EXIT
    else
      cat > /dev/null
    fi
    activate staging "$sha"
    prune
    ;;
  verified)
    check_sha
    [ "$(current_of staging)" = "$sha" ] || fail "staging no está en $sha"
    echo "$sha" > "$ROOT/staging/verified"
    echo "staging: $sha verificada"
    ;;
  promote)
    check_sha
    [ "$(current_of staging)" = "$sha" ] || fail "staging no está en $sha: solo se promueve lo que hay en staging"
    [ "$(cat "$ROOT/staging/verified" 2>/dev/null)" = "$sha" ] || fail "$sha no está verificada en staging"
    activate production "$sha"
    prune
    ;;
  status)
    echo "staging:    $(current_of staging || echo ninguna)"
    echo "verificada: $(cat "$ROOT/staging/verified" 2>/dev/null || echo ninguna)"
    echo "production: $(current_of production || echo ninguna)"
    ;;
  *)
    fail "orden desconocida (stage, verified, promote, status)"
    ;;
esac
