#!/bin/bash
# Lo lanza nexora-backup.timer como root (MariaDB autentica a root por el socket de Unix).
set -euo pipefail
umask 077
DEST=/var/backups/nexora
mkdir -p "$DEST"
stamp=$(date +%Y%m%d-%H%M%S)
for db in nexora_production nexora_staging; do
  mysqldump --single-transaction --routines --triggers "$db" | gzip -9 > "$DEST/$db-$stamp.sql.gz.tmp"
  mv "$DEST/$db-$stamp.sql.gz.tmp" "$DEST/$db-$stamp.sql.gz"
done
find "$DEST" -name 'nexora_*.sql.gz' -mtime +14 -delete
