# Servidor de NEXORA en un entorno: nexora@staging (puerto 3101) o nexora@production (puerto 3100).
# La configuración de cada entorno está en /etc/nexora/<entorno>.env (no está en el repositorio).
[Unit]
Description=NEXORA (%i)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=nexora
Group=nexora
WorkingDirectory=/opt/nexora/%i/current/servidor
ExecStart=/opt/node24/bin/node --env-file=/etc/nexora/%i.env src/index.js
Restart=on-failure
RestartSec=3
# lifecycle.js termina las peticiones en curso al recibir SIGTERM (límite propio de 10 s).
KillSignal=SIGTERM
TimeoutStopSec=20

# El servidor no escribe en disco: todo el sistema de archivos es de solo lectura para él.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
