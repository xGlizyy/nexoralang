{
  "grammars": [
    {
      "name": "nexora",
      "camelcase": "Nexora",
      "scope": "source.nexora",
      "path": ".",
      "file-types": ["nex"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the NEXORA language",
    "authors": [{ "name": "NEXORA contributors" }],
    "links": { "repository": "https://github.com/xGlizyy/nexoralang" }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
