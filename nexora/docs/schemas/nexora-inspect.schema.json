{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.invalid/schemas/nexora-inspect.schema.json",
  "title": "nexora.inspect/3: the syntax tree of a program",
  "type": "object",
  "required": [
    "schema",
    "nexora_version",
    "file",
    "ok",
    "diagnostics",
    "complete",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "nexora.inspect/3"
    },
    "nexora_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "file": {
      "type": "string",
      "description": "The name the source was given. A label, not necessarily a path."
    },
    "ok": {
      "type": "boolean",
      "description": "True when the static analysis found no errors."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "complete": {
      "type": "boolean",
      "description": "True when the analysis covers the whole file. False when syntax errors left out the statements and functions that have them, or when there is no structure at all."
    },
    "program": {
      "oneOf": [
        {
          "$ref": "#/$defs/Program"
        },
        {
          "type": "null"
        }
      ],
      "description": "Partial when 'complete' is false. Null when the source has lexical errors."
    }
  },
  "$defs": {
    "span": {
      "description": "A region of the source. Lines and columns start at 1; the end is exclusive. Columns count Unicode code points.",
      "type": "object",
      "required": [
        "line",
        "column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "severity",
        "category",
        "code",
        "message",
        "label",
        "hint",
        "notes",
        "file",
        "line",
        "column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "category": {
          "enum": [
            "contract",
            "file",
            "lexical",
            "runtime",
            "semantic",
            "syntax",
            "test",
            "type"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[EW][0-9]{4}$",
          "description": "Stable identifier of the problem."
        },
        "message": {
          "type": "string",
          "description": "Fixed title of the code."
        },
        "label": {
          "type": "string",
          "description": "What is wrong in this particular case."
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "description": "A suggested fix, only when a rule of the language supports it."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Related information."
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "IntLiteral": {
      "type": "object",
      "required": [
        "kind",
        "span",
        "value",
        "type"
      ],
      "properties": {
        "kind": {
          "const": "IntLiteral"
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "value": {
          "type": "integer"
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "The type the checker computed: Int, Float, Bool, Text, Void, a list type such as List[Int], or the name of a refined type the program declares. Null if the expression has an error."
        }
      }
    },
    "FloatLiteral": {
