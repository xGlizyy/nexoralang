// Contracts state what a function expects from its caller and what it promises in return.
// They go in the header of the function, between its signature and its body.
//
// 'needs' is checked when the function is called, before its body runs.
// 'promises' is checked when the function finishes; 'result' is the value it gives.
// 'trust' states something the program relies on and NEXORA does not check: it is never
// evaluated, and its explanation says why it can be trusted.
// A clause can have a name before ':', and an explanation after a comma: it is shown if the
// condition is broken.
// `nex check` verifies that each condition is a well-typed Bool expression.
// Whether a condition holds is checked while the program runs, on every call.

fn divide(a: Float, b: Float) gives Float
    needs b != 0.0, "Dividing by zero has no result"
{
    return a / b
}

fn absolute(value: Int) gives Int
    promises result >= 0
    promises result == value or result == -value
{
    if value < 0 {
        return -value
    }
    return value
}

fn percentage(part: Int, whole: Int) gives Int
    needs whole_positive: whole > 0, "A percentage of nothing is not defined"
    needs part_inside: part >= 0 and part <= whole, "The part has to be inside the whole"
    trust small: whole <= 1000000, "The totals of this program are counts of people in a room"
    promises in_range: result >= 0 and result <= 100
{
    return part * 100 / whole
}

fn main() {
    print(divide(10.0, 4.0))
    print(absolute(-42))
    print(percentage(3, 12))
}
