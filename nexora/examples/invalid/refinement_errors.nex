// Incorrect on purpose: mistakes with refined types (categories "semantic" and "type").
// `nex check examples/invalid/refinement_errors.nex` reports them all without running anything,
// and exits with code 1.

type Percent = Int where value >= 0 and value <= 100, "A percentage goes from 0 to 100"
type percent = Int where value >= 0
type Positive = Int where is_positive(value)

fn is_positive(n: Int) gives Bool {
    return n > 0
}

fn half(p: Percent) gives Percent {
    return p / 2
}

fn main() {
    let full: Percent = 120
    let typed = 50
    let checked: Percent = typed
    print(half(full))
    print(Percent("fifty"))
}
