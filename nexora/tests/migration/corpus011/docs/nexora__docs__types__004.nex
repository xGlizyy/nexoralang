fn main() -> Void {
    print(2 + 3 * 4)                    // 14: '*' before '+'
    print((2 + 3) * 4)                  // 20
    print(7 / 2)                        // 3: Int / Int is Int
    print(7.0 / 2.0)                    // 3.5
    print("Nex" + "ora")
    print(3 > 2 and not (1 == 2))
    print(true or false and false)      // 'and' before 'or'
}
