type Point = { x: Int, y: Int }

fn add(a: Int, b: Int, unused: Int) gives Int {
    let never = 1
    let used = 2
    var counter = 0
    var changed = 0
    changed = changed + 1
    for item in [1, 2, 3] {
        print(1)
    }
    for other in [1, 2] {
        print(other)
    }
    var total = 0
    for value in [1, 2] {
        total = total + value
    }
    return a + b + used + changed + total
}

fn ignored(_: Int, other: Int) {
    print(other)
}

fn underscore_let() {
    let _ = 5
}

fn underscore_var() {
    var _ = 6
}

fn reads_only_in_contract(x: Int) gives Int
    needs x > 0
    promises result > x
{
    return 1
}

fn main() {
    let p = Point(x: 1, y: 2)
