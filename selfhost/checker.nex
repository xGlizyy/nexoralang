// The NEXORA checker, written in NEXORA (decision 0025, stage 2).
//
// It follows nexora/src/nexora/checker.py. Like the parser, it threads its state through every call:
// a check returns the new state beside its result, and an error is added to the state.
//
// The result of checking is a new tree where every expression node has a "type" field, which is what
// `nex inspect` shows. A type is a Text ("Int", "List[Text]"...); the empty Text stands for None, the
// type of an expression that had an error.
//
// This first slice checks functions, variables, loops, `if`, operators, lists and calls to the
// functions of the program and the built-in ones. What it does not know yet it reports as
// `unsupported` in the state, and the comparison with the Python checker skips those programs.

import "lexer.nex"
import "parser.nex"

uses read "."

// A name that is visible: a parameter, a variable or the iterator of a `for`.
type Binding = {
    name: Text, category: Text, ty: Text, mutable: Bool, loop_variable: Bool, line: Int, column: Int,
    end_line: Int, end_column: Int
}

// What a call needs to know about a function. `generic` marks the built-ins of List, whose types
// mention the type variable T.
pub type Sig = {
    name: Text, param_names: List[Text], param_types: List[Text], return_type: Text, builtin: Bool,
    generic: Bool, line: Int, column: Int
}

type State = {
    problems: List[parser.Problem], user: List[Sig], function: Text, return_type: Text,
    in_example: Text, unsupported: Text, tables: Tables, usage: Usage
}

type Checked = { node: parser.Node, ty: Text, state: State }

type Free = { state: State, free: Bool }

type Typed = { node: parser.Node, state: State }

type Flow = { node: parser.Node, state: State, env: List[Binding], returns: Bool }

// The types a value can have, and the one of a call to a function that gives nothing.
fn any_value() gives Text {
    return "Int | Float | Bool | Text"
}

// Reading the tree

fn kind_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Obj(kind, names, values) => kind
        _ => ""
    }
}

fn index_of(names: List[Text], name: Text) gives Int {
    var i = 0
    while i < List.length(names)
        shrinks List.length(names) - i
    {
        if List.get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn field(node: parser.Node, name: Text) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => field_at(names, values, name)
        _ => parser.Node.Null()
    }
}

fn field_at(names: List[Text], values: List[parser.Node], name: Text) gives parser.Node {
    let index = index_of(names, name)
    if index < 0 {
        return parser.Node.Null()
    }
    return List.get(values, index)
}

fn text_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Str(value) => value
        _ => ""
    }
}

fn items_of(node: parser.Node) gives List[parser.Node] {
    return match node {
        parser.Node.Items(items) => items
        _ => []
    }
}

fn is_null(node: parser.Node) gives Bool {
    return match node {
        parser.Node.Null => true
        _ => false
    }
}

fn span_of(node: parser.Node) gives parser.Span {
    return match field(node, "span") {
        parser.Node.Place(line, column, end_line, end_column) => parser.Span(
            line: line, column: column, end_line: end_line, end_column: end_column
        )
        _ => parser.no_span()
    }
}

// The same node with the value of one field replaced.
fn with_field(node: parser.Node, name: Text, value: parser.Node) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => parser.Node.Obj(kind, names, replace_at(values, index_of(names, name), value))
        _ => node
    }
}

fn replace_at(values: List[parser.Node], index: Int, value: parser.Node) gives List[parser.Node] {
    var result: List[parser.Node] = []
    var i = 0
    while i < List.length(values)
        shrinks List.length(values) - i
    {
        if i == index {
            result = List.append(result, value)
        } else {
            result = List.append(result, List.get(values, i))
        }
        i = i + 1
    }
    return result
}

// The same node with its type added, as `nex inspect` shows it.
fn with_type(node: parser.Node, ty: Text) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => parser.Node.Obj(
            kind, List.append(names, "type"), List.append(values, parser.optional_text(ty))
        )
        _ => node
    }
}

// State

fn with_problems(state: State, problems: List[parser.Problem]) gives State {
    return State(
        problems: problems, user: state.user, function: state.function, return_type: state.return_type,
        in_example: state.in_example, unsupported: state.unsupported,
        tables: state.tables, usage: state.usage
    )
}

fn with_user(state: State, user: List[Sig]) gives State {
    return State(
        problems: state.problems, user: user, function: state.function, return_type: state.return_type,
        in_example: state.in_example, unsupported: state.unsupported,
        tables: state.tables, usage: state.usage
    )
}

fn with_function(state: State, function: Text, return_type: Text) gives State {
    return State(
        problems: state.problems, user: state.user, function: function, return_type: return_type,
        in_example: state.in_example, unsupported: state.unsupported,
        tables: state.tables, usage: state.usage
    )
}

fn with_example(state: State, in_example: Text) gives State {
    return State(
        problems: state.problems, user: state.user, function: state.function, return_type: state.return_type,
        in_example: in_example, unsupported: state.unsupported,
        tables: state.tables, usage: state.usage
    )
}

// Records the first thing the checker does not know yet.
fn unsupported(state: State, reason: Text) gives State {
    if state.unsupported != "" {
        return state
    }
    return State(
        problems: state.problems, user: state.user, function: state.function, return_type: state.return_type,
        in_example: state.in_example, unsupported: reason, tables: state.tables, usage: state.usage
    )
}

fn report(state: State, code: Text, label: Text, hint: Text, notes: List[Text], span: parser.Span) gives State {
    let problem = parser.Problem(
        code: code, label: label, hint: hint, notes: notes,
        line: span.line, column: span.column, end_line: span.end_line, end_column: span.end_column
    )
    return with_problems(state, List.append(state.problems, problem))
}

fn note_declared(name: Text, line: Int, column: Int) gives Text {
    return "'" + name + "' is declared at line " + to_text(line) + ", column " + to_text(column) + "."
}

// Built-in functions

fn make_sig(name: Text, param_names: List[Text], param_types: List[Text], return_type: Text, generic: Bool) gives Sig {
    return Sig(
        name: name, param_names: param_names, param_types: param_types, return_type: return_type,
        builtin: true, generic: generic, line: 0, column: 0
    )
}

fn builtin_names() gives List[Text] {
    return (
        [
            "print", "to_text", "to_float", "to_int", "args", "input", "read_file", "write_file", "Net.get",
            "Process.run", "Text.length", "Text.slice", "Text.contains", "Text.starts_with", "Text.ends_with",
            "Int.can_parse", "Int.parse", "Float.can_parse", "Float.parse", "List.length", "List.get",
            "List.append", "List.concat", "List.contains", "Some", "Ok", "Err", "Option.is_some",
            "Option.is_none", "Option.value_or", "Option.value", "Result.is_ok", "Result.is_err",
            "Result.value_or", "Result.value", "Result.error"
        ]
    )
}

pub fn is_builtin(name: Text) gives Bool {
    return List.contains(builtin_names(), name)
}

// The built-ins this slice checks. The others are reported as unsupported by the call.
fn builtin(name: Text) gives Sig {
    let any = any_value()
    if name == "print" {
        return make_sig(name, ["value"], [any], "Void", false)
    }
    if name == "to_text" {
        return make_sig(name, ["value"], [any], "Text", false)
    }
    if name == "to_float" {
        return make_sig(name, ["value"], ["Int"], "Float", false)
    }
    if name == "to_int" {
        return make_sig(name, ["value"], ["Float"], "Int", false)
    }
    if name == "args" {
        return make_sig(name, [], [], "List[Text]", false)
    }
    if name == "input" {
        return make_sig(name, [], [], "Text", false)
    }
    if name == "Text.length" {
        return make_sig(name, ["text"], ["Text"], "Int", false)
    }
    if name == "Text.slice" {
        return make_sig(name, ["text", "start", "end"], ["Text", "Int", "Int"], "Text", false)
    }
    if name == "Text.contains" or name == "Text.starts_with" or name == "Text.ends_with" {
        return make_sig(name, ["text", "part"], ["Text", "Text"], "Bool", false)
    }
    if name == "Int.can_parse" {
        return make_sig(name, ["text"], ["Text"], "Bool", false)
    }
    if name == "Int.parse" {
        return make_sig(name, ["text"], ["Text"], "Int", false)
    }
    if name == "Float.can_parse" {
        return make_sig(name, ["text"], ["Text"], "Bool", false)
    }
    if name == "Float.parse" {
        return make_sig(name, ["text"], ["Text"], "Float", false)
    }
    if name == "List.length" {
        return make_sig(name, ["xs"], ["List[T]"], "Int", true)
    }
    if name == "List.get" {
        return make_sig(name, ["xs", "i"], ["List[T]", "Int"], "T", true)
    }
    if name == "List.append" {
        return make_sig(name, ["xs", "x"], ["List[T]", "T"], "List[T]", true)
    }
    if name == "List.concat" {
        return make_sig(name, ["xs", "ys"], ["List[T]", "List[T]"], "List[T]", true)
    }
    if name == "List.contains" {
        return make_sig(name, ["xs", "x"], ["List[T]", "T"], "Bool", true)
    }
    if name == "read_file" {
        return make_sig(name, ["path"], ["Text"], "Text", false)
    }
    if name == "write_file" {
        return make_sig(name, ["path", "text"], ["Text", "Text"], "Void", false)
    }
    if name == "Net.get" {
        return make_sig(name, ["url"], ["Text"], "Text", false)
    }
    if name == "Process.run" {
        return make_sig(name, ["command", "arguments"], ["Text", "List[Text]"], "Text", true)
    }
    if name == "Some" {
        return make_sig(name, ["value"], ["T"], "Option[T]", true)
    }
    if name == "Ok" {
        return make_sig(name, ["value"], ["T"], "Result[T, E]", true)
    }
    if name == "Err" {
        return make_sig(name, ["error"], ["E"], "Result[T, E]", true)
    }
    if name == "Option.is_some" or name == "Option.is_none" {
        return make_sig(name, ["value"], ["Option[T]"], "Bool", true)
    }
    if name == "Option.value_or" {
        return make_sig(name, ["value", "fallback"], ["Option[T]", "T"], "T", true)
    }
    if name == "Option.value" {
        return make_sig(name, ["value"], ["Option[T]"], "T", true)
    }
    if name == "Result.is_ok" or name == "Result.is_err" {
        return make_sig(name, ["value"], ["Result[T, E]"], "Bool", true)
    }
    if name == "Result.value_or" {
        return make_sig(name, ["value", "fallback"], ["Result[T, E]", "T"], "T", true)
    }
    if name == "Result.value" {
        return make_sig(name, ["value"], ["Result[T, E]"], "T", true)
    }
    if name == "Result.error" {
        return make_sig(name, ["value"], ["Result[T, E]"], "E", true)
    }
    return make_sig("", [], [], "", false)
}

// A function of another module is looked up qualified, and shown with its own name, as it is declared.
fn shown_name(sig: Sig) gives Text {
    let dot = index_of_char(sig.name, ".")
    if sig.builtin or dot < 0 {
        return sig.name
    }
    return Text.slice(sig.name, dot + 1, Text.length(sig.name))
}

fn describe(sig: Sig) gives Text {
    var params = ""
    var i = 0
    while i < List.length(sig.param_names)
        shrinks List.length(sig.param_names) - i
    {
        if i > 0 {
            params = params + ", "
        }
        var shown = List.get(sig.param_types, i)
        if shown == "" {
            shown = "?"
        }
        params = params + List.get(sig.param_names, i) + ": " + shown
        i = i + 1
    }
    if sig.return_type == "Void" {
        return "fn " + shown_name(sig) + "(" + params + ")"
    }
    var given = sig.return_type
    if given == "" {
        given = "?"
    }
    return "fn " + shown_name(sig) + "(" + params + ") gives " + given
}

fn user_index(state: State, name: Text) gives Int {
    var i = 0
    while i < List.length(state.user)
        shrinks List.length(state.user) - i
    {
        let sig = List.get(state.user, i)
        if sig.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Types

fn is_value_type(ty: Text) gives Bool {
    return ty != "Void" and ty != ""
}

fn is_list(ty: Text) gives Bool {
    return Text.starts_with(ty, "List[") and Text.ends_with(ty, "]")
}

// The element type of a list type, or the empty text when it is not one.
fn list_item(ty: Text) gives Text {
    if is_list(ty) {
        return Text.slice(ty, 5, Text.length(ty) - 1)
    }
    return ""
}

fn conversion_hint(found: Text, expected: Text) gives Text {
    if found == "Int" and expected == "Float" {
        return "Convert the Int explicitly with to_float(...)."
    }
    if found == "Float" and expected == "Int" {
        return "Convert the Float explicitly with to_int(...), which drops the fractional part."
    }
    if expected == "Text" and (found == "Int" or found == "Float" or found == "Bool" or found == "Text") {
        return "Convert the value explicitly with to_text(...)."
    }
    return ""
}

fn binary_hint(operator: Text, left: Text, right: Text) gives Text {
    let numbers = (left == "Int" and right == "Float") or (left == "Float" and right == "Int")
    let texts = left == "Text" or right == "Text"
    let only_basic = (left == "Text" or left == "Int" or left == "Float") and (right == "Text" or right == "Int" or right == "Float")
    if left == "Void" or right == "Void" {
        return "A call to a Void function does not produce a value."
    }
    if operator == "and" or operator == "or" {
        return "'" + operator + "' combines two Bool values."
    }
    if numbers {
        return "Int and Float are never mixed. Convert one side: to_float(x) turns an Int into a Float."
    }
    if operator == "==" or operator == "!=" {
        return "Both sides of '" + operator + "' must have the same type."
    }
    if operator == "<" or operator == "<=" or operator == ">" or operator == ">=" {
        if texts and only_basic {
            return (
                "'" + operator + "' compares two values of the same type. Convert one side: to_text(...) "
                + "turns a number into a Text, and Int.parse(...) reads an Int from a Text."
            )
        }
        return "'" + operator + "' compares two Int values, two Float values or two Text values."
    }
    if operator == "+" and texts {
        return "'+' joins Text with Text. Convert the other side with to_text(...)."
    }
    if left == "Text" and right == "Text" {
        return "The only arithmetic operator defined for Text is '+', which joins two texts."
    }
    if left == "Bool" or right == "Bool" {
        return "Arithmetic works on numbers. Bool values are combined with 'and', 'or' and 'not'."
    }
    return ""
}

// The type of `left operator right`, or the empty text when the operation is not defined. Both
// operands always have the same type: nothing is converted implicitly.
fn binary_result(operator: Text, left: Text, right: Text) gives Text {
    if left != right or not is_value_type(left) {
        return ""
    }
    if operator == "and" or operator == "or" {
        if left == "Bool" {
            return "Bool"
        }
        return ""
    }
    if operator == "==" or operator == "!=" {
        return "Bool"
    }
    if operator == "<" or operator == "<=" or operator == ">" or operator == ">=" {
        if left == "Int" or left == "Float" or left == "Text" {
            return "Bool"
        }
        return ""
    }
    if left == "Int" or left == "Float" {
        return left
    }
    if left == "Text" and operator == "+" {
        return "Text"
    }
    return ""
}

// Checks that the expression `node`, of type `found`, can be used where `expected` is needed. A constant of the
// base type is accepted where a refined type is expected if it satisfies the condition, which is checked here.
// Any other value has to be checked explicitly.
fn expect_type(state: State, expected: Text, found: Text, node: parser.Node, notes: List[Text]) gives State {
    if accepts(state, expected, found) {
        return state
    }
    let span = span_of(node)
    if ref_index(state, expected) >= 0 {
        if root_of(state, found) == root_of(state, expected) {
            let constant = constant_of(node)
            if constant.present and ref_index(state, found) < 0 {
                return check_constant(state, node, expected)
            }
            return report(
                state, "E2011", "Expected " + expected + ", found " + found,
                "Check the value explicitly with " + expected + "(...). The program stops there if the value does "
                + "not satisfy the condition of " + expected + ".",
                notes, span
            )
        }
    }
    return report(
        state, "E2011", "Expected " + expected + ", found " + found,
        conversion_hint(root_of(state, found), root_of(state, expected)), notes, span
    )
}

// Visible names

fn binding_index(env: List[Binding], name: Text) gives Int {
    var i = List.length(env) - 1
    while i >= 0
        shrinks i + 1
    {
        let binding = List.get(env, i)
        if binding.name == name {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

fn make_binding(name: Text, category: Text, ty: Text, mutable: Bool, loop_variable: Bool, span: parser.Span) gives Binding {
    return Binding(
        name: name, category: category, ty: ty, mutable: mutable, loop_variable: loop_variable,
        line: span.line, column: span.column, end_line: span.end_line, end_column: span.end_column
    )
}

// Reports E2006 and says that `name` cannot be declared when it is a built-in, a function or already
// visible: functions, parameters and variables share one namespace.
fn name_is_free(state: State, env: List[Binding], name: Text, span: parser.Span) gives Free {
    if is_declared_record(state, name) or is_type_name(state, name) {
        return Free(
            state: report(
                state, "E2006", "'" + name + "' is the name of a type and cannot be used for something else",
                "Choose a different name. Types start with a capital letter; values usually do not.", [], span
            ),
            free: false
        )
    }
    if is_builtin(name) or user_index(state, name) >= 0 {
        var what = "a function"
        if is_builtin(name) {
            what = "a built-in function"
        }
        return Free(
            state: report(
                state, "E2006", "'" + name + "' is the name of " + what + " and cannot be used for something else",
                "Choose a different name.", [], span
            ),
            free: false
        )
    }
    let index = binding_index(env, name)
    if index >= 0 {
        let existing = List.get(env, index)
        return Free(
            state: report(
                state, "E2006", "'" + name + "' is already declared and still visible here",
                "Choose a different name: a visible name cannot be declared again.",
                [
                    "It was first declared at line " + to_text(existing.line) + ", column "
                    + to_text(existing.column) + "."
                ],
                span
            ),
            free: false
        )
    }
    return Free(state: state, free: true)
}

// Expressions

fn checked(node: parser.Node, ty: Text, state: State) gives Checked {
    return Checked(node: with_type(node, ty), ty: ty, state: state)
}

// The type of each argument is its own expression's; the Checked keeps the typed nodes in order.
type ArgList = { nodes: List[parser.Node], types: List[Text], state: State }

fn check_expression(state: State, env: List[Binding], node: parser.Node, expected: Text) gives Checked {
    let kind = kind_of(node)
    if kind == "IntLiteral" {
        return checked(node, "Int", state)
    }
    if kind == "FloatLiteral" {
        return checked(node, "Float", state)
    }
    if kind == "TextLiteral" {
        return checked(node, "Text", state)
    }
    if kind == "BoolLiteral" {
        return checked(node, "Bool", state)
    }
    if kind == "ListLiteral" {
        return check_list_literal(state, env, node, expected)
    }
    if kind == "Group" {
        let inner = check_expression(state, env, field(node, "expression"), expected)
        return checked(with_field(node, "expression", inner.node), inner.ty, inner.state)
    }
    if kind == "Name" {
        return check_name(state, env, node, expected)
    }
    if kind == "Unary" {
        return check_unary(state, env, node)
    }
    if kind == "Binary" {
        return check_binary(state, env, node)
    }
    if kind == "Call" {
        return check_call(state, env, node, expected)
    }
    if kind == "RecordConstruction" {
        return check_record_construction(state, env, node)
    }
    if kind == "FieldAccess" {
        return check_field_access(state, env, node)
    }
    if kind == "MatchExpr" {
        return check_match_expression(state, env, node, expected)
    }
    return checked(node, "", unsupported(state, kind))
}

fn check_name(state: State, env: List[Binding], node: parser.Node, expected: Text) gives Checked {
    let name = text_of(field(node, "name"))
    let index = binding_index(env, name)
    if index >= 0 {
        let binding = List.get(env, index)
        return checked(node, binding.ty, mark_read(state, binding, span_of(node)))
    }
    if is_type_name(state, name) or is_enum_name(state, name) {
        return checked(
            node, "",
            report(
                state, "E2011", "'" + name + "' is a type, not a value",
                "To check a refined value use " + name + "(x); to build an enum use " + name + ".Variant(...).",
                [], span_of(node)
            )
        )
    }
    if is_declared_record(state, name) {
        return checked(
            node, "",
            report(
                state, "E2011", "'" + name + "' is a type, not a value",
                "To build one, write it: " + name + "(field: value)", [], span_of(node)
            )
        )
    }
    if is_builtin(name) or user_index(state, name) >= 0 {
        return checked(
            node, "",
            report(
                state, "E2011", "'" + name + "' is a function, not a value",
                "Call it with parentheses: " + name + "(...)", [], span_of(node)
            )
        )
    }
    if name == "None" {
        return none_type(state, node, expected)
    }
    return checked(node, "", check_unknown_variable(state, env, name, span_of(node)))
}

fn check_unknown_variable(state: State, env: List[Binding], name: Text, span: parser.Span) gives State {
    if state.in_example != "" {
        return report(
            state, "E2005", "There is no variable named '" + name + "' here",
            "An example has no parameters: write its inputs as values, for example: " + state.in_example + "(2)",
            [], span
        )
    }
    if state.tables.refining != "" {
        return report(
            state, "E2005", "There is no variable named '" + name + "' here",
            "In the condition of '" + state.tables.refining + "', the only name is 'value': the value being checked.",
            [], span
        )
    }
    if name == "result" {
        return report(
            state, "E2005", "There is no variable named 'result' here",
            "'result' only exists inside a 'promises' clause of a function that gives a value.", [], span
        )
    }
    let close = close_match(name, binding_names(env))
    var hint = "Declare it first with 'let'."
    if close != "" {
        hint = "Did you mean '" + close + "'?"
    }
    return report(state, "E2005", "There is no variable named '" + name + "' here", hint, [], span)
}

fn check_unary(state: State, env: List[Binding], node: parser.Node) gives Checked {
    let operand = check_expression(state, env, field(node, "operand"), "")
    let rebuilt = with_field(node, "operand", operand.node)
    if operand.ty == "" {
        return checked(rebuilt, "", operand.state)
    }
    // A refined value takes part in operations as a value of its base type.
    let root = root_of(operand.state, operand.ty)
    let operator = text_of(field(node, "operator"))
    if operator == "-" {
        if root == "Int" or root == "Float" {
            return checked(rebuilt, root, operand.state)
        }
        return checked(
            rebuilt, "",
            report(
                operand.state, "E2011", "Cannot apply '-' to " + root, "'-' negates an Int or a Float.", [],
                span_of(node)
            )
        )
    }
    if root == "Bool" {
        return checked(rebuilt, "Bool", operand.state)
    }
    var hint = "'not' negates a Bool."
    if root == "Int" or root == "Float" {
        hint = hint + " To negate a comparison, put it in parentheses: not (a == b)"
    }
    return checked(
        rebuilt, "",
        report(operand.state, "E2011", "Cannot apply 'not' to " + root, hint, [], span_of(node))
    )
}

fn is_empty_list_literal(node: parser.Node) gives Bool {
    return kind_of(node) == "ListLiteral" and List.length(items_of(field(node, "elements"))) == 0
}

type Operands = { left: Checked, right: Checked }

// Checks both sides of a binary operator. The `right` holds the state after both sides. `None` takes its
// type from the other side of a comparison, and an empty list on the right takes it from the left.
fn check_operands(state: State, env: List[Binding], node: parser.Node, operator: Text) gives Operands {
    let equality = operator == "==" or operator == "!="
    let left_node = field(node, "left")
    let right_node = field(node, "right")
    if equality and is_none_constant(env, right_node) {
        let left = check_expression(state, env, left_node, "")
        let right = check_expression(left.state, env, right_node, left.ty)
        return Operands(left: left, right: right)
    }
    if equality and is_none_constant(env, left_node) {
        let right = check_expression(state, env, right_node, "")
        let left = check_expression(right.state, env, left_node, right.ty)
        return Operands(left: left, right: Checked(node: right.node, ty: right.ty, state: left.state))
    }
    let left = check_expression(state, env, left_node, "")
    // The left side is an expected type for an empty list on the right: `[1] == []`.
    var right_expected = ""
    if is_empty_list_literal(right_node) {
        right_expected = left.ty
    }
    let right = check_expression(left.state, env, right_node, right_expected)
    return Operands(left: left, right: right)
}

fn check_binary(state: State, env: List[Binding], node: parser.Node) gives Checked {
    let operator = text_of(field(node, "operator"))
    let operands = check_operands(state, env, node, operator)
    let left = operands.left
    let right = operands.right
    let rebuilt = with_field(with_field(node, "left", left.node), "right", right.node)
    if left.ty == "" or right.ty == "" {
        return checked(rebuilt, "", right.state)
    }
    var result = binary_result(operator, root_of(right.state, left.ty), root_of(right.state, right.ty))
    if left.ty == right.ty and (rec_index(right.state, left.ty) >= 0 or enum_index(right.state, left.ty) >= 0) {
        // A record or an enum is a value type: two values of the same type are compared by value.
        result = ""
        if operator == "==" or operator == "!=" {
            result = "Bool"
        }
    }
    if result == "" {
        return checked(
            rebuilt, "",
            report(
                right.state, "E2011", "Cannot apply '" + operator + "' to " + left.ty + " and " + right.ty,
                binary_hint(operator, root_of(right.state, left.ty), root_of(right.state, right.ty)), [], parser.Span(
                    line: span_line(field(node, "operator_span")), column: span_column(field(node, "operator_span")),
                    end_line: span_end_line(field(node, "operator_span")),
                    end_column: span_end_column(field(node, "operator_span"))
                )
            )
        )
    }
    return checked(rebuilt, result, right.state)
}

fn span_line(place: parser.Node) gives Int {
    return match place {
        parser.Node.Place(line, column, end_line, end_column) => line
        _ => 0
    }
}

fn span_column(place: parser.Node) gives Int {
    return match place {
        parser.Node.Place(line, column, end_line, end_column) => column
        _ => 0
    }
}

fn span_end_line(place: parser.Node) gives Int {
    return match place {
        parser.Node.Place(line, column, end_line, end_column) => end_line
        _ => 0
    }
}

fn span_end_column(place: parser.Node) gives Int {
    return match place {
        parser.Node.Place(line, column, end_line, end_column) => end_column
        _ => 0
    }
}

fn place_span(place: parser.Node) gives parser.Span {
    return parser.Span(
        line: span_line(place), column: span_column(place), end_line: span_end_line(place),
        end_column: span_end_column(place)
    )
}

// The type of `[a, b]`, or the empty text if an element is invalid or an empty list is ambiguous. The
// first element (or the expected type) fixes the element type.
fn check_list_literal(state: State, env: List[Binding], node: parser.Node, expected: Text) gives Checked {
    var item = list_item(expected)
    let elements = items_of(field(node, "elements"))
    if List.length(elements) == 0 {
        if item == "" {
            return checked(
                node, "",
                report(
                    state, "E2011", "Cannot infer the type of an empty list without an expected type",
                    "Write the type of its elements, for example: let xs: List[Int] = [].", [], span_of(node)
                )
            )
        }
        return checked(node, "List[" + item + "]", state)
    }
    var current = state
    var invalid = false
    var typed: List[parser.Node] = []
    var i = 0
    while i < List.length(elements)
        shrinks List.length(elements) - i
    {
        let element = List.get(elements, i)
        let found = check_expression(current, env, element, item)
        typed = List.append(typed, found.node)
        current = found.state
        if found.ty == "" {
            invalid = true
        } else if found.ty == "Void" {
            current = report(
                current, "E2011", "This call does not produce a value to put in a list", "", [], span_of(element)
            )
            invalid = true
        } else if item == "" {
            item = found.ty
        } else if not accepts(current, item, found.ty) {
            var notes: List[Text] = []
            if expected == "" {
                notes = ["The first element of this list is " + item + "."]
            }
            current = report(
                current, "E2011", "Expected " + item + ", found " + found.ty,
                "Every element of a list has the same type: " + item + ".", notes, span_of(element)
            )
            invalid = true
        }
        i = i + 1
    }
    let rebuilt = with_field(node, "elements", parser.Node.Items(typed))
    if invalid or item == "" {
        return checked(rebuilt, "", current)
    }
    return checked(rebuilt, "List[" + item + "]", current)
}

// The type each argument is checked against before the arguments are read: only a resolved signature
// fixes one, and a parameter that still mentions T or accepts any value fixes nothing.
fn expectation(sig: Sig, index: Int) gives Text {
    if index >= List.length(sig.param_types) {
        return ""
    }
    let declared = List.get(sig.param_types, index)
    if declared == any_value() or (sig.generic and has_variable(declared)) {
        return ""
    }
    return declared
}

fn check_arguments(state: State, env: List[Binding], arguments: List[parser.Node], sig: Sig) gives ArgList {
    var current = state
    var nodes: List[parser.Node] = []
    var types: List[Text] = []
    var i = 0
    while i < List.length(arguments)
        shrinks List.length(arguments) - i
    {
        let found = check_expression(current, env, List.get(arguments, i), expectation(sig, i))
        nodes = List.append(nodes, found.node)
        types = List.append(types, found.ty)
        current = found.state
        i = i + 1
    }
    return ArgList(nodes: nodes, types: types, state: current)
}

fn check_call(state: State, env: List[Binding], node: parser.Node, expected: Text) gives Checked {
    let callee = text_of(field(node, "callee"))
    let callee_span = place_span(field(node, "callee_span"))
    let arguments = items_of(field(node, "arguments"))
    let qualifier = text_of(field(node, "qualifier"))
    if qualifier != "" {
        var enum_key = qualifier
        if last_dot(callee) != index_of_char(callee, ".") {
            enum_key = Text.slice(callee, 0, last_dot(callee))
        }
        if is_enum_name(state, enum_key) {
            return check_enum_construction(state, env, node, enum_key)
        }
    }
    var sig = builtin(callee)
    let user = user_index(state, callee)
    if qualifier != "" and not is_builtin(callee) and user < 0 and not is_type_name(state, callee) {
        // `Name.function(...)` where Name is no type with that function.
        return checked(node, "", unknown_qualified_call(state, env, node))
    }
    if is_builtin(callee) and sig.name == "" {
        return checked(node, "", unsupported(state, "built-in " + callee))
    }
    if sig.name == "" and user >= 0 {
        sig = List.get(state.user, user)
    }
    let known = sig.name != ""
    var expectations_sig = sig
    if not known {
        expectations_sig = make_sig("", [], [], "", false)
    }
    let given = check_arguments(state, env, arguments, expectations_sig)
    let rebuilt = with_field(node, "arguments", parser.Node.Items(given.nodes))
    if is_type_name(state, callee) {
        if is_private(given.state, callee) {
            return checked(rebuilt, "", report_private(given.state, callee, callee_span))
        }
        return refinement_check(given, rebuilt, callee, arguments)
    }
    if state.tables.refining != "" and List.contains(state.tables.fn_names, callee) and not is_builtin(callee) {
        return checked(
            rebuilt, "",
            report(
                given.state, "E2018",
                "The condition of '" + state.tables.refining + "' cannot call the function '" + callee + "'",
                "A refinement only describes the value itself: it can use operators, literals and the built-in "
                + "conversions. Write the rule there, or check it with 'needs'.",
                [], callee_span
            )
        )
    }
    if not known {
        if binding_index(env, callee) >= 0 {
            return checked(
                rebuilt, "",
                report(given.state, "E2008", "'" + callee + "' is a variable, not a function", "", [], callee_span)
            )
        }
        return checked(
            rebuilt, "",
            report(
                given.state, "E2008", "There is no function named '" + callee + "'", function_hint(given.state, callee),
                [], callee_span
            )
        )
    }
    if not sig.builtin and is_private(given.state, callee) {
        return checked(rebuilt, "", report_private(given.state, callee, callee_span))
    }
    var tracked = given
    if not sig.builtin {
        tracked = ArgList(
            nodes: given.nodes, types: given.types, state: mark_function(given.state, sig.name, callee_span)
        )
    }
    let expected_count = List.length(sig.param_types)
    let count = List.length(arguments)
    if count != expected_count {
        var plural = "s"
        if expected_count == 1 {
            plural = ""
        }
        var verb = "were"
        if count == 1 {
            verb = "was"
        }
        var result = sig.return_type
        if sig.generic {
            result = ""
        }
        return checked(
            rebuilt, result,
            report(
                tracked.state, "E2009",
                "'" + shown_name(sig) + "' takes " + to_text(expected_count) + " argument" + plural + ", but "
                + to_text(count) + " " + verb + " given",
                "", ["Its signature is: " + describe(sig)], span_of(node)
            )
        )
    }
    var after_caps = tracked
    if capability_of(callee) != "" {
        after_caps = ArgList(nodes: tracked.nodes, types: tracked.types, state: check_capability(tracked.state, node))
    }
    if sig.generic {
        return check_generic_call(after_caps, rebuilt, sig, arguments, expected)
    }
    var current = after_caps.state
    var i = 0
    while i < count
        shrinks count - i
    {
        let found = List.get(tracked.types, i)
        let wanted = List.get(sig.param_types, i)
        if found != "" and wanted != "" {
            if found == "Void" {
                current = report(
                    current, "E2011", "This call does not produce a value to pass as an argument", "", [],
                    span_of(List.get(arguments, i))
                )
            } else if wanted != any_value() {
                current = expect_type(
                    current, wanted, found, List.get(arguments, i),
                    [
                        "This is the argument for '" + List.get(sig.param_names, i) + "' in: " + describe(sig)
                    ]
                )
            }
        }
        i = i + 1
    }
    return checked(rebuilt, sig.return_type, current)
}

// Conditions

fn check_condition(state: State, env: List[Binding], node: parser.Node, owner: Text) gives Checked {
    let found = check_expression(state, env, node, "")
    if found.ty == "" or accepts(found.state, "Bool", found.ty) {
        return found
    }
    var hint = ""
    if found.ty == "Int" or found.ty == "Float" {
        hint = "A number is not a condition. Compare it explicitly, for example: x != 0"
    } else if found.ty == "Void" {
        hint = "A call to a Void function does not produce a value."
    }
    return Checked(
        node: found.node, ty: found.ty,
        state: report(
            found.state, "E2011", "The condition of " + owner + " must be Bool, found " + found.ty, hint, [],
            span_of(node)
        )
    )
}

// Statements. Each returns the new tree, the new state and whether it always ends the function with
// `return`. A declaration also returns the environment with the new name.

fn flow(node: parser.Node, state: State, env: List[Binding], returns: Bool) gives Flow {
    return Flow(node: node, state: state, env: env, returns: returns)
}

fn declared_type(state: State, node: parser.Node, what: Text, allow_broken: Bool) gives Checked {
    // The type a TypeRef names. The empty type stands for a type written wrong.
    let name = text_of(field(node, "name"))
    let qualifier = field(node, "qualifier")
    let arguments = items_of(field(node, "arguments"))
    if not is_null(qualifier) {
        return qualified_type(state, node, allow_broken)
    }
    if name == "Void" {
        return checked(
            node, "",
            report(
                state, "E2012", what + " cannot have the type Void",
                "Void means 'no value', and it is never written: a function that gives nothing has no 'gives'.",
                [], span_of(node)
            )
        )
    }
    if name == "List" and List.length(arguments) == 1 {
        let item = declared_type(state, List.get(arguments, 0), "A list element", allow_broken)
        if item.ty == "" {
            return checked(node, "", item.state)
        }
        return checked(node, "List[" + item.ty + "]", item.state)
    }
    if (name == "Option" and List.length(arguments) == 1) or (name == "Result" and List.length(arguments) == 2) {
        var current = state
        var shown: List[Text] = []
        for argument in arguments {
            let resolved = declared_type(current, argument, "An argument of '" + name + "'", allow_broken)
            current = resolved.state
            if resolved.ty == "" {
                return checked(node, "", current)
            }
            shown = List.append(shown, resolved.ty)
        }
        return checked(node, name + "[" + parser.join_texts(shown, ", ") + "]", current)
    }
    if List.length(arguments) > 0 {
        return checked(node, "", unsupported(state, "generic type " + name))
    }
    if name == "Int" or name == "Float" or name == "Bool" or name == "Text" {
        return checked(node, name, state)
    }
    if is_type_name(state, name) {
        // A refined type whose own declaration has an error is already reported there: it is no type here.
        if ref_index(state, name) >= 0 {
            return checked(node, name, state)
        }
        return checked(node, "", state)
    }
    if is_enum_name(state, name) {
        // An enum whose own declaration has an error is already reported there: it is no type here.
        if enum_index(state, name) >= 0 or allow_broken {
            return checked(node, name, state)
        }
        return checked(node, "", state)
    }
    if is_declared_record(state, name) {
        // A record whose own declaration has an error is already reported there: it is no type here.
        if rec_index(state, name) >= 0 or allow_broken {
            return checked(node, name, state)
        }
        return checked(node, "", state)
    }
    let close = close_match_at(
        name,
        List.concat(
            List.concat(List.concat(known_type_names(), state.tables.type_names), state.tables.declared),
            state.tables.enum_names
        ),
        1, 2
    )
    var hint = "The types are Int, Float, Bool, Text and Void, and the types the program declares."
    if name == "String" {
        hint = "The text type is called Text."
    } else if close != "" {
        hint = "Did you mean '" + close + "'?"
    }
    return checked(node, "", report(state, "E2012", "'" + name + "' is not a type", hint, [], span_of(node)))
}

// `models.Point` written as a type: the record, refined type or enum `Point` of the module `models`.
fn qualified_type(state: State, node: parser.Node, allow_broken: Bool) gives Checked {
    let name = text_of(field(node, "name"))
    let module = text_of(field(node, "qualifier"))
    let key = module + "." + name
    if List.length(items_of(field(node, "arguments"))) > 0 {
        return checked(
            node, "",
            report(
                state, "E2012", "'" + key + "' cannot take type arguments",
                "Only 'List', 'Option' and 'Result' take type arguments, and they are built-in: a module does not declare them.",
                [], span_of(node)
            )
        )
    }
    let is_type = is_type_name(state, key)
    let is_record = is_declared_record(state, key)
    let is_enum = is_enum_name(state, key)
    if is_type or is_record or is_enum {
        if is_private(state, key) {
            return checked(node, "", report_private(state, key, span_of(node)))
        }
        let usable_type = is_type and ref_index(state, key) >= 0
        let usable_enum = is_enum and (enum_index(state, key) >= 0 or allow_broken)
        let usable_record = is_record and (rec_index(state, key) >= 0 or allow_broken)
        if usable_type or usable_enum or usable_record {
            return checked(node, key, state)
        }
        return checked(node, "", state)
    }
    let close = close_match_at(
        key,
        List.concat(
            List.concat(List.concat(known_type_names(), state.tables.type_names), state.tables.declared),
            state.tables.enum_names
        ),
        1, 2
    )
    var hint = "The types are Int, Float, Bool, Text and Void, and the types the program declares."
    if name == "String" {
        hint = "The text type is called Text."
    } else if List.contains(known_type_names(), name) {
        hint = "'" + name + "' is a built-in type: it belongs to no module. Write it as '" + name + "'."
    } else if close != "" {
        hint = "Did you mean '" + close + "'?"
    }
    return checked(node, "", report(state, "E2012", "'" + key + "' is not a type", hint, [], span_of(node)))
}

fn check_let(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let name = text_of(field(node, "name"))
    let name_span = place_span(field(node, "name_span"))
    let declared_node = field(node, "declared_type")
    var declared = ""
    var current = state
    if not is_null(declared_node) {
        let resolved = declared_type(current, declared_node, "The variable '" + name + "'", false)
        declared = resolved.ty
        current = resolved.state
    }
    let value = check_expression(current, env, field(node, "value"), declared)
    current = value.state
    var value_type = value.ty
    if value_type == "Void" {
        current = report(
            current, "E2011", "This call does not produce a value to store", "", [], span_of(field(node, "value"))
        )
        value_type = ""
    }
    var variable_type = value_type
    if declared != "" {
        // The annotation decides the type, so later uses are checked against what was intended.
        variable_type = declared
        if value_type != "" {
            current = expect_type(
                current, declared, value_type, field(node, "value"),
                ["'" + name + "' is declared as " + declared + "."]
            )
        }
    }
    let free = name_is_free(current, env, name, name_span)
    var next_env = env
    var next_state = free.state
    if free.free {
        let binding = make_binding(name, "variable", variable_type, kind_of(node) == "Var", false, name_span)
        next_env = List.append(env, binding)
        next_state = add_symbol(free.state, binding, free.state.usage.scope)
    }
    return flow(with_field(node, "value", value.node), next_state, next_env, false)
}

fn check_assign(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let name = text_of(field(node, "name"))
    let span = place_span(field(node, "name_span"))
    let index = binding_index(env, name)
    var target_type = ""
    if index >= 0 {
        let target = List.get(env, index)
        target_type = target.ty
    }
    let value = check_expression(state, env, field(node, "value"), target_type)
    let rebuilt = with_field(node, "value", value.node)
    var current = value.state
    if index < 0 {
        return flow(rebuilt, check_unknown_variable(current, env, name, span), env, false)
    }
    let target = List.get(env, index)
    if target.category == "parameter" {
        return flow(
            rebuilt,
            report(
                current, "E2007", "'" + name + "' is a parameter and cannot be given a new value",
                "Copy it into a variable: 'var name = " + name + "'.", [], span
            ),
            env, false
        )
    }
    if target.loop_variable {
        return flow(
            rebuilt,
            report(
                current, "E2007", "'" + name + "' is the iterator of a 'for' loop and cannot be given a new value",
                "The iterator takes each element of the list in turn; declare a 'var' for anything that changes.",
                [], span
            ),
            env, false
        )
    }
    if not target.mutable {
        return flow(
            rebuilt,
            report(
                current, "E2007", "'" + name + "' was declared with 'let' and cannot be given a new value",
                "Declare it with 'var' if its value has to change.",
                [note_declared(name, target.line, target.column)], span
            ),
            env, false
        )
    }
    if value.ty == "Void" {
        current = report(
            current, "E2011", "This call does not produce a value to store", "", [], span_of(field(node, "value"))
        )
    } else if value.ty != "" and target.ty != "" {
        current = expect_type(
            current, target.ty, value.ty, field(node, "value"),
            ["'" + name + "' is declared as " + target.ty + "."]
        )
    }
    return flow(rebuilt, mark_assigned(current, target, span), env, false)
}

fn check_return(state: State, env: List[Binding], node: parser.Node) gives Typed {
    let expected = state.return_type
    let name = state.function
    let value_node = field(node, "value")
    if is_null(value_node) {
        if expected != "" and expected != "Void" {
            return Typed(
                node: node,
                state: report(
                    state, "E2011", "Expected a value of type " + expected + " after 'return'", "",
                    ["'" + name + "' is declared to return " + expected + "."], span_of(node)
                )
            )
        }
        return Typed(node: node, state: state)
    }
    var wanted = ""
    if expected != "" and expected != "Void" {
        wanted = expected
    }
    let found = check_expression(state, env, value_node, wanted)
    let rebuilt = with_field(node, "value", found.node)
    if found.ty == "" or expected == "" {
        return Typed(node: rebuilt, state: found.state)
    }
    if expected == "Void" {
        return Typed(
            node: rebuilt,
            state: report(
                found.state, "E2011", "'" + name + "' returns Void, so 'return' cannot be followed by a value",
                "Write 'return' on its own, or change the return type of the function.", [], span_of(value_node)
            )
        )
    }
    if found.ty == "Void" {
        return Typed(
            node: rebuilt,
            state: report(found.state, "E2011", "This call does not produce a value to return", "", [], span_of(value_node))
        )
    }
    return Typed(
        node: rebuilt,
        state: expect_type(
            found.state, expected, found.ty, value_node,
            ["'" + name + "' is declared to return " + expected + "."]
        )
    )
}

fn check_expression_statement(state: State, env: List[Binding], node: parser.Node) gives Typed {
    let expression = field(node, "expression")
    let found = check_expression(state, env, expression, "")
    let rebuilt = with_field(node, "expression", found.node)
    if found.ty == "" {
        return Typed(node: rebuilt, state: found.state)
    }
    let hint = "Store it with 'let name = ...' or pass it to a function."
    if kind_of(expression) == "MatchExpr" and found.ty == "Void" {
        return Typed(node: rebuilt, state: found.state)
    }
    if kind_of(expression) != "Call" {
        return Typed(
            node: rebuilt,
            state: report(found.state, "E2010", "The value of this expression is never used", hint, [], span_of(expression))
        )
    }
    if found.ty != "Void" {
        return Typed(
            node: rebuilt,
            state: report(
                found.state, "E2010",
                "The " + found.ty + " returned by '" + text_of(field(expression, "callee")) + "' is never used",
                hint, [], span_of(expression)
            )
        )
    }
    return Typed(node: rebuilt, state: found.state)
}

// A block opens a scope: the names it declares are not visible after it. The Flow holds the typed
// block and whether it always returns; its environment is the one it received.
fn check_block(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let statements = items_of(field(node, "statements"))
    let outer = state.usage.scope
    var current = with_scope(state, span_of(node))
    var scope = env
    var typed: List[parser.Node] = []
    var returned = false
    var reported = false
    var i = 0
    while i < List.length(statements)
        shrinks List.length(statements) - i
    {
        let statement = List.get(statements, i)
        if returned and not reported {
            current = report(
                current, "E2015", "This code can never run: the function has already returned",
                "Remove it, or move it before the 'return'.", [], span_of(statement)
            )
            reported = true
        }
        let done = check_statement(current, scope, statement)
        typed = List.append(typed, done.node)
        current = done.state
        scope = done.env
        if done.returns {
            returned = true
        }
        i = i + 1
    }
    return flow(with_field(node, "statements", parser.Node.Items(typed)), with_scope(current, outer), env, returned)
}

fn check_statement(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let kind = kind_of(node)
    if kind == "Let" or kind == "Var" {
        return check_let(state, env, node)
    }
    if kind == "Return" {
        let done = check_return(state, env, node)
        return flow(done.node, done.state, env, true)
    }
    if kind == "If" {
        return check_if(state, env, node)
    }
    if kind == "Block" {
        return check_block(state, env, node)
    }
    if kind == "While" {
        return check_while(state, env, node)
    }
    if kind == "For" {
        return check_for(state, env, node)
    }
    if kind == "Assign" {
        return check_assign(state, env, node)
    }
    if kind == "FieldAssign" {
        return check_field_assign(state, env, node)
    }
    if kind == "IfLet" {
        return check_if_let(state, env, node)
    }
    if kind == "ExprStatement" {
        let done = check_expression_statement(state, env, node)
        return flow(done.node, done.state, env, false)
    }
    return flow(node, unsupported(state, kind), env, false)
}

// `if`, with its `else` branch: a block, another `if`, or nothing.
fn check_if(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let condition = check_condition(state, env, field(node, "condition"), "'if'")
    let then_flow = check_block(condition.state, env, field(node, "then_block"))
    let else_node = field(node, "else_branch")
    let head = with_field(with_field(node, "condition", condition.node), "then_block", then_flow.node)
    if is_null(else_node) {
        return flow(head, then_flow.state, env, false)
    }
    var else_flow = check_block(then_flow.state, env, else_node)
    if kind_of(else_node) == "If" {
        else_flow = check_if(then_flow.state, env, else_node)
    } else if kind_of(else_node) == "IfLet" {
        else_flow = check_if_let(then_flow.state, env, else_node)
    }
    return flow(
        with_field(head, "else_branch", else_flow.node), else_flow.state, env, then_flow.returns and else_flow.returns
    )
}

// The clauses of a loop. A `keeps` is a condition; a `shrinks` is an Int measure, and a `for` has none.
fn check_loop_clauses(state: State, env: List[Binding], clauses: List[parser.Node], is_for: Bool) gives Typed {
    var current = state
    var typed: List[parser.Node] = []
    var i = 0
    while i < List.length(clauses)
        shrinks List.length(clauses) - i
    {
        let clause = List.get(clauses, i)
        if text_of(field(clause, "clause")) == "keeps" {
            let kept = check_condition(current, env, field(clause, "condition"), "'keeps'")
            typed = List.append(typed, with_field(clause, "condition", kept.node))
            current = kept.state
        } else if is_for {
            typed = List.append(typed, clause)
            current = report(
                current, "E2022", "'shrinks' has no meaning in a 'for' loop",
                "A 'for' loop ends when the list is exhausted; remove the 'shrinks' clause.", [], span_of(clause)
            )
        } else {
            let measure = check_expression(current, env, field(clause, "condition"), "")
            typed = List.append(typed, with_field(clause, "condition", measure.node))
            current = measure.state
            if measure.ty != "" and root_of(current, measure.ty) != "Int" {
                current = report(
                    current, "E2011", "The measure of 'shrinks' must be Int, found " + measure.ty,
                    "The measure is a whole number that gets smaller on every turn and never goes below 0.",
                    [], span_of(field(clause, "condition"))
                )
            }
        }
        i = i + 1
    }
    return Typed(node: parser.Node.Items(typed), state: current)
}

fn count_measures(clauses: List[parser.Node]) gives Int {
    var count = 0
    var i = 0
    while i < List.length(clauses)
        shrinks List.length(clauses) - i
    {
        if text_of(field(List.get(clauses, i), "clause")) == "shrinks" {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// A loop never counts as always returning: the analysis does not evaluate conditions.
fn check_while(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let condition = check_condition(state, env, field(node, "condition"), "'while'")
    let clauses = items_of(field(node, "clauses"))
    let checked_clauses = check_loop_clauses(condition.state, env, clauses, false)
    var current = checked_clauses.state
    let measures = count_measures(clauses)
    if measures == 0 {
        let at = span_of(node)
        current = report(
            current, "E2021", "This loop does not say why it ends",
            "Add 'shrinks <expression>' to the header of the loop, with an Int that gets smaller on every turn and "
            + "never goes below 0, for example 'shrinks n - i'.",
            [], parser.Span(line: at.line, column: at.column, end_line: at.line, end_column: at.column + 5)
        )
    }
    var seen = 0
    var j = 0
    while j < List.length(clauses)
        shrinks List.length(clauses) - j
    {
        let clause = List.get(clauses, j)
        if text_of(field(clause, "clause")) == "shrinks" {
            if seen == 0 {
                seen = 1
            } else {
                let first = first_measure_span(clauses)
                current = report(
                    current, "E2021", "A loop has exactly one measure",
                    "Combine them into one Int that gets smaller on every turn.",
                    ["The first 'shrinks' is at line " + to_text(first.line) + ", column " + to_text(first.column) + "."],
                    span_of(clause)
                )
            }
        }
        j = j + 1
    }
    let body = check_block(current, env, field(node, "body"))
    let rebuilt = with_field(with_field(with_field(node, "condition", condition.node), "clauses", checked_clauses.node), "body", body.node)
    return flow(rebuilt, body.state, env, false)
}

fn first_measure_span(clauses: List[parser.Node]) gives parser.Span {
    var i = 0
    while i < List.length(clauses)
        shrinks List.length(clauses) - i
    {
        let clause = List.get(clauses, i)
        if text_of(field(clause, "clause")) == "shrinks" {
            return span_of(clause)
        }
        i = i + 1
    }
    return parser.no_span()
}

// A `for` loop over a `List[T]`: the iterator is a new immutable name in the scope of the body.
fn check_for(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let iterable = check_expression(state, env, field(node, "iterable"), "")
    var current = iterable.state
    var item = ""
    if iterable.ty == "Void" {
        current = report(
            current, "E2011", "This call does not produce a value to walk over", "", [],
            span_of(field(node, "iterable"))
        )
    } else if iterable.ty != "" {
        item = list_item(iterable.ty)
        if item == "" {
            current = report(
                current, "E2011", "The value a 'for' walks over must be a List, found " + iterable.ty,
                "Write the list the loop walks over, for example: for x in xs \{ ... }.", [],
                span_of(field(node, "iterable"))
            )
        }
    }
    let clauses = check_loop_clauses(current, env, items_of(field(node, "clauses")), true)
    current = clauses.state
    let name = text_of(field(node, "name"))
    let name_span = place_span(field(node, "name_span"))
    let free = name_is_free(current, env, name, name_span)
    var body_env = env
    var body_state = free.state
    if free.free {
        let binding = make_binding(name, "variable", item, false, true, name_span)
        body_env = List.append(env, binding)
        body_state = add_symbol(free.state, binding, span_of(field(node, "body")))
    }
    let body = check_block(body_state, body_env, field(node, "body"))
    let rebuilt = with_field(
        with_field(with_field(node, "iterable", iterable.node), "clauses", clauses.node), "body", body.node
    )
    return flow(rebuilt, body.state, env, false)
}

// Functions

fn declare_param(
    state: State, env: List[Binding], name: Text, span: parser.Span, ty: Text, scope: parser.Span
) gives Flow {
    let binding = make_binding(name, "parameter", ty, false, false, span)
    if name == "result" {
        return flow(
            parser.Node.Null(),
            add_symbol(
                report(
                    state, "E2013", "A parameter cannot be named 'result'",
                    "'result' is the name of the value a function gives, inside a 'promises' clause.", [], span
                ),
                binding, scope
            ),
            List.append(env, binding),
            false
        )
    }
    let free = name_is_free(state, env, name, span)
    if not free.free {
        return flow(parser.Node.Null(), free.state, env, false)
    }
    return flow(parser.Node.Null(), add_symbol(free.state, binding, scope), List.append(env, binding), false)
}

// The signature of a function: the types of its parameters and what it gives.
type SigResult = { sig: Sig, state: State }

fn make_signature(state: State, node: parser.Node) gives SigResult {
    var current = state
    var names: List[Text] = []
    var types: List[Text] = []
    let params = items_of(field(node, "params"))
    var i = 0
    while i < List.length(params)
        shrinks List.length(params) - i
    {
        let param = List.get(params, i)
        let name = text_of(field(param, "name"))
        let resolved = declared_type(current, field(param, "type"), "The parameter '" + name + "'", false)
        current = resolved.state
        names = List.append(names, name)
        types = List.append(types, resolved.ty)
        i = i + 1
    }
    let name_span = place_span(field(node, "name_span"))
    let return_node = field(node, "return_type")
    var return_type = "Void"
    if not is_null(return_node) {
        if text_of(field(return_node, "name")) == "Void" and is_null(field(return_node, "qualifier")) {
            // `gives Void` is not written; the function still gives nothing.
            current = report(
                current, "E2012", "'Void' is not written after 'gives'",
                "A function that gives nothing has no 'gives'", [], span_of(return_node)
            )
        } else {
            let resolved = declared_type(current, return_node, "", false)
            current = resolved.state
            return_type = resolved.ty
        }
    }
    let sig = Sig(
        name: text_of(field(node, "name")), param_names: names, param_types: types, return_type: return_type,
        builtin: false, generic: false, line: name_span.line, column: name_span.column
    )
    return SigResult(sig: sig, state: current)
}

// The loops inside a block, at any depth, in the order they are written. As in Python, only blocks,
// loops and `if` are looked into.
fn collect_loops(node: parser.Node) gives List[parser.Node] {
    let kind = kind_of(node)
    var found: List[parser.Node] = []
    if kind == "Block" {
        for statement in items_of(field(node, "statements")) {
            found = List.concat(found, collect_loops(statement))
        }
    } else if kind == "While" or kind == "For" {
        found = List.append(found, node)
        found = List.concat(found, collect_loops(field(node, "body")))
    } else if kind == "If" {
        found = List.concat(found, collect_loops(field(node, "then_block")))
        let else_branch = field(node, "else_branch")
        if not is_null(else_branch) {
            found = List.concat(found, collect_loops(else_branch))
        }
    }
    return found
}

fn header_of_kind(header: List[parser.Node], kind: Text) gives List[parser.Node] {
    var found: List[parser.Node] = []
    for item in header {
        if kind_of(item) == kind {
            found = List.append(found, item)
        }
    }
    return found
}

// Whether the clauses are ordered by position, so a stable insertion sort can put them in order.
fn before(a: parser.Node, b: parser.Node) gives Bool {
    let first = span_of(a)
    let second = span_of(b)
    return first.line < second.line or (first.line == second.line and first.column < second.column)
}

fn sort_by_position(nodes: List[parser.Node]) gives List[parser.Node] {
    var sorted: List[parser.Node] = []
    for node in nodes {
        var result: List[parser.Node] = []
        var placed = false
        for existing in sorted {
            if not placed and before(node, existing) {
                result = List.append(result, node)
                placed = true
            }
            result = List.append(result, existing)
        }
        if not placed {
            result = List.append(result, node)
        }
        sorted = result
    }
    return sorted
}

// E2031: a clause name is used once in a function, its loops included, and is neither a parameter nor
// `result`. A name is not a variable.
fn check_clause_names(state: State, node: parser.Node, sig: Sig) gives State {
    var clauses = header_of_kind(items_of(field(node, "header")), "Contract")
    for loop in collect_loops(field(node, "body")) {
        clauses = List.concat(clauses, items_of(field(loop, "clauses")))
    }
    var current = state
    var seen_names: List[Text] = []
    var seen_lines: List[Int] = []
    var seen_columns: List[Int] = []
    for clause in sort_by_position(clauses) {
        let name_node = field(clause, "name")
        if not is_null(name_node) {
            let name = text_of(name_node)
            let span = span_of(clause)
            let seen = index_of(seen_names, name)
            if seen >= 0 {
                current = report(
                    current, "E2031", "The promise name '" + name + "' is used twice in '" + sig.name + "'",
                    "Give each clause of a function, and of its loops, its own name.",
                    [
                        "It is first used at line " + to_text(List.get(seen_lines, seen)) + ", column "
                        + to_text(List.get(seen_columns, seen)) + "."
                    ],
                    span
                )
            } else if List.contains(sig.param_names, name) {
                current = report(
                    current, "E2031", "The promise name '" + name + "' is also a parameter of '" + sig.name + "'",
                    "A clause name says what the clause is about; choose one that is not a parameter.", [], span
                )
            } else if name == "result" {
                current = report(
                    current, "E2031", "'result' cannot be the name of a clause",
                    "'result' is the value the function gives; choose another name.", [], span
                )
            }
            if seen < 0 {
                seen_names = List.append(seen_names, name)
                seen_lines = List.append(seen_lines, span.line)
                seen_columns = List.append(seen_columns, span.column)
            }
        }
    }
    return current
}

// Whether a tree has a call to `function` anywhere inside it.
fn calls_function(node: parser.Node, function: Text) gives Bool {
    return match node {
        parser.Node.Obj(kind, names, values) => object_calls(kind, names, values, function)
        parser.Node.Items(items) => any_calls(items, function)
        _ => false
    }
}

fn object_calls(kind: Text, names: List[Text], values: List[parser.Node], function: Text) gives Bool {
    if kind == "Call" and text_of(field_at(names, values, "callee")) == function {
        return true
    }
    return any_calls(values, function)
}

fn any_calls(nodes: List[parser.Node], function: Text) gives Bool {
    for node in nodes {
        if calls_function(node, function) {
            return true
        }
    }
    return false
}

// An `example` clause: checked, never evaluated. It sees no parameter and no `result`, only the
// functions of the program.
fn check_example(state: State, node: parser.Node, function: Text) gives Typed {
    let inside = check_condition(with_example(state, function), [], field(node, "condition"), "'example'")
    var current = with_example(inside.state, "")
    if not calls_function(field(node, "condition"), function) {
        current = report(
            current, "E2020", "This example of '" + function + "' never calls '" + function + "'",
            "Write the call with its inputs, for example: example " + function + "(2) == 4", [],
            span_of(field(node, "condition"))
        )
    }
    return Typed(node: with_field(node, "condition", inside.node), state: current)
}

fn check_function(state: State, node: parser.Node, sig: Sig) gives Typed {
    var current = with_function(state, sig.name, sig.return_type)
    var env: List[Binding] = []
    let params = items_of(field(node, "params"))
    var i = 0
    while i < List.length(params)
        shrinks List.length(params) - i
    {
        let param = List.get(params, i)
        let declared = declare_param(
            current, env, text_of(field(param, "name")), place_span(field(param, "name_span")),
            List.get(sig.param_types, i), span_of(field(node, "body"))
        )
        current = declared.state
        env = declared.env
        i = i + 1
    }
    current = check_clause_names(current, node, sig)
    let header = items_of(field(node, "header"))
    let has_value = sig.return_type != "" and sig.return_type != "Void"
    var typed_contracts: List[parser.Node] = []
    for item in header {
        if kind_of(item) == "Contract" {
            var contract_env = env
            let clause = text_of(field(item, "clause"))
            if clause == "promises" and has_value {
                // `result` exists only here, and only when there is a value to name.
                contract_env = List.append(
                    env, make_binding("result", "result", sig.return_type, false, false, span_of(item))
                )
            }
            let condition = check_condition(current, contract_env, field(item, "condition"), "'" + clause + "'")
            typed_contracts = List.append(typed_contracts, with_field(item, "condition", condition.node))
            current = condition.state
        }
    }
    var typed_examples: List[parser.Node] = []
    for item in header {
        if kind_of(item) == "Example" {
            let checked_example = check_example(current, item, sig.name)
            typed_examples = List.append(typed_examples, checked_example.node)
            current = checked_example.state
        }
    }
    var typed_header: List[parser.Node] = []
    var contract_index = 0
    var example_index = 0
    for item in header {
        if kind_of(item) == "Contract" {
            typed_header = List.append(typed_header, List.get(typed_contracts, contract_index))
            contract_index = contract_index + 1
        } else {
            typed_header = List.append(typed_header, List.get(typed_examples, example_index))
            example_index = example_index + 1
        }
    }
    let body = check_block(current, env, field(node, "body"))
    current = body.state
    if has_value and not body.returns {
        current = report(
            current, "E2014",
            "'" + sig.name + "' must return a value of type " + sig.return_type
            + ", but its body can end without a 'return'",
            "Make sure every path through the function ends with 'return'. "
            + "An 'if' without 'else' can be skipped, and a loop may not run at all.",
            [], place_span(field(node, "name_span"))
        )
    }
    let rebuilt = with_field(with_field(node, "header", parser.Node.Items(typed_header)), "body", body.node)
    return Typed(node: rebuilt, state: current)
}

// The entry point.
fn check_main(state: State, entry: parser.Node, found: Bool, sig: Sig) gives State {
    if not found {
        return report(
            state, "E2001", "This program has no 'main' function, so there is nothing to run",
            "Add the entry point: fn main() \{ ... }", [], parser.no_span()
        )
    }
    var current = state
    let params = items_of(field(entry, "params"))
    if List.length(params) > 0 {
        current = report(
            current, "E2013", "'main' cannot have parameters", "Write: fn main() \{", [],
            parser.join_spans(span_of(List.get(params, 0)), span_of(List.get(params, List.length(params) - 1)))
        )
    }
    if sig.return_type != "" and sig.return_type != "Void" {
        current = report(
            current, "E2004", "'main' gives nothing", "Write: fn main() \{", [], span_of(field(entry, "return_type"))
        )
    }
    return current
}

fn has_declarations(program: parser.Node) gives Bool {
    return (
        List.length(items_of(field(program, "imports"))) > 0
    )
}

fn is_expression_kind(kind: Text) gives Bool {
    return List.contains(
        [
            "IntLiteral", "FloatLiteral", "TextLiteral", "BoolLiteral", "ListLiteral", "Name", "Unary", "Binary",
            "Group", "Call", "RecordConstruction", "FieldAccess", "MatchExpr"
        ],
        kind
    )
}

// An expression the checker never reached has no type: `nex inspect` shows it as null.
fn fill_types(node: parser.Node) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => fill_object(kind, names, values)
        parser.Node.Items(items) => parser.Node.Items(fill_all(items))
        _ => node
    }
}

fn fill_all(nodes: List[parser.Node]) gives List[parser.Node] {
    var result: List[parser.Node] = []
    for node in nodes {
        result = List.append(result, fill_types(node))
    }
    return result
}

fn fill_object(kind: Text, names: List[Text], values: List[parser.Node]) gives parser.Node {
    var filled_names = names
    var filled_values = fill_all(values)
    if is_expression_kind(kind) and index_of(names, "type") < 0 {
        filled_names = List.append(filled_names, "type")
        filled_values = List.append(filled_values, parser.Node.Null())
    }
    return parser.Node.Obj(kind, filled_names, filled_values)
}

fn initial_state() gives State {
    return State(
        problems: [], user: [], function: "", return_type: "", in_example: "", unsupported: "",
        tables: empty_tables(), usage: empty_usage()
    )
}

// Modules (decision 0018). A module is checked by itself, with its own names bare. What the modules that import it
// need from it is its Export: the same tables, with every name qualified with the module, and the names it does not
// make public listed apart so that using one of them can be told from using a name that does not exist.
pub type Export = {
    name: Text, user: List[Sig], declared: List[Text], records: List[Rec], type_names: List[Text],
    type_decls: List[parser.Node], refined: List[Ref], enum_names: List[Text], enums: List[EnumInfo],
    private: List[Text]
}

// The export of a module that could not be analysed (a lexical error): it declares nothing.
pub fn empty_export() gives Export {
    return Export(
        name: "", user: [], declared: [], records: [], type_names: [], type_decls: [], refined: [], enum_names: [],
        enums: [], private: []
    )
}

fn is_word_char(c: Text) gives Bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"
}

// A type as another module sees it: each name the module declares gets the module in front. A name that is already
// qualified (it comes from a third module) and the built-in ones stay as they are.
pub fn qualify_type(ty: Text, names: List[Text], module: Text) gives Text {
    var result = ""
    var i = 0
    while i < Text.length(ty)
        shrinks Text.length(ty) - i
    {
        let c = Text.slice(ty, i, i + 1)
        if is_word_char(c) {
            var j = i
            while j < Text.length(ty) and is_word_char(Text.slice(ty, j, j + 1))
                shrinks Text.length(ty) - j
            {
                j = j + 1
            }
            let word = Text.slice(ty, i, j)
            if List.contains(names, word) and not (i > 0 and Text.slice(ty, i - 1, i) == ".") {
                result = result + module + "." + word
            } else {
                result = result + word
            }
            i = j
        } else {
            result = result + c
            i = i + 1
        }
    }
    return result
}

fn qualify_all(types: List[Text], names: List[Text], module: Text) gives List[Text] {
    var result: List[Text] = []
    for ty in types {
        result = List.append(result, qualify_type(ty, names, module))
    }
    return result
}

fn not_public(declarations: List[parser.Node], module: Text) gives List[Text] {
    var result: List[Text] = []
    for declaration in declarations {
        if not flag_of(field(declaration, "public")) {
            result = List.append(result, module + "." + text_of(field(declaration, "name")))
        }
    }
    return result
}

fn export_module(state: State, program: parser.Node, module: Text) gives Export {
    let t = state.tables
    let local = List.concat(List.concat(t.declared, t.type_names), t.enum_names)
    var user: List[Sig] = []
    for sig in state.user {
        user = List.append(
            user,
            Sig(
                name: module + "." + sig.name, param_names: sig.param_names,
                param_types: qualify_all(sig.param_types, local, module),
                return_type: qualify_type(sig.return_type, local, module), builtin: sig.builtin,
                generic: sig.generic, line: sig.line, column: sig.column
            )
        )
    }
    var declared: List[Text] = []
    for name in t.declared {
        declared = List.append(declared, module + "." + name)
    }
    var records: List[Rec] = []
    for record in t.records {
        records = List.append(
            records,
            Rec(
                name: module + "." + record.name, field_names: record.field_names,
                field_types: qualify_all(record.field_types, local, module), line: record.line, column: record.column
            )
        )
    }
    var type_names: List[Text] = []
    for name in t.type_names {
        type_names = List.append(type_names, module + "." + name)
    }
    var refined: List[Ref] = []
    for ref in t.refined {
        refined = List.append(
            refined,
            Ref(
                name: module + "." + ref.name, base: qualify_type(ref.base, local, module), root: ref.root,
                chain: qualify_all(ref.chain, local, module)
            )
        )
    }
    var enum_names: List[Text] = []
    for name in t.enum_names {
        enum_names = List.append(enum_names, module + "." + name)
    }
    var enums: List[EnumInfo] = []
    for info in t.enums {
        var field_types: List[List[Text]] = []
        for types in info.variant_field_types {
            field_types = List.append(field_types, qualify_all(types, local, module))
        }
        enums = List.append(
            enums,
            EnumInfo(
                name: module + "." + info.name, variant_names: info.variant_names,
                variant_field_names: info.variant_field_names, variant_field_types: field_types
            )
        )
    }
    var private: List[Text] = []
    for function in items_of(field(program, "functions")) {
        if not flag_of(field(function, "public")) {
            private = List.append(private, module + "." + text_of(field(function, "name")))
        }
    }
    private = List.concat(private, not_public(items_of(field(program, "records")), module))
    private = List.concat(private, not_public(items_of(field(program, "types")), module))
    private = List.concat(private, not_public(items_of(field(program, "enums")), module))
    return Export(
        name: module, user: user, declared: declared, records: records, type_names: type_names,
        type_decls: t.type_decls, refined: refined, enum_names: enum_names, enums: enums, private: private
    )
}

fn import_module(state: State, ex: Export) gives State {
    let t = state.tables
    let tables = Tables(
        declared: List.concat(t.declared, ex.declared), records: List.concat(t.records, ex.records),
        type_names: List.concat(t.type_names, ex.type_names), type_decls: List.concat(t.type_decls, ex.type_decls),
        refined: List.concat(t.refined, ex.refined), steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: List.concat(t.enum_names, ex.enum_names), enums: List.concat(t.enums, ex.enums),
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules,
        private: List.concat(t.private, ex.private)
    )
    return with_user(with_tables(state, tables), List.concat(state.user, ex.user))
}

fn seed_imports(imports: List[Export], modules: List[Text]) gives State {
    var current = initial_state()
    for ex in imports {
        current = import_module(current, ex)
    }
    let t = current.tables
    return with_tables(
        current,
        Tables(
            declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
            refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
            reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns, enum_names: t.enum_names,
            enums: t.enums, cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: modules, private: t.private
        )
    )
}

fn check_program(program: parser.Node, require_main: Bool) gives Typed {
    if has_declarations(program) {
        return Typed(node: program, state: unsupported(initial_state(), "declarations"))
    }
    return check_with(program, require_main, true, [], [])
}

// The program with the modules it imports already checked, in the order they were read.
fn check_with(
    program: parser.Node, require_main: Bool, warn: Bool, imports: List[Export], modules: List[Text]
) gives Typed {
    var current = seed_imports(imports, modules)
    current = declare_type_names(current, program)
    current = declare_types(current)
    current = declare_uses(current, program)
    let functions = items_of(field(program, "functions"))
    var function_names: List[Text] = []
    for function in functions {
        function_names = List.append(function_names, text_of(field(function, "name")))
    }
    current = with_tables(current, set_fn_names(current.tables, function_names))
    // The conditions of the refined types are checked before the signatures, so a type whose condition is
    // wrong is already unusable when a signature names it.
    var typed_types: List[parser.Node] = []
    for declaration in items_of(field(program, "types")) {
        let done = check_type_condition(current, declaration)
        typed_types = List.append(typed_types, done.node)
        current = done.state
    }
    current = declare_enums(current, program)
    current = declare_records(current, program)
    var signatures: List[Sig] = []
    var main_node = parser.Node.Null()
    var main_found = false
    var main_sig = make_sig("", [], [], "", false)
    // Signatures first: a function can be called before the line that declares it.
    for function in functions {
        let made = make_signature(current, function)
        current = made.state
        signatures = List.append(signatures, made.sig)
        let sig = made.sig
        let name_span = place_span(field(function, "name_span"))
        if is_builtin(sig.name) {
            current = report(
                current, "E2002", "'" + sig.name + "' is a built-in function and cannot be declared again",
                "Choose a different name for this function.", [], name_span
            )
        } else if is_declared_record(current, sig.name) or is_type_name(current, sig.name) or is_enum_name(current, sig.name) {
            var meaning = sig.name + "(x) already means: check that x is a valid " + sig.name + "."
            if is_declared_record(current, sig.name) {
                meaning = sig.name + "(x) already means: build one: " + sig.name + "(field: value)"
            }
            current = report(
                current, "E2006", "'" + sig.name + "' is the name of a type and cannot be used for a function",
                meaning, [], name_span
            )
        } else if user_index(current, sig.name) >= 0 {
            let first = List.get(current.user, user_index(current, sig.name))
            current = report(
                current, "E2002", "The function '" + sig.name + "' is declared more than once", "",
                ["It was first declared at line " + to_text(first.line) + ", column " + to_text(first.column) + "."],
                name_span
            )
        } else {
            current = with_user(current, List.append(current.user, sig))
            if sig.name == "main" {
                main_node = function
                main_found = true
                main_sig = sig
            }
        }
    }
    if require_main or main_found {
        current = check_main(current, main_node, main_found, main_sig)
    }
    var typed_functions: List[parser.Node] = []
    var i = 0
    while i < List.length(functions)
        shrinks List.length(functions) - i
    {
        let done = check_function(current, List.get(functions, i), List.get(signatures, i))
        typed_functions = List.append(typed_functions, done.node)
        current = done.state
        i = i + 1
    }
    if warn and List.length(current.problems) == 0 {
        current = with_problems(current, warnings_of(current, program))
    }
    return Typed(
        node: fill_types(
            with_field(with_field(program, "functions", parser.Node.Items(typed_functions)), "types", parser.Node.Items(typed_types))
        ),
        state: current
    )
}

// Close matches (difflib.get_close_matches with n=1 and a cutoff of 0.6)

type Block = { i: Int, j: Int, k: Int }

// The longest run of equal characters of a[alo:ahi] and b[blo:bhi]. Among runs of the same length, the
// one that starts first in `a`, and then first in `b`, as difflib picks it.
fn longest_block(a: Text, b: Text, alo: Int, ahi: Int, blo: Int, bhi: Int) gives Block {
    var best_i = alo
    var best_j = blo
    var best_k = 0
    var previous: List[Int] = []
    var fill = 0
    while fill < bhi - blo + 1
        shrinks bhi - blo + 1 - fill
    {
        previous = List.append(previous, 0)
        fill = fill + 1
    }
    var i = alo
    while i < ahi
        shrinks ahi - i
    {
        var current: List[Int] = [0]
        var j = blo
        while j < bhi
            shrinks bhi - j
        {
            var run = 0
            if Text.slice(a, i, i + 1) == Text.slice(b, j, j + 1) {
                run = List.get(previous, j - blo) + 1
            }
            current = List.append(current, run)
            if run > best_k {
                best_i = i - run + 1
                best_j = j - run + 1
                best_k = run
            }
            j = j + 1
        }
        previous = current
        i = i + 1
    }
    return Block(i: best_i, j: best_j, k: best_k)
}

// How many characters the matching blocks of a[alo:ahi] and b[blo:bhi] cover.
fn matched(a: Text, b: Text, alo: Int, ahi: Int, blo: Int, bhi: Int) gives Int {
    if alo >= ahi or blo >= bhi {
        return 0
    }
    let block = longest_block(a, b, alo, ahi, blo, bhi)
    if block.k == 0 {
        return 0
    }
    return (
        block.k + matched(a, b, alo, block.i, blo, block.j)
        + matched(a, b, block.i + block.k, ahi, block.j + block.k, bhi)
    )
}

// The best possibility for `word`, or the empty text when none is close enough: the highest ratio
// (2 * matched / total length) of at least 0.6, and the greatest text among equal ratios.
fn close_match(word: Text, possibilities: List[Text]) gives Text {
    return close_match_at(word, possibilities, 3, 5)
}

// The same with another cutoff, written as a fraction: numerator / denominator.
fn close_match_at(word: Text, possibilities: List[Text], numerator: Int, denominator: Int) gives Text {
    var best = ""
    var best_matched = 0 - 1
    var best_total = 1
    for candidate in possibilities {
        let total = Text.length(candidate) + Text.length(word)
        if total > 0 {
            let common = matched(candidate, word, 0, Text.length(candidate), 0, Text.length(word))
            if 2 * common * denominator >= numerator * total {
                // Compare common / total with best_matched / best_total without dividing.
                let left = common * best_total
                let right = best_matched * total
                if best_matched < 0 or left > right or (left == right and candidate > best) {
                    best = candidate
                    best_matched = common
                    best_total = total
                }
            }
        }
    }
    return best
}

fn sort_texts(items: List[Text]) gives List[Text] {
    var sorted: List[Text] = []
    for item in items {
        var result: List[Text] = []
        var placed = false
        for existing in sorted {
            if not placed and item < existing {
                result = List.append(result, item)
                placed = true
            }
            result = List.append(result, existing)
        }
        if not placed {
            result = List.append(result, item)
        }
        sorted = result
    }
    return sorted
}

fn binding_names(env: List[Binding]) gives List[Text] {
    var names: List[Text] = []
    for binding in env {
        names = List.append(names, binding.name)
    }
    return names
}

fn upper_first(name: Text) gives Text {
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    if Text.length(name) == 0 {
        return name
    }
    let first = Text.slice(name, 0, 1)
    var mapped = first
    var i = 0
    while i < 26
        shrinks 26 - i
    {
        if first == Text.slice(lower, i, i + 1) {
            mapped = Text.slice(upper, i, i + 1)
        }
        i = i + 1
    }
    return mapped + Text.slice(name, 1, Text.length(name))
}

fn starts_upper(name: Text) gives Bool {
    if Text.length(name) == 0 {
        return false
    }
    let first = Text.slice(name, 0, 1)
    return first >= "A" and first <= "Z"
}

// The functions of each built-in type, as they are listed in hints.
fn type_functions(name: Text) gives List[Text] {
    if name == "Text" {
        return ["contains", "ends_with", "length", "slice", "starts_with"]
    }
    if name == "Int" or name == "Float" {
        return ["can_parse", "parse"]
    }
    if name == "List" {
        return ["append", "concat", "contains", "get", "length"]
    }
    if name == "Option" {
        return ["is_none", "is_some", "value", "value_or"]
    }
    if name == "Result" {
        return ["error", "is_err", "is_ok", "value", "value_or"]
    }
    return []
}

fn dotted_member(name: Text) gives Text {
    let at = index_of_char(name, ".")
    if at < 0 {
        return ""
    }
    return Text.slice(name, at + 1, Text.length(name))
}

fn index_of_char(text: Text, c: Text) gives Int {
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        if Text.slice(text, i, i + 1) == c {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn qualified_names(member: Text) gives List[Text] {
    var found: List[Text] = []
    for name in builtin_names() {
        if index_of_char(name, ".") >= 0 and dotted_member(name) == member {
            found = List.append(found, name)
        }
    }
    return sort_texts(found)
}

fn suggest(names: List[Text]) gives Text {
    var quoted: List[Text] = []
    for name in names {
        quoted = List.append(quoted, "'" + name + "'")
    }
    return "Did you mean " + parser.join_texts(quoted, " or ") + "?"
}

// The suggestion for a call to a function that does not exist. A name that is a function of a type,
// written without it ("length"), suggests the qualified name first.
fn function_hint(state: State, callee: Text) gives Text {
    if List.length(qualified_names(callee)) > 0 {
        return suggest(qualified_names(callee))
    }
    var plain: List[Text] = []
    for sig in state.user {
        plain = List.append(plain, sig.name)
    }
    for name in builtin_names() {
        if index_of_char(name, ".") < 0 {
            plain = List.append(plain, name)
        }
    }
    let close = close_match(callee, plain)
    if close != "" {
        return suggest([close])
    }
    var members: List[Text] = []
    for name in builtin_names() {
        let member = dotted_member(name)
        if member != "" and not List.contains(members, member) {
            members = List.append(members, member)
        }
    }
    let close_member = close_match(callee, sort_texts(members))
    if close_member != "" {
        return suggest(qualified_names(close_member))
    }
    return ""
}

fn known_type_names() gives List[Text] {
    return ["Void", "Int", "Float", "Bool", "Text"]
}

// Records

pub type Rec = { name: Text, field_names: List[Text], field_types: List[Text], line: Int, column: Int }

fn rec_index(state: State, name: Text) gives Int {
    var i = 0
    while i < List.length(state.tables.records)
        shrinks List.length(state.tables.records) - i
    {
        let rec = List.get(state.tables.records, i)
        if rec.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn rec_field_type(rec: Rec, name: Text) gives Text {
    let at = index_of(rec.field_names, name)
    if at < 0 {
        return ""
    }
    return List.get(rec.field_types, at)
}

fn is_declared_record(state: State, name: Text) gives Bool {
    return List.contains(state.tables.declared, name)
}

fn record_decl(program: parser.Node, name: Text) gives parser.Node {
    for declaration in items_of(field(program, "records")) {
        if text_of(field(declaration, "name")) == name {
            return declaration
        }
    }
    return parser.Node.Null()
}

// The record types a type reference depends on, looking inside `List[...]` too.
fn type_dependencies(state: State, reference: parser.Node) gives List[Text] {
    var found: List[Text] = []
    let name = text_of(field(reference, "name"))
    if is_null(field(reference, "qualifier")) and is_declared_record(state, name) {
        found = List.append(found, name)
    }
    for argument in items_of(field(reference, "arguments")) {
        found = List.concat(found, type_dependencies(state, argument))
    }
    return found
}

type Fields = { names: List[Text], references: List[parser.Node], ok: Bool, state: State }

// The fields of a record: their names and the types they were written with. A field repeated, or a
// type that is not a type, makes the declaration unusable; the error is reported once, here.
fn resolve_fields(state: State, declaration: parser.Node) gives Fields {
    let name = text_of(field(declaration, "name"))
    let declared_at = place_span(field(declaration, "name_span"))
    var current = state
    var names: List[Text] = []
    var kinds: List[Text] = []
    var references: List[parser.Node] = []
    var ok = true
    for declared in items_of(field(declaration, "fields")) {
        let field_name = text_of(field(declared, "name"))
        if List.contains(names, field_name) {
            current = report(
                current, "E2016", "The field '" + field_name + "' is declared more than once in '" + name + "'", "",
                [note_line("'" + name + "' is declared at line ", declared_at.line)],
                place_span(field(declared, "name_span"))
            )
            ok = false
        } else {
            names = List.append(names, field_name)
            let resolved = declared_type(
                current, field(declared, "type"), "The field '" + field_name + "' of '" + name + "'", true
            )
            current = resolved.state
            if resolved.ty == "" {
                ok = false
            } else {
                kinds = List.append(kinds, resolved.ty)
                references = List.append(references, field(declared, "type"))
            }
        }
    }
    return Fields(names: kinds_names(names, kinds, ok), references: references, ok: ok, state: current)
}

fn note_line(prefix: Text, line: Int) gives Text {
    return prefix + to_text(line) + "."
}

// The names of the fields that resolved, paired by position with their types, in one list of
// "name:type" texts, so a valid record can be rebuilt from them.
fn kinds_names(names: List[Text], kinds: List[Text], ok: Bool) gives List[Text] {
    var joined: List[Text] = []
    if ok {
        var i = 0
        while i < List.length(names)
            shrinks List.length(names) - i
        {
            joined = List.append(joined, List.get(names, i) + ":" + List.get(kinds, i))
            i = i + 1
        }
    }
    return joined
}

type Walk = { state: State, done: List[Text], cyclic: List[Text] }

// Reports every cycle of record types, once, where the cycle starts.
fn walk_record(
    state: State, program: parser.Node, graph: List[Text], dependencies: List[List[Text]], name: Text,
    visiting: List[Text], done: List[Text], cyclic: List[Text]
) gives Walk {
    if List.contains(done, name) {
        return Walk(state: state, done: done, cyclic: cyclic)
    }
    let at = index_of(visiting, name)
    if at >= 0 {
        var cycle: List[Text] = []
        var i = at
        while i < List.length(visiting)
            shrinks List.length(visiting) - i
        {
            cycle = List.append(cycle, List.get(visiting, i))
            i = i + 1
        }
        cycle = List.append(cycle, name)
        let start = List.get(cycle, 0)
        let declaration = record_decl(program, start)
        let reported = report(
            state, "E2016", "The record '" + start + "' cannot contain itself",
            "A record cannot hold a value of its own type, directly or through another record.",
            ["The cycle is: " + parser.join_texts(cycle, " -> ")], place_span(field(declaration, "name_span"))
        )
        return Walk(state: reported, done: done, cyclic: List.concat(cyclic, cycle))
    }
    var current = state
    var finished = done
    var marked = cyclic
    let position = index_of(graph, name)
    if position >= 0 {
        for dependency in List.get(dependencies, position) {
            let walked = walk_record(
                current, program, graph, dependencies, dependency, List.append(visiting, name), finished, marked
            )
            current = walked.state
            finished = walked.done
            marked = walked.cyclic
        }
    }
    return Walk(state: current, done: List.append(finished, name), cyclic: marked)
}

fn split_pair(pair: Text) gives List[Text] {
    let at = index_of_char(pair, ":")
    return [Text.slice(pair, 0, at), Text.slice(pair, at + 1, Text.length(pair))]
}

// The names a module declares itself: the ones it imports are qualified with the module that declares them.
fn own_names(names: List[Text]) gives List[Text] {
    var own: List[Text] = []
    for name in names {
        if index_of_char(name, ".") < 0 {
            own = List.append(own, name)
        }
    }
    return own
}

// Resolves the record types the program declares, and decides which ones are valid. The names are
// already registered, so a record can use another one declared later.
fn declare_records(state: State, program: parser.Node) gives State {
    var current = state
    var graph: List[Text] = []
    var dependencies: List[List[Text]] = []
    var resolved_names: List[Text] = []
    var resolved_fields: List[List[Text]] = []
    for name in own_names(state.tables.declared) {
        let declaration = record_decl(program, name)
        let fields = resolve_fields(current, declaration)
        current = fields.state
        if fields.ok {
            var deps: List[Text] = []
            for reference in fields.references {
                deps = List.concat(deps, type_dependencies(current, reference))
            }
            graph = List.append(graph, name)
            dependencies = List.append(dependencies, deps)
            resolved_names = List.append(resolved_names, name)
            resolved_fields = List.append(resolved_fields, fields.names)
        }
    }
    // The cycles: a record cannot contain itself, directly or through another one.
    var done: List[Text] = []
    var cyclic: List[Text] = []
    for name in graph {
        let walked = walk_record(current, program, graph, dependencies, name, [], done, cyclic)
        current = walked.state
        done = walked.done
        cyclic = walked.cyclic
    }
    // A record that uses a record that cannot be used is not usable either.
    var invalid = cyclic
    for name in own_names(state.tables.declared) {
        if not List.contains(resolved_names, name) and not List.contains(invalid, name) {
            invalid = List.append(invalid, name)
        }
    }
    // One pass per record is enough for any chain of dependencies.
    for round in graph {
        var position = 0
        while position < List.length(graph)
            shrinks List.length(graph) - position
        {
            let name = List.get(graph, position)
            if not List.contains(invalid, name) {
                for dependency in List.get(dependencies, position) {
                    if List.contains(invalid, dependency) and not List.contains(invalid, name) {
                        invalid = List.append(invalid, name)
                    }
                }
            }
            position = position + 1
        }
    }
    var records: List[Rec] = []
    var index = 0
    while index < List.length(resolved_names)
        shrinks List.length(resolved_names) - index
    {
        let name = List.get(resolved_names, index)
        if not List.contains(invalid, name) {
            var names: List[Text] = []
            var kinds: List[Text] = []
            for pair in List.get(resolved_fields, index) {
                let parts = split_pair(pair)
                names = List.append(names, List.get(parts, 0))
                kinds = List.append(kinds, List.get(parts, 1))
            }
            let at = place_span(field(record_decl(program, name), "name_span"))
            records = List.append(
                records, Rec(name: name, field_names: names, field_types: kinds, line: at.line, column: at.column)
            )
        }
        index = index + 1
    }
    return with_tables(current, set_records(current.tables, List.concat(current.tables.records, records)))
}

// `Point(x: 1, y: 2)`: builds a record value. Every field is given once, with a value of its type; the
// order of the text does not matter.
fn check_record_construction(state: State, env: List[Binding], node: parser.Node) gives Checked {
    var name = text_of(field(node, "name"))
    let written_module = text_of(field(node, "qualifier"))
    if written_module != "" {
        name = written_module + "." + name
    }
    let fields = items_of(field(node, "fields"))
    let at = rec_index(state, name)
    var current = state
    var typed: List[parser.Node] = []
    if at < 0 and written_module != "" {
        current = report_unknown_record(current, written_module, text_of(field(node, "name")), span_of(node))
    } else if at >= 0 and is_private(current, name) {
        current = report_private(current, name, span_of(node))
    }
    if at < 0 or is_private(current, name) {
        // The declaration of the record has an error, already reported where it happens. The values are
        // still checked, so that a mistake inside one of them is not hidden.
        for initializer in fields {
            let value = check_expression(current, env, field(initializer, "value"), "")
            typed = List.append(typed, with_field(initializer, "value", value.node))
            current = value.state
        }
        return checked(with_field(node, "fields", parser.Node.Items(typed)), "", current)
    }
    let rec = List.get(current.tables.records, at)
    var given: List[Text] = []
    var repeated: List[parser.Node] = []
    var unknown: List[parser.Node] = []
    for initializer in fields {
        let field_name = text_of(field(initializer, "name"))
        if rec_field_type(rec, field_name) == "" {
            unknown = List.append(unknown, initializer)
        } else if List.contains(given, field_name) {
            repeated = List.append(repeated, initializer)
        } else {
            given = List.append(given, field_name)
        }
    }
    for initializer in unknown {
        current = report(
            current, "E2023",
            "The record '" + rec.name + "' has no field named '" + text_of(field(initializer, "name")) + "'",
            "The fields of " + rec.name + " are: " + parser.join_texts(rec.field_names, ", ") + ".", [],
            place_span(field(initializer, "name_span"))
        )
    }
    for initializer in repeated {
        current = report(
            current, "E2023", "The field '" + text_of(field(initializer, "name")) + "' is given twice", "", [],
            place_span(field(initializer, "name_span"))
        )
    }
    for expected_name in rec.field_names {
        if not List.contains(given, expected_name) {
            current = report(
                current, "E2023", "The field '" + expected_name + "' of '" + rec.name + "' is missing",
                "Give it a value: " + rec.name + "(" + expected_name + ": ...)", [],
                place_span(field(node, "name_span"))
            )
        }
    }
    for initializer in fields {
        let field_name = text_of(field(initializer, "name"))
        let wanted = rec_field_type(rec, field_name)
        let value = check_expression(current, env, field(initializer, "value"), wanted)
        typed = List.append(typed, with_field(initializer, "value", value.node))
        current = value.state
        if value.ty != "" and wanted != "" {
            current = expect_type(
                current, wanted, value.ty, field(initializer, "value"),
                ["The field '" + field_name + "' of '" + rec.name + "' is " + wanted + "."]
            )
        }
    }
    return checked(with_field(node, "fields", parser.Node.Items(typed)), rec.name, current)
}

// `models.Record(...)` where that module declares no record with that name.
fn report_unknown_record(state: State, qualifier: Text, name: Text, span: parser.Span) gives State {
    if not List.contains(state.tables.modules, qualifier) {
        return report_unknown_module(state, qualifier, span)
    }
    let public = public_names(state, qualifier, state.tables.declared)
    let close = close_match(name, public)
    var hint = ""
    if close != "" {
        hint = "Did you mean '" + qualifier + "." + close + "'?"
    }
    var notes: List[Text] = []
    if List.length(public) > 0 {
        notes = ["The records '" + qualifier + "' makes public: " + parser.join_texts(public, ", ") + "."]
    }
    return report(
        state, "E2023", "The module '" + qualifier + "' has no record named '" + name + "'", hint, notes, span
    )
}

// `p.x`: reads a field of a record value.
fn check_field_access(state: State, env: List[Binding], node: parser.Node) gives Checked {
    let target = check_expression(state, env, field(node, "target"), "")
    let rebuilt = with_field(node, "target", target.node)
    if target.ty == "" {
        return checked(rebuilt, "", target.state)
    }
    let at = rec_index(target.state, target.ty)
    if at < 0 {
        return checked(
            rebuilt, "",
            report(
                target.state, "E2024", "A value of type " + target.ty + " is not a record, so it has no fields",
                "Only a record has fields.", [], span_of(field(node, "target"))
            )
        )
    }
    let rec = List.get(target.state.tables.records, at)
    let field_name = text_of(field(node, "name"))
    let kind = rec_field_type(rec, field_name)
    if kind == "" {
        return checked(
            rebuilt, "",
            report(
                target.state, "E2024", "The record '" + target.ty + "' has no field named '" + field_name + "'",
                "The fields of " + target.ty + " are: " + parser.join_texts(rec.field_names, ", ") + ".", [],
                place_span(field(node, "name_span"))
            )
        )
    }
    return checked(rebuilt, kind, target.state)
}

// `p.x = value`: a record is immutable, so its fields never change.
fn check_field_assign(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let target = check_expression(state, env, field(node, "target"), "")
    let rebuilt = with_field(node, "target", target.node)
    if target.ty == "" {
        return flow(rebuilt, target.state, env, false)
    }
    let at = rec_index(target.state, target.ty)
    if at < 0 {
        return flow(
            rebuilt,
            report(
                target.state, "E2024", "A value of type " + target.ty + " is not a record, so it has no fields",
                "Only a record has fields.", [], span_of(field(node, "target"))
            ),
            env, false
        )
    }
    let rec = List.get(target.state.tables.records, at)
    let field_name = text_of(field(node, "name"))
    if rec_field_type(rec, field_name) == "" {
        return flow(
            rebuilt,
            report(
                target.state, "E2024", "The record '" + target.ty + "' has no field named '" + field_name + "'",
                "The fields of " + target.ty + " are: " + parser.join_texts(rec.field_names, ", ") + ".", [],
                place_span(field(node, "name_span"))
            ),
            env, false
        )
    }
    let reported = report(
        target.state, "E2025", "The field '" + field_name + "' of '" + target.ty + "' cannot be given a new value",
        "A record is immutable: build another one with the value you want.", [], place_span(field(node, "name_span"))
    )
    // The value is checked, but its type is not compared with the type of the field.
    let value = check_expression(reported, env, field(node, "value"), "")
    return flow(with_field(rebuilt, "value", value.node), value.state, env, false)
}


// Modules: the names of another module are private unless it declared them with `pub`.

fn is_private(state: State, key: Text) gives Bool {
    return List.contains(state.tables.private, key)
}

fn report_private(state: State, key: Text, span: parser.Span) gives State {
    let dot = index_of_char(key, ".")
    let module = Text.slice(key, 0, dot)
    let own = Text.slice(key, dot + 1, Text.length(key))
    return report(
        state, "E2028", "'" + key + "' is private: the module '" + module + "' does not declare it with 'pub'",
        "Mark it in " + module + ".nex: pub fn " + own + "(...) or pub type " + upper_first(own) + " = ...", [], span
    )
}

fn report_unknown_module(state: State, qualifier: Text, span: parser.Span) gives State {
    let modules = state.tables.modules
    if List.length(modules) == 0 {
        return report(
            state, "E2027", "There is no module named '" + qualifier + "'",
            "This program imports no modules. Declare one at the top of the file: import \"app/models.nex\"", [], span
        )
    }
    var hint = ""
    let close = close_match(qualifier, modules)
    if close != "" {
        hint = "Did you mean '" + close + "'? "
    }
    return report(
        state, "E2027", "There is no module named '" + qualifier + "'",
        hint + "The modules this program imports are: " + parser.join_texts(modules, ", ") + ".", [], span
    )
}

fn sorted_texts(items: List[Text]) gives List[Text] {
    var result: List[Text] = []
    for item in items {
        var inserted = false
        var next: List[Text] = []
        for existing in result {
            if not inserted and item < existing {
                next = List.append(next, item)
                inserted = true
            }
            next = List.append(next, existing)
        }
        if not inserted {
            next = List.append(next, item)
        }
        result = next
    }
    return result
}

// What a module makes public, without the module in front.
fn public_names(state: State, module: Text, kinds: List[Text]) gives List[Text] {
    var result: List[Text] = []
    for key in kinds {
        if Text.starts_with(key, module + ".") and not is_private(state, key) {
            result = List.append(result, Text.slice(key, Text.length(module) + 1, Text.length(key)))
        }
    }
    return sorted_texts(result)
}

fn module_member_keys(state: State) gives List[Text] {
    var keys: List[Text] = []
    for sig in state.user {
        keys = List.append(keys, sig.name)
    }
    return List.concat(
        List.concat(List.concat(keys, state.tables.declared), state.tables.type_names), state.tables.enum_names
    )
}

// `Name.function(...)` where Name is neither a type with that function nor a module that makes one
// public. The message depends on what Name is.
fn unknown_qualified_call(state: State, env: List[Binding], node: parser.Node) gives State {
    let qualifier = text_of(field(node, "qualifier"))
    let callee = text_of(field(node, "callee"))
    let function = Text.slice(callee, index_of_char(callee, ".") + 1, Text.length(callee))
    let span = place_span(field(node, "callee_span"))
    let symbol = binding_index(env, qualifier)
    var label = ""
    var hint = ""
    var notes: List[Text] = []
    if List.contains(state.tables.modules, qualifier) {
        let public = public_names(state, qualifier, module_member_keys(state))
        label = "The module '" + qualifier + "' has no function named '" + function + "'"
        let close = close_match(function, public)
        if close != "" {
            hint = "Did you mean '" + qualifier + "." + close + "'?"
        } else if List.length(public) > 0 {
            notes = ["The functions '" + qualifier + "' makes public: " + parser.join_texts(public, ", ") + "."]
        } else {
            notes = ["The module '" + qualifier + "' makes no function public: it declares none with 'pub'."]
        }
    } else if List.contains(known_type_names(), qualifier) or qualifier == "List" {
        label = "'" + qualifier + "' has no function named '" + function + "'"
        let functions = type_functions(qualifier)
        if List.length(functions) > 0 {
            let close = close_match(function, functions)
            if close != "" {
                hint = "Did you mean '" + qualifier + "." + close + "'?"
            }
            notes = ["The functions of " + qualifier + ": " + parser.join_texts(functions, ", ") + "."]
        } else {
            notes = [qualifier + " has no functions yet."]
        }
    } else if is_declared_record(state, qualifier) or is_type_name(state, qualifier) or is_enum_name(state, qualifier) {
        label = "'" + qualifier + "' has no functions of its own"
        let base = root_of(state, qualifier)
        if List.length(type_functions(base)) > 0 {
            hint = "A value of " + qualifier + " can be passed to the functions of its base type, " + base + "."
        }
    } else if symbol >= 0 {
        let binding = List.get(env, symbol)
        label = "'" + qualifier + "' is a " + binding.category + ": values have no functions of their own"
        if binding.ty != "" and List.contains(type_functions(binding.ty), function) {
            hint = "Call the function of its type: " + binding.ty + "." + function + "(" + qualifier + ")"
        }
    } else if is_builtin(qualifier) or user_index(state, qualifier) >= 0 {
        label = "'" + qualifier + "' is a function, not a type"
    } else {
        let first = Text.slice(qualifier, 0, 1)
        if first >= "a" and first <= "z" {
            // A type always starts with a capital letter, so a name before the '.' that starts with a
            // lower case one can only be a module.
            return report_unknown_module(state, qualifier, span)
        }
        label = "There is no type named '" + qualifier + "'"
        let close = close_match(
            qualifier,
            List.concat(
                List.concat(List.concat(List.append(known_type_names(), "List"), state.tables.type_names), state.tables.declared),
                state.tables.enum_names
            )
        )
        if close != "" {
            hint = "Did you mean '" + close + "'?"
        }
    }
    return report(state, "E2008", label, hint, notes, span)
}

// Tables of types

// A declared refined type once its base is resolved: the type it refines, the built-in type at the end of
// its chain, and the names of the declarations whose conditions a value must satisfy, from the root outwards.
pub type Ref = { name: Text, base: Text, root: Text, chain: List[Text] }

type Tables = {
    declared: List[Text], records: List[Rec], type_names: List[Text], type_decls: List[parser.Node],
    refined: List[Ref], steps: Int, refining: Text, fn_names: List[Text],
    reg_names: List[Text], reg_lines: List[Int], reg_columns: List[Int], enum_names: List[Text], enums: List[EnumInfo],
    cap_kinds: List[Text], cap_paths: List[Text], modules: List[Text], private: List[Text]
}

fn empty_tables() gives Tables {
    return Tables(
        declared: [], records: [], type_names: [], type_decls: [], refined: [], steps: 0, refining: "",
        fn_names: [], reg_names: [], reg_lines: [], reg_columns: [], enum_names: [], enums: [],
        cap_kinds: [], cap_paths: [], modules: [], private: []
    )
}

fn set_declared(t: Tables, value: List[Text]) gives Tables {
    return Tables(
        declared: value, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_records(t: Tables, value: List[Rec]) gives Tables {
    return Tables(
        declared: t.declared, records: value, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_type_names(t: Tables, names: List[Text], decls: List[parser.Node]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: names, type_decls: decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_refined(t: Tables, value: List[Ref]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: value, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_steps(t: Tables, value: Int) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: value, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_refining(t: Tables, value: Text) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: value, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_fn_names(t: Tables, value: List[Text]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: value,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_registered(t: Tables, names: List[Text], lines: List[Int], columns: List[Int]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: names, reg_lines: lines, reg_columns: columns,
        enum_names: t.enum_names, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_enum_names(t: Tables, value: List[Text]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: value, enums: t.enums,
        cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn set_enums(t: Tables, value: List[EnumInfo]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: value, cap_kinds: t.cap_kinds, cap_paths: t.cap_paths, modules: t.modules, private: t.private
    )
}

fn with_tables(state: State, tables: Tables) gives State {
    return State(
        problems: state.problems, user: state.user, function: state.function, return_type: state.return_type,
        in_example: state.in_example, unsupported: state.unsupported, tables: tables,
        usage: state.usage
    )
}

fn is_type_name(state: State, name: Text) gives Bool {
    return List.contains(state.tables.type_names, name)
}

fn ref_index(state: State, name: Text) gives Int {
    var i = 0
    while i < List.length(state.tables.refined)
        shrinks List.length(state.tables.refined) - i
    {
        let ref = List.get(state.tables.refined, i)
        if ref.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// The declaration of a refined type by name.
fn type_decl(state: State, name: Text) gives parser.Node {
    let at = index_of(state.tables.type_names, name)
    if at < 0 {
        return parser.Node.Null()
    }
    return List.get(state.tables.type_decls, at)
}

// The built-in type at the end of a chain of refinements, or the type itself if it is not refined.
fn root_of(state: State, ty: Text) gives Text {
    let at = ref_index(state, ty)
    if at < 0 {
        return ty
    }
    let ref = List.get(state.tables.refined, at)
    return ref.root
}

// Whether a value of type `found` can be used where `expected` is needed: the same type, or a refined type
// widening through its chain of bases. A base is never accepted where a refined type is expected.
fn accepts(state: State, expected: Text, found: Text) gives Bool {
    var current = found
    var steps = 0
    while steps <= List.length(state.tables.refined)
        shrinks List.length(state.tables.refined) + 1 - steps
    {
        if current == expected {
            return true
        }
        let at = ref_index(state, current)
        if at < 0 {
            return false
        }
        let ref = List.get(state.tables.refined, at)
        current = ref.base
        steps = steps + 1
    }
    return false
}

// Declaring the types

// Registers the name of every record and refined type the program declares, in the order they appear. A
// name belongs to one type: it cannot be declared twice, whatever the kind of the two declarations.
fn declare_type_names(state: State, program: parser.Node) gives State {
    var current = state
    let ordered = sort_by_position(
        List.concat(
            List.concat(items_of(field(program, "records")), items_of(field(program, "types"))),
            items_of(field(program, "enums"))
        )
    )
    for declaration in ordered {
        let name = text_of(field(declaration, "name"))
        let span = place_span(field(declaration, "name_span"))
        let is_record = kind_of(declaration) == "RecordDecl"
        let is_enum = kind_of(declaration) == "EnumDecl"
        let registered = index_of(current.tables.reg_names, name)
        if List.contains(known_type_names(), name) or (is_record and name == "List") {
            current = report(
                current, "E2016", "'" + name + "' is a built-in type and cannot be declared again",
                "Choose a different name for this type.", [], span
            )
        } else if not starts_upper(name) {
            current = report(
                current, "E2016", "The type name '" + name + "' must start with a capital letter",
                "Write it as: " + upper_first(name), [], span
            )
        } else if registered >= 0 {
            current = report(
                current, "E2016", "The type '" + name + "' is declared more than once", "",
                [
                    "It was first declared at line " + to_text(List.get(current.tables.reg_lines, registered))
                    + ", column " + to_text(List.get(current.tables.reg_columns, registered)) + "."
                ],
                span
            )
        } else {
            var tables = set_registered(
                current.tables, List.append(current.tables.reg_names, name),
                List.append(current.tables.reg_lines, span.line), List.append(current.tables.reg_columns, span.column)
            )
            if is_record {
                tables = set_declared(tables, List.append(tables.declared, name))
            } else if is_enum {
                tables = set_enum_names(tables, List.append(tables.enum_names, name))
            } else {
                tables = set_type_names(
                    tables, List.append(tables.type_names, name), List.append(tables.type_decls, declaration)
                )
            }
            current = with_tables(current, tables)
        }
    }
    return current
}

type Resolution = { state: State, found: Bool, ref: Ref }

fn no_ref() gives Ref {
    return Ref(name: "", base: "", root: "", chain: [])
}

fn base_name_of(state: State, name: Text) gives Text {
    return text_of(field(field(type_decl(state, name), "base"), "name"))
}

// Whether a chain of refined types comes back to `name`.
fn in_cycle(state: State, name: Text) gives Bool {
    var seen: List[Text] = []
    var current = base_name_of(state, name)
    while is_type_name(state, current) and not List.contains(seen, current)
        shrinks List.length(state.tables.type_names) + 1 - List.length(seen)
    {
        if current == name {
            return true
        }
        seen = List.append(seen, current)
        current = base_name_of(state, current)
    }
    return false
}

// The refined type `name`, with its chain of bases. Not found if its declaration has an error.
fn resolve_type(state: State, name: Text, visiting: List[Text]) gives Resolution {
    let known = ref_index(state, name)
    if known >= 0 {
        return Resolution(state: state, found: true, ref: List.get(state.tables.refined, known))
    }
    let declaration = type_decl(state, name)
    if List.contains(visiting, name) {
        // Reported once, at the declaration where the chain started.
        return Resolution(state: state, found: false, ref: no_ref())
    }
    let base = field(declaration, "base")
    let base_name = text_of(field(base, "name"))
    let base_span = span_of(base)
    if not is_null(field(base, "qualifier")) {
        return Resolution(state: unsupported(state, "qualified type"), found: false, ref: no_ref())
    }
    if base_name == "List" and List.length(items_of(field(base, "arguments"))) > 0 {
        var current = state
        if List.length(visiting) == 0 {
            current = report(
                current, "E2016", "The refined type '" + name + "' cannot refine a list type yet",
                "Refining 'List[T]' is not supported yet. Refine a built-in type such as Int or Text.", [], base_span
            )
        }
        return Resolution(state: current, found: false, ref: no_ref())
    }
    if is_declared_record(state, base_name) {
        var current = state
        if List.length(visiting) == 0 {
            current = report(
                current, "E2016", "The refined type '" + name + "' cannot refine a record type",
                "Refining a record is not supported yet. Refine a built-in type such as Int or Text.", [], base_span
            )
        }
        return Resolution(state: current, found: false, ref: no_ref())
    }
    var made = no_ref()
    var current = state
    if is_type_name(state, base_name) {
        let resolved = resolve_type(state, base_name, List.append(visiting, name))
        current = resolved.state
        if not resolved.found {
            if List.length(visiting) == 0 and in_cycle(current, name) {
                current = report(
                    current, "E2016", "The type '" + name + "' refines itself through a chain of types",
                    "A chain of refined types must end in Int, Float, Bool or Text.", [], base_span
                )
            }
            return Resolution(state: current, found: false, ref: no_ref())
        }
        made = Ref(
            name: name, base: base_name, root: resolved.ref.root, chain: List.append(resolved.ref.chain, name)
        )
    } else {
        let base_type = declared_type(current, base, "The type '" + name + "'", false)
        current = base_type.state
        if base_type.ty == "" {
            return Resolution(state: current, found: false, ref: no_ref())
        }
        made = Ref(name: name, base: base_type.ty, root: base_type.ty, chain: [name])
    }
    return Resolution(
        state: with_tables(current, set_refined(current.tables, List.append(current.tables.refined, made))),
        found: true, ref: made
    )
}

fn declare_types(state: State) gives State {
    var current = state
    for name in own_names(state.tables.type_names) {
        let resolved = resolve_type(current, name, [])
        current = resolved.state
    }
    return current
}

// Every refined type whose chain goes through `name` is left without a valid chain.
fn drop_type(state: State, name: Text) gives State {
    var kept: List[Ref] = []
    for ref in state.tables.refined {
        if not List.contains(ref.chain, name) {
            kept = List.append(kept, ref)
        }
    }
    return with_tables(state, set_refined(state.tables, kept))
}

// Checks the condition after `where`. Only `value` is visible in it, and it calls no function of the
// program: a refinement is a fact about one value and nothing else.
fn check_type_condition(state: State, declaration: parser.Node) gives Typed {
    let name = text_of(field(declaration, "name"))
    let at = ref_index(state, name)
    let registered_span = span_of(type_decl(state, name))
    let declared_span = span_of(declaration)
    if at < 0 or registered_span.line != declared_span.line or registered_span.column != declared_span.column {
        return Typed(node: declaration, state: state)
    }
    let ref = List.get(state.tables.refined, at)
    let env = [make_binding("value", "value", ref.base, false, false, place_span(field(declaration, "name_span")))]
    let before_count = List.length(state.problems)
    let inside = check_condition(
        with_tables(state, set_refining(state.tables, name)), env, field(declaration, "condition"),
        "'where' in '" + name + "'"
    )
    var current = with_tables(inside.state, set_refining(inside.state.tables, ""))
    if List.length(current.problems) > before_count {
        // Constants cannot be checked against a condition that is not well formed, and the types that refine
        // this one are left without a valid chain.
        current = drop_type(current, name)
    }
    return Typed(node: with_field(declaration, "condition", inside.node), state: current)
}

// Values, and the evaluation of the conditions of refined types

type Val = enum { VInt(v: Int), VFloat(v: Float), VText(v: Text), VBool(v: Bool) }

type EvalOut = { ok: Bool, val: Val, label: Text, unsupported: Text }

fn int_max() gives Int {
    return 9223372036854775807
}

fn int_min() gives Int {
    return 0 - 9223372036854775807 - 1
}

fn ok_val(v: Val) gives EvalOut {
    return EvalOut(ok: true, val: v, label: "", unsupported: "")
}

fn eval_failure(label: Text) gives EvalOut {
    return EvalOut(ok: false, val: Val.VBool(false), label: label, unsupported: "")
}

fn eval_unsupported(reason: Text) gives EvalOut {
    return EvalOut(ok: false, val: Val.VBool(false), label: "", unsupported: reason)
}

fn int_of(node: parser.Node) gives Int {
    return match node {
        parser.Node.Whole(value) => value
        _ => 0
    }
}

fn real_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Real(text) => text
        _ => "0.0"
    }
}

fn flag_of(node: parser.Node) gives Bool {
    return match node {
        parser.Node.Flag(value) => value
        _ => false
    }
}

fn truth(v: Val) gives Bool {
    return match v {
        Val.VBool(b) => b
        _ => false
    }
}

fn vals_equal(a: Val, b: Val) gives Bool {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => x == y
            _ => false
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => x == y
            _ => false
        }
        Val.VText(x) => match b {
            Val.VText(y) => x == y
            _ => false
        }
        Val.VBool(x) => match b {
            Val.VBool(y) => x == y
            _ => false
        }
    }
}

fn vals_less(a: Val, b: Val) gives Bool {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => x < y
            _ => false
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => x < y
            _ => false
        }
        Val.VText(x) => match b {
            Val.VText(y) => x < y
            _ => false
        }
        Val.VBool(x) => false
    }
}

fn add_overflows(a: Int, b: Int) gives Bool {
    return (b > 0 and a > int_max() - b) or (b < 0 and a < int_min() - b)
}

fn subtract_overflows(a: Int, b: Int) gives Bool {
    return (b < 0 and a > int_max() + b) or (b > 0 and a < int_min() + b)
}

fn multiply_overflows(a: Int, b: Int) gives Bool {
    if a == 0 or b == 0 {
        return false
    }
    if a > 0 and b > 0 {
        return a > int_max() / b
    }
    if a > 0 and b < 0 {
        return b < int_min() / a
    }
    if a < 0 and b > 0 {
        return a < int_min() / b
    }
    return a < int_max() / b
}

fn int_overflow() gives EvalOut {
    return eval_failure("The result of this operation does not fit in an Int")
}

fn evaluate_int(operator: Text, a: Int, b: Int) gives EvalOut {
    if operator == "+" {
        if add_overflows(a, b) {
            return int_overflow()
        }
        return ok_val(Val.VInt(a + b))
    }
    if operator == "-" {
        if subtract_overflows(a, b) {
            return int_overflow()
        }
        return ok_val(Val.VInt(a - b))
    }
    if operator == "*" {
        if multiply_overflows(a, b) {
            return int_overflow()
        }
        return ok_val(Val.VInt(a * b))
    }
    if b == 0 {
        return eval_failure("The right-hand side of this division is zero")
    }
    if a == int_min() and b == 0 - 1 {
        return int_overflow()
    }
    return ok_val(Val.VInt(a / b))
}

fn evaluate_float(operator: Text, a: Float, b: Float) gives EvalOut {
    if operator == "+" {
        return ok_val(Val.VFloat(a + b))
    }
    if operator == "-" {
        return ok_val(Val.VFloat(a - b))
    }
    if operator == "*" {
        return ok_val(Val.VFloat(a * b))
    }
    if b == 0.0 {
        return eval_failure("The right-hand side of this division is zero")
    }
    return ok_val(Val.VFloat(a / b))
}

fn evaluate_arithmetic(operator: Text, a: Val, b: Val) gives EvalOut {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => evaluate_int(operator, x, y)
            _ => eval_unsupported("mixed arithmetic")
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => evaluate_float(operator, x, y)
            _ => eval_unsupported("mixed arithmetic")
        }
        Val.VText(x) => match b {
            Val.VText(y) => ok_val(Val.VText(x + y))
            _ => eval_unsupported("mixed arithmetic")
        }
        Val.VBool(x) => eval_unsupported("arithmetic on Bool")
    }
}

fn evaluate_binary(node: parser.Node, current: Val) gives EvalOut {
    let operator = text_of(field(node, "operator"))
    let left = evaluate(field(node, "left"), current)
    if not left.ok {
        return left
    }
    // 'and' and 'or' only evaluate their right side when it can change the result.
    if operator == "or" or operator == "and" {
        let decided = truth(left.val)
        if (operator == "or" and decided) or (operator == "and" and not decided) {
            return left
        }
        return evaluate(field(node, "right"), current)
    }
    let right = evaluate(field(node, "right"), current)
    if not right.ok {
        return right
    }
    if operator == "==" {
        return ok_val(Val.VBool(vals_equal(left.val, right.val)))
    }
    if operator == "!=" {
        return ok_val(Val.VBool(not vals_equal(left.val, right.val)))
    }
    if operator == "<" {
        return ok_val(Val.VBool(vals_less(left.val, right.val)))
    }
    if operator == ">" {
        return ok_val(Val.VBool(vals_less(right.val, left.val)))
    }
    if operator == "<=" {
        return ok_val(Val.VBool(not vals_less(right.val, left.val)))
    }
    if operator == ">=" {
        return ok_val(Val.VBool(not vals_less(left.val, right.val)))
    }
    return evaluate_arithmetic(operator, left.val, right.val)
}

fn evaluate_unary(node: parser.Node, current: Val) gives EvalOut {
    let operand = evaluate(field(node, "operand"), current)
    if not operand.ok {
        return operand
    }
    if text_of(field(node, "operator")) == "not" {
        return ok_val(Val.VBool(not truth(operand.val)))
    }
    return match operand.val {
        Val.VInt(x) => negate_int(x)
        Val.VFloat(x) => ok_val(Val.VFloat(0.0 - x))
        _ => eval_unsupported("negation")
    }
}

fn negate_int(x: Int) gives EvalOut {
    if x == int_min() {
        return int_overflow()
    }
    return ok_val(Val.VInt(0 - x))
}

// The text a value is shown with, as in `to_text`.
fn format_val(v: Val) gives Text {
    return match v {
        Val.VInt(x) => to_text(x)
        Val.VFloat(x) => to_text(x)
        Val.VText(x) => x
        Val.VBool(x) => to_text(x)
    }
}

// A value as it would be written in source code, for diagnostics: Text is quoted.
fn show_val(v: Val) gives Text {
    return match v {
        Val.VText(x) => parser.quote(x)
        _ => format_val(v)
    }
}

fn text_arg(v: Val) gives Text {
    return match v {
        Val.VText(x) => x
        _ => ""
    }
}

fn evaluate_call(node: parser.Node, current: Val) gives EvalOut {
    let callee = text_of(field(node, "callee"))
    let arguments = items_of(field(node, "arguments"))
    var values: List[Val] = []
    for argument in arguments {
        let evaluated = evaluate(argument, current)
        if not evaluated.ok {
            return evaluated
        }
        values = List.append(values, evaluated.val)
    }
    if callee == "to_text" and List.length(values) == 1 {
        return ok_val(Val.VText(format_val(List.get(values, 0))))
    }
    if callee == "to_float" and List.length(values) == 1 {
        return match List.get(values, 0) {
            Val.VInt(x) => ok_val(Val.VFloat(to_float(x)))
            _ => eval_unsupported("to_float")
        }
    }
    if callee == "to_int" and List.length(values) == 1 {
        return match List.get(values, 0) {
            Val.VFloat(x) => convert_float(x)
            _ => eval_unsupported("to_int")
        }
    }
    if callee == "Text.length" and List.length(values) == 1 {
        return ok_val(Val.VInt(Text.length(text_arg(List.get(values, 0)))))
    }
    if List.length(values) == 2 {
        let first = text_arg(List.get(values, 0))
        let second = text_arg(List.get(values, 1))
        if callee == "Text.contains" {
            return ok_val(Val.VBool(Text.contains(first, second)))
        }
        if callee == "Text.starts_with" {
            return ok_val(Val.VBool(Text.starts_with(first, second)))
        }
        if callee == "Text.ends_with" {
            return ok_val(Val.VBool(Text.ends_with(first, second)))
        }
    }
    if callee == "Int.can_parse" and List.length(values) == 1 {
        return ok_val(Val.VBool(Int.can_parse(text_arg(List.get(values, 0)))))
    }
    if callee == "Float.can_parse" and List.length(values) == 1 {
        return ok_val(Val.VBool(Float.can_parse(text_arg(List.get(values, 0)))))
    }
    return eval_unsupported("call " + callee)
}

// to_int drops the fractional part (rounds toward zero) and stops when the result does not fit.
fn convert_float(x: Float) gives EvalOut {
    if x >= 9223372036854775808.0 or x < 0.0 - 9223372036854775808.0 {
        return eval_failure(to_text(x) + " is outside the range of Int")
    }
    return ok_val(Val.VInt(to_int(x)))
}

// Evaluates the condition of a refined type for one value. Only `value` is visible in it.
fn evaluate(node: parser.Node, current: Val) gives EvalOut {
    let kind = kind_of(node)
    if kind == "IntLiteral" {
        return ok_val(Val.VInt(int_of(field(node, "value"))))
    }
    if kind == "FloatLiteral" {
        return ok_val(Val.VFloat(Float.parse(real_of(field(node, "value")))))
    }
    if kind == "TextLiteral" {
        return ok_val(Val.VText(text_of(field(node, "value"))))
    }
    if kind == "BoolLiteral" {
        return ok_val(Val.VBool(flag_of(field(node, "value"))))
    }
    if kind == "Name" {
        if text_of(field(node, "name")) == "value" {
            return ok_val(current)
        }
        return eval_unsupported("name")
    }
    if kind == "Group" {
        return evaluate(field(node, "expression"), current)
    }
    if kind == "Unary" {
        return evaluate_unary(node, current)
    }
    if kind == "Binary" {
        return evaluate_binary(node, current)
    }
    if kind == "Call" {
        return evaluate_call(node, current)
    }
    return eval_unsupported(kind)
}

// An expression written back as source text, for the notes of a refinement.
pub fn unparse(node: parser.Node) gives Text {
    let kind = kind_of(node)
    if kind == "TextLiteral" {
        return parser.quote(text_of(field(node, "value")))
    }
    if kind == "IntLiteral" {
        return to_text(int_of(field(node, "value")))
    }
    if kind == "FloatLiteral" {
        return to_text(Float.parse(real_of(field(node, "value"))))
    }
    if kind == "BoolLiteral" {
        return to_text(flag_of(field(node, "value")))
    }
    if kind == "Name" {
        return text_of(field(node, "name"))
    }
    if kind == "Group" {
        return "(" + unparse(field(node, "expression")) + ")"
    }
    if kind == "Unary" {
        var separator = ""
        if text_of(field(node, "operator")) == "not" {
            separator = " "
        }
        return text_of(field(node, "operator")) + separator + unparse(field(node, "operand"))
    }
    if kind == "Binary" {
        return (
            unparse(field(node, "left")) + " " + text_of(field(node, "operator")) + " "
            + unparse(field(node, "right"))
        )
    }
    if kind == "ListLiteral" {
        return "[" + parser.join_texts(unparse_all(items_of(field(node, "elements"))), ", ") + "]"
    }
    if kind == "RecordConstruction" {
        var written: List[Text] = []
        for initializer in items_of(field(node, "fields")) {
            written = List.append(written, text_of(field(initializer, "name")) + ": " + unparse(field(initializer, "value")))
        }
        var prefix = ""
        if not is_null(field(node, "qualifier")) {
            prefix = text_of(field(node, "qualifier")) + "."
        }
        return prefix + text_of(field(node, "name")) + "(" + parser.join_texts(written, ", ") + ")"
    }
    if kind == "FieldAccess" {
        return unparse(field(node, "target")) + "." + text_of(field(node, "name"))
    }
    return text_of(field(node, "callee")) + "(" + parser.join_texts(unparse_all(items_of(field(node, "arguments"))), ", ") + ")"
}

fn unparse_all(nodes: List[parser.Node]) gives List[Text] {
    var result: List[Text] = []
    for node in nodes {
        result = List.append(result, unparse(node))
    }
    return result
}

// The number of nodes of an expression.
fn size_of(node: parser.Node) gives Int {
    let kind = kind_of(node)
    if kind == "Binary" {
        return 1 + size_of(field(node, "left")) + size_of(field(node, "right"))
    }
    if kind == "Unary" {
        return 1 + size_of(field(node, "operand"))
    }
    if kind == "Group" {
        return 1 + size_of(field(node, "expression"))
    }
    if kind == "Call" {
        var total = 1
        for argument in items_of(field(node, "arguments")) {
            total = total + size_of(argument)
        }
        return total
    }
    if kind == "ListLiteral" {
        var total = 1
        for element in items_of(field(node, "elements")) {
            total = total + size_of(element)
        }
        return total
    }
    return 1
}

// Constants

type ConstOut = { present: Bool, val: Val }

// The value of a literal (possibly negated or in parentheses), or nothing for anything else.
fn constant_of(node: parser.Node) gives ConstOut {
    let kind = kind_of(node)
    let none = ConstOut(present: false, val: Val.VBool(false))
    if kind == "IntLiteral" {
        return ConstOut(present: true, val: Val.VInt(int_of(field(node, "value"))))
    }
    if kind == "FloatLiteral" {
        return ConstOut(present: true, val: Val.VFloat(Float.parse(real_of(field(node, "value")))))
    }
    if kind == "TextLiteral" {
        return ConstOut(present: true, val: Val.VText(text_of(field(node, "value"))))
    }
    if kind == "BoolLiteral" {
        return ConstOut(present: true, val: Val.VBool(flag_of(field(node, "value"))))
    }
    if kind == "Group" {
        return constant_of(field(node, "expression"))
    }
    if kind == "Unary" {
        let inner = constant_of(field(node, "operand"))
        if not inner.present {
            return none
        }
        let operator = text_of(field(node, "operator"))
        if operator == "-" {
            return match inner.val {
                Val.VInt(x) => ConstOut(present: true, val: Val.VInt(0 - x))
                Val.VFloat(x) => ConstOut(present: true, val: Val.VFloat(0.0 - x))
                _ => none
            }
        }
        return match inner.val {
            Val.VBool(x) => ConstOut(present: true, val: Val.VBool(not x))
            _ => none
        }
    }
    return none
}

fn refinement_notes(state: State, kind: Text, broken: parser.Node, written: Text) gives List[Text] {
    let condition = "where " + unparse(field(broken, "condition"))
    let broken_name = text_of(field(broken, "name"))
    var notes: List[Text] = []
    if broken_name == kind {
        notes = ["The condition of '" + kind + "' is false: " + condition]
    } else {
        let refines = "'" + kind + "' refines '" + broken_name + "', and the condition of '" + broken_name + "' is false: "
        notes = [refines + condition]
    }
    notes = List.append(notes, "The value: " + written)
    let message = field(broken, "message")
    if not is_null(message) {
        notes = List.append(notes, "Reason: " + text_of(message))
    }
    return notes
}

// The most work the analysis may spend checking constants, counted as the nodes of the conditions it evaluates.
fn max_refinement_steps() gives Int {
    return 100000
}

// Reports E2017 if the constant `node` is not a valid value of the refined type `kind`.
fn check_constant(state: State, node: parser.Node, kind: Text) gives State {
    let at = ref_index(state, kind)
    let constant = constant_of(node)
    if at < 0 or not constant.present or state.tables.steps < 0 {
        return state
    }
    let refined = List.get(state.tables.refined, at)
    var cost = 0
    for name in refined.chain {
        cost = cost + size_of(field(type_decl(state, name), "condition"))
    }
    let total = state.tables.steps + cost
    if total > max_refinement_steps() {
        return report(
            with_tables(state, set_steps(state.tables, 0 - 1)), "E2019",
            "Checking constants against refined types needs more than " + to_text(max_refinement_steps()) + " steps",
            "Use fewer constants of long chains of refined types, or shorter conditions. "
            + "The limit keeps the analysis fast; every constant is still checked before running.",
            [], span_of(node)
        )
    }
    let counted = with_tables(state, set_steps(state.tables, total))
    let written = show_val(constant.val)
    for name in refined.chain {
        let declaration = type_decl(counted, name)
        let outcome = evaluate(field(declaration, "condition"), constant.val)
        if outcome.unsupported != "" {
            return unsupported(counted, outcome.unsupported)
        }
        if not outcome.ok {
            return report(
                counted, "E2017", written + " cannot be checked against the condition of '" + kind + "'", "",
                ["Evaluating the condition stops with: " + outcome.label], span_of(node)
            )
        }
        if not truth(outcome.val) {
            return report(
                counted, "E2017", written + " is not a valid " + kind, "",
                refinement_notes(counted, kind, declaration, written), span_of(node)
            )
        }
    }
    return counted
}

// `Percent(x)`: checks, when the program runs, that x satisfies the condition of Percent.
fn refinement_check(given: ArgList, node: parser.Node, name: Text, arguments: List[parser.Node]) gives Checked {
    let state = given.state
    let callee_span = place_span(field(node, "callee_span"))
    if state.tables.refining != "" {
        return checked(
            node, "",
            report(
                state, "E2018",
                "The condition of '" + state.tables.refining + "' cannot check a value against '" + name + "'",
                "To build on '" + name + "', refine it: type " + state.tables.refining + " = " + name + " where ...",
                [], callee_span
            )
        )
    }
    let at = ref_index(state, name)
    let count = List.length(arguments)
    if count != 1 {
        var verb = "were"
        if count == 1 {
            verb = "was"
        }
        var result = ""
        if at >= 0 {
            result = name
        }
        return checked(
            node, result,
            report(
                state, "E2009", "'" + name + "' takes 1 argument, but " + to_text(count) + " " + verb + " given", "",
                [name + "(x) checks that x satisfies the condition of " + name + "."], span_of(node)
            )
        )
    }
    if at < 0 {
        return checked(node, "", state)
    }
    let refined = List.get(state.tables.refined, at)
    let found = List.get(given.types, 0)
    let argument = List.get(arguments, 0)
    if found == "" {
        return checked(node, name, state)
    }
    if found == "Void" {
        return checked(
            node, name,
            report(state, "E2011", "This call does not produce a value to check", "", [], span_of(argument))
        )
    }
    if root_of(state, found) != refined.root {
        return checked(
            node, name,
            report(
                state, "E2011", "Expected " + refined.root + ", found " + found,
                conversion_hint(root_of(state, found), refined.root),
                ["'" + name + "' refines " + refined.base + ", so it checks values of type " + refined.root + "."],
                span_of(argument)
            )
        )
    }
    return checked(node, name, check_constant(state, argument, name))
}

// Enums

pub type EnumInfo = {
    name: Text, variant_names: List[Text], variant_field_names: List[List[Text]],
    variant_field_types: List[List[Text]]
}

fn is_enum_name(state: State, name: Text) gives Bool {
    return List.contains(state.tables.enum_names, name)
}

fn enum_index(state: State, name: Text) gives Int {
    var i = 0
    while i < List.length(state.tables.enums)
        shrinks List.length(state.tables.enums) - i
    {
        let info = List.get(state.tables.enums, i)
        if info.name == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn enum_decl(program: parser.Node, name: Text, nth: Int) gives parser.Node {
    var seen = 0
    for declaration in items_of(field(program, "enums")) {
        if text_of(field(declaration, "name")) == name {
            if seen == nth {
                return declaration
            }
            seen = seen + 1
        }
    }
    return parser.Node.Null()
}

// Resolves every closed enum and the types of its variant payloads. As in Python, a declaration whose name
// was registered is processed, so a repeated one is processed again.
fn declare_enums(state: State, program: parser.Node) gives State {
    var current = state
    for declaration in items_of(field(program, "enums")) {
        let name = text_of(field(declaration, "name"))
        if is_enum_name(current, name) {
            var seen_names: List[Text] = []
            var seen_lines: List[Int] = []
            var seen_columns: List[Int] = []
            var variant_names: List[Text] = []
            var field_names: List[List[Text]] = []
            var field_types: List[List[Text]] = []
            var broken = false
            for variant in items_of(field(declaration, "variants")) {
                let variant_name = text_of(field(variant, "name"))
                let variant_span = place_span(field(variant, "name_span"))
                let seen = index_of(seen_names, variant_name)
                if seen >= 0 {
                    current = report(
                        current, "E2016", "The variant '" + variant_name + "' is declared more than once in '" + name + "'", "",
                        [
                            "It was first declared at line " + to_text(List.get(seen_lines, seen)) + ", column "
                            + to_text(List.get(seen_columns, seen)) + "."
                        ],
                        variant_span
                    )
                    broken = true
                } else {
                    seen_names = List.append(seen_names, variant_name)
                    seen_lines = List.append(seen_lines, variant_span.line)
                    seen_columns = List.append(seen_columns, variant_span.column)
                    var names: List[Text] = []
                    var kinds: List[Text] = []
                    for payload in items_of(field(variant, "fields")) {
                        let payload_name = text_of(field(payload, "name"))
                        if List.contains(names, payload_name) {
                            current = report(
                                current, "E2016",
                                "The field '" + payload_name + "' is declared more than once in '" + name + "." + variant_name + "'",
                                "", [], place_span(field(payload, "name_span"))
                            )
                            broken = true
                        } else {
                            names = List.append(names, payload_name)
                            let resolved = declared_type(
                                current, field(payload, "type"),
                                "The field '" + payload_name + "' of '" + name + "." + variant_name + "'", true
                            )
                            current = resolved.state
                            if resolved.ty == "" {
                                broken = true
                            } else {
                                kinds = List.append(kinds, resolved.ty)
                            }
                        }
                    }
                    variant_names = List.append(variant_names, variant_name)
                    field_names = List.append(field_names, names)
                    field_types = List.append(field_types, kinds)
                }
            }
            if List.length(variant_names) > 0 and not broken {
                let info = EnumInfo(
                    name: name, variant_names: variant_names, variant_field_names: field_names,
                    variant_field_types: field_types
                )
                var kept: List[EnumInfo] = []
                var replaced = false
                for existing in current.tables.enums {
                    if existing.name == name {
                        kept = List.append(kept, info)
                        replaced = true
                    } else {
                        kept = List.append(kept, existing)
                    }
                }
                if not replaced {
                    kept = List.append(kept, info)
                }
                current = with_tables(current, set_enums(current.tables, kept))
            }
        }
    }
    return current
}

// `Shape.Circle(2.0)`: builds a variant of a closed enum. The Checked holds the enum type, or nothing after
// an error; the arguments are checked only when the variant exists.
fn check_enum_construction(state: State, env: List[Binding], node: parser.Node, enum_name: Text) gives Checked {
    let at = enum_index(state, enum_name)
    if at < 0 {
        return checked(node, "", state)
    }
    let info = List.get(state.tables.enums, at)
    let callee = text_of(field(node, "callee"))
    let variant_name = Text.slice(callee, last_dot(callee) + 1, Text.length(callee))
    let position = index_of(info.variant_names, variant_name)
    if position < 0 {
        return checked(
            node, "",
            report(
                state, "E2035", "'" + variant_name + "' is not a variant of " + enum_name,
                "The variants are: " + parser.join_texts(info.variant_names, ", ") + ".", [],
                place_span(field(node, "callee_span"))
            )
        )
    }
    var current = state
    let arguments = items_of(field(node, "arguments"))
    let field_types = List.get(info.variant_field_types, position)
    if List.length(arguments) != List.length(field_types) {
        current = report(
            current, "E2035",
            "'" + enum_name + "." + variant_name + "' takes " + to_text(List.length(field_types))
            + " argument(s), but " + to_text(List.length(arguments)) + " were given",
            "", [], span_of(node)
        )
    }
    var typed: List[parser.Node] = []
    var index = 0
    while index < List.length(arguments)
        shrinks List.length(arguments) - index
    {
        var kind = ""
        if index < List.length(field_types) {
            kind = List.get(field_types, index)
        }
        let argument = List.get(arguments, index)
        let found = check_expression(current, env, argument, kind)
        typed = List.append(typed, found.node)
        current = found.state
        if found.ty != "" and kind != "" {
            current = expect_type(
                current, kind, found.ty, argument,
                ["This is the payload for '" + enum_name + "." + variant_name + "'."]
            )
        }
        index = index + 1
    }
    return checked(with_field(node, "arguments", parser.Node.Items(typed)), enum_name, current)
}

fn last_dot(text: Text) gives Int {
    var i = Text.length(text) - 1
    while i >= 0
        shrinks i + 1
    {
        if Text.slice(text, i, i + 1) == "." {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

// Option and Result, as the strings that name them

fn is_option_type(ty: Text) gives Bool {
    return Text.starts_with(ty, "Option[") and Text.ends_with(ty, "]")
}

fn option_item(ty: Text) gives Text {
    return Text.slice(ty, 7, Text.length(ty) - 1)
}

fn is_result_type(ty: Text) gives Bool {
    return Text.starts_with(ty, "Result[") and Text.ends_with(ty, "]")
}

// The two types inside `Result[T, E]`, split at the comma that is not inside brackets.
fn result_parts(ty: Text) gives List[Text] {
    let inner = Text.slice(ty, 7, Text.length(ty) - 1)
    var depth = 0
    var i = 0
    while i < Text.length(inner)
        shrinks Text.length(inner) - i
    {
        let c = Text.slice(inner, i, i + 1)
        if c == "[" {
            depth = depth + 1
        } else if c == "]" {
            depth = depth - 1
        } else if c == "," and depth == 0 {
            return [Text.slice(inner, 0, i), Text.slice(inner, i + 2, Text.length(inner))]
        }
        i = i + 1
    }
    return [inner, ""]
}

// Patterns, once they have been checked

type Pat = enum { PAny, PLit(key: Text), PVar(key: Text, children: List[Pat]) }

type PatOut = { pat: Pat, env: List[Binding], state: State }

type Ctor = { key: Text, display: Text, field_types: List[Text] }

type PatternInfo = { state: State, ok: Bool, key: Text, field_types: List[Text] }

// The variants of a closed type, as (name, field types): an enum, an Option or a Result.
type Variants = { enum_name: Text, names: List[Text], fields: List[List[Text]], known: Bool }

fn variants_of(state: State, expected: Text) gives Variants {
    if is_option_type(expected) {
        return Variants(
            enum_name: "Option", names: ["None", "Some"], fields: [[], [option_item(expected)]], known: true
        )
    }
    if is_result_type(expected) {
        let parts = result_parts(expected)
        return Variants(
            enum_name: "Result", names: ["Ok", "Err"], fields: [[List.get(parts, 0)], [List.get(parts, 1)]],
            known: true
        )
    }
    let at = enum_index(state, expected)
    if at >= 0 {
        let info = List.get(state.tables.enums, at)
        return Variants(
            enum_name: expected, names: info.variant_names, fields: info.variant_field_types, known: true
        )
    }
    return Variants(enum_name: expected, names: [], fields: [], known: false)
}

fn pattern_failure(state: State) gives PatternInfo {
    return PatternInfo(state: state, ok: false, key: "", field_types: [])
}

// Resolves a variant pattern against the closed type of the scrutinee.
fn pattern_info(state: State, pattern: parser.Node, expected: Text) gives PatternInfo {
    let variants = variants_of(state, expected)
    let name = text_of(field(pattern, "name"))
    if not variants.known {
        return pattern_failure(
            report(
                state, "E2033", "A variant pattern cannot match a value of type " + expected,
                "Match a value whose type is an enum, Option, or Result.", [], span_of(pattern)
            )
        )
    }
    let qualifier = field(pattern, "qualifier")
    if not is_null(qualifier) and text_of(qualifier) != variants.enum_name {
        return pattern_failure(
            report(
                state, "E2033", "'" + text_of(qualifier) + "." + name + "' is not a variant of " + expected, "", [],
                span_of(pattern)
            )
        )
    }
    let position = index_of(variants.names, name)
    if position < 0 {
        return pattern_failure(
            report(
                state, "E2033", "'" + name + "' is not a variant of " + expected,
                "The variants are: " + parser.join_texts(variants.names, ", ") + ".", [],
                place_span(field(pattern, "name_span"))
            )
        )
    }
    let field_types = List.get(variants.fields, position)
    let arguments = items_of(field(pattern, "arguments"))
    if List.length(arguments) != List.length(field_types) {
        return pattern_failure(
            report(
                state, "E2033",
                "'" + name + "' takes " + to_text(List.length(field_types)) + " pattern argument(s), but "
                + to_text(List.length(arguments)) + " were given",
                "", [], span_of(pattern)
            )
        )
    }
    return PatternInfo(state: state, ok: true, key: variants.enum_name + "." + name, field_types: field_types)
}

fn literal_key(expected: Text, value: parser.Node) gives Text {
    return match value {
        parser.Node.Flag(b) => "Bool." + to_text(b)
        parser.Node.Whole(n) => expected + "::" + to_text(n)
        parser.Node.Real(text) => expected + "::" + to_text(Float.parse(text))
        parser.Node.Str(text) => expected + "::" + parser.quote(text)
        _ => expected + "::"
    }
}

fn literal_type(value: parser.Node) gives Text {
    return match value {
        parser.Node.Flag(b) => "Bool"
        parser.Node.Whole(n) => "Int"
        parser.Node.Real(text) => "Float"
        _ => "Text"
    }
}

// Type-checks a pattern and binds its names in the scope of the arm.
fn check_pattern(state: State, env: List[Binding], pattern: parser.Node, expected: Text) gives PatOut {
    let kind = kind_of(pattern)
    if kind == "WildcardPattern" {
        return PatOut(pat: Pat.PAny(), env: env, state: state)
    }
    if kind == "BindingPattern" {
        let name = text_of(field(pattern, "name"))
        let free = name_is_free(state, env, name, place_span(field(pattern, "name_span")))
        var next_env = env
        var next_state = free.state
        if free.free {
            let binding = make_binding(
                name, "pattern variable", expected, false, false, place_span(field(pattern, "name_span"))
            )
            next_env = List.append(env, binding)
            next_state = add_pattern_symbol(free.state, binding)
        }
        return PatOut(pat: Pat.PAny(), env: next_env, state: next_state)
    }
    if kind == "LiteralPattern" {
        let value = field(pattern, "value")
        let found = literal_type(value)
        var current = state
        if not accepts(state, expected, found) {
            current = report(
                state, "E2011", "Expected " + expected + ", found " + found, "", [], span_of(pattern)
            )
        }
        return PatOut(pat: Pat.PLit(literal_key(expected, value)), env: env, state: current)
    }
    let info = pattern_info(state, pattern, expected)
    if not info.ok {
        return PatOut(pat: Pat.PVar("", []), env: env, state: info.state)
    }
    var current = info.state
    var scope = env
    var children: List[Pat] = []
    let arguments = items_of(field(pattern, "arguments"))
    var index = 0
    while index < List.length(arguments)
        shrinks List.length(arguments) - index
    {
        let child = check_pattern(current, scope, List.get(arguments, index), List.get(info.field_types, index))
        children = List.append(children, child.pat)
        current = child.state
        scope = child.env
        index = index + 1
    }
    return PatOut(pat: Pat.PVar(info.key, children), env: scope, state: current)
}

// Exhaustiveness and usefulness of patterns

fn is_catchall(p: Pat) gives Bool {
    return match p {
        Pat.PAny => true
        _ => false
    }
}

fn pat_key(p: Pat) gives Text {
    return match p {
        Pat.PVar(key, children) => key
        Pat.PLit(key) => key
        _ => ""
    }
}

// The key of a literal pattern, or nothing for a variant: only literals tell themselves apart by it.
fn lit_key(p: Pat) gives Text {
    return match p {
        Pat.PLit(key) => key
        _ => ""
    }
}

fn pat_args(p: Pat) gives List[Pat] {
    return match p {
        Pat.PVar(key, children) => children
        _ => []
    }
}

fn drop_first_pats(items: List[Pat]) gives List[Pat] {
    var rest: List[Pat] = []
    var i = 1
    while i < List.length(items)
        shrinks List.length(items) - i
    {
        rest = List.append(rest, List.get(items, i))
        i = i + 1
    }
    return rest
}

fn drop_first_texts(items: List[Text]) gives List[Text] {
    var rest: List[Text] = []
    var i = 1
    while i < List.length(items)
        shrinks List.length(items) - i
    {
        rest = List.append(rest, List.get(items, i))
        i = i + 1
    }
    return rest
}

fn any_patterns(count: Int) gives List[Pat] {
    var result: List[Pat] = []
    var i = 0
    while i < count
        shrinks count - i
    {
        result = List.append(result, Pat.PAny())
        i = i + 1
    }
    return result
}

// The finite constructors of a type. Open domains deliberately return none.
fn finite_constructors(state: State, kind: Text) gives List[Ctor] {
    if root_of(state, kind) == "Bool" {
        return [Ctor(key: "Bool.true", display: "true", field_types: []), Ctor(key: "Bool.false", display: "false", field_types: [])]
    }
    if is_option_type(kind) {
        return (
            [
                Ctor(key: "Option.None", display: "None", field_types: []),
                Ctor(key: "Option.Some", display: "Some", field_types: [option_item(kind)])
            ]
        )
    }
    if is_result_type(kind) {
        let parts = result_parts(kind)
        return (
            [
                Ctor(key: "Result.Ok", display: "Ok", field_types: [List.get(parts, 0)]),
                Ctor(key: "Result.Err", display: "Err", field_types: [List.get(parts, 1)])
            ]
        )
    }
    let at = enum_index(state, kind)
    if at >= 0 {
        let info = List.get(state.tables.enums, at)
        var constructors: List[Ctor] = []
        var i = 0
        while i < List.length(info.variant_names)
            shrinks List.length(info.variant_names) - i
        {
            let variant = List.get(info.variant_names, i)
            constructors = List.append(
                constructors,
                Ctor(key: kind + "." + variant, display: variant, field_types: List.get(info.variant_field_types, i))
            )
            i = i + 1
        }
        return constructors
    }
    return []
}

// The position, among `constructors`, of the one a pattern stands for; -1 when it stands for none.
fn ctor_position(constructors: List[Ctor], p: Pat) gives Int {
    let key = pat_key(p)
    if key == "" {
        return 0 - 1
    }
    var i = 0
    while i < List.length(constructors)
        shrinks List.length(constructors) - i
    {
        let constructor = List.get(constructors, i)
        if constructor.key == key {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn specialize(state: State, matrix: List[List[Pat]], key: Text, arity: Int, kind: Text) gives List[List[Pat]] {
    var rows: List[List[Pat]] = []
    let constructors = finite_constructors(state, kind)
    for row in matrix {
        let head = List.get(row, 0)
        let tail = drop_first_pats(row)
        if is_catchall(head) {
            rows = List.append(rows, List.concat(any_patterns(arity), tail))
        } else {
            let position = ctor_position(constructors, head)
            if position >= 0 {
                let constructor = List.get(constructors, position)
                if constructor.key == key {
                    rows = List.append(rows, List.concat(pat_args(head), tail))
                }
            }
        }
    }
    return rows
}

fn present_keys(state: State, matrix: List[List[Pat]], constructors: List[Ctor]) gives List[Text] {
    var present: List[Text] = []
    for row in matrix {
        let position = ctor_position(constructors, List.get(row, 0))
        if position >= 0 {
            let constructor = List.get(constructors, position)
            present = List.append(present, constructor.key)
        }
    }
    return present
}

fn all_present(constructors: List[Ctor], present: List[Text]) gives Bool {
    for constructor in constructors {
        if not List.contains(present, constructor.key) {
            return false
        }
    }
    return true
}

fn default_rows(matrix: List[List[Pat]]) gives List[List[Pat]] {
    var rows: List[List[Pat]] = []
    for row in matrix {
        if is_catchall(List.get(row, 0)) {
            rows = List.append(rows, drop_first_pats(row))
        }
    }
    return rows
}

fn is_exhaustive(state: State, matrix: List[List[Pat]], kinds: List[Text]) gives Bool {
    if List.length(kinds) == 0 {
        return List.length(matrix) > 0
    }
    let kind = List.get(kinds, 0)
    let tail_kinds = drop_first_texts(kinds)
    let constructors = finite_constructors(state, kind)
    if List.length(constructors) > 0 {
        if all_present(constructors, present_keys(state, matrix, constructors)) {
            for constructor in constructors {
                let specialized = specialize(state, matrix, constructor.key, List.length(constructor.field_types), kind)
                if not is_exhaustive(state, specialized, List.concat(constructor.field_types, tail_kinds)) {
                    return false
                }
            }
            return true
        }
    }
    return is_exhaustive(state, default_rows(matrix), tail_kinds)
}

fn useful_pattern(state: State, matrix: List[List[Pat]], vector: List[Pat], kinds: List[Text]) gives Bool {
    if List.length(kinds) == 0 {
        return List.length(matrix) == 0
    }
    let kind = List.get(kinds, 0)
    let tail_kinds = drop_first_texts(kinds)
    let pattern = List.get(vector, 0)
    let tail = drop_first_pats(vector)
    let constructors = finite_constructors(state, kind)
    if is_catchall(pattern) {
        let present = present_keys(state, matrix, constructors)
        if List.length(constructors) > 0 and all_present(constructors, present) {
            for constructor in constructors {
                let specialized = specialize(state, matrix, constructor.key, List.length(constructor.field_types), kind)
                if useful_pattern(
                    state, specialized, List.concat(any_patterns(List.length(constructor.field_types)), tail),
                    List.concat(constructor.field_types, tail_kinds)
                ) {
                    return true
                }
            }
            return false
        }
        return useful_pattern(state, default_rows(matrix), tail, tail_kinds)
    }
    let position = ctor_position(constructors, pattern)
    if position >= 0 {
        let constructor = List.get(constructors, position)
        let specialized = specialize(state, matrix, constructor.key, List.length(constructor.field_types), kind)
        return useful_pattern(
            state, specialized, List.concat(pat_args(pattern), tail),
            List.concat(constructor.field_types, tail_kinds)
        )
    }
    // Literal patterns over open types are useful unless that exact literal or a wildcard was already covered.
    // They never make an infinite domain exhaustive.
    let literal = lit_key(pattern)
    var rows: List[List[Pat]] = []
    for row in matrix {
        let head = List.get(row, 0)
        if is_catchall(head) or lit_key(head) == literal {
            rows = List.append(rows, drop_first_pats(row))
        }
    }
    return useful_pattern(state, rows, tail, tail_kinds)
}

// What a match does not cover, written as patterns; the empty list when it covers everything.
type Witness = { found: Bool, patterns: List[Text] }

fn missing_pattern(state: State, matrix: List[List[Pat]], kinds: List[Text]) gives Witness {
    if List.length(kinds) == 0 {
        return Witness(found: List.length(matrix) == 0, patterns: [])
    }
    let kind = List.get(kinds, 0)
    let tail_kinds = drop_first_texts(kinds)
    let constructors = finite_constructors(state, kind)
    if List.length(constructors) > 0 {
        for constructor in constructors {
            let specialized = specialize(state, matrix, constructor.key, List.length(constructor.field_types), kind)
            let witness = missing_pattern(state, specialized, List.concat(constructor.field_types, tail_kinds))
            if witness.found {
                let count = List.length(constructor.field_types)
                var arguments: List[Text] = []
                var rest: List[Text] = []
                var i = 0
                while i < List.length(witness.patterns)
                    shrinks List.length(witness.patterns) - i
                {
                    if i < count {
                        arguments = List.append(arguments, List.get(witness.patterns, i))
                    } else {
                        rest = List.append(rest, List.get(witness.patterns, i))
                    }
                    i = i + 1
                }
                var head = constructor.display
                if count > 0 {
                    head = constructor.display + "(" + parser.join_texts(arguments, ", ") + ")"
                }
                return Witness(found: true, patterns: List.concat([head], rest))
            }
        }
        return Witness(found: false, patterns: [])
    }
    let witness = missing_pattern(state, default_rows(matrix), tail_kinds)
    if not witness.found {
        return Witness(found: false, patterns: [])
    }
    return Witness(found: true, patterns: List.concat(["_"], witness.patterns))
}

// Match

// A match arm body that is a block checks its statements and gives nothing.
fn check_match_expression(state: State, env: List[Binding], node: parser.Node, expected: Text) gives Checked {
    let scrutinee = check_expression(state, env, field(node, "value"), "")
    let arms = items_of(field(node, "arms"))
    var current = scrutinee.state
    if scrutinee.ty == "" {
        for arm in arms {
            let unknown_pattern = check_pattern(current, env, field(arm, "pattern"), "<unknown>")
            current = unknown_pattern.state
        }
        return checked(with_field(node, "value", scrutinee.node), "", current)
    }
    var matrix: List[List[Pat]] = []
    var result_type = expected
    var failed = false
    var typed_arms: List[parser.Node] = []
    for arm in arms {
        let pattern = check_pattern(current, env, field(arm, "pattern"), scrutinee.ty)
        current = pattern.state
        if not useful_pattern(current, matrix, [pattern.pat], [scrutinee.ty]) {
            current = report(
                current, "E2034", "This arm can never be reached", "", [], span_of(field(arm, "pattern"))
            )
        }
        matrix = List.append(matrix, [pattern.pat])
        let body = field(arm, "body")
        var found = ""
        if kind_of(body) == "Block" {
            let block = check_block(current, pattern.env, body)
            typed_arms = List.append(typed_arms, with_field(arm, "body", block.node))
            current = block.state
            found = "Void"
        } else {
            var arm_expected = result_type
            if result_type == "" {
                arm_expected = expected
            }
            let value = check_expression(current, pattern.env, body, arm_expected)
            typed_arms = List.append(typed_arms, with_field(arm, "body", value.node))
            current = value.state
            found = value.ty
        }
        if found == "" {
            failed = true
        } else if result_type == "" {
            result_type = found
        } else if not accepts(current, result_type, found) {
            current = report(
                current, "E2011", "Expected " + result_type + ", found " + found, "",
                ["Every arm of a match expression must produce the same type."], span_of(body)
            )
            failed = true
        }
    }
    if not is_exhaustive(current, matrix, [scrutinee.ty]) {
        let witness = missing_pattern(current, matrix, [scrutinee.ty])
        var shown = ["_"]
        if witness.found and List.length(witness.patterns) > 0 {
            shown = witness.patterns
        }
        current = report(
            current, "E2032", "This match does not cover: " + parser.join_texts(shown, ", "),
            "Add an arm for the missing pattern, or a final '_' arm.", [], span_of(node)
        )
    }
    let rebuilt = with_field(with_field(node, "value", scrutinee.node), "arms", parser.Node.Items(typed_arms))
    if failed {
        return checked(rebuilt, "", current)
    }
    return checked(rebuilt, result_type, current)
}

// `if let pattern = value { ... } else { ... }`
fn check_if_let(state: State, env: List[Binding], node: parser.Node) gives Flow {
    let value = check_expression(state, env, field(node, "value"), "")
    var current = value.state
    var then_env = env
    if value.ty != "" {
        let pattern = check_pattern(current, env, field(node, "pattern"), value.ty)
        current = pattern.state
        then_env = pattern.env
    }
    let then_flow = check_block(current, then_env, field(node, "then_block"))
    let else_node = field(node, "else_branch")
    let head = with_field(with_field(node, "value", value.node), "then_block", then_flow.node)
    if is_null(else_node) {
        return flow(head, then_flow.state, env, false)
    }
    var else_flow = check_block(then_flow.state, env, else_node)
    if kind_of(else_node) == "If" {
        else_flow = check_if(then_flow.state, env, else_node)
    } else if kind_of(else_node) == "IfLet" {
        else_flow = check_if_let(then_flow.state, env, else_node)
    }
    return flow(
        with_field(head, "else_branch", else_flow.node), else_flow.state, env, then_flow.returns and else_flow.returns
    )
}

// Generic types: parsing, substitution and unification of the types of the built-ins that mention T and E

type Ty = enum { TyName(name: Text, children: List[Ty]) }

type TyAt = { ty: Ty, next: Int }

fn is_space(c: Text) gives Bool {
    return c == " "
}

fn is_delimiter(c: Text) gives Bool {
    return c == "[" or c == "]" or c == ","
}

// Reads one type written as text, starting at `start`: `Name`, or `Name[Type, Type]`.
fn parse_ty_at(text: Text, start: Int) gives TyAt {
    var end = start
    while end < Text.length(text) and not is_delimiter(Text.slice(text, end, end + 1))
        shrinks Text.length(text) - end
    {
        end = end + 1
    }
    let name = Text.slice(text, start, end)
    if end < Text.length(text) and Text.slice(text, end, end + 1) == "[" {
        var children: List[Ty] = []
        var at = end + 1
        var more = true
        while more
            shrinks Text.length(text) + 1 - at
        {
            while at < Text.length(text) and is_space(Text.slice(text, at, at + 1))
                shrinks Text.length(text) - at
            {
                at = at + 1
            }
            let parsed = parse_ty_at(text, at)
            children = List.append(children, parsed.ty)
            at = parsed.next
            if at < Text.length(text) and Text.slice(text, at, at + 1) == "," {
                at = at + 1
            } else {
                more = false
                at = at + 1
            }
        }
        return TyAt(ty: Ty.TyName(name, children), next: at)
    }
    return TyAt(ty: Ty.TyName(name, []), next: end)
}

fn parse_ty(text: Text) gives Ty {
    let parsed = parse_ty_at(text, 0)
    return parsed.ty
}

fn show_ty(t: Ty) gives Text {
    return match t {
        Ty.TyName(name, children) => show_named(name, children)
    }
}

fn show_named(name: Text, children: List[Ty]) gives Text {
    if List.length(children) == 0 {
        return name
    }
    var shown: List[Text] = []
    for arg in children {
        shown = List.append(shown, show_ty(arg))
    }
    return name + "[" + parser.join_texts(shown, ", ") + "]"
}

fn is_variable(t: Ty) gives Bool {
    return match t {
        Ty.TyName(name, children) => List.length(children) == 0 and (name == "T" or name == "E")
    }
}

fn ty_name(t: Ty) gives Text {
    return match t {
        Ty.TyName(name, children) => name
    }
}

fn ty_args(t: Ty) gives List[Ty] {
    return match t {
        Ty.TyName(name, children) => children
    }
}

// What the variables T and E are bound to; the empty text means not bound yet.
type Bind = { t: Text, e: Text }

type Unified = { ok: Bool, bind: Bind }

fn bound_value(t: Ty, bind: Bind) gives Text {
    if ty_name(t) == "T" {
        return bind.t
    }
    return bind.e
}

fn substitute_ty(t: Ty, bind: Bind) gives Ty {
    if is_variable(t) {
        let value = bound_value(t, bind)
        if value == "" {
            return t
        }
        return parse_ty(value)
    }
    var children: List[Ty] = []
    for arg in ty_args(t) {
        children = List.append(children, substitute_ty(arg, bind))
    }
    return Ty.TyName(ty_name(t), children)
}

// The text of a type with every bound variable replaced by what it is bound to.
fn substitute(ty: Text, bind: Bind) gives Text {
    return show_ty(substitute_ty(parse_ty(ty), bind))
}

fn has_variable_ty(t: Ty) gives Bool {
    if is_variable(t) {
        return true
    }
    for arg in ty_args(t) {
        if has_variable_ty(arg) {
            return true
        }
    }
    return false
}

fn has_variable(ty: Text) gives Bool {
    return has_variable_ty(parse_ty(ty))
}

fn bind_variable(t: Ty, value: Text, bind: Bind) gives Bind {
    if ty_name(t) == "T" {
        return Bind(t: value, e: bind.e)
    }
    return Bind(t: bind.t, e: value)
}

// First-order unification: makes `left` (which may have variables) equal to `right`.
fn unify_ty(left: Ty, right: Ty, bind: Bind) gives Unified {
    var l = left
    var r = right
    if is_variable(l) and bound_value(l, bind) != "" {
        l = parse_ty(bound_value(l, bind))
    }
    if is_variable(r) and bound_value(r, bind) != "" {
        r = parse_ty(bound_value(r, bind))
    }
    if show_ty(l) == show_ty(r) {
        return Unified(ok: true, bind: bind)
    }
    if is_variable(l) {
        return Unified(ok: true, bind: bind_variable(l, show_ty(r), bind))
    }
    if is_variable(r) {
        return Unified(ok: true, bind: bind_variable(r, show_ty(l), bind))
    }
    let left_args = ty_args(l)
    let right_args = ty_args(r)
    if ty_name(l) != ty_name(r) or List.length(left_args) != List.length(right_args) or List.length(left_args) == 0 {
        return Unified(ok: false, bind: bind)
    }
    var current = bind
    var i = 0
    while i < List.length(left_args)
        shrinks List.length(left_args) - i
    {
        let inner = unify_ty(List.get(left_args, i), List.get(right_args, i), current)
        if not inner.ok {
            return Unified(ok: false, bind: bind)
        }
        current = inner.bind
        i = i + 1
    }
    return Unified(ok: true, bind: current)
}

// What a call cannot infer by itself, and how to say it.
fn uninferable_label(name: Text) gives Text {
    if name == "Ok" {
        return "Cannot infer the error type of this Result"
    }
    if name == "Err" {
        return "Cannot infer the item type of this Result"
    }
    return "Cannot infer the type of the elements of this list"
}

fn uninferable_hint(name: Text) gives Text {
    if name == "Ok" {
        return "Write the type of the result explicitly, for example: let r: Result[Int, Text] = Ok(1)."
    }
    if name == "Err" {
        return "Write the type of the result explicitly, for example: let r: Result[Int, Text] = Err(\"boom\")."
    }
    return "Write the type of the list explicitly, for example: let xs: List[Int] = []."
}

// A call to a built-in whose signature mentions type variables. Each argument is unified, in order, with its
// parameter type, and the result is the return type after the same substitution. The type the context expects
// is unified last: it fixes the variables that no argument can, such as the error type of an `Ok`.
fn check_generic_call(
    given: ArgList, node: parser.Node, sig: Sig, arguments: List[parser.Node], expected_result: Text
) gives Checked {
    var current = given.state
    var bind = Bind(t: "", e: "")
    var invalid = false
    var i = 0
    while i < List.length(arguments)
        shrinks List.length(arguments) - i
    {
        let found = List.get(given.types, i)
        let declared = List.get(sig.param_types, i)
        let argument = List.get(arguments, i)
        let notes = ["This is the argument for '" + List.get(sig.param_names, i) + "' in: " + describe(sig)]
        if found == "" {
            invalid = true
        } else if found == "Void" {
            current = report(
                current, "E2011", "This call does not produce a value to pass as an argument", "", [],
                span_of(argument)
            )
            invalid = true
        } else {
            let wanted = substitute(declared, bind)
            if has_variable(wanted) {
                let unified = unify_ty(parse_ty(wanted), parse_ty(found), bind)
                if unified.ok {
                    bind = unified.bind
                } else {
                    current = report(
                        current, "E2011", "Expected " + wanted + ", found " + found,
                        "A list accepts only one element type: List[Int] and List[Text] are different types.",
                        notes, span_of(argument)
                    )
                    invalid = true
                }
            } else {
                let problems_before = List.length(current.problems)
                current = expect_type(current, wanted, found, argument, notes)
                if List.length(current.problems) != problems_before {
                    invalid = true
                }
            }
        }
        i = i + 1
    }
    if invalid {
        return checked(node, "", current)
    }
    var result = substitute(sig.return_type, bind)
    if expected_result != "" and has_variable(result) {
        let unified = unify_ty(parse_ty(result), parse_ty(expected_result), bind)
        if not unified.ok {
            return checked(
                node, "",
                report(
                    current, "E2011", "Expected " + expected_result + ", found " + result,
                    "This is the result of: " + describe(sig), [], span_of(node)
                )
            )
        }
        bind = unified.bind
        result = substitute(sig.return_type, bind)
    }
    if has_variable(result) {
        return checked(
            node, "",
            report(current, "E2011", uninferable_label(sig.name), uninferable_hint(sig.name), [], span_of(node))
        )
    }
    return checked(node, result, current)
}

// `None` is the absence of a value: an Option without a payload. The type of its item comes from the context
// that expects it.
fn none_type(state: State, node: parser.Node, expected: Text) gives Checked {
    if expected == "" {
        return checked(
            node, "",
            report(
                state, "E2011", "Cannot infer the type of None without an expected type",
                "Write the type of the option explicitly, for example: let x: Option[Int] = None.", [], span_of(node)
            )
        )
    }
    if is_option_type(expected) {
        return checked(node, expected, state)
    }
    return checked(
        node, "",
        report(
            state, "E2011", "Expected " + expected + ", found None",
            "None is an Option without a value: it needs a type of the form Option[Text].", [], span_of(node)
        )
    )
}

// Whether the expression is the `None` constant and not a variable of the program.
fn is_none_constant(env: List[Binding], node: parser.Node) gives Bool {
    return kind_of(node) == "Name" and text_of(field(node, "name")) == "None" and binding_index(env, "None") < 0
}

// Capabilities: what a program declares that it needs

fn set_caps(t: Tables, kinds: List[Text], paths: List[Text]) gives Tables {
    return Tables(
        declared: t.declared, records: t.records, type_names: t.type_names, type_decls: t.type_decls,
        refined: t.refined, steps: t.steps, refining: t.refining, fn_names: t.fn_names,
        reg_names: t.reg_names, reg_lines: t.reg_lines, reg_columns: t.reg_columns,
        enum_names: t.enum_names, enums: t.enums, cap_kinds: kinds, cap_paths: paths, modules: t.modules, private: t.private
    )
}

// The capability a built-in needs: "read", "write", "network" or "process"; the empty text for the others.
fn capability_of(callee: Text) gives Text {
    if callee == "read_file" {
        return "read"
    }
    if callee == "write_file" {
        return "write"
    }
    if callee == "Net.get" {
        return "network"
    }
    if callee == "Process.run" {
        return "process"
    }
    return ""
}

// The capabilities the program declares, once each: declaring is not granting.
fn declare_uses(state: State, program: parser.Node) gives State {
    var kinds: List[Text] = []
    var paths: List[Text] = []
    for declaration in items_of(field(program, "uses")) {
        let kind = text_of(field(declaration, "capability"))
        let path = text_of(field(declaration, "path"))
        var present = false
        var i = 0
        while i < List.length(kinds)
            shrinks List.length(kinds) - i
        {
            if List.get(kinds, i) == kind and List.get(paths, i) == path {
                present = true
            }
            i = i + 1
        }
        if not present {
            kinds = List.append(kinds, kind)
            paths = List.append(paths, path)
        }
    }
    return with_tables(state, set_caps(state.tables, kinds, paths))
}

fn declared_scopes(state: State, kind: Text) gives List[Text] {
    var scopes: List[Text] = []
    var i = 0
    while i < List.length(state.tables.cap_kinds)
        shrinks List.length(state.tables.cap_kinds) - i
    {
        if List.get(state.tables.cap_kinds, i) == kind {
            scopes = List.append(scopes, List.get(state.tables.cap_paths, i))
        }
        i = i + 1
    }
    return scopes
}

// Paths, compared by segments

type PathParts = { root: Text, segments: List[Text] }

fn slashes(path: Text) gives Text {
    var text = ""
    var i = 0
    while i < Text.length(path)
        shrinks Text.length(path) - i
    {
        let c = Text.slice(path, i, i + 1)
        if c == "\\" {
            text = text + "/"
        } else {
            text = text + c
        }
        i = i + 1
    }
    return text
}

// The root of a path and its segments, with `.` and `..` resolved, without touching the file system. A `..`
// that would leave a relative path is kept, and one that would leave the root is dropped.
fn split_path(path: Text) gives PathParts {
    var text = slashes(path)
    var root = ""
    if Text.starts_with(text, "/") {
        root = "/"
        text = Text.slice(text, 1, Text.length(text))
    } else if Text.length(text) > 1 and Text.slice(text, 1, 2) == ":" {
        root = upper_first(Text.slice(text, 0, 1)) + ":"
        text = Text.slice(text, 2, Text.length(text))
    }
    var segments: List[Text] = []
    var start = 0
    var i = 0
    while i <= Text.length(text)
        shrinks Text.length(text) + 1 - i
    {
        if i == Text.length(text) or Text.slice(text, i, i + 1) == "/" {
            let part = Text.slice(text, start, i)
            start = i + 1
            if part != "" and part != "." {
                if part == ".." {
                    let last = List.length(segments) - 1
                    if last >= 0 and List.get(segments, last) != ".." {
                        segments = drop_last(segments)
                    } else if root == "" {
                        segments = List.append(segments, "..")
                    }
                } else {
                    segments = List.append(segments, part)
                }
            }
        }
        i = i + 1
    }
    return PathParts(root: root, segments: segments)
}

fn drop_last(items: List[Text]) gives List[Text] {
    var result: List[Text] = []
    var i = 0
    while i < List.length(items) - 1
        shrinks List.length(items) - i
    {
        result = List.append(result, List.get(items, i))
        i = i + 1
    }
    return result
}

// Whether `path` is `scope` itself or is inside it. Both are compared by segments and their roots have to be
// the same: `data2` is not inside `data`, and a relative path is never inside an absolute one.
pub fn is_inside(scope: Text, path: Text) gives Bool {
    if scope == "" {
        return false
    }
    let inner = split_path(scope)
    let outer = split_path(path)
    if inner.root != outer.root or List.length(outer.segments) < List.length(inner.segments) {
        return false
    }
    var i = 0
    while i < List.length(inner.segments)
        shrinks List.length(inner.segments) - i
    {
        if List.get(inner.segments, i) != List.get(outer.segments, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn same_root(first: Text, second: Text) gives Bool {
    let a = split_path(first)
    let b = split_path(second)
    return a.root == b.root
}

// HTTPS origins

pub type Origin = { ok: Bool, host: Text, port: Int, unsupported: Text }

fn bad_origin() gives Origin {
    return Origin(ok: false, host: "", port: 0, unsupported: "")
}

fn lower_ascii(text: Text) gives Text {
    return parser.lower_text(text)
}

fn is_digits(text: Text) gives Bool {
    if Text.length(text) == 0 {
        return false
    }
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        let c = Text.slice(text, i, i + 1)
        if c < "0" or c > "9" {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_ascii_text(text: Text) gives Bool {
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        let c = Text.slice(text, i, i + 1)
        if c < " " or c > "~" {
            return false
        }
        i = i + 1
    }
    return true
}

// Whether every label of an ASCII host is between 1 and 63 characters, as the idna codec requires. One
// trailing dot is allowed.
fn labels_valid(host: Text) gives Bool {
    var text = host
    if Text.ends_with(text, ".") {
        text = Text.slice(text, 0, Text.length(text) - 1)
    }
    var start = 0
    var i = 0
    while i <= Text.length(text)
        shrinks Text.length(text) + 1 - i
    {
        if i == Text.length(text) or Text.slice(text, i, i + 1) == "." {
            let size = i - start
            if size < 1 or size > 63 {
                return false
            }
            start = i + 1
        }
        i = i + 1
    }
    return true
}

fn first_index_of_any(text: Text, chars: Text) gives Int {
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        if Text.contains(chars, Text.slice(text, i, i + 1)) {
            return i
        }
        i = i + 1
    }
    return Text.length(text)
}

// The scheme of a URL as urlsplit reads it: the text before the first ':' when it is a valid scheme.
fn url_scheme(url: Text) gives Text {
    let colon = index_of_char(url, ":")
    if colon <= 0 {
        return ""
    }
    let candidate = Text.slice(url, 0, colon)
    let first = Text.slice(candidate, 0, 1)
    if not ((first >= "a" and first <= "z") or (first >= "A" and first <= "Z")) {
        return ""
    }
    var i = 0
    while i < Text.length(candidate)
        shrinks Text.length(candidate) - i
    {
        let c = Text.slice(candidate, i, i + 1)
        let valid = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "+" or c == "-" or c == "."
        if not valid {
            return ""
        }
        i = i + 1
    }
    return parser.lower_text(candidate)
}

// The origin of an HTTPS URL: its lowercase host and its port. Not valid when the scheme is not https, when
// there is no host, when there are credentials or when the port is not a number.
pub fn url_origin(url: Text) gives Origin {
    if url_scheme(url) != "https" {
        return bad_origin()
    }
    let rest = Text.slice(url, index_of_char(url, ":") + 1, Text.length(url))
    if not Text.starts_with(rest, "//") {
        return bad_origin()
    }
    let after = Text.slice(rest, 2, Text.length(rest))
    let netloc = Text.slice(after, 0, first_index_of_any(after, "/?#"))
    var hostinfo = netloc
    let at = last_index_of_char(netloc, "@")
    if at >= 0 {
        let userinfo = Text.slice(netloc, 0, at)
        hostinfo = Text.slice(netloc, at + 1, Text.length(netloc))
        let colon = index_of_char(userinfo, ":")
        var username = userinfo
        var password = ""
        if colon >= 0 {
            username = Text.slice(userinfo, 0, colon)
            password = Text.slice(userinfo, colon + 1, Text.length(userinfo))
        }
        if username != "" or password != "" {
            return bad_origin()
        }
    }
    if Text.starts_with(hostinfo, "[") {
        return Origin(ok: false, host: "", port: 0, unsupported: "ipv6 origin")
    }
    var host = hostinfo
    var port_text = ""
    var has_port = false
    let port_at = index_of_char(hostinfo, ":")
    if port_at >= 0 {
        host = Text.slice(hostinfo, 0, port_at)
        port_text = Text.slice(hostinfo, port_at + 1, Text.length(hostinfo))
        has_port = true
    }
    if host == "" {
        return bad_origin()
    }
    var port = 443
    if has_port {
        if not is_digits(port_text) or not Int.can_parse(port_text) {
            return bad_origin()
        }
        let number = Int.parse(port_text)
        if number > 65535 {
            return bad_origin()
        }
        if number != 0 {
            port = number
        }
    }
    if not is_ascii_text(host) {
        return Origin(ok: false, host: "", port: 0, unsupported: "idna host")
    }
    if not labels_valid(host) {
        return bad_origin()
    }
    return Origin(ok: true, host: parser.lower_text(host), port: port, unsupported: "")
}

fn last_index_of_char(text: Text, c: Text) gives Int {
    return last_dot_of(text, c)
}

fn last_dot_of(text: Text, c: Text) gives Int {
    var i = Text.length(text) - 1
    while i >= 0
        shrinks i + 1
    {
        if Text.slice(text, i, i + 1) == c {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

// Whether a declaration covers a file path, an HTTPS origin or an executable. The paths are compared as they
// were written.
type Covers = { covered: Bool, unsupported: Text }

fn covers(state: State, kind: Text, path: Text) gives Covers {
    let scopes = declared_scopes(state, kind)
    if kind == "network" {
        let target = url_origin(path)
        if target.unsupported != "" {
            return Covers(covered: false, unsupported: target.unsupported)
        }
        if not target.ok {
            return Covers(covered: false, unsupported: "")
        }
        for scope in scopes {
            let declared = url_origin(scope)
            if declared.unsupported != "" {
                return Covers(covered: false, unsupported: declared.unsupported)
            }
            if declared.ok and declared.host == target.host and declared.port == target.port {
                return Covers(covered: true, unsupported: "")
            }
        }
        return Covers(covered: false, unsupported: "")
    }
    if kind == "process" {
        return Covers(covered: path != "" and List.contains(scopes, path), unsupported: "")
    }
    for scope in scopes {
        if is_inside(scope, path) {
            return Covers(covered: true, unsupported: "")
        }
    }
    return Covers(covered: false, unsupported: "")
}

// Whether a declared path and `path` can be compared at all: with nothing declared the answer is that the
// path is not covered; a declaration of another root cannot be compared without the working directory.
fn comparable(state: State, kind: Text, path: Text) gives Bool {
    if kind == "network" or kind == "process" {
        return true
    }
    let scopes = declared_scopes(state, kind)
    if List.length(scopes) == 0 {
        return true
    }
    for scope in scopes {
        if same_root(scope, path) {
            return true
        }
    }
    return false
}

// A host operation needs a declaration that covers its target. This is a help, not the security: the
// interpreter checks the permissions again when the program runs.
fn check_capability(state: State, node: parser.Node) gives State {
    let kind = capability_of(text_of(field(node, "callee")))
    let arguments = items_of(field(node, "arguments"))
    if List.length(arguments) == 0 {
        return state
    }
    let path = List.get(arguments, 0)
    if kind_of(path) != "TextLiteral" {
        // The path is computed: only the interpreter can tell whether it is allowed.
        return state
    }
    let text = text_of(field(path, "value"))
    let found = covers(state, kind, text)
    if found.unsupported != "" {
        return unsupported(state, found.unsupported)
    }
    if found.covered or not comparable(state, kind, text) {
        return state
    }
    return report(
        state, "E2026", "This program does not declare that it needs to " + kind + " '" + text + "'",
        "Declare it at the top level of the file: uses " + kind + " \"" + text + "\"", [], span_of(path)
    )
}

// Symbols and warnings

// A name the program declares (a variable, a parameter or the iterator of a `for`), and, apart, every place
// where the checker read it or gave it a new value. Warnings are decided from them once the program is known to
// have no errors.
//
// The same list is what `nex symbols` shows: `ty` is the type the checker gave the name, the scope is the block where it is
// visible (none for a pattern variable, which is declared before its block is entered), and `pattern` marks a name that a pattern
// binds, which no warning is about.
pub type Sym = {
    name: Text, category: Text, mutable: Bool, loop_variable: Bool,
    line: Int, column: Int, end_line: Int, end_column: Int, function: Text,
    ty: Text, scope_line: Int, scope_column: Int, scope_end_line: Int, scope_end_column: Int, pattern: Bool
}

// A place where the checker resolved a use of a name, in the order it met them. `key` is the position of the declaration of a
// variable or a parameter, or the name of the function that a call resolved to; `assign` marks the write of `name = value`.
pub type SymRef = {
    key: Text, function: Bool, assign: Bool, line: Int, column: Int, end_line: Int, end_column: Int
}

type Usage = {
    symbols: List[Sym], reads: List[Text], assigns: List[Text], refs: List[SymRef], scope: parser.Span
}

fn empty_usage() gives Usage {
    return Usage(symbols: [], reads: [], assigns: [], refs: [], scope: parser.no_span())
}

fn with_usage(state: State, usage: Usage) gives State {
    return State(
        problems: state.problems, user: state.user, function: state.function, return_type: state.return_type,
        in_example: state.in_example, unsupported: state.unsupported, tables: state.tables, usage: usage
    )
}

fn symbol_key(line: Int, column: Int) gives Text {
    return to_text(line) + ":" + to_text(column)
}

fn add_symbol(state: State, binding: Binding, scope: parser.Span) gives State {
    if binding.category != "variable" and binding.category != "parameter" {
        return state
    }
    return with_usage(state, with_new_symbol(state.usage, binding, scope, false, state.function))
}

// A name that a pattern binds: no warning is about it, but `nex symbols` lists it.
fn add_pattern_symbol(state: State, binding: Binding) gives State {
    return with_usage(state, with_new_symbol(state.usage, binding, parser.no_span(), true, state.function))
}

fn with_new_symbol(usage: Usage, binding: Binding, scope: parser.Span, pattern: Bool, function: Text) gives Usage {
    let sym = Sym(
        name: binding.name, category: binding.category, mutable: binding.mutable,
        loop_variable: binding.loop_variable, line: binding.line, column: binding.column,
        end_line: binding.end_line, end_column: binding.end_column, function: function,
        ty: binding.ty, scope_line: scope.line, scope_column: scope.column, scope_end_line: scope.end_line,
        scope_end_column: scope.end_column, pattern: pattern
    )
    return Usage(
        symbols: List.append(usage.symbols, sym), reads: usage.reads, assigns: usage.assigns, refs: usage.refs,
        scope: usage.scope
    )
}

fn with_scope(state: State, scope: parser.Span) gives State {
    let usage = state.usage
    return with_usage(
        state, Usage(symbols: usage.symbols, reads: usage.reads, assigns: usage.assigns, refs: usage.refs, scope: scope)
    )
}

fn mark_read(state: State, binding: Binding, at: parser.Span) gives State {
    let usage = state.usage
    return with_usage(
        state,
        Usage(
            symbols: usage.symbols, reads: List.append(usage.reads, symbol_key(binding.line, binding.column)),
            assigns: usage.assigns,
            refs: List.append(
                usage.refs,
                SymRef(
                    key: symbol_key(binding.line, binding.column), function: false, assign: false, line: at.line,
                    column: at.column, end_line: at.end_line, end_column: at.end_column
                )
            ),
            scope: usage.scope
        )
    )
}

fn mark_assigned(state: State, binding: Binding, at: parser.Span) gives State {
    let usage = state.usage
    return with_usage(
        state,
        Usage(
            symbols: usage.symbols, reads: usage.reads,
            assigns: List.append(usage.assigns, symbol_key(binding.line, binding.column)),
            refs: List.append(
                usage.refs,
                SymRef(
                    key: symbol_key(binding.line, binding.column), function: false, assign: true, line: at.line,
                    column: at.column, end_line: at.end_line, end_column: at.end_column
                )
            ),
            scope: usage.scope
        )
    )
}

// A call that resolved to a function of the program.
fn mark_function(state: State, name: Text, at: parser.Span) gives State {
    let usage = state.usage
    return with_usage(
        state,
        Usage(
            symbols: usage.symbols, reads: usage.reads, assigns: usage.assigns,
            refs: List.append(
                usage.refs,
                SymRef(
                    key: name, function: true, assign: false, line: at.line, column: at.column,
                    end_line: at.end_line, end_column: at.end_column
                )
            ),
            scope: usage.scope
        )
    )
}

// The naming convention of every value name: `^_?[a-z][a-z0-9_]*$`.
fn is_snake_case(name: Text) gives Bool {
    var start = 0
    if Text.starts_with(name, "_") {
        start = 1
    }
    if Text.length(name) <= start {
        return false
    }
    let first = Text.slice(name, start, start + 1)
    if first < "a" or first > "z" {
        return false
    }
    var i = start + 1
    while i < Text.length(name)
        shrinks Text.length(name) - i
    {
        let c = Text.slice(name, i, i + 1)
        let valid = (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or c == "_"
        if not valid {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_lower_or_digit(c: Text) gives Bool {
    return (c >= "a" and c <= "z") or (c >= "0" and c <= "9")
}

fn is_upper_letter(c: Text) gives Bool {
    return c >= "A" and c <= "Z"
}

fn is_lower_letter(c: Text) gives Bool {
    return c >= "a" and c <= "z"
}

// Puts an underscore at the boundary between a lower case letter or a digit and an upper case letter
// (`camelCase` becomes `camel_Case`) or, with `acronyms`, between an upper case letter and the start of a word
// that follows another upper case one (`HTTPServer` becomes `HTTP_Server`).
fn insert_boundaries(text: Text, acronyms: Bool) gives Text {
    var result = ""
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        let c = Text.slice(text, i, i + 1)
        if i > 0 {
            let previous = Text.slice(text, i - 1, i)
            if not acronyms and is_lower_or_digit(previous) and is_upper_letter(c) {
                result = result + "_"
            }
            if acronyms and is_upper_letter(previous) and is_upper_letter(c) and i + 1 < Text.length(text) {
                if is_lower_letter(Text.slice(text, i + 1, i + 2)) {
                    result = result + "_"
                }
            }
        }
        result = result + c
        i = i + 1
    }
    return result
}

fn is_name_character(c: Text) gives Bool {
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
}

// Every run of characters that are not letters or digits becomes one underscore.
fn collapse_separators(text: Text) gives Text {
    var result = ""
    var in_run = false
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        let c = Text.slice(text, i, i + 1)
        if is_name_character(c) {
            result = result + c
            in_run = false
        } else if not in_run {
            result = result + "_"
            in_run = true
        }
        i = i + 1
    }
    return result
}

fn strip_underscores(text: Text) gives Text {
    var start = 0
    while start < Text.length(text) and Text.slice(text, start, start + 1) == "_"
        shrinks Text.length(text) - start
    {
        start = start + 1
    }
    var end = Text.length(text)
    while end > start and Text.slice(text, end - 1, end) == "_"
        shrinks end
    {
        end = end - 1
    }
    return Text.slice(text, start, end)
}

// The snake_case spelling suggested for a name that is not snake_case.
fn snake_suggestion(name: Text) gives Text {
    var prefix = ""
    var body = name
    if Text.starts_with(name, "_") {
        prefix = "_"
        body = Text.slice(name, 1, Text.length(name))
    }
    body = insert_boundaries(body, false)
    body = insert_boundaries(body, true)
    body = strip_underscores(collapse_separators(body))
    body = parser.lower_text(body)
    if body == "" {
        body = "value"
    }
    return prefix + body
}

fn warning(code: Text, label: Text, hint: Text, line: Int, column: Int, end_line: Int, end_column: Int) gives parser.Problem {
    return parser.Problem(
        code: code, label: label, hint: hint, notes: [], line: line, column: column,
        end_line: end_line, end_column: end_column
    )
}

fn problem_before(a: parser.Problem, b: parser.Problem) gives Bool {
    if a.line != b.line {
        return a.line < b.line
    }
    if a.column != b.column {
        return a.column < b.column
    }
    return a.code < b.code
}

// A stable sort by position and then by code.
fn sort_problems(problems: List[parser.Problem]) gives List[parser.Problem] {
    var sorted: List[parser.Problem] = []
    for problem in problems {
        var result: List[parser.Problem] = []
        var placed = false
        for existing in sorted {
            if not placed and problem_before(problem, existing) {
                result = List.append(result, problem)
                placed = true
            }
            result = List.append(result, existing)
        }
        if not placed {
            result = List.append(result, problem)
        }
        sorted = result
    }
    return sorted
}

// The warnings of a module that has no errors: a name that is never used, a `var` whose value never changes,
// and a name that does not follow the convention. They describe improvements, not failures.
fn warnings_of(state: State, program: parser.Node) gives List[parser.Problem] {
    var pending: List[parser.Problem] = []
    var public_functions: List[Text] = []
    for function in items_of(field(program, "functions")) {
        if flag_of(field(function, "public")) {
            public_functions = List.append(public_functions, text_of(field(function, "name")))
        }
    }
    for sym in state.usage.symbols {
        if sym.name != "_" and not sym.pattern {
            var kind = "variable"
            if sym.category == "parameter" {
                kind = "parameter"
            } else if sym.loop_variable {
                kind = "iterator"
            }
            let key = symbol_key(sym.line, sym.column)
            if not List.contains(state.usage.reads, key) {
                var hint = "Remove it, or use its value in an expression."
                if kind == "parameter" {
                    hint = "Remove it, or use it in the body. Name it '_' if the signature must keep the position."
                } else if kind == "iterator" {
                    hint = "Remove it, or use it in the body of the loop."
                }
                pending = List.append(
                    pending,
                    warning(
                        "W2001", "The " + kind + " '" + sym.name + "' is never used", hint,
                        sym.line, sym.column, sym.end_line, sym.end_column
                    )
                )
            } else if sym.mutable and not List.contains(state.usage.assigns, key) {
                pending = List.append(
                    pending,
                    warning(
                        "W2002", "'" + sym.name + "' is declared with 'var' but is never reassigned",
                        "Declare it with 'let': its value never changes.",
                        sym.line, sym.column, sym.end_line, sym.end_column
                    )
                )
            }
            // A parameter of a public function is part of what another module sees, so its spelling is left alone.
            let exempt = sym.category == "parameter" and List.contains(public_functions, sym.function)
            if not exempt and not is_snake_case(sym.name) {
                pending = List.append(
                    pending,
                    warning(
                        "W2003", "The " + kind + " name '" + sym.name + "' does not follow snake_case",
                        "Write it as '" + snake_suggestion(sym.name) + "'.",
                        sym.line, sym.column, sym.end_line, sym.end_column
                    )
                )
            }
        }
    }
    for function in items_of(field(program, "functions")) {
        let name = text_of(field(function, "name"))
        // Public names belong to every module that imports this one.
        if not flag_of(field(function, "public")) and name != "_" and not is_snake_case(name) {
            let at = place_span(field(function, "name_span"))
            pending = List.append(
                pending,
                warning(
                    "W2003", "The function name '" + name + "' does not follow snake_case",
                    "Write it as '" + snake_suggestion(name) + "'.", at.line, at.column, at.end_line, at.end_column
                )
            )
        }
    }
    return sort_problems(pending)
}

// What the interpreter needs from the analysis of a program: the typed tree, the problems found and, when the
// checker met something it does not know yet, what it was.
pub type Analysis = { node: parser.Node, problems: List[parser.Problem], unsupported: Text }

// One module of a project: what analyze gives, and what the modules that import it need.
pub type ModuleAnalysis = {
    node: parser.Node, problems: List[parser.Problem], unsupported: Text, export: Export, symbols: List[Sym],
    refs: List[SymRef]
}

// `warn` is false when a module before this one had an error: a warning only helps in a program that is correct.
pub fn analyze_module(
    program: parser.Node, name: Text, require_main: Bool, warn: Bool, imports: List[Export], modules: List[Text]
) gives ModuleAnalysis {
    let result = check_with(program, require_main, warn, imports, modules)
    return ModuleAnalysis(
        node: result.node, problems: result.state.problems, unsupported: result.state.unsupported,
        export: export_module(result.state, program, name), symbols: result.state.usage.symbols,
        refs: result.state.usage.refs
    )
}

pub fn analyze(program: parser.Node, require_main: Bool) gives Analysis {
    let result = check_program(program, require_main)
    return Analysis(node: result.node, problems: result.state.problems, unsupported: result.state.unsupported)
}

// Test driver: every argument after the first is a file. For each one prints `FILE|path` and then
// SKIP when it has lexical or syntax errors, UNSUPPORTED when the checker meets something it does not
// know yet, or the typed tree and the errors found (the format selfhost/compare_checker.py reads).
fn run_checks() {
    let files = args()
    var i = 1
    while i < List.length(files)
        shrinks List.length(files) - i
    {
        let path = List.get(files, i)
        print("FILE|" + path)
        let lexed = lexer.tokenize(read_file(path))
        if List.length(lexed.diagnostics) > 0 {
            print("SKIP|lexical")
        } else {
            let outcome = parser.parse_program(lexed.tokens)
            if List.length(outcome.diagnostics) > 0 {
                print("SKIP|syntax")
            } else {
                let result = check_program(outcome.program, true)
                if result.state.unsupported != "" {
                    print("UNSUPPORTED|" + result.state.unsupported)
                } else {
                    print("CHECKED|" + parser.to_json(result.node))
                    var shown = 0
                    for problem in result.state.problems {
                        if shown < 100 or Text.starts_with(problem.code, "W") {
                            var place_text = ""
                            if problem.line > 0 {
                                place_text = parser.span_text(problem.line, problem.column, problem.end_line, problem.end_column)
                            }
                            print(
                                "D|" + problem.code + "|" + problem.label + "|" + problem.hint + "|"
                                + parser.join_texts(problem.notes, "~~") + "|" + place_text
                            )
                        }
                        shown = shown + 1
                    }
                }
            }
        }
        i = i + 1
    }
}

fn main() {
    run_checks()
}
