type P = { x: Int, y: Int }
type Shape = enum { Dot(p: P), Line(a: P, b: P), Empty }

fn size(s: Shape) gives Int {
    return match s {
        Shape.Dot(p) => p.x + p.y
        Shape.Line(a, b) => (b.x - a.x) * (b.y - a.y)
        Shape.Empty => 0
    }
}

fn main() {
    var i = 0
    var total = 0
    while i < 20000
        shrinks 20000 - i
    {
        let a = P(x: i, y: i + 1)
        let b = P(x: i + 3, y: i + 5)
        total = total + size(Shape.Dot(a)) + size(Shape.Line(a, b)) + size(Shape.Empty())
        i = i + 1
    }
    print(total)
}
