fn find(xs: List[Int], wanted: Int) gives Option[Int] {
    var i = 0
    while i < List.length(xs)
        shrinks List.length(xs) - i
    {
        if List.get(xs, i) == wanted {
            return Some(i)
        }
        i = i + 1
    }
    return None
}

fn half(n: Int) gives Result[Int, Text] {
    if n / 2 * 2 == n {
        return Ok(n / 2)
    }
    return Err("odd: " + to_text(n))
}

fn main() {
    print(find([4, 5, 6], 6))
    print(find([4, 5, 6], 9))
    print(half(8))
    print(half(7))
    print(Option.is_some(find([1], 1)))
    print(Option.value_or(find([1], 5), 0 - 1))
    print(Result.value_or(half(3), 0))
    print(Result.is_err(half(3)))
    if let Some(i) = find([9, 8], 8) {
        print("found at " + to_text(i))
    } else {
        print("missing")
    }
    match half(10) {
        Ok(v) => print(v)
        Err(e) => print(e)
    }
    match half(11) {
        Ok(v) => print(v)
        Err(e) => print(e)
    }
}
