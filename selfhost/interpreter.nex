// The NEXORA interpreter, written in NEXORA (decision 0024, stage 2).
//
// It runs the typed tree the checker gives (checker.nex) and follows nexora/src/nexora/interpreter.py.
//
// The interpreter is an abstract machine with an explicit stack of continuations. A tree-walking evaluator
// written with recursive calls would spend several calls of its own for each call of the program it runs, and
// the language limits the nesting of calls to 1000: a recursive program that nests 1000 calls would reach
// that limit after about 250. Here the depth of the program does not use the depth of the interpreter: what
// is left to do after a call returns is kept in a linked stack, which can be as deep as memory allows, and a
// push or a pop costs one step.
//
// A machine has a control (what it does now), an environment (the visible names), a stack and the output.
// Every step moves it one transition; the loop that runs it is bounded by a fuel that goes down on every step.
//
// It runs expressions, statements, functions, records, enums, Option and Result, `match`, refined checks, the
// contracts of the functions (`needs` and `guarantees`), the clauses of the loops (`invariants` and `shrinks`) and the
// pure built-ins, and it stops with the same diagnostic as the Python interpreter when the program breaks one
// of them. It does not run the examples, the host functions (files, input, network, processes) or the limits
// of resources.

import "lexer.nex"
import "parser.nex"
import "checker.nex"

uses read "."
uses write "."

// Values

type Val = enum {
    VInt(v: Int), VFloat(v: Float), VText(v: Text), VBool(v: Bool), VUnit,
    VList(items: List[Val]),
    VRecord(name: Text, names: List[Text], vals: List[Val]),
    VVariant(owner: Text, kind: Text, items: List[Val])
}

// A scope: the names it declares and their values.
type Frame = { names: List[Text], vals: List[Val] }

// What the machine does now. A failure holds the whole diagnostic.
type Control = enum {
    CEval(node: parser.Node), CExec(node: parser.Node), CValue(v: Val), CReturn(v: Val), CHalt, CDone(v: Val),
    CFail(problem: parser.Problem)
}

// What is left to do when a value arrives.
type Kont = enum {
    KUnary(node: parser.Node),
    KBinLeft(node: parser.Node),
    KBinRight(node: parser.Node, left: Val),
    KArgs(node: parser.Node, done: List[Val]),
    KField(node: parser.Node),
    KMatch(node: parser.Node),
    KPopFrame,
    KSeq(statements: List[parser.Node], next: Int),
    KLet(node: parser.Node),
    KAssign(node: parser.Node),
    KReturn,
    KIf(node: parser.Node),
    KWhileKeep(node: parser.Node, turn: Int, previous: Option[Int], index: Int),
    KWhileCond(node: parser.Node, turn: Int, previous: Option[Int]),
    KWhileMeasure(node: parser.Node, turn: Int, previous: Option[Int]),
    KWhileBody(node: parser.Node, turn: Int, previous: Option[Int]),
    KForStart(node: parser.Node),
    KForKeep(node: parser.Node, items: List[Val], turn: Int, index: Int),
    KForBody(node: parser.Node, items: List[Val], turn: Int),
    KIfLet(node: parser.Node),
    KDiscard,
    KNeeds(function: parser.Node, frame: Frame, site: parser.Span, index: Int),
    KCall(saved: List[Frame], name: Text, site: parser.Span, function: parser.Node, frame: Frame),
    KPromise(function: parser.Node, frame: Frame, returned: Val, index: Int),
    KRet(saved: List[Frame], name: Text, site: parser.Span),
    KHalt
}

type Stk = enum { Nil, Cons(top: Kont, rest: Stk) }

type Machine = {
    control: Control, env: List[Frame], stack: Stk, out: List[Text], depth: Int, fuel: Int, tracing: Tracing
}

// What the program declares, indexed once.
type Prog = {
    fn_names: List[Text], fn_nodes: List[parser.Node],
    record_names: List[Text], record_fields: List[List[Text]],
    type_names: List[Text], type_nodes: List[parser.Node], host: HostCfg
}

// Reading the tree

fn kind_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Obj(kind, names, values) => kind
        _ => ""
    }
}

fn index_of(names: List[Text], name: Text) gives Int {
    var i = 0
    while i < List.length(names)
        shrinks List.length(names) - i
    {
        if List.get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn field(node: parser.Node, name: Text) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => field_at(names, values, name)
        _ => parser.Node.Null()
    }
}

fn field_at(names: List[Text], values: List[parser.Node], name: Text) gives parser.Node {
    let index = index_of(names, name)
    if index < 0 {
        return parser.Node.Null()
    }
    return List.get(values, index)
}

fn text_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Str(value) => value
        _ => ""
    }
}

fn int_of(node: parser.Node) gives Int {
    return match node {
        parser.Node.Whole(value) => value
        _ => 0
    }
}

fn real_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Real(text) => text
        _ => "0.0"
    }
}

fn flag_of(node: parser.Node) gives Bool {
    return match node {
        parser.Node.Flag(value) => value
        _ => false
    }
}

fn items_of(node: parser.Node) gives List[parser.Node] {
    return match node {
        parser.Node.Items(items) => items
        _ => []
    }
}

fn is_null(node: parser.Node) gives Bool {
    return match node {
        parser.Node.Null => true
        _ => false
    }
}

fn place_of(node: parser.Node) gives parser.Span {
    return place_in(node, "span")
}

// The span stored in a field that holds a place (`span`, `name_span`, `operator_span`...).
fn place_in(node: parser.Node, name: Text) gives parser.Span {
    return match field(node, name) {
        parser.Node.Place(line, column, end_line, end_column) => parser.Span(
            line: line, column: column, end_line: end_line, end_column: end_column
        )
        _ => parser.no_span()
    }
}

// The program

fn build_prog(program: parser.Node, host: HostCfg) gives Prog {
    var fn_names: List[Text] = []
    var fn_nodes: List[parser.Node] = []
    for function in items_of(field(program, "functions")) {
        let name = text_of(field(function, "name"))
        if index_of(fn_names, name) < 0 {
            fn_names = List.append(fn_names, name)
            fn_nodes = List.append(fn_nodes, function)
        }
    }
    var record_names: List[Text] = []
    var record_fields: List[List[Text]] = []
    for record in items_of(field(program, "records")) {
        var names: List[Text] = []
        for declared in items_of(field(record, "fields")) {
            names = List.append(names, text_of(field(declared, "name")))
        }
        record_names = List.append(record_names, text_of(field(record, "name")))
        record_fields = List.append(record_fields, names)
    }
    var type_names: List[Text] = []
    var type_nodes: List[parser.Node] = []
    for declaration in items_of(field(program, "types")) {
        type_names = List.append(type_names, text_of(field(declaration, "name")))
        type_nodes = List.append(type_nodes, declaration)
    }
    return Prog(
        fn_names: fn_names, fn_nodes: fn_nodes, record_names: record_names, record_fields: record_fields,
        type_names: type_names, type_nodes: type_nodes, host: host
    )
}

// The clauses of a function header of one kind (`needs` or `guarantees`), in the order they are written.
fn clauses_of(function: parser.Node, clause: Text) gives List[parser.Node] {
    var found: List[parser.Node] = []
    for item in items_of(field(function, "header")) {
        if kind_of(item) == "Contract" and text_of(field(item, "clause")) == clause {
            found = List.append(found, item)
        }
    }
    return found
}

// The clauses of a loop header of one kind (`invariants` or `shrinks`).
fn loop_clauses(loop: parser.Node, clause: Text) gives List[parser.Node] {
    var found: List[parser.Node] = []
    for item in items_of(field(loop, "clauses")) {
        if text_of(field(item, "clause")) == clause {
            found = List.append(found, item)
        }
    }
    return found
}

// Values: showing and comparing

fn join_vals(items: List[Val]) gives Text {
    var shown: List[Text] = []
    for item in items {
        shown = List.append(shown, format_val(item))
    }
    return parser.join_texts(shown, ", ")
}

fn join_shown(items: List[Val]) gives Text {
    var shown: List[Text] = []
    for item in items {
        shown = List.append(shown, show_val(item))
    }
    return parser.join_texts(shown, ", ")
}

// The text `print` writes for a value, and what `to_text` returns.
fn format_val(v: Val) gives Text {
    return match v {
        Val.VInt(n) => to_text(n)
        Val.VFloat(x) => to_text(x)
        Val.VText(t) => t
        Val.VBool(b) => to_text(b)
        Val.VUnit => ""
        Val.VList(items) => "[" + join_vals(items) + "]"
        Val.VRecord(name, names, vals) => format_record(name, names, vals, false)
        Val.VVariant(owner, kind, items) => format_variant(owner, kind, items, false)
    }
}

// A value as it would be written in source code, for diagnostics: Text is quoted.
fn show_val(v: Val) gives Text {
    return match v {
        Val.VText(t) => parser.quote(t)
        Val.VList(items) => "[" + join_shown(items) + "]"
        Val.VRecord(name, names, vals) => format_record(name, names, vals, true)
        Val.VVariant(owner, kind, items) => format_variant(owner, kind, items, true)
        _ => format_val(v)
    }
}

fn shown_or_formatted(v: Val, shown: Bool) gives Text {
    if shown {
        return show_val(v)
    }
    return format_val(v)
}

fn format_record(name: Text, names: List[Text], vals: List[Val], shown: Bool) gives Text {
    var fields: List[Text] = []
    var i = 0
    while i < List.length(names)
        shrinks List.length(names) - i
    {
        fields = List.append(fields, List.get(names, i) + ": " + shown_or_formatted(List.get(vals, i), shown))
        i = i + 1
    }
    return name + "(" + parser.join_texts(fields, ", ") + ")"
}

fn format_variant(owner: Text, kind: Text, items: List[Val], shown: Bool) gives Text {
    var inner: List[Text] = []
    for item in items {
        inner = List.append(inner, shown_or_formatted(item, shown))
    }
    let payload = parser.join_texts(inner, ", ")
    if owner != "" {
        if List.length(items) == 0 {
            return owner + "." + kind
        }
        return owner + "." + kind + "(" + payload + ")"
    }
    if kind == "None" {
        return "None"
    }
    return kind + "(" + payload + ")"
}

fn vals_equal(a: Val, b: Val) gives Bool {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => x == y
            _ => false
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => x == y
            _ => false
        }
        Val.VText(x) => match b {
            Val.VText(y) => x == y
            _ => false
        }
        Val.VBool(x) => match b {
            Val.VBool(y) => x == y
            _ => false
        }
        Val.VUnit => true
        Val.VList(xs) => match b {
            Val.VList(ys) => all_equal(xs, ys)
            _ => false
        }
        Val.VRecord(n1, names1, vals1) => match b {
            Val.VRecord(n2, names2, vals2) => n1 == n2 and all_equal(vals1, vals2)
            _ => false
        }
        Val.VVariant(o1, k1, i1) => match b {
            Val.VVariant(o2, k2, i2) => o1 == o2 and k1 == k2 and all_equal(i1, i2)
            _ => false
        }
    }
}

fn all_equal(xs: List[Val], ys: List[Val]) gives Bool {
    if List.length(xs) != List.length(ys) {
        return false
    }
    var i = 0
    while i < List.length(xs)
        shrinks List.length(xs) - i
    {
        if not vals_equal(List.get(xs, i), List.get(ys, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn vals_less(a: Val, b: Val) gives Bool {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => x < y
            _ => false
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => x < y
            _ => false
        }
        Val.VText(x) => match b {
            Val.VText(y) => x < y
            _ => false
        }
        _ => false
    }
}

fn truth(v: Val) gives Bool {
    return match v {
        Val.VBool(b) => b
        _ => false
    }
}

// The result of an operation that may fail. `points_at` says what the error points at: the call or operator itself
// ("node"), its first argument ("arg0") or the right side of a division ("right").
type Res = { ok: Bool, val: Val, code: Text, label: Text, hint: Text, notes: List[Text], points_at: Text }

fn good(v: Val) gives Res {
    return Res(ok: true, val: v, code: "", label: "", hint: "", notes: [], points_at: "node")
}

fn bad(code: Text, label: Text) gives Res {
    return Res(ok: false, val: Val.VUnit(), code: code, label: label, hint: "", notes: [], points_at: "node")
}

fn bad_at(code: Text, label: Text, hint: Text, notes: List[Text], points_at: Text) gives Res {
    return Res(ok: false, val: Val.VUnit(), code: code, label: label, hint: hint, notes: notes, points_at: points_at)
}

fn int_max() gives Int {
    return 9223372036854775807
}

fn int_min() gives Int {
    return 0 - 9223372036854775807 - 1
}

fn int_range_hint() gives Text {
    return "Int holds whole numbers from -9223372036854775808 to 9223372036854775807."
}

fn add_overflows(a: Int, b: Int) gives Bool {
    return (b > 0 and a > int_max() - b) or (b < 0 and a < int_min() - b)
}

fn subtract_overflows(a: Int, b: Int) gives Bool {
    return (b < 0 and a > int_max() + b) or (b > 0 and a < int_min() + b)
}

fn multiply_overflows(a: Int, b: Int) gives Bool {
    if a == 0 or b == 0 {
        return false
    }
    if a > 0 and b > 0 {
        return a > int_max() / b
    }
    if a > 0 and b < 0 {
        return b < int_min() / a
    }
    if a < 0 and b > 0 {
        return a < int_min() / b
    }
    return a < int_max() / b
}

fn int_overflow() gives Res {
    return bad_at("E3002", "The result of this operation does not fit in an Int", int_range_hint(), [], "node")
}

fn int_operation(operator: Text, a: Int, b: Int) gives Res {
    if operator == "+" {
        if add_overflows(a, b) {
            return int_overflow()
        }
        return good(Val.VInt(a + b))
    }
    if operator == "-" {
        if subtract_overflows(a, b) {
            return int_overflow()
        }
        return good(Val.VInt(a - b))
    }
    if operator == "*" {
        if multiply_overflows(a, b) {
            return int_overflow()
        }
        return good(Val.VInt(a * b))
    }
    if b == 0 {
        return bad_at("E3001", "The right-hand side of this division is zero", "", [], "right")
    }
    if a == int_min() and b == 0 - 1 {
        return int_overflow()
    }
    return good(Val.VInt(a / b))
}

fn float_operation(operator: Text, a: Float, b: Float) gives Res {
    if operator == "+" {
        return good(Val.VFloat(a + b))
    }
    if operator == "-" {
        return good(Val.VFloat(a - b))
    }
    if operator == "*" {
        return good(Val.VFloat(a * b))
    }
    if b == 0.0 {
        return bad_at("E3001", "The right-hand side of this division is zero", "", [], "right")
    }
    return good(Val.VFloat(a / b))
}

fn arithmetic(operator: Text, a: Val, b: Val) gives Res {
    return match a {
        Val.VInt(x) => match b {
            Val.VInt(y) => int_operation(operator, x, y)
            _ => bad("E0000", "mixed operands")
        }
        Val.VFloat(x) => match b {
            Val.VFloat(y) => float_operation(operator, x, y)
            _ => bad("E0000", "mixed operands")
        }
        Val.VText(x) => match b {
            Val.VText(y) => good(Val.VText(x + y))
            _ => bad("E0000", "mixed operands")
        }
        _ => bad("E0000", "arithmetic on a value that is not a number or a text")
    }
}

fn binary_value(operator: Text, a: Val, b: Val) gives Res {
    if operator == "==" {
        return good(Val.VBool(vals_equal(a, b)))
    }
    if operator == "!=" {
        return good(Val.VBool(not vals_equal(a, b)))
    }
    if operator == "<" {
        return good(Val.VBool(vals_less(a, b)))
    }
    if operator == ">" {
        return good(Val.VBool(vals_less(b, a)))
    }
    if operator == "<=" {
        return good(Val.VBool(not vals_less(b, a)))
    }
    if operator == ">=" {
        return good(Val.VBool(not vals_less(a, b)))
    }
    return arithmetic(operator, a, b)
}

// The machine

fn nil_stack() gives Stk {
    return Stk.Nil()
}

fn push(k: Kont, rest: Stk) gives Stk {
    return Stk.Cons(k, rest)
}

fn is_nil(stack: Stk) gives Bool {
    return match stack {
        Stk.Nil => true
        _ => false
    }
}

fn stack_top(stack: Stk) gives Kont {
    return match stack {
        Stk.Nil => Kont.KHalt()
        Stk.Cons(top, rest) => top
    }
}

fn stack_rest(stack: Stk) gives Stk {
    return match stack {
        Stk.Nil => Stk.Nil()
        Stk.Cons(top, rest) => rest
    }
}

// The machine after one more step: the fuel always goes down, which is what makes the loop end.
fn mk(m: Machine, control: Control, env: List[Frame], stack: Stk) gives Machine {
    return Machine(
        control: control, env: env, stack: stack, out: m.out, depth: m.depth, fuel: m.fuel - 1, tracing: m.tracing
    )
}

fn mk_depth(m: Machine, control: Control, env: List[Frame], stack: Stk, depth: Int) gives Machine {
    return Machine(
        control: control, env: env, stack: stack, out: m.out, depth: depth, fuel: m.fuel - 1, tracing: m.tracing
    )
}

fn mk_out(m: Machine, control: Control, stack: Stk, out: List[Text]) gives Machine {
    return Machine(
        control: control, env: m.env, stack: stack, out: out, depth: m.depth, fuel: m.fuel - 1, tracing: m.tracing
    )
}

// Failures: the diagnostic, with the chain of calls and the loops that led to it as notes

fn max_trace() gives Int {
    return 6
}

type CallInfo = { is_call: Bool, name: Text, site: parser.Span }

fn call_info(top: Kont) gives CallInfo {
    return match top {
        Kont.KCall(saved, name, site, function, frame) => CallInfo(is_call: true, name: name, site: site)
        Kont.KRet(saved, name, site) => CallInfo(is_call: true, name: name, site: site)
        _ => CallInfo(is_call: false, name: "", site: parser.no_span())
    }
}

fn line_text(node: parser.Node) gives Text {
    let at = place_of(node)
    return to_text(at.line)
}

// Where in a loop a condition is evaluated: before the first turn, or after the turn that just ended.
fn when_note(node: parser.Node, turn: Int) gives Text {
    if turn == 0 {
        return "Before the first turn of the loop at line " + line_text(node) + "."
    }
    return "After turn " + to_text(turn) + " of the loop at line " + line_text(node) + "."
}

// The note a loop adds to an error that leaves it, or nothing for a frame that is not a loop.
fn loop_note(top: Kont) gives Text {
    return match top {
        Kont.KWhileKeep(node, turn, previous, index) => when_note(node, turn)
        Kont.KWhileCond(node, turn, previous) => when_note(node, turn)
        Kont.KWhileMeasure(node, turn, previous) => "Before turn " + to_text(turn) + " of the loop at line " + line_text(node) + "."
        Kont.KWhileBody(node, turn, previous) => "In turn " + to_text(turn) + " of the loop at line " + line_text(node) + "."
        Kont.KForKeep(node, items, turn, index) => when_note(node, turn)
        Kont.KForBody(node, items, turn) => "In turn " + to_text(turn) + " of the loop at line " + line_text(node) + "."
        _ => ""
    }
}

fn call_text(name: Text, site: parser.Span) gives Text {
    return "In '" + name + "', called at line " + to_text(site.line) + ", column " + to_text(site.column) + "."
}

fn is_loop_note(note: Text) gives Bool {
    return Text.contains(note, " of the loop at line ")
}

fn count_loop_notes(notes: List[Text]) gives Int {
    var count = 0
    for note in notes {
        if is_loop_note(note) {
            count = count + 1
        }
    }
    return count
}

// The notes of an error: its own, the calls that led to it (innermost first, the first `skip_calls` left out) and
// the loops it left (innermost first). Both lists are cut at six entries, as the Python interpreter cuts them.
fn all_notes(stack: Stk, skip_calls: Int, own: List[Text]) gives List[Text] {
    var calls: List[Text] = []
    var total = 0
    var skipped = 0
    var loops: List[Text] = []
    var loop_count = count_loop_notes(own)
    var more_added = false
    var current = stack
    var guard = 100000000
    while not is_nil(current) and guard > 0
        shrinks guard
    {
        guard = guard - 1
        let top = stack_top(current)
        let info = call_info(top)
        if info.is_call {
            if skipped < skip_calls {
                skipped = skipped + 1
            } else if info.site.line > 0 {
                total = total + 1
                if total <= max_trace() {
                    calls = List.append(calls, call_text(info.name, info.site))
                }
            }
        } else {
            let note = loop_note(top)
            if note != "" and not more_added {
                if loop_count < max_trace() {
                    loops = List.append(loops, note)
                    loop_count = loop_count + 1
                } else {
                    loops = List.append(loops, "... and more loops.")
                    more_added = true
                }
            }
        }
        current = stack_rest(current)
    }
    var trace = calls
    if total > max_trace() {
        let hidden = total - max_trace()
        var plural = "s"
        if hidden == 1 {
            plural = ""
        }
        trace = List.append(trace, "... and " + to_text(hidden) + " more call" + plural + ".")
    }
    return List.concat(List.concat(own, trace), loops)
}

fn problem_at(code: Text, label: Text, hint: Text, notes: List[Text], span: parser.Span) gives parser.Problem {
    return parser.Problem(
        code: code, label: label, hint: hint, notes: notes, line: span.line, column: span.column,
        end_line: span.end_line, end_column: span.end_column
    )
}

// The machine stopped by an error, with the calls and loops of `stack` as notes.
fn stop_with(
    m: Machine, stack: Stk, skip_calls: Int, code: Text, label: Text, hint: Text, own: List[Text], span: parser.Span
) gives Machine {
    let problem = problem_at(code, label, hint, all_notes(stack, skip_calls, own), span)
    return mk(m, Control.CFail(problem), m.env, m.stack)
}

fn fail_at(m: Machine, code: Text, label: Text, span: parser.Span) gives Machine {
    return stop_with(m, m.stack, 0, code, label, "", [], span)
}

// The span an operation's error points at.
fn res_span(res: Res, node: parser.Node) gives parser.Span {
    if res.points_at == "right" {
        return place_of(field(node, "right"))
    }
    if res.points_at == "arg0" {
        let arguments = items_of(field(node, "arguments"))
        if List.length(arguments) > 0 {
            return place_of(List.get(arguments, 0))
        }
    }
    return place_of(node)
}

fn failed(m: Machine, res: Res, node: parser.Node) gives Machine {
    return stop_with(m, m.stack, 0, res.code, res.label, res.hint, res.notes, res_span(res, node))
}

// Environment

fn empty_frame() gives Frame {
    return Frame(names: [], vals: [])
}

fn lookup(env: List[Frame], name: Text) gives Val {
    var i = List.length(env) - 1
    while i >= 0
        shrinks i + 1
    {
        let frame = List.get(env, i)
        let at = index_of(frame.names, name)
        if at >= 0 {
            return List.get(frame.vals, at)
        }
        i = i - 1
    }
    return Val.VUnit()
}

fn has_name(env: List[Frame], name: Text) gives Bool {
    for frame in env {
        if index_of(frame.names, name) >= 0 {
            return true
        }
    }
    return false
}

fn declare(env: List[Frame], name: Text, value: Val) gives List[Frame] {
    let last = List.length(env) - 1
    if last < 0 {
        return [Frame(names: [name], vals: [value])]
    }
    var returned: List[Frame] = []
    var i = 0
    while i < List.length(env)
        shrinks List.length(env) - i
    {
        let frame = List.get(env, i)
        if i == last {
            returned = List.append(returned, Frame(names: List.append(frame.names, name), vals: List.append(frame.vals, value)))
        } else {
            returned = List.append(returned, frame)
        }
        i = i + 1
    }
    return returned
}

fn replace_val(vals: List[Val], at: Int, value: Val) gives List[Val] {
    var returned: List[Val] = []
    var i = 0
    while i < List.length(vals)
        shrinks List.length(vals) - i
    {
        if i == at {
            returned = List.append(returned, value)
        } else {
            returned = List.append(returned, List.get(vals, i))
        }
        i = i + 1
    }
    return returned
}

// Gives a new value to the innermost variable with that name.
fn assign(env: List[Frame], name: Text, value: Val) gives List[Frame] {
    var found = 0 - 1
    var i = List.length(env) - 1
    while i >= 0 and found < 0
        shrinks i + 1
    {
        let candidate = List.get(env, i)
        if index_of(candidate.names, name) >= 0 {
            found = i
        }
        i = i - 1
    }
    if found < 0 {
        return env
    }
    var returned: List[Frame] = []
    var j = 0
    while j < List.length(env)
        shrinks List.length(env) - j
    {
        let frame = List.get(env, j)
        if j == found {
            let at = index_of(frame.names, name)
            returned = List.append(returned, Frame(names: frame.names, vals: replace_val(frame.vals, at, value)))
        } else {
            returned = List.append(returned, frame)
        }
        j = j + 1
    }
    return returned
}

fn drop_frame(env: List[Frame]) gives List[Frame] {
    var returned: List[Frame] = []
    var i = 0
    while i < List.length(env) - 1
        shrinks List.length(env) - i
    {
        returned = List.append(returned, List.get(env, i))
        i = i + 1
    }
    return returned
}

fn push_frame(env: List[Frame], frame: Frame) gives List[Frame] {
    return List.append(env, frame)
}

// "The values: a = 1, b = 2": every name visible, in the order they were declared.
fn values_note(env: List[Frame]) gives List[Text] {
    var pairs: List[Text] = []
    for frame in env {
        var i = 0
        while i < List.length(frame.names)
            shrinks List.length(frame.names) - i
        {
            pairs = List.append(pairs, List.get(frame.names, i) + " = " + show_val(List.get(frame.vals, i)))
            i = i + 1
        }
    }
    if List.length(pairs) == 0 {
        return []
    }
    return ["The values: " + parser.join_texts(pairs, ", ")]
}

// "It was called with: a = 1, b = 2"
fn called_with(function: parser.Node, frame: Frame) gives List[Text] {
    if List.length(frame.names) == 0 {
        return []
    }
    var pairs: List[Text] = []
    var i = 0
    while i < List.length(frame.names)
        shrinks List.length(frame.names) - i
    {
        pairs = List.append(pairs, List.get(frame.names, i) + " = " + show_val(List.get(frame.vals, i)))
        i = i + 1
    }
    return ["It was called with: " + parser.join_texts(pairs, ", ")]
}

// Patterns

type Bound = { ok: Bool, names: List[Text], vals: List[Val] }

fn no_match() gives Bound {
    return Bound(ok: false, names: [], vals: [])
}

fn literal_val(value: parser.Node) gives Val {
    return match value {
        parser.Node.Flag(b) => Val.VBool(b)
        parser.Node.Whole(n) => Val.VInt(n)
        parser.Node.Real(text) => Val.VFloat(Float.parse(text))
        parser.Node.Str(text) => Val.VText(text)
        _ => Val.VUnit()
    }
}

fn variant_kind(v: Val) gives Text {
    return match v {
        Val.VVariant(owner, kind, items) => kind
        _ => ""
    }
}

fn variant_items(v: Val) gives List[Val] {
    return match v {
        Val.VVariant(owner, kind, items) => items
        _ => []
    }
}

// Whether a value matches a pattern, and the names it binds.
fn match_pattern(pattern: parser.Node, v: Val) gives Bound {
    let kind = kind_of(pattern)
    if kind == "WildcardPattern" {
        return Bound(ok: true, names: [], vals: [])
    }
    if kind == "BindingPattern" {
        return Bound(ok: true, names: [text_of(field(pattern, "name"))], vals: [v])
    }
    if kind == "LiteralPattern" {
        return Bound(ok: vals_equal(literal_val(field(pattern, "value")), v), names: [], vals: [])
    }
    if variant_kind(v) != text_of(field(pattern, "name")) {
        return no_match()
    }
    let arguments = items_of(field(pattern, "arguments"))
    let items = variant_items(v)
    var names: List[Text] = []
    var vals: List[Val] = []
    var i = 0
    while i < List.length(arguments)
        shrinks List.length(arguments) - i
    {
        let inner = match_pattern(List.get(arguments, i), List.get(items, i))
        if not inner.ok {
            return no_match()
        }
        names = List.concat(names, inner.names)
        vals = List.concat(vals, inner.vals)
        i = i + 1
    }
    return Bound(ok: true, names: names, vals: vals)
}

// Built-in functions

fn text_val(v: Val) gives Text {
    return match v {
        Val.VText(t) => t
        _ => ""
    }
}

fn int_val(v: Val) gives Int {
    return match v {
        Val.VInt(n) => n
        _ => 0
    }
}

fn float_val(v: Val) gives Float {
    return match v {
        Val.VFloat(x) => x
        _ => 0.0
    }
}

fn list_val(v: Val) gives List[Val] {
    return match v {
        Val.VList(items) => items
        _ => []
    }
}

fn some_val(v: Val) gives Val {
    return Val.VVariant("", "Some", [v])
}

fn none_val() gives Val {
    return Val.VVariant("", "None", [])
}

// The grammar of a number written in a text, as the hints of Int.parse and Float.parse use it.
fn digits_end(text: Text, start: Int) gives Int {
    var i = start
    while i < Text.length(text) and Text.slice(text, i, i + 1) >= "0" and Text.slice(text, i, i + 1) <= "9"
        shrinks Text.length(text) - i
    {
        i = i + 1
    }
    return i
}

fn is_integer_text(text: Text) gives Bool {
    var start = 0
    if Text.starts_with(text, "-") {
        start = 1
    }
    let end = digits_end(text, start)
    return end > start and end == Text.length(text)
}

// `e5`, `E-3`: an exponent that ends the text.
fn is_exponent_text(text: Text, start: Int) gives Bool {
    if start >= Text.length(text) or (Text.slice(text, start, start + 1) != "e" and Text.slice(text, start, start + 1) != "E") {
        return false
    }
    var from = start + 1
    if from < Text.length(text) and (Text.slice(text, from, from + 1) == "+" or Text.slice(text, from, from + 1) == "-") {
        from = from + 1
    }
    let end = digits_end(text, from)
    return end > from and end == Text.length(text)
}

fn is_decimal_text(text: Text) gives Bool {
    var start = 0
    if Text.starts_with(text, "-") {
        start = 1
    }
    let integer_end = digits_end(text, start)
    if integer_end == start {
        return false
    }
    if is_exponent_text(text, integer_end) {
        return true
    }
    if integer_end < Text.length(text) and Text.slice(text, integer_end, integer_end + 1) == "." {
        let fraction_end = digits_end(text, integer_end + 1)
        if fraction_end == integer_end + 1 {
            return false
        }
        return fraction_end == Text.length(text) or is_exponent_text(text, fraction_end)
    }
    return false
}

fn parse_hint(callee: Text, text: Text) gives Text {
    if callee == "Int.parse" {
        if is_integer_text(text) {
            return int_range_hint()
        }
        return "Check the text first with Int.can_parse(...), and call Int.parse only when it is true."
    }
    if is_integer_text(text) {
        return "This text is a whole number: read it with to_float(Int.parse(...))."
    }
    if is_decimal_text(text) {
        return "The number is too large for a Float."
    }
    return "Check the text first with Float.can_parse(...), and call Float.parse only when it is true."
}

// A `needs` of a built-in function that is false: the same E4001 as for a function of the program.
fn broken_needs(callee: Text, condition: Text, reason: Text, params: List[Text], a: List[Val], hint: Text) gives Res {
    var pairs: List[Text] = []
    var i = 0
    while i < List.length(params)
        shrinks List.length(params) - i
    {
        pairs = List.append(pairs, List.get(params, i) + " = " + show_val(List.get(a, i)))
        i = i + 1
    }
    return bad_at(
        "E4001", "This call breaks a 'needs' condition of '" + callee + "'", hint,
        [
            "The condition of the built-in function is false: needs " + condition, "Reason: " + reason,
            "It was called with: " + parser.join_texts(pairs, ", ")
        ],
        "node"
    )
}

fn ok_unit() gives Res {
    return good(Val.VUnit())
}

// The built-ins that are pure: they compute a value from the arguments, or stop with a broken `needs`.
fn apply_builtin(callee: Text, a: List[Val]) gives Res {
    if callee == "to_text" {
        return good(Val.VText(format_val(List.get(a, 0))))
    }
    if callee == "to_float" {
        return good(Val.VFloat(to_float(int_val(List.get(a, 0)))))
    }
    if callee == "to_int" {
        let x = float_val(List.get(a, 0))
        if x >= 9223372036854775808.0 or x < 0.0 - 9223372036854775808.0 {
            return bad_at("E3005", to_text(x) + " is outside the range of Int", int_range_hint(), [], "arg0")
        }
        return good(Val.VInt(to_int(x)))
    }
    if callee == "args" {
        return good(Val.VList([]))
    }
    if callee == "Text.length" {
        return good(Val.VInt(Text.length(text_val(List.get(a, 0)))))
    }
    if callee == "Text.slice" {
        return text_slice(a)
    }
    if callee == "Text.contains" {
        return good(Val.VBool(Text.contains(text_val(List.get(a, 0)), text_val(List.get(a, 1)))))
    }
    if callee == "Text.starts_with" {
        return good(Val.VBool(Text.starts_with(text_val(List.get(a, 0)), text_val(List.get(a, 1)))))
    }
    if callee == "Text.ends_with" {
        return good(Val.VBool(Text.ends_with(text_val(List.get(a, 0)), text_val(List.get(a, 1)))))
    }
    if callee == "Int.can_parse" {
        return good(Val.VBool(Int.can_parse(text_val(List.get(a, 0)))))
    }
    if callee == "Int.parse" {
        let text = text_val(List.get(a, 0))
        if not Int.can_parse(text) {
            return broken_needs(
                callee, "Int.can_parse(text)", "Only a whole number within the range of Int can be read as an Int",
                ["text"], a, parse_hint(callee, text)
            )
        }
        return good(Val.VInt(Int.parse(text)))
    }
    if callee == "Float.can_parse" {
        return good(Val.VBool(Float.can_parse(text_val(List.get(a, 0)))))
    }
    if callee == "Float.parse" {
        let text = text_val(List.get(a, 0))
        if not Float.can_parse(text) {
            return broken_needs(
                callee, "Float.can_parse(text)", "Only a decimal number that fits in a Float can be read as a Float",
                ["text"], a, parse_hint(callee, text)
            )
        }
        return good(Val.VFloat(Float.parse(text)))
    }
    if callee == "List.length" {
        return good(Val.VInt(List.length(list_val(List.get(a, 0)))))
    }
    if callee == "List.get" {
        let items = list_val(List.get(a, 0))
        let index = int_val(List.get(a, 1))
        if index < 0 or index >= List.length(items) {
            return broken_needs(
                callee, "0 <= i and i < List.length(xs)", "An index must be inside the list", ["xs", "i"], a, ""
            )
        }
        return good(List.get(items, index))
    }
    if callee == "List.append" {
        return good(Val.VList(List.append(list_val(List.get(a, 0)), List.get(a, 1))))
    }
    if callee == "List.concat" {
        return good(Val.VList(List.concat(list_val(List.get(a, 0)), list_val(List.get(a, 1)))))
    }
    if callee == "List.contains" {
        for item in list_val(List.get(a, 0)) {
            if vals_equal(item, List.get(a, 1)) {
                return good(Val.VBool(true))
            }
        }
        return good(Val.VBool(false))
    }
    if callee == "Some" {
        return good(some_val(List.get(a, 0)))
    }
    if callee == "Ok" or callee == "Err" {
        return good(Val.VVariant("", callee, [List.get(a, 0)]))
    }
    return option_result(callee, a)
}

fn text_slice(a: List[Val]) gives Res {
    let text = text_val(List.get(a, 0))
    let start = int_val(List.get(a, 1))
    let end = int_val(List.get(a, 2))
    let params = ["text", "start", "end"]
    if start < 0 {
        return broken_needs(
            "Text.slice", "start >= 0", "A slice cannot start before the first character", params, a, ""
        )
    }
    if start > end {
        return broken_needs("Text.slice", "start <= end", "A slice cannot end before it starts", params, a, "")
    }
    if end > Text.length(text) {
        return broken_needs(
            "Text.slice", "end <= Text.length(text)", "A slice cannot end after the last character", params, a, ""
        )
    }
    return good(Val.VText(Text.slice(text, start, end)))
}

// The functions that look into an Option or a Result.
fn option_result(callee: Text, a: List[Val]) gives Res {
    if List.length(a) == 0 {
        return bad("E0000", "the built-in '" + callee + "' is not run by this interpreter yet")
    }
    let first = List.get(a, 0)
    if callee == "Option.is_some" {
        return good(Val.VBool(variant_kind(first) == "Some"))
    }
    if callee == "Option.is_none" {
        return good(Val.VBool(variant_kind(first) == "None"))
    }
    if callee == "Option.value_or" {
        if variant_kind(first) == "Some" {
            return good(List.get(variant_items(first), 0))
        }
        return good(List.get(a, 1))
    }
    if callee == "Option.value" {
        if variant_kind(first) == "Some" {
            return good(List.get(variant_items(first), 0))
        }
        return bad_at(
            "E3011", "This Option has no value",
            "Check it with Option.is_none(...) before reading it, or use Option.value_or(...) to give a value for "
            + "the case of no value.", [], "arg0"
        )
    }
    if callee == "Result.is_ok" {
        return good(Val.VBool(variant_kind(first) == "Ok"))
    }
    if callee == "Result.is_err" {
        return good(Val.VBool(variant_kind(first) == "Err"))
    }
    if callee == "Result.value_or" {
        if variant_kind(first) == "Ok" {
            return good(List.get(variant_items(first), 0))
        }
        return good(List.get(a, 1))
    }
    if callee == "Result.value" {
        if variant_kind(first) == "Err" {
            return bad_at(
                "E3012", "This Result is an error: " + show_val(List.get(variant_items(first), 0)),
                "Check it with Result.is_err(...) before reading it, or use Result.value_or(...) to give a value "
                + "for the case of error.", [], "arg0"
            )
        }
        return good(List.get(variant_items(first), 0))
    }
    if callee == "Result.error" {
        if variant_kind(first) == "Ok" {
            return bad_at(
                "E3013", "This Result is not an error",
                "Check it with Result.is_ok(...) before reading the error.", [], "arg0"
            )
        }
        return good(List.get(variant_items(first), 0))
    }
    return bad("E0000", "the built-in '" + callee + "' is not run by this interpreter yet")
}

// Expressions

fn call_children(node: parser.Node) gives List[parser.Node] {
    let kind = kind_of(node)
    if kind == "Call" {
        return items_of(field(node, "arguments"))
    }
    if kind == "ListLiteral" {
        return items_of(field(node, "elements"))
    }
    var values: List[parser.Node] = []
    for initializer in items_of(field(node, "fields")) {
        values = List.append(values, field(initializer, "value"))
    }
    return values
}

// Starts to evaluate an expression.
fn step_eval(prog: Prog, m: Machine, node: parser.Node) gives Machine {
    let kind = kind_of(node)
    if kind == "IntLiteral" {
        return mk(m, Control.CValue(Val.VInt(int_of(field(node, "value")))), m.env, m.stack)
    }
    if kind == "FloatLiteral" {
        return mk(m, Control.CValue(Val.VFloat(Float.parse(real_of(field(node, "value"))))), m.env, m.stack)
    }
    if kind == "TextLiteral" {
        return mk(m, Control.CValue(Val.VText(text_of(field(node, "value")))), m.env, m.stack)
    }
    if kind == "BoolLiteral" {
        return mk(m, Control.CValue(Val.VBool(flag_of(field(node, "value")))), m.env, m.stack)
    }
    if kind == "Name" {
        let name = text_of(field(node, "name"))
        if name == "None" and not has_name(m.env, name) {
            return mk(m, Control.CValue(none_val()), m.env, m.stack)
        }
        return mk(m, Control.CValue(lookup(m.env, name)), m.env, m.stack)
    }
    if kind == "Group" {
        return mk(m, Control.CEval(field(node, "expression")), m.env, m.stack)
    }
    if kind == "Unary" {
        return mk(m, Control.CEval(field(node, "operand")), m.env, push(Kont.KUnary(node), m.stack))
    }
    if kind == "Binary" {
        return mk(m, Control.CEval(field(node, "left")), m.env, push(Kont.KBinLeft(node), m.stack))
    }
    if kind == "FieldAccess" {
        return mk(m, Control.CEval(field(node, "target")), m.env, push(Kont.KField(node), m.stack))
    }
    if kind == "MatchExpr" {
        return mk(m, Control.CEval(field(node, "value")), m.env, push(Kont.KMatch(node), m.stack))
    }
    // A call, a list or a record: its parts are evaluated one by one, from the first.
    let children = call_children(node)
    if List.length(children) == 0 {
        return finish_parts(prog, m, node, [])
    }
    return mk(m, Control.CEval(List.get(children, 0)), m.env, push(Kont.KArgs(node, []), m.stack))
}

// A call, a list or a record whose parts have all been evaluated.
fn finish_parts(prog: Prog, m: Machine, node: parser.Node, parts: List[Val]) gives Machine {
    let kind = kind_of(node)
    if kind == "ListLiteral" {
        return mk(m, Control.CValue(Val.VList(parts)), m.env, m.stack)
    }
    if kind == "RecordConstruction" {
        return mk(m, Control.CValue(build_record(prog, node, parts)), m.env, m.stack)
    }
    return finish_call(prog, m, node, parts)
}

// The record, with its fields in the order of the declaration and not in the order they were written.
fn build_record(prog: Prog, node: parser.Node, parts: List[Val]) gives Val {
    let name = text_of(field(node, "name"))
    let declared = List.get(prog.record_fields, index_of(prog.record_names, name))
    let written = items_of(field(node, "fields"))
    var vals: List[Val] = []
    for field_name in declared {
        var i = 0
        while i < List.length(written)
            shrinks List.length(written) - i
        {
            if text_of(field(List.get(written, i), "name")) == field_name {
                vals = List.append(vals, List.get(parts, i))
            }
            i = i + 1
        }
    }
    return Val.VRecord(name, declared, vals)
}

fn last_dot_index(text: Text) gives Int {
    var i = Text.length(text) - 1
    while i >= 0
        shrinks i + 1
    {
        if Text.slice(text, i, i + 1) == "." {
            return i
        }
        i = i - 1
    }
    return 0 - 1
}

fn max_call_depth() gives Int {
    return 1000
}

// A call whose arguments have been evaluated: a function of the program, the check of a refined type, a variant
// of an enum or a built-in.
fn finish_call(prog: Prog, m: Machine, node: parser.Node, arguments: List[Val]) gives Machine {
    let callee = text_of(field(node, "callee"))
    let at = index_of(prog.fn_names, callee)
    if at >= 0 {
        return call_function(note_invoked(m, node), List.get(prog.fn_nodes, at), arguments, node)
    }
    if index_of(prog.type_names, callee) >= 0 {
        return refine(prog, m, node, callee, List.get(arguments, 0))
    }
    if not checker.is_builtin(callee) {
        // `Shape.Circle(2.0)`: a variant of an enum.
        let dot = last_dot_index(callee)
        let owner = Text.slice(callee, 0, dot)
        let kind = Text.slice(callee, dot + 1, Text.length(callee))
        return mk(m, Control.CValue(Val.VVariant(owner, kind, arguments)), m.env, m.stack)
    }
    if is_host_function(callee) {
        return host_call(prog, m, node, callee, arguments)
    }
    if callee == "print" {
        let line = format_val(List.get(arguments, 0))
        return mk_out(m, Control.CValue(Val.VUnit()), m.stack, List.append(m.out, line))
    }
    let res = apply_builtin(callee, arguments)
    if not res.ok {
        return failed(m, res, node)
    }
    return mk(m, Control.CValue(res.val), m.env, m.stack)
}

// How a diagnostic names a clause: by its name when it has one.
fn clause_label(contract: parser.Node) gives Text {
    let clause = text_of(field(contract, "clause"))
    let name = field(contract, "name")
    if not is_null(name) {
        return clause + " '" + text_of(name) + "'"
    }
    if clause == "needs" {
        return "a '" + clause + "' condition"
    }
    return "'" + clause + "' condition"
}

// A clause as it is written, with its name: `needs whole_positive: whole > 0`.
fn source_of(contract: parser.Node) gives Text {
    var name = ""
    if not is_null(field(contract, "name")) {
        name = text_of(field(contract, "name")) + ": "
    }
    return text_of(field(contract, "clause")) + " " + name + checker.unparse(field(contract, "condition"))
}

fn reason_notes(contract: parser.Node) gives List[Text] {
    let message = field(contract, "message")
    if is_null(message) {
        return []
    }
    return ["Reason: " + text_of(message)]
}

// Enters a function of the program. Its parameters are the first scope, what is left to do after it returns is
// saved on the stack, and its `needs` are checked before its body starts.
fn call_function(m: Machine, function: parser.Node, arguments: List[Val], node: parser.Node) gives Machine {
    let site = place_of(node)
    if m.depth >= max_call_depth() {
        return stop_with(
            m, m.stack, 0, "E3004", "The program nested more than 1000 calls",
            "A recursive function probably never reaches the case where it stops calling itself.", [], site
        )
    }
    var names: List[Text] = []
    for param in items_of(field(function, "params")) {
        names = List.append(names, text_of(field(param, "name")))
    }
    let frame = Frame(names: names, vals: arguments)
    let name = text_of(field(function, "name"))
    let entered = push(Kont.KCall(m.env, name, site, function, frame), m.stack)
    let required = clauses_of(function, "needs")
    if List.length(required) == 0 {
        return mk_depth(m, Control.CExec(field(function, "body")), [frame], entered, m.depth + 1)
    }
    return mk_depth(
        m, Control.CEval(field(List.get(required, 0), "condition")), [frame],
        push(Kont.KNeeds(function, frame, site, 0), entered), m.depth + 1
    )
}

// A `needs` has been evaluated: if it is false the call fails, and if not the next one or the body goes on.
fn needs_value(
    m: Machine, function: parser.Node, frame: Frame, site: parser.Span, index: Int, rest: Stk, v: Val
) gives Machine {
    let required = clauses_of(function, "needs")
    let contract = List.get(required, index)
    let contract_span = place_of(contract)
    let name = text_of(field(function, "name"))
    if not truth(v) {
        let own = List.concat(
            List.concat(
                ["The condition at line " + to_text(contract_span.line) + " is false: " + source_of(contract)],
                reason_notes(contract)
            ),
            called_with(function, frame)
        )
        // The callee never started: the trace begins at the caller.
        return stop_with(
            m, rest, 1, "E4001", "This call breaks " + clause_label(contract) + " of '" + name + "'", "", own, site
        )
    }
    if index + 1 < List.length(required) {
        return mk(
            m, Control.CEval(field(List.get(required, index + 1), "condition")), m.env,
            push(Kont.KNeeds(function, frame, site, index + 1), rest)
        )
    }
    return mk(m, Control.CExec(field(function, "body")), m.env, rest)
}

// The environment in which the `guarantees` of a function are evaluated: its parameters and, when it gives a value,
// `result`.
fn promise_env(function: parser.Node, frame: Frame, returned: Val) gives List[Frame] {
    if is_null(field(function, "return_type")) {
        return [frame]
    }
    return [frame, Frame(names: ["result"], vals: [returned])]
}

// The function has returned `result`: its `guarantees` are checked, and then the caller goes on.
fn finish_function(
    m: Machine, saved: List[Frame], name: Text, site: parser.Span, function: parser.Node, frame: Frame, rest: Stk,
    returned: Val
) gives Machine {
    let guarantees = clauses_of(function, "promises")
    if List.length(guarantees) == 0 {
        return mk_depth(with_returned(m, site, returned), Control.CValue(returned), saved, rest, m.depth - 1)
    }
    return mk(
        m, Control.CEval(field(List.get(guarantees, 0), "condition")), promise_env(function, frame, returned),
        push(Kont.KPromise(function, frame, returned, 0), push(Kont.KRet(saved, name, site), rest))
    )
}

fn promise_value(
    m: Machine, function: parser.Node, frame: Frame, returned: Val, index: Int, rest: Stk, v: Val
) gives Machine {
    let guarantees = clauses_of(function, "promises")
    let contract = List.get(guarantees, index)
    let name = text_of(field(function, "name"))
    if not truth(v) {
        var own = ["'" + name + "' finished, but its condition is false: " + source_of(contract)]
        own = List.concat(own, reason_notes(contract))
        if not is_null(field(function, "return_type")) {
            own = List.append(own, "It returned: result = " + show_val(returned))
        }
        own = List.concat(own, called_with(function, frame))
        return stop_with(
            m, rest, 0, "E4002", "'" + name + "' breaks its own " + clause_label(contract), "", own,
            place_of(contract)
        )
    }
    if index + 1 < List.length(guarantees) {
        return mk(
            m, Control.CEval(field(List.get(guarantees, index + 1), "condition")), m.env,
            push(Kont.KPromise(function, frame, returned, index + 1), rest)
        )
    }
    return mk(m, Control.CValue(returned), m.env, rest)
}

// Refined types

type Refinement = { ok: Bool, errored: Bool, rule: Text, problem: parser.Problem }

fn refinement_ok() gives Refinement {
    return Refinement(ok: true, errored: false, rule: "", problem: problem_at("", "", "", [], parser.no_span()))
}

// `Percent(x)`: lets a value through only if it satisfies the conditions of the type and of the types it refines.
fn refine(prog: Prog, m: Machine, node: parser.Node, name: Text, v: Val) gives Machine {
    let outcome = check_refinement(prog, m, name, v)
    if outcome.errored {
        // The error points into the declaration of the type: say which check led there.
        let site = place_of(node)
        let note = "While checking that a value is a valid " + name + ", at line " + to_text(site.line) + ", column " + to_text(site.column) + "."
        let inner = outcome.problem
        let wrapped = parser.Problem(
            code: inner.code, label: inner.label, hint: inner.hint, notes: List.concat([note], inner.notes),
            line: inner.line, column: inner.column, end_line: inner.end_line, end_column: inner.end_column
        )
        return mk(m, Control.CFail(wrapped), m.env, m.stack)
    }
    if not outcome.ok {
        return stop_with(
            m, m.stack, 0, "E4003", "This value is not a valid " + name, "",
            refinement_notes(prog, name, outcome.rule, show_val(v)), place_of(node)
        )
    }
    return mk(m, Control.CValue(v), m.env, m.stack)
}

// The notes that explain why a value is not a valid `kind`: which condition is false, and why it exists.
fn refinement_notes(prog: Prog, kind: Text, broken_name: Text, written: Text) gives List[Text] {
    let broken = List.get(prog.type_nodes, index_of(prog.type_names, broken_name))
    let condition = "where " + checker.unparse(field(broken, "condition"))
    var notes: List[Text] = []
    if broken_name == kind {
        notes = ["The condition of '" + kind + "' is false: " + condition]
    } else {
        let refines = "'" + kind + "' refines '" + broken_name + "', and the condition of '" + broken_name + "' is false: "
        notes = [refines + condition]
    }
    notes = List.append(notes, "The value: " + written)
    let message = field(broken, "message")
    if not is_null(message) {
        notes = List.append(notes, "Reason: " + text_of(message))
    }
    return notes
}

// Evaluates the conditions of the chain of a type, root first. The evaluation is another machine whose stack ends in
// the stack of this one, so that a failure inside it names the calls and the loops that led to it.
fn check_refinement(prog: Prog, m: Machine, name: Text, v: Val) gives Refinement {
    let at = index_of(prog.type_names, name)
    if at < 0 {
        return refinement_ok()
    }
    let declaration = List.get(prog.type_nodes, at)
    let inner = check_refinement(prog, m, text_of(field(field(declaration, "base"), "name")), v)
    if not inner.ok or inner.errored {
        return inner
    }
    let machine = Machine(
        control: Control.CEval(field(declaration, "condition")), env: [Frame(names: ["value"], vals: [v])],
        stack: push(Kont.KHalt(), m.stack), out: [], depth: m.depth, fuel: 1000000, tracing: no_tracing()
    )
    let done = run_machine(prog, machine)
    return match done.control {
        Control.CDone(outcome) => rule_result(outcome, name)
        Control.CFail(problem) => Refinement(ok: false, errored: true, rule: name, problem: problem)
        _ => Refinement(ok: false, errored: false, rule: name, problem: problem_at("", "", "", [], parser.no_span()))
    }
}

fn rule_result(outcome: Val, name: Text) gives Refinement {
    if truth(outcome) {
        return refinement_ok()
    }
    return Refinement(ok: false, errored: false, rule: name, problem: problem_at("", "", "", [], parser.no_span()))
}

fn field_of_record(v: Val, name: Text) gives Val {
    return match v {
        Val.VRecord(type_name, names, vals) => List.get(vals, index_of(names, name))
        _ => Val.VUnit()
    }
}

// A value arrives and the top of the stack says what to do with it.
fn step_value(prog: Prog, m: Machine, v: Val) gives Machine {
    return match m.stack {
        Stk.Nil => mk(m, Control.CHalt(), m.env, m.stack)
        Stk.Cons(top, rest) => handle_value(prog, m, top, rest, v)
    }
}

fn handle_value(prog: Prog, m: Machine, top: Kont, rest: Stk, v: Val) gives Machine {
    return match top {
        Kont.KUnary(node) => unary_value(m, node, rest, v)
        Kont.KBinLeft(node) => binary_left(m, node, rest, v)
        Kont.KBinRight(node, left) => binary_right(m, node, rest, left, v)
        Kont.KArgs(node, done) => next_part(prog, m, node, rest, done, v)
        Kont.KField(node) => mk(m, Control.CValue(field_of_record(v, text_of(field(node, "name")))), m.env, rest)
        Kont.KMatch(node) => match_value(m, node, rest, v)
        Kont.KPopFrame => mk(m, Control.CValue(v), drop_frame(m.env), rest)
        Kont.KSeq(statements, next) => next_statement(m, statements, next, rest)
        Kont.KLet(node) => mk(
            m, Control.CValue(Val.VUnit()), declare(m.env, text_of(field(node, "name")), v), rest
        )
        Kont.KAssign(node) => mk(
            m, Control.CValue(Val.VUnit()), assign(m.env, text_of(field(node, "name")), v), rest
        )
        Kont.KReturn => mk(m, Control.CReturn(v), m.env, rest)
        Kont.KIf(node) => if_value(m, node, rest, v)
        Kont.KWhileKeep(node, turn, previous, index) => while_keep_value(m, node, turn, previous, index, rest, v)
        Kont.KWhileCond(node, turn, previous) => while_cond_value(m, node, turn, previous, rest, v)
        Kont.KWhileMeasure(node, turn, previous) => while_measure_value(m, node, turn, previous, rest, v)
        Kont.KWhileBody(node, turn, previous) => while_invariants(m, node, turn, previous, 0, rest)
        Kont.KForStart(node) => for_invariants(m, node, list_val(v), 0, 0, rest)
        Kont.KForKeep(node, items, turn, index) => for_keep_value(m, node, items, turn, index, rest, v)
        Kont.KForBody(node, items, turn) => for_invariants(without_frame(m), node, items, turn, 0, rest)
        Kont.KIfLet(node) => if_let_value(m, node, rest, v)
        Kont.KDiscard => mk(m, Control.CValue(Val.VUnit()), m.env, rest)
        Kont.KNeeds(function, frame, site, index) => needs_value(m, function, frame, site, index, rest, v)
        Kont.KCall(saved, name, site, function, frame) => finish_function(m, saved, name, site, function, frame, rest, v)
        Kont.KPromise(function, frame, returned, index) => promise_value(m, function, frame, returned, index, rest, v)
        Kont.KRet(saved, name, site) => mk_depth(with_returned(m, site, v), Control.CValue(v), saved, rest, m.depth - 1)
        Kont.KHalt => mk(m, Control.CDone(v), m.env, rest)
    }
}

fn unary_value(m: Machine, node: parser.Node, rest: Stk, v: Val) gives Machine {
    if text_of(field(node, "operator")) == "not" {
        return mk(m, Control.CValue(Val.VBool(not truth(v))), m.env, rest)
    }
    return match v {
        Val.VInt(n) => negate(m, node, rest, n)
        Val.VFloat(x) => mk(m, Control.CValue(Val.VFloat(0.0 - x)), m.env, rest)
        _ => mk(m, Control.CValue(v), m.env, rest)
    }
}

fn negate(m: Machine, node: parser.Node, rest: Stk, n: Int) gives Machine {
    if n == int_min() {
        return failed(m, int_overflow(), node)
    }
    return mk(m, Control.CValue(Val.VInt(0 - n)), m.env, rest)
}

fn binary_left(m: Machine, node: parser.Node, rest: Stk, left: Val) gives Machine {
    let operator = text_of(field(node, "operator"))
    if operator == "or" or operator == "and" {
        // The right side is evaluated only when it can change the result.
        let decided = truth(left)
        if (operator == "or" and decided) or (operator == "and" and not decided) {
            return mk(note_skipped(m, field(node, "right")), Control.CValue(left), m.env, rest)
        }
        return mk(m, Control.CEval(field(node, "right")), m.env, rest)
    }
    return mk(m, Control.CEval(field(node, "right")), m.env, push(Kont.KBinRight(node, left), rest))
}

fn binary_right(m: Machine, node: parser.Node, rest: Stk, left: Val, right: Val) gives Machine {
    let res = binary_value(text_of(field(node, "operator")), left, right)
    if not res.ok {
        return failed(m, res, node)
    }
    return mk(m, Control.CValue(res.val), m.env, rest)
}

// One more part of a call, a list or a record has been evaluated.
fn next_part(prog: Prog, m: Machine, node: parser.Node, rest: Stk, done: List[Val], v: Val) gives Machine {
    let parts = List.append(done, v)
    let children = call_children(node)
    if List.length(parts) < List.length(children) {
        return mk(
            m, Control.CEval(List.get(children, List.length(parts))), m.env,
            push(Kont.KArgs(node, parts), rest)
        )
    }
    let next = Machine(
        control: m.control, env: m.env, stack: rest, out: m.out, depth: m.depth, fuel: m.fuel, tracing: m.tracing
    )
    return finish_parts(prog, next, node, parts)
}

fn match_value(m: Machine, node: parser.Node, rest: Stk, v: Val) gives Machine {
    for arm in items_of(field(node, "arms")) {
        let bound = match_pattern(field(arm, "pattern"), v)
        if bound.ok {
            return mk(
                m, Control.CEval(field(arm, "body")), push_frame(m.env, Frame(names: bound.names, vals: bound.vals)),
                push(Kont.KPopFrame(), rest)
            )
        }
    }
    return fail_at(m, "E0000", "an exhaustive match had no matching arm", place_of(node))
}

// Statements

fn step_exec(prog: Prog, m: Machine, node: parser.Node) gives Machine {
    let kind = kind_of(node)
    if kind == "Block" {
        return mk(
            m, Control.CValue(Val.VUnit()), push_frame(m.env, empty_frame()),
            push(Kont.KSeq(items_of(field(node, "statements")), 0), push(Kont.KPopFrame(), m.stack))
        )
    }
    if kind == "Let" or kind == "Var" {
        return mk(m, Control.CEval(field(node, "value")), m.env, push(Kont.KLet(node), m.stack))
    }
    if kind == "Assign" {
        return mk(m, Control.CEval(field(node, "value")), m.env, push(Kont.KAssign(node), m.stack))
    }
    if kind == "Return" {
        if is_null(field(node, "value")) {
            return mk(m, Control.CReturn(Val.VUnit()), m.env, m.stack)
        }
        return mk(m, Control.CEval(field(node, "value")), m.env, push(Kont.KReturn(), m.stack))
    }
    if kind == "If" {
        return mk(m, Control.CEval(field(node, "condition")), m.env, push(Kont.KIf(node), m.stack))
    }
    if kind == "IfLet" {
        return mk(m, Control.CEval(field(node, "value")), m.env, push(Kont.KIfLet(node), m.stack))
    }
    if kind == "While" {
        return while_invariants(m, node, 0, None, 0, m.stack)
    }
    if kind == "For" {
        return mk(m, Control.CEval(field(node, "iterable")), m.env, push(Kont.KForStart(node), m.stack))
    }
    if kind == "ExprStatement" {
        return mk(m, Control.CEval(field(node, "expression")), m.env, push(Kont.KDiscard(), m.stack))
    }
    return fail_at(m, "E0000", "a statement the interpreter does not know: " + kind, place_of(node))
}

// The block runs its statements in order; when none is left, the value goes on.
fn next_statement(m: Machine, statements: List[parser.Node], next: Int, rest: Stk) gives Machine {
    if next < List.length(statements) {
        return mk(
            m, Control.CExec(List.get(statements, next)), m.env, push(Kont.KSeq(statements, next + 1), rest)
        )
    }
    return mk(m, Control.CValue(Val.VUnit()), m.env, rest)
}

fn branch(m: Machine, else_node: parser.Node, rest: Stk) gives Machine {
    if is_null(else_node) {
        return mk(m, Control.CValue(Val.VUnit()), m.env, rest)
    }
    return mk(m, Control.CExec(else_node), m.env, rest)
}

fn if_value(m: Machine, node: parser.Node, rest: Stk, v: Val) gives Machine {
    if truth(v) {
        return mk(m, Control.CExec(field(node, "then_block")), m.env, rest)
    }
    return branch(m, field(node, "else_branch"), rest)
}

fn if_let_value(m: Machine, node: parser.Node, rest: Stk, v: Val) gives Machine {
    let bound = match_pattern(field(node, "pattern"), v)
    if bound.ok {
        return mk(
            m, Control.CExec(field(node, "then_block")), push_frame(m.env, Frame(names: bound.names, vals: bound.vals)),
            push(Kont.KPopFrame(), rest)
        )
    }
    return branch(m, field(node, "else_branch"), rest)
}

// Loops. Before every turn the invariants must hold; in a `while` the measure must be 0 or more and smaller than on
// the turn before. So a loop always ends, or stops with a diagnostic that names the turn and the values.

fn while_invariants(
    m: Machine, node: parser.Node, turn: Int, previous: Option[Int], index: Int, rest: Stk
) gives Machine {
    let invariants = loop_clauses(node, "keeps")
    if index < List.length(invariants) {
        return mk(
            m, Control.CEval(field(List.get(invariants, index), "condition")), m.env,
            push(Kont.KWhileKeep(node, turn, previous, index), rest)
        )
    }
    return mk(m, Control.CEval(field(node, "condition")), m.env, push(Kont.KWhileCond(node, turn, previous), rest))
}

// An watched that is false stops the program, naming the turn and the values.
fn broken_invariant(m: Machine, node: parser.Node, turn: Int, index: Int, rest: Stk) gives Machine {
    let watched = List.get(loop_clauses(node, "keeps"), index)
    let watched_span = place_of(watched)
    let own = List.concat(
        List.concat(
            List.concat(
                ["The condition at line " + to_text(watched_span.line) + " is false: " + source_of(watched)],
                reason_notes(watched)
            ),
            [when_note(node, turn)]
        ),
        values_note(m.env)
    )
    return stop_with(
        m, rest, 0, "E4005", "This condition is false", "", own, place_of(field(watched, "condition"))
    )
}

fn while_keep_value(
    m: Machine, node: parser.Node, turn: Int, previous: Option[Int], index: Int, rest: Stk, v: Val
) gives Machine {
    if not truth(v) {
        return broken_invariant(m, node, turn, index, rest)
    }
    return while_invariants(m, node, turn, previous, index + 1, rest)
}

fn while_cond_value(
    m: Machine, node: parser.Node, turn: Int, previous: Option[Int], rest: Stk, v: Val
) gives Machine {
    if not truth(v) {
        return mk(m, Control.CValue(Val.VUnit()), m.env, rest)
    }
    let measure = List.get(loop_clauses(node, "shrinks"), 0)
    return mk(
        m, Control.CEval(field(measure, "condition")), m.env, push(Kont.KWhileMeasure(node, turn + 1, previous), rest)
    )
}

fn measure_label(current: Int, previous: Option[Int]) gives Text {
    if current < 0 {
        return "The measure is " + to_text(current) + "; it must be 0 or more"
    }
    return match previous {
        Some(before) => measure_change(before, current)
        None => ""
    }
}

fn measure_change(before: Int, current: Int) gives Text {
    if current == before {
        return "The measure was " + to_text(before) + " and is still " + to_text(current)
    }
    return "The measure was " + to_text(before) + " and is now " + to_text(current)
}

fn measure_broken(current: Int, previous: Option[Int]) gives Bool {
    if current < 0 {
        return true
    }
    return match previous {
        Some(before) => current >= before
        None => false
    }
}

fn while_measure_value(
    m: Machine, node: parser.Node, turn: Int, previous: Option[Int], rest: Stk, v: Val
) gives Machine {
    let current = int_val(v)
    let measure = List.get(loop_clauses(node, "shrinks"), 0)
    let measure_span = place_of(measure)
    if measure_broken(current, previous) {
        let before = "Before turn " + to_text(turn) + " of the loop at line " + line_text(node) + "."
        let own = List.concat(
            List.concat(
                List.concat(
                    ["The measure at line " + to_text(measure_span.line) + ": " + source_of(measure)],
                    reason_notes(measure)
                ),
                [before]
            ),
            values_note(m.env)
        )
        return stop_with(
            m, rest, 0, "E4006", measure_label(current, previous), "", own, place_of(field(measure, "condition"))
        )
    }
    return mk(
        m, Control.CExec(field(node, "body")), m.env, push(Kont.KWhileBody(node, turn, Some(current)), rest)
    )
}

// One turn of a `for`: the iterator is a new name in a new scope of the body.
fn for_invariants(
    m: Machine, node: parser.Node, items: List[Val], turn: Int, index: Int, rest: Stk
) gives Machine {
    let invariants = loop_clauses(node, "keeps")
    if index < List.length(invariants) {
        return mk(
            m, Control.CEval(field(List.get(invariants, index), "condition")), m.env,
            push(Kont.KForKeep(node, items, turn, index), rest)
        )
    }
    if turn >= List.length(items) {
        return mk(m, Control.CValue(Val.VUnit()), m.env, rest)
    }
    let frame = Frame(names: [text_of(field(node, "name"))], vals: [List.get(items, turn)])
    return mk(
        m, Control.CExec(field(node, "body")), push_frame(m.env, frame),
        push(Kont.KForBody(node, items, turn + 1), rest)
    )
}

fn for_keep_value(
    m: Machine, node: parser.Node, items: List[Val], turn: Int, index: Int, rest: Stk, v: Val
) gives Machine {
    if not truth(v) {
        return broken_invariant(m, node, turn, index, rest)
    }
    return for_invariants(m, node, items, turn, index + 1, rest)
}

// The machine with the innermost scope of the environment left out.
fn without_frame(m: Machine) gives Machine {
    return Machine(
        control: m.control, env: drop_frame(m.env), stack: m.stack, out: m.out, depth: m.depth, fuel: m.fuel,
        tracing: m.tracing
    )
}

// A return unwinds the stack up to the call that is returning.
fn step_return(m: Machine, v: Val) gives Machine {
    return match m.stack {
        Stk.Nil => mk(m, Control.CHalt(), m.env, m.stack)
        Stk.Cons(top, rest) => unwind(m, top, rest, v)
    }
}

fn unwind(m: Machine, top: Kont, rest: Stk, v: Val) gives Machine {
    return match top {
        Kont.KCall(saved, name, site, function, frame) => finish_function(m, saved, name, site, function, frame, rest, v)
        Kont.KHalt => mk(m, Control.CDone(v), m.env, rest)
        _ => mk(m, Control.CReturn(v), m.env, rest)
    }
}

fn step(prog: Prog, m: Machine) gives Machine {
    return match m.control {
        Control.CEval(node) => step_eval(prog, m, node)
        Control.CExec(node) => step_exec(prog, m, node)
        Control.CValue(v) => step_value(prog, m, v)
        Control.CReturn(v) => step_return(m, v)
        Control.CHalt => m
        Control.CDone(v) => m
        Control.CFail(problem) => m
    }
}

fn is_finished(control: Control) gives Bool {
    return match control {
        Control.CHalt => true
        Control.CDone(v) => true
        Control.CFail(problem) => true
        _ => false
    }
}

// Runs the machine until it stops or the fuel is spent.
fn run_machine(prog: Prog, start: Machine) gives Machine {
    var m = start
    while m.fuel > 0 and not is_finished(m.control)
        shrinks m.fuel
    {
        m = step(prog, m)
    }
    return m
}

// The program

fn start_machine(prog: Prog, fuel: Int) gives Machine {
    let main_at = index_of(prog.fn_names, "main")
    let function = List.get(prog.fn_nodes, main_at)
    return Machine(
        control: Control.CExec(field(function, "body")), env: [empty_frame()],
        stack: push(
            Kont.KCall([], "main", parser.no_span(), function, empty_frame()), push(Kont.KHalt(), nil_stack())
        ),
        out: [], depth: 1, fuel: fuel, tracing: no_tracing()
    )
}

// Examples (`nex test`)

// An own call of an example that was invoked: it stays "stopped" unless the function returns a value.
type Seen = { key: Text, status: Text, val: Val }

// What is observed about the own calls of the example being evaluated.
type Tracing = { watch: List[Text], invoked: List[Seen], skipped: List[Text], inputs: List[Text] }

fn no_tracing() gives Tracing {
    return Tracing(watch: [], invoked: [], skipped: [], inputs: [])
}

fn span_key(span: parser.Span) gives Text {
    return to_text(span.line) + ":" + to_text(span.column)
}

fn with_tracing(m: Machine, tracing: Tracing) gives Machine {
    return Machine(
        control: m.control, env: m.env, stack: m.stack, out: m.out, depth: m.depth, fuel: m.fuel, tracing: tracing
    )
}

// An own call is about to be invoked: it is recorded, even if the function never starts.
fn note_invoked(m: Machine, node: parser.Node) gives Machine {
    let key = span_key(place_of(node))
    if not List.contains(m.tracing.watch, key) {
        return m
    }
    return with_tracing(
        m,
        Tracing(
            watch: m.tracing.watch,
            invoked: List.append(m.tracing.invoked, Seen(key: key, status: "stopped", val: Val.VUnit())),
            skipped: m.tracing.skipped, inputs: m.tracing.inputs
        )
    )
}

// The function of an own call has returned `value`.
fn with_returned(m: Machine, site: parser.Span, value: Val) gives Machine {
    if List.length(m.tracing.watch) == 0 {
        return m
    }
    let key = span_key(site)
    var invoked: List[Seen] = []
    for seen in m.tracing.invoked {
        if seen.key == key and seen.status == "stopped" {
            invoked = List.append(invoked, Seen(key: key, status: "returned", val: value))
        } else {
            invoked = List.append(invoked, seen)
        }
    }
    return with_tracing(
        m, Tracing(watch: m.tracing.watch, invoked: invoked, skipped: m.tracing.skipped, inputs: m.tracing.inputs)
    )
}

// The own calls inside an operand that `and` or `or` did not need to evaluate.
fn skipped_calls(node: parser.Node, watch: List[Text]) gives List[Text] {
    let kind = kind_of(node)
    var found: List[Text] = []
    if kind == "Call" {
        let key = span_key(place_of(node))
        if List.contains(watch, key) {
            found = List.append(found, key)
        }
        for argument in items_of(field(node, "arguments")) {
            found = List.concat(found, skipped_calls(argument, watch))
        }
    } else if kind == "Binary" {
        found = List.concat(skipped_calls(field(node, "left"), watch), skipped_calls(field(node, "right"), watch))
    } else if kind == "Unary" {
        found = skipped_calls(field(node, "operand"), watch)
    } else if kind == "Group" {
        found = skipped_calls(field(node, "expression"), watch)
    } else if kind == "ListLiteral" {
        for element in items_of(field(node, "elements")) {
            found = List.concat(found, skipped_calls(element, watch))
        }
    } else if kind == "RecordConstruction" {
        for initializer in items_of(field(node, "fields")) {
            found = List.concat(found, skipped_calls(field(initializer, "value"), watch))
        }
    } else if kind == "FieldAccess" {
        found = skipped_calls(field(node, "target"), watch)
    }
    return found
}

fn note_skipped(m: Machine, operand: parser.Node) gives Machine {
    if List.length(m.tracing.watch) == 0 {
        return m
    }
    return with_tracing(
        m,
        Tracing(
            watch: m.tracing.watch, invoked: m.tracing.invoked,
            skipped: List.concat(m.tracing.skipped, skipped_calls(operand, m.tracing.watch)),
            inputs: m.tracing.inputs
        )
    )
}

// The calls to `function` written in an expression, in the order they start in the text.
fn calls_to(node: parser.Node, function: Text) gives List[parser.Node] {
    return match node {
        parser.Node.Obj(kind, names, values) => object_calls_to(node, kind, values, function)
        parser.Node.Items(items) => all_calls_to(items, function)
        _ => []
    }
}

fn object_calls_to(node: parser.Node, kind: Text, values: List[parser.Node], function: Text) gives List[parser.Node] {
    var found: List[parser.Node] = []
    if kind == "Call" and text_of(field(node, "callee")) == function {
        found = [node]
    }
    return List.concat(found, all_calls_to(values, function))
}

fn all_calls_to(nodes: List[parser.Node], function: Text) gives List[parser.Node] {
    var found: List[parser.Node] = []
    for node in nodes {
        found = List.concat(found, calls_to(node, function))
    }
    return found
}

fn call_before(a: parser.Node, b: parser.Node) gives Bool {
    let first = place_of(a)
    let second = place_of(b)
    return first.line < second.line or (first.line == second.line and first.column < second.column)
}

fn sort_calls(calls: List[parser.Node]) gives List[parser.Node] {
    var sorted: List[parser.Node] = []
    for call in calls {
        var result: List[parser.Node] = []
        var placed = false
        for existing in sorted {
            if not placed and call_before(call, existing) {
                result = List.append(result, call)
                placed = true
            }
            result = List.append(result, existing)
        }
        if not placed {
            result = List.append(result, call)
        }
        sorted = result
    }
    return sorted
}

// The text a span covers, exactly as it was written.
fn source_lines(text: Text) gives List[Text] {
    var lines: List[Text] = []
    var start = 0
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        if Text.slice(text, i, i + 1) == "\n" {
            lines = List.append(lines, Text.slice(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return List.append(lines, Text.slice(text, start, Text.length(text)))
}

fn line_part(lines: List[Text], number: Int, from: Int, to: Int) gives Text {
    if number < 1 or number > List.length(lines) {
        return ""
    }
    let line = List.get(lines, number - 1)
    var start = from
    var end = to
    if end > Text.length(line) {
        end = Text.length(line)
    }
    if start > end {
        start = end
    }
    return Text.slice(line, start, end)
}

fn text_of_span(lines: List[Text], span: parser.Span) gives Text {
    if span.line == span.end_line {
        return line_part(lines, span.line, span.column - 1, span.end_column - 1)
    }
    var parts = [line_part(lines, span.line, span.column - 1, 1000000)]
    var number = span.line + 1
    while number < span.end_line
        shrinks span.end_line - number
    {
        parts = List.append(parts, line_part(lines, number, 0, 1000000))
        number = number + 1
    }
    parts = List.append(parts, line_part(lines, span.end_line, 0, span.end_column - 1))
    return parser.join_texts(parts, "\n")
}

fn call_for_key(calls: List[parser.Node], key: Text) gives parser.Node {
    for call in calls {
        if span_key(place_of(call)) == key {
            return call
        }
    }
    return parser.Node.Null()
}

fn type_text(node: parser.Node) gives Text {
    return text_of(field(node, "type"))
}

fn show_status_value(seen: Seen) gives Text {
    if seen.status == "returned" {
        return show_val(seen.val)
    }
    return ""
}

fn span_line(span: parser.Span) gives Text {
    return parser.span_text(span.line, span.column, span.end_line, span.end_column)
}

fn diagnostic_line(problem: parser.Problem) gives Text {
    return (
        "DIAG|" + problem.code + "|" + problem.label + "|" + problem.hint + "|"
        + parser.join_texts(problem.notes, "~~") + "|"
        + parser.span_text(problem.line, problem.column, problem.end_line, problem.end_column)
    )
}

// Evaluates the examples of a program, each in a new machine, in the order of the file, and prints for each one what
// `nex test` reports: its status, the own calls that were and were not evaluated, the diagnostic and what it printed.
fn run_examples(prog: Prog, text: Text, program: parser.Node) {
    let lines = source_lines(text)
    for function in items_of(field(program, "functions")) {
        let name = text_of(field(function, "name"))
        var index = 0
        for item in items_of(field(function, "header")) {
            if kind_of(item) == "Example" {
                index = index + 1
                run_example(prog, lines, name, index, item)
            }
        }
    }
}

fn run_example(prog: Prog, lines: List[Text], name: Text, index: Int, item: parser.Node) {
    let condition = field(item, "condition")
    let calls = sort_calls(calls_to(condition, name))
    var watch: List[Text] = []
    for call in calls {
        watch = List.append(watch, span_key(place_of(call)))
    }
    let machine = Machine(
        control: Control.CEval(condition), env: [], stack: push(Kont.KHalt(), nil_stack()), out: [], depth: 0,
        fuel: start_fuel(), tracing: Tracing(watch: watch, invoked: [], skipped: [], inputs: [])
    )
    let done = run_machine(prog, machine)
    let at = place_of(condition)
    var status = "failed"
    var problem = problem_at("", "", "", [], parser.no_span())
    var has_problem = false
    match done.control {
        Control.CFail(raised) => {
            status = "error"
            has_problem = true
            problem = parser.Problem(
                code: raised.code, label: raised.label, hint: raised.hint,
                notes: List.append(
                    raised.notes,
                    "While evaluating example " + to_text(index) + " of '" + name + "', at line " + to_text(at.line) + "."
                ),
                line: raised.line, column: raised.column, end_line: raised.end_line, end_column: raised.end_column
            )
        }
        Control.CDone(outcome) => {
            if truth(outcome) {
                status = "passed"
            }
        }
        _ => {
            status = "failed"
        }
    }
    var message = ""
    if not is_null(field(item, "message")) {
        message = text_of(field(item, "message"))
    }
    print("EX|" + name + "|" + to_text(index) + "|" + status + "|" + span_line(at) + "|" + text_of_span(lines, at) + "|" + message)
    var notes: List[Text] = []
    for seen in done.tracing.invoked {
        let call = call_for_key(calls, seen.key)
        let call_span = place_of(call)
        let written = text_of_span(lines, call_span)
        print(
            "VAL|" + written + "|" + span_line(call_span) + "|" + type_text(call) + "|" + seen.status + "|"
            + show_status_value(seen)
        )
        var shown = "None"
        if seen.status == "returned" {
            shown = show_val(seen.val)
        }
        notes = List.append(notes, written + " returned " + shown)
    }
    var invoked_keys: List[Text] = []
    for seen in done.tracing.invoked {
        invoked_keys = List.append(invoked_keys, seen.key)
    }
    for call in calls {
        let key = span_key(place_of(call))
        if not List.contains(invoked_keys, key) {
            var reason = "stopped_before"
            if List.contains(done.tracing.skipped, key) {
                reason = "short_circuit"
            }
            let call_span = place_of(call)
            print("NOT|" + text_of_span(lines, call_span) + "|" + span_line(call_span) + "|" + type_text(call) + "|" + reason)
        }
    }
    if status == "failed" {
        if message != "" {
            notes = List.append(notes, "Reason: " + message)
        }
        print(diagnostic_line(problem_at("E4004", "This example of '" + name + "' is false", "", notes, at)))
    } else if has_problem {
        print(diagnostic_line(problem))
    }
    for line in done.out {
        print("OUT|" + line)
    }
}

// The host: what a program may do besides computing
//
// The Python interpreter asks a host for the arguments, the input and the files of the program, and the host
// decides with the three rules of decision 0015: what the program declared, what the user allowed and what the
// environment permits. This interpreter makes the same decisions with what it is given on its command line, and
// performs the operation itself for the files and the standard input.
//
// Two things the language cannot do yet limit it. A capability is declared with a literal (`uses read "."`), so
// this interpreter can only touch what it declares itself: it declares the working directory for files, and it
// cannot forward a network request or a process to an origin or a command it does not know in advance (it says
// so with E0000 when everything else allows the operation). And a read of a file that does not exist, or of an
// input that has ended, stops this interpreter instead of becoming a value the program can see: the input is
// read from a file given with --stdin, whose end it knows, and a missing file ends the run. The paths are
// resolved by their text, so a symbolic link that points outside what is allowed is not noticed.

// The host a program runs with.
type HostCfg = {
    arguments: List[Text], declared_kinds: List[Text], declared_paths: List[Text],
    grant_kinds: List[Text], grant_paths: List[Text], cwd: Text
}

// The host of a run where the user has allowed nothing: the program has declared what it needs, and that is all.
fn declared_host(program: parser.Node) gives HostCfg {
    return HostCfg(
        arguments: [], declared_kinds: declared_kinds_of(program), declared_paths: declared_paths_of(program),
        grant_kinds: [], grant_paths: [], cwd: ""
    )
}

fn no_host() gives HostCfg {
    return HostCfg(
        arguments: [], declared_kinds: [], declared_paths: [], grant_kinds: [], grant_paths: [], cwd: ""
    )
}

// What a program declares with `uses`, as pairs of (capability, scope) in two lists.
fn declared_kinds_of(program: parser.Node) gives List[Text] {
    var kinds: List[Text] = []
    for declaration in items_of(field(program, "uses")) {
        kinds = List.append(kinds, text_of(field(declaration, "capability")))
    }
    return kinds
}

fn declared_paths_of(program: parser.Node) gives List[Text] {
    var paths: List[Text] = []
    for declaration in items_of(field(program, "uses")) {
        paths = List.append(paths, text_of(field(declaration, "path")))
    }
    return paths
}

fn scopes_for(kinds: List[Text], paths: List[Text], kind: Text) gives List[Text] {
    var scopes: List[Text] = []
    var i = 0
    while i < List.length(kinds)
        shrinks List.length(kinds) - i
    {
        if List.get(kinds, i) == kind {
            scopes = List.append(scopes, List.get(paths, i))
        }
        i = i + 1
    }
    return scopes
}

fn is_absolute_path(path: Text) gives Bool {
    return Text.starts_with(path, "/") or Text.starts_with(path, "\\") or (Text.length(path) > 1 and Text.slice(path, 1, 2) == ":")
}

// The path made absolute with the working directory, as the file system would see it, without following links.
fn resolve_path(host: HostCfg, path: Text) gives Text {
    if is_absolute_path(path) or host.cwd == "" {
        return path
    }
    return host.cwd + "/" + path
}

fn covered_by(host: HostCfg, scopes: List[Text], path: Text) gives Bool {
    let target = resolve_path(host, path)
    for scope in scopes {
        if checker.is_inside(resolve_path(host, scope), target) {
            return true
        }
    }
    return false
}

// Why the program may not use a file, or the empty text when it may.
fn file_denied(host: HostCfg, kind: Text, path: Text) gives Text {
    if not covered_by(host, scopes_for(host.declared_kinds, host.declared_paths, kind), path) {
        return "this program does not declare that it needs to " + kind + " '" + path + "'"
    }
    if not covered_by(host, scopes_for(host.grant_kinds, host.grant_paths, kind), path) {
        return "'" + path + "' is not among the paths the user allowed to " + kind
    }
    return ""
}

fn denied_machine(m: Machine, message: Text, hint: Text, node: parser.Node) gives Machine {
    let res = bad_at("E3008", message, hint, [], "arg0")
    return failed(m, res, node)
}

fn forwarding_machine(m: Machine, callee: Text, node: parser.Node) gives Machine {
    return failed(m, bad("E0000", "'" + callee + "' cannot be forwarded to the host by this interpreter yet"), node)
}

fn read_hint() gives Text {
    return "A program reads a file when it declares it with 'uses read' and the user allows it with --allow-read."
}

fn write_hint() gives Text {
    return "A program writes a file when it declares it with 'uses write' and the user allows it with --allow-write."
}

// `Net.get(url)`: the origin the request would go to, when the URL is one the host admits at all.
type OriginCheck = { admitted: Bool, origin: Text, unsupported: Bool }

fn https_origin(url: Text) gives OriginCheck {
    let parsed = checker.url_origin(url)
    if parsed.unsupported != "" {
        return OriginCheck(admitted: false, origin: "", unsupported: true)
    }
    if not parsed.ok or parsed.port != 443 {
        return OriginCheck(admitted: false, origin: "", unsupported: false)
    }
    return OriginCheck(admitted: true, origin: "https://" + parsed.host, unsupported: false)
}

fn origin_declared(host: HostCfg, kinds: List[Text], paths: List[Text], origin: Text) gives Bool {
    for scope in scopes_for(kinds, paths, "network") {
        let declared = checker.url_origin(scope)
        let wanted = checker.url_origin(origin)
        if declared.ok and wanted.ok and declared.host == wanted.host and declared.port == wanted.port {
            return true
        }
    }
    return false
}

// The standard input has ended: the program has to know that there is nothing more to read.
fn read_input_line(m: Machine, node: parser.Node) gives Machine {
    let inputs = m.tracing.inputs
    if List.length(inputs) == 0 {
        return stop_with(
            m, m.stack, 0, "E3009", "There is no more input to read",
            "The standard input ended. Check it before reading again.", [], place_of(node)
        )
    }
    let line = List.get(inputs, 0)
    var rest: List[Text] = []
    var i = 1
    while i < List.length(inputs)
        shrinks List.length(inputs) - i
    {
        rest = List.append(rest, List.get(inputs, i))
        i = i + 1
    }
    let consumed = with_tracing(
        m,
        Tracing(
            watch: m.tracing.watch, invoked: m.tracing.invoked, skipped: m.tracing.skipped, inputs: rest
        )
    )
    return mk(consumed, Control.CValue(Val.VText(line)), consumed.env, consumed.stack)
}

fn is_host_function(callee: Text) gives Bool {
    return (
        callee == "args" or callee == "input" or callee == "read_file" or callee == "write_file"
        or callee == "Net.get" or callee == "Process.run"
    )
}

// A call to a function of the host, once its arguments are evaluated.
fn host_call(prog: Prog, m: Machine, node: parser.Node, callee: Text, a: List[Val]) gives Machine {
    let host = prog.host
    if callee == "args" {
        var shown: List[Val] = []
        for argument in host.arguments {
            shown = List.append(shown, Val.VText(argument))
        }
        return mk(m, Control.CValue(Val.VList(shown)), m.env, m.stack)
    }
    if callee == "input" {
        return read_input_line(m, node)
    }
    let first = text_val(List.get(a, 0))
    if callee == "read_file" {
        let denied = file_denied(host, "read", first)
        if denied != "" {
            return denied_machine(m, denied, read_hint(), node)
        }
        return mk(m, Control.CValue(Val.VText(read_file(first))), m.env, m.stack)
    }
    if callee == "write_file" {
        let denied = file_denied(host, "write", first)
        if denied != "" {
            return denied_machine(m, denied, write_hint(), node)
        }
        write_file(first, text_val(List.get(a, 1)))
        return mk(m, Control.CValue(Val.VUnit()), m.env, m.stack)
    }
    if callee == "Net.get" {
        let origin = https_origin(first)
        if origin.unsupported {
            return forwarding_machine(m, callee, node)
        }
        if not origin.admitted {
            return failed(
                m, bad_at("E3014", "only HTTPS URLs without credentials and on port 443 are allowed", "", [], "arg0"), node
            )
        }
        let network_hint = "A program needs 'uses network' and the matching --allow-network origin; the environment may still deny network access."
        if not origin_declared(host, host.declared_kinds, host.declared_paths, origin.origin) {
            return denied_machine(m, "this program does not declare network access to '" + origin.origin + "'", network_hint, node)
        }
        if not origin_declared(host, host.grant_kinds, host.grant_paths, origin.origin) {
            return denied_machine(m, "'" + origin.origin + "' is not among the network origins the user allowed", network_hint, node)
        }
        return forwarding_machine(m, callee, node)
    }
    let process_hint = "A program needs 'uses process' and the matching --allow-process command; the environment may still deny external processes."
    if not List.contains(scopes_for(host.declared_kinds, host.declared_paths, "process"), first) {
        return denied_machine(m, "this program does not declare permission to run '" + first + "'", process_hint, node)
    }
    if not List.contains(scopes_for(host.grant_kinds, host.grant_paths, "process"), first) {
        return denied_machine(m, "'" + first + "' is not among the commands the user allowed", process_hint, node)
    }
    return forwarding_machine(m, callee, node)
}

// Reads what the command line gives a run: the grants, the input, the working directory and the arguments.
type RunOptions = {
    grant_kinds: List[Text], grant_paths: List[Text], stdin: List[Text], cwd: Text, path: Text,
    arguments: List[Text]
}

fn input_lines(text: Text) gives List[Text] {
    if text == "" {
        return []
    }
    var lines = source_lines(text)
    if List.length(lines) > 0 and List.get(lines, List.length(lines) - 1) == "" {
        lines = drop_last_text(lines)
    }
    return lines
}

fn drop_last_text(items: List[Text]) gives List[Text] {
    var result: List[Text] = []
    var i = 0
    while i < List.length(items) - 1
        shrinks List.length(items) - i
    {
        result = List.append(result, List.get(items, i))
        i = i + 1
    }
    return result
}

fn parse_options(words: List[Text]) gives RunOptions {
    var kinds: List[Text] = []
    var paths: List[Text] = []
    var stdin: List[Text] = []
    var cwd = ""
    var path = ""
    var arguments: List[Text] = []
    var i = 0
    while i < List.length(words)
        shrinks List.length(words) - i
    {
        let word = List.get(words, i)
        if path != "" {
            arguments = List.append(arguments, word)
            i = i + 1
        } else if word == "--allow-read" or word == "--allow-write" or word == "--allow-network" or word == "--allow-process" {
            kinds = List.append(kinds, Text.slice(word, 8, Text.length(word)))
            paths = List.append(paths, List.get(words, i + 1))
            i = i + 2
        } else if word == "--stdin" {
            stdin = input_lines(read_file(List.get(words, i + 1)))
            i = i + 2
        } else if word == "--cwd" {
            cwd = List.get(words, i + 1)
            i = i + 2
        } else {
            path = word
            i = i + 1
        }
    }
    return RunOptions(grant_kinds: kinds, grant_paths: paths, stdin: stdin, cwd: cwd, path: path, arguments: arguments)
}

// Test driver for one program with the host: `--run [options] FILE [arguments]`. The options are --allow-read,
// --allow-write, --allow-network and --allow-process (each with its scope), --stdin FILE and --cwd DIRECTORY.
// Prints `FILE|path`, what the program prints, and `FAIL|...` and `STOP|` as the other drivers do.
fn run_hosted(words: List[Text]) {
    let options = parse_options(words)
    print("FILE|" + options.path)
    let lexed = lexer.tokenize(read_file(options.path))
    if List.length(lexed.diagnostics) > 0 {
        print("STOP|lexical")
        return
    }
    let outcome = parser.parse_program(lexed.tokens)
    if List.length(outcome.diagnostics) > 0 {
        print("STOP|syntax")
        return
    }
    let analysis = checker.analyze(outcome.program, true)
    if analysis.unsupported != "" {
        print("STOP|unsupported " + analysis.unsupported)
        return
    }
    if has_errors(analysis.problems) {
        print("STOP|check")
        return
    }
    let host = HostCfg(
        arguments: options.arguments, declared_kinds: declared_kinds_of(analysis.node),
        declared_paths: declared_paths_of(analysis.node), grant_kinds: options.grant_kinds,
        grant_paths: options.grant_paths, cwd: options.cwd
    )
    let prog = build_prog(analysis.node, host)
    let start = start_machine(prog, start_fuel())
    let tracing = Tracing(watch: [], invoked: [], skipped: [], inputs: options.stdin)
    let done = run_machine(prog, with_tracing(start, tracing))
    for line in done.out {
        print(line)
    }
    print(stop_text(done))
}

// The steps a run may take before it is stopped.
fn start_fuel() gives Int {
    return 300000000
}

// Whether any of the problems is an error: the warnings of a program do not stop it.
fn has_errors(problems: List[parser.Problem]) gives Bool {
    for problem in problems {
        if not Text.starts_with(problem.code, "W") {
            return true
        }
    }
    return false
}

fn problem_line(problem: parser.Problem) gives Text {
    return (
        "FAIL|" + problem.code + "|" + problem.label + "|" + problem.hint + "|"
        + parser.join_texts(problem.notes, "~~") + "|"
        + parser.span_text(problem.line, problem.column, problem.end_line, problem.end_column)
    )
}

// Test driver: every argument is a file. For each one prints `FILE|path`, then what the program prints, then
// `FAIL|...` with the diagnostic if it stopped with an error, and `STOP|` with how the run ended.
fn run_files() {
    let files = args()
    var i = 0
    while i < List.length(files)
        shrinks List.length(files) - i
    {
        let path = List.get(files, i)
        print("FILE|" + path)
        let lexed = lexer.tokenize(read_file(path))
        if List.length(lexed.diagnostics) > 0 {
            print("STOP|lexical")
        } else {
            let outcome = parser.parse_program(lexed.tokens)
            if List.length(outcome.diagnostics) > 0 {
                print("STOP|syntax")
            } else {
                let analysis = checker.analyze(outcome.program, true)
                if analysis.unsupported != "" {
                    print("STOP|unsupported " + analysis.unsupported)
                } else if has_errors(analysis.problems) {
                    print("STOP|check")
                } else {
                    let prog = build_prog(analysis.node, declared_host(analysis.node))
                    let done = run_machine(prog, start_machine(prog, start_fuel()))
                    for line in done.out {
                        print(line)
                    }
                    print(stop_text(done))
                }
            }
        }
        i = i + 1
    }
}

fn stop_text(m: Machine) gives Text {
    return match m.control {
        Control.CHalt => "STOP|ok " + to_text(start_fuel() - m.fuel)
        Control.CDone(v) => "STOP|ok " + to_text(start_fuel() - m.fuel)
        Control.CFail(problem) => problem_line(problem) + "\nSTOP|fail " + problem.code
        _ => "STOP|fuel"
    }
}

fn drop_first_text_item(items: List[Text]) gives List[Text] {
    var rest: List[Text] = []
    var i = 1
    while i < List.length(items)
        shrinks List.length(items) - i
    {
        rest = List.append(rest, List.get(items, i))
        i = i + 1
    }
    return rest
}

// Test driver for the examples: every argument after `--test` is a file. For each one prints `FILE|path`, what `nex test`
// reports of each example, and `STOP|`.
fn run_tests() {
    let files = args()
    var i = 1
    while i < List.length(files)
        shrinks List.length(files) - i
    {
        let path = List.get(files, i)
        print("FILE|" + path)
        let text = read_file(path)
        let lexed = lexer.tokenize(text)
        if List.length(lexed.diagnostics) > 0 {
            print("STOP|lexical")
        } else {
            let outcome = parser.parse_program(lexed.tokens)
            if List.length(outcome.diagnostics) > 0 {
                print("STOP|syntax")
            } else {
                let analysis = checker.analyze(outcome.program, false)
                if analysis.unsupported != "" {
                    print("STOP|unsupported " + analysis.unsupported)
                } else if has_errors(analysis.problems) {
                    print("STOP|check")
                } else {
                    run_examples(build_prog(analysis.node, declared_host(analysis.node)), text, analysis.node)
                    print("STOP|ok")
                }
            }
        }
        i = i + 1
    }
}

fn main() {
    if List.length(args()) > 0 and List.get(args(), 0) == "--run" {
        run_hosted(drop_first_text_item(args()))
    } else if List.length(args()) > 0 and List.get(args(), 0) == "--test" {
        run_tests()
    } else {
        run_files()
    }
}
