// `nex`, written in NEXORA: check, run and test a program and the modules it imports (decision 0025).
//
//     nex run selfhost/nex.nex --allow-read . --allow-write . -- check  FILE
//     nex run selfhost/nex.nex --allow-read . --allow-write . -- run    [OPTIONS] FILE [ARGUMENTS]
//     nex run selfhost/nex.nex --allow-read . --allow-write . -- test   FILE [--function NAME]
//
// The options of `run` are --allow-read, --allow-write, --allow-network and --allow-process (each with its scope),
// --stdin FILE, --cwd DIRECTORY, --max-text, --max-output, --max-input and --max-source. It is the lexer, the parser, the
// checker, the project loader and the interpreter of this directory, all written in NEXORA, with the messages of `nex`.
//
// What a program written in the language cannot do (no standard error, no exit status, no way to ask whether a file can be read)
// is done by three functions of this file, `err`, `exit_with` and `file_problem`, that the executable made by cgen.nex replaces with
// C ones. The definitions here are what Python runs: they write everything to the standard output and set no status. In the
// executable, the diagnostics and the summaries of a failure go to the standard error, the results to the standard output, and
// the process ends with the status `nex` ends with (0 success, 1 invalid program, 2 usage, 3 the program failed, 4 unreadable
// file, 5 a contract was broken, 6 a test did not pass, 70 something this implementation cannot do yet).
//   * It cannot read the standard input: the input of a program that is run comes from a file, given with --stdin.
//   * It prints a whole line at a time, so when the output limit stops a program in the middle of a line, that part of the
//     line is printed with a line break.

import "parser.nex"
import "project.nex"
import "render.nex"
import "titles.nex"
import "interpreter.nex"
import "info.nex"
import "report.nex"

uses read "."
uses write "."

fn plural(count: Int) gives Text {
    if count >= 100 {
        return to_text(count) + " errors (stopped at the limit of 100; there may be more)"
    }
    return counted(count, "error")
}

fn counted(count: Int, noun: Text) gives Text {
    if count == 1 {
        return "1 " + noun
    }
    return to_text(count) + " " + noun + "s"
}

// A line on the standard error (replaced in the executable).
fn err(text: Text) {
    print(text)
}

// The status the process ends with (replaced in the executable).
fn exit_with(code: Int) {
    print_nothing(code)
}

fn print_nothing(_code: Int) {
}

// Why a file cannot be read, or "" when it can (replaced in the executable).
fn file_problem(path: Text) gives Text {
    return ""
}

// What a failure writes: the diagnostics and a summary line as text, or the `nexora.diagnostics/1` document with --format json (on
// the standard output for `check`, on the standard error for `run`, as `nex` does).
fn fail_with(path: Text, reports: List[report.Report], format: Text, to_stdout: Bool, summary: Text) {
    if format == "json" {
        if to_stdout {
            print(report.document(path, reports))
        } else {
            err(report.document(path, reports))
        }
    } else {
        show_reports(reports)
        err("error: " + path + ": " + summary)
    }
}

// The time and memory limits of `nex run`, in the executable: whether the system can apply them (replaced in the executable).
fn prepare_timeout(seconds: Text, message: Text) gives Bool {
    return false
}

fn start_timeout() {
}

fn set_memory_limit(bytes: Int, message: Text) gives Bool {
    return false
}

// A file that cannot be read is E0001, shown as `nex` shows it, and status 4. True when the file can be read.
fn is_readable(path: Text, summary: Text, format: Text, to_stdout: Bool) gives Bool {
    let reason = file_problem(path)
    if reason == "" {
        return true
    }
    let problem = parser.Problem(
        code: "E0001", label: reason + ": " + path, hint: "", notes: [], line: 0, column: 0, end_line: 0, end_column: 0
    )
    if format == "json" {
        fail_with(path, [report.Report(problem: problem, file: path)], format, to_stdout, summary)
    } else {
        // There is no text of the file to quote.
        err(render.render(problem, path, []))
        err("")
        err("error: " + path + ": " + summary)
    }
    exit_with(4)
    return false
}

fn is_error(problem: parser.Problem) gives Bool {
    return not Text.starts_with(problem.code, "W")
}

fn count_errors(reports: List[report.Report]) gives Int {
    var errors = 0
    for report in reports {
        if is_error(report.problem) {
            errors = errors + 1
        }
    }
    return errors
}

fn show(problem: parser.Problem, file: Text) {
    err(render.render(problem, file, render.lines_of(read_file(file))))
}

fn show_reports(reports: List[report.Report]) {
    for report in reports {
        show(report.problem, report.file)
        err("")
    }
}

fn limit_problem(label: Text) gives parser.Problem {
    return parser.Problem(
        code: "E3015", label: label, hint: "", notes: [], line: 0, column: 0, end_line: 0, end_column: 0
    )
}

// The modules of the program, checked. `stop` says why it cannot go on, or is empty.
type Loaded = { results: List[project.Checked], stop: Text, node: parser.Node }

fn load_and_check(path: Text, require_main: Bool, max_source: Int, format: Text) gives Loaded {
    let loaded = project.load_limited(path, max_source)
    if loaded.over != "" {
        if Text.starts_with(loaded.over, "?") {
            return Loaded(
                results: [], stop: "the bytes of a file with characters that are not ASCII cannot be counted for --max-source",
                node: parser.Node.Null()
            )
        }
        let limit = limit_problem("--max-source limit exceeded (" + to_text(max_source) + ")")
        if format == "json" {
            err(report.document(path, [report.Report(problem: limit, file: loaded.over)]))
        } else {
            err(render.render(limit, loaded.over, []))
        }
        return Loaded(results: [], stop: "limit", node: parser.Node.Null())
    }
    let results = project.check_all(loaded, require_main)
    for result in results {
        if result.unsupported != "" {
            return Loaded(
                results: results, stop: "this implementation cannot check yet: " + result.unsupported,
                node: parser.Node.Null()
            )
        }
    }
    let last = List.get(results, List.length(results) - 1)
    if List.length(results) == 1 {
        return Loaded(results: results, stop: "", node: last.node)
    }
    return Loaded(results: results, stop: "", node: project.link(results))
}

fn check_command(path: Text, format: Text) {
    if not is_readable(path, "check failed with 1 error", format, true) {
        return
    }
    let loaded = load_and_check(path, true, 0, format)
    if loaded.stop != "" {
        if loaded.stop != "limit" {
            err("error: " + path + ": " + loaded.stop)
        }
        exit_with(70)
        return
    }
    let reports = report.reports_of(loaded.results)
    let errors = count_errors(reports)
    if format == "json" {
        print(report.document(path, reports))
        if errors > 0 {
            exit_with(1)
        }
        return
    }
    show_reports(reports)
    if errors > 0 {
        err("error: " + path + ": check failed with " + plural(errors))
        exit_with(1)
    } else if List.length(reports) > 0 {
        print("✓ Check passed with " + counted(List.length(reports), "warning") + ": " + path)
    } else {
        print("✓ Check passed: " + path)
    }
}

fn run_command(given: List[Text], format: Text) {
    if not limits_are_valid(given) {
        return
    }
    let timeout = take_option(given, "--timeout")
    let memory = take_option(timeout.rest, "--max-memory")
    let words = memory.rest
    let options = interpreter.parse_options(words)
    let path = options.path
    var timeout_seconds = 0.0
    if timeout.found {
        timeout_seconds = Float.parse(float_text(timeout.value))
        let limit = limit_problem("time limit exceeded (" + to_text(timeout_seconds) + ")")
        var message = render.render(limit, path, [])
        if format == "json" {
            message = report.document(path, [report.Report(problem: limit, file: path)])
        }
        if not prepare_timeout(float_text(timeout.value), message) {
            err("error: --timeout requires a POSIX platform with interval timers")
            exit_with(2)
            return
        }
    }
    if not is_readable(path, "the file could not be read", format, false) {
        return
    }
    if memory.found {
        let exhausted = parser.Problem(
            code: "E3007", label: "The process memory limit was exceeded (--max-memory " + memory.value + ")", hint: "", notes: [],
            line: 0, column: 0, end_line: 0, end_column: 0
        )
        var message = render.render(exhausted, path, []) + "\n\nerror: " + path + ": the program stopped because of a runtime error"
        if format == "json" {
            message = report.document(path, [report.Report(problem: exhausted, file: path)])
        }
        if not set_memory_limit(Int.parse(memory.value), message) {
            err("error: --max-memory is enforced only on Linux; use an OS supervisor on this platform")
            exit_with(2)
            return
        }
    }
    let loaded = load_and_check(path, true, options.max_source, format)
    if loaded.stop != "" {
        if loaded.stop == "limit" {
            exit_with(3)
        } else {
            err("error: " + path + ": " + loaded.stop)
            exit_with(70)
        }
        return
    }
    let reports = report.reports_of(loaded.results)
    let errors = count_errors(reports)
    if errors > 0 {
        fail_with(path, reports, format, false, "not run because of " + plural(errors))
        exit_with(1)
        return
    }
    start_timeout()
    let done = interpreter.execute(loaded.node, options)
    for line in done.printed {
        print(line)
    }
    if done.partial != "" {
        print(done.partial)
    }
    if done.out_of_fuel {
        err("error: " + path + ": the program used all the steps this interpreter allows")
        exit_with(70)
        return
    }
    if not done.failed {
        return
    }
    var file = done.file
    if file == "" {
        file = path
    }
    let failure = [report.Report(problem: done.problem, file: file)]
    if done.problem.code == "E3015" {
        if format == "json" {
            err(report.document(path, failure))
        } else {
            show(done.problem, file)
        }
        exit_with(3)
        return
    }
    if titles.category_of(done.problem.code) == "contract" {
        fail_with(path, failure, format, false, "the program stopped because a contract was broken")
        exit_with(5)
    } else {
        fail_with(path, failure, format, false, "the program stopped because of a runtime error")
        exit_with(3)
    }
}

fn count_status(results: List[interpreter.ExampleResult], function: Text, status: Text) gives Int {
    var total = 0
    for result in results {
        if result.function == function and result.status == status {
            total = total + 1
        }
    }
    return total
}

fn padded(name: Text, width: Int) gives Text {
    var text = name
    while Text.length(text) < width
        shrinks width - Text.length(text)
    {
        text = text + " "
    }
    return text
}

fn test_command(path: Text, only: Text) {
    if not is_readable(path, "the file could not be read", "text", false) {
        return
    }
    let loaded = load_and_check(path, false, 0, "text")
    if loaded.stop != "" {
        if loaded.stop != "limit" {
            err("error: " + path + ": " + loaded.stop)
        }
        exit_with(70)
        return
    }
    let reports = report.reports_of(loaded.results)
    let errors = count_errors(reports)
    if errors > 0 {
        show_reports(reports)
        err("error: " + path + ": not tested because of " + plural(errors))
        exit_with(1)
        return
    }
    let text = read_file(path)
    let results = interpreter.evaluate_examples(loaded.node, text, only)
    if List.length(results) == 0 {
        print(path + ": no examples to run")
        err("error: " + path + ": nothing was tested")
        exit_with(6)
        return
    }
    var functions: List[Text] = []
    for result in results {
        if not List.contains(functions, result.function) {
            functions = List.append(functions, result.function)
        }
    }
    if only != "" {
        print(path + ": " + counted(List.length(results), "example") + " of '" + only + "'")
    } else {
        print(path + ": " + counted(List.length(results), "example") + " in " + counted(List.length(functions), "function"))
    }
    var width = 0
    for name in functions {
        if Text.length(name) > width {
            width = Text.length(name)
        }
    }
    for name in functions {
        var parts: List[Text] = []
        for status in ["passed", "failed", "error"] {
            let count = count_status(results, name, status)
            if count > 0 {
                parts = List.append(parts, to_text(count) + " " + status)
            }
        }
        print("  " + padded(name, width) + "   " + parser.join_texts(parts, ", "))
    }
    let lines = render.lines_of(text)
    var failed = 0
    var broken = 0
    for result in results {
        if result.status == "failed" {
            failed = failed + 1
        } else if result.status == "error" {
            broken = broken + 1
        }
        if result.status != "passed" {
            err("")
            err(render.render(result.problem, path, lines))
            if List.length(result.out) > 0 {
                err("")
                err("output of example " + to_text(result.index) + " of '" + result.function + "':")
                for line in result.out {
                    err("    " + line)
                }
            }
        }
    }
    if failed + broken == 0 {
        print("✓ " + counted(List.length(results), "example") + " passed: " + path)
    } else {
        err("")
        err(
            "error: " + path + ": " + to_text(failed + broken) + " of " + counted(List.length(results), "example")
            + " did not pass (" + to_text(failed) + " failed, " + counted(broken, "error") + ")"
        )
        exit_with(6)
    }
}

// Whether `--format` was written at all.
fn has_format(words: List[Text]) gives Bool {
    for word in words {
        if word == "--format" or Text.starts_with(word, "--format=") {
            return true
        }
    }
    return false
}

fn usage() {
    err("usage: nex [-h] [--version] <command> ...")
    err("       nex check FILE")
    err("       nex run [OPTIONS] FILE [ARGUMENTS]")
    err("       nex test FILE [--function NAME]")
    err("       nex inspect FILE")
    exit_with(2)
}

// The options that take a value, to know where the file of a command starts.
fn takes_value(word: Text) gives Bool {
    for name in ["--allow-read", "--allow-write", "--allow-network", "--allow-process", "--stdin", "--cwd", "--max-text", "--max-output", "--max-input", "--max-source", "--function", "--format", "--timeout", "--max-memory"] {
        if word == name {
            return true
        }
    }
    return false
}

// `--format` (or `--format=...`) taken out of the words of a command. For `run` it is looked for only before the file: what comes
// after the file belongs to the program.
type Format = { format: Text, rest: List[Text], bad: Text }

fn take_format(words: List[Text], before_file: Bool) gives Format {
    var format = "text"
    var rest: List[Text] = []
    var bad = ""
    var i = 0
    var in_file = false
    while i < List.length(words)
        shrinks List.length(words) - i
    {
        let word = List.get(words, i)
        var value = ""
        var found = false
        if not (before_file and in_file) {
            if word == "--format" and i + 1 < List.length(words) {
                value = List.get(words, i + 1)
                found = true
                i = i + 1
            } else if Text.starts_with(word, "--format=") {
                value = Text.slice(word, 9, Text.length(word))
                found = true
            }
        }
        if found {
            if value == "text" or value == "json" {
                format = value
            } else {
                bad = value
            }
        } else {
            rest = List.append(rest, word)
            if before_file and not in_file {
                if takes_value(word) and i + 1 < List.length(words) {
                    rest = List.append(rest, List.get(words, i + 1))
                    i = i + 1
                } else if not Text.starts_with(word, "-") {
                    in_file = true
                }
            }
        }
        i = i + 1
    }
    return Format(format: format, rest: rest, bad: bad)
}

// An option of `run` with a value, looked for before the file, and the words without it.
type Taken = { found: Bool, value: Text, rest: List[Text] }

fn take_option(words: List[Text], name: Text) gives Taken {
    var rest: List[Text] = []
    var found = false
    var value = ""
    var in_file = false
    var i = 0
    while i < List.length(words)
        shrinks List.length(words) - i
    {
        let word = List.get(words, i)
        if not in_file and word == name and i + 1 < List.length(words) {
            found = true
            value = List.get(words, i + 1)
            i = i + 1
        } else {
            rest = List.append(rest, word)
            if not in_file {
                if takes_value(word) and i + 1 < List.length(words) {
                    rest = List.append(rest, List.get(words, i + 1))
                    i = i + 1
                } else if not Text.starts_with(word, "-") {
                    in_file = true
                }
            }
        }
        i = i + 1
    }
    return Taken(found: found, value: value, rest: rest)
}

// A number of seconds as a Float text: "1" is read as 1.0, as Python does for --timeout. "" when it is not a number.
fn float_text(value: Text) gives Text {
    if Float.can_parse(value) {
        return value
    }
    if Int.can_parse(value) {
        return value + ".0"
    }
    return ""
}

// The six limits of `run` must be greater than zero (a usage error, status 2, as in Python).
fn limits_are_valid(words: List[Text]) gives Bool {
    for name in ["--timeout", "--max-output", "--max-text", "--max-source", "--max-input", "--max-memory"] {
        let taken = take_option(words, name)
        if taken.found {
            var positive = false
            if name == "--timeout" {
                positive = float_text(taken.value) != "" and Float.parse(float_text(taken.value)) > 0.0
            } else {
                positive = Int.can_parse(taken.value) and Int.parse(taken.value) > 0
            }
            if not positive {
                err("error: " + name + " must be greater than zero")
                exit_with(2)
                return false
            }
        }
    }
    return true
}

// `nex inspect FILE`: the syntax tree as JSON (nexora.inspect/3), with the type of every expression the checker could type.
fn inspect_command(path: Text) {
    let reason = file_problem(path)
    if reason != "" {
        let problem = parser.Problem(
            code: "E0001", label: reason + ": " + path, hint: "", notes: [], line: 0, column: 0, end_line: 0, end_column: 0
        )
        print(report.inspect_document(path, [report.Report(problem: problem, file: path)], false, parser.Node.Null()))
        exit_with(4)
        return
    }
    let loaded = load_and_check(path, true, 0, "json")
    if loaded.stop != "" {
        if loaded.stop != "limit" {
            err("error: " + path + ": " + loaded.stop)
        }
        exit_with(70)
        return
    }
    let last = List.get(loaded.results, List.length(loaded.results) - 1)
    let reports = report.reports_of(loaded.results)
    var program = last.typed
    if last.module.reason == "lexical" and not last.module.clean {
        program = parser.Node.Null()
    }
    print(report.inspect_document(path, reports, last.module.clean, program))
    if count_errors(reports) > 0 {
        exit_with(1)
    }
}

fn rest_of(words: List[Text]) gives List[Text] {
    var rest: List[Text] = []
    var i = 1
    while i < List.length(words)
        shrinks List.length(words) - i
    {
        rest = List.append(rest, List.get(words, i))
        i = i + 1
    }
    return rest
}

fn main() {
    let given = args()
    if List.length(given) == 1 and List.get(given, 0) == "--version" {
        print("NEXORA " + info.version())
        return
    }
    if List.length(given) < 2 {
        usage()
        return
    }
    let command = List.get(given, 0)
    let taken = take_format(rest_of(given), command == "run")
    if taken.bad != "" {
        err("nex " + command + ": error: argument --format: invalid choice: '" + taken.bad + "' (choose from text, json)")
        exit_with(2)
        return
    }
    let words = taken.rest
    if command == "check" and List.length(words) >= 1 {
        check_command(List.get(words, 0), taken.format)
    } else if command == "run" and List.length(words) >= 1 {
        run_command(words, taken.format)
    } else if command == "inspect" and List.length(words) >= 1 {
        if taken.format == "text" and has_format(rest_of(given)) {
            err("nex inspect: error: argument --format: invalid choice: 'text' (choose from json)")
            exit_with(2)
        } else {
            inspect_command(List.get(words, 0))
        }
    } else if command == "test" and List.length(words) >= 1 {
        if taken.format == "json" {
            err("error: nex test --format json is not supported by this implementation yet")
            exit_with(70)
            return
        }
        var only = ""
        if List.length(words) >= 3 and List.get(words, 1) == "--function" {
            only = List.get(words, 2)
        }
        test_command(List.get(words, 0), only)
    } else {
        usage()
    }
}
