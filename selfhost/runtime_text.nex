// The runtime of the C that cgen.nex writes, as text. Generated by selfhost/make_runtime.py from
// selfhost/runtime/nexora_rt.h: do not edit it by hand.

pub fn runtime_lines() gives List[Text] {
    var lines: List[Text] = []
    lines = List.append(lines, "/* The runtime of the programs that selfhost/cgen.nex compiles (decision 0026).")
    lines = List.append(lines, " *")
    lines = List.append(lines, " * It is embedded, as it is, at the top of every generated C file. It does what the interpreter does that is not the program:")
    lines = List.append(lines, " * Int arithmetic with its checks, Text as a sequence of code points, the stack of calls and loops that explains an error, and")
    lines = List.append(lines, " * the text of a diagnostic exactly as `nex` writes it (diagnostics.py, `render`). C11 and the overflow builtins of GCC and")
    lines = List.append(lines, " * Clang are all it needs.")
    lines = List.append(lines, " */")
    lines = List.append(lines, "/* The POSIX parts (signals, timers, limits of a process) are not declared by the headers of a system when the file is compiled as")
    lines = List.append(lines, " * strict C11 (musl, for instance); this asks for them. Windows has none of them and the code that uses them is left out there. */")
    lines = List.append(lines, "#if !defined(_WIN32) && !defined(_GNU_SOURCE)")
    lines = List.append(lines, "#define _GNU_SOURCE 1")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "#include <errno.h>")
    lines = List.append(lines, "#include <stdbool.h>")
    lines = List.append(lines, "#include <stdint.h>")
    lines = List.append(lines, "#include <stdio.h>")
    lines = List.append(lines, "#include <stdlib.h>")
    lines = List.append(lines, "#include <string.h>")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* With -DRT_STATS the runtime counts what it does and prints the counts when the program ends (a tool for tuning it). */")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "static unsigned long long rt_stat[16];")
    lines = List.append(lines, "static const char *const rt_stat_names[16] = \{\"allocations\", \"bytes\", \"collections\", \"field\", \"is_kind\", \"eq\", \"record_new\",")
    lines = List.append(lines, "                                              \"variant_new\", \"list_new\", \"list_append\", \"calls\", \"text_compare\", \"\", \"\", \"\", \"\"};")
    lines = List.append(lines, "#define RT_COUNT(i) (rt_stat[i]++)")
    lines = List.append(lines, "#define RT_COUNT_BY(i, n) (rt_stat[i] += (unsigned long long)(n))")
    lines = List.append(lines, "/* How many times each function of the program was called. */")
    lines = List.append(lines, "static const char *rt_fn_name[4096];")
    lines = List.append(lines, "static unsigned long long rt_fn_count[4096];")
    lines = List.append(lines, "static int rt_fn_total = 0;")
    lines = List.append(lines, "static void rt_count_function(const char *name) \{")
    lines = List.append(lines, "    for (int i = 0; i < rt_fn_total; i++) \{")
    lines = List.append(lines, "        if (rt_fn_name[i] == name) \{ rt_fn_count[i]++; return; }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (rt_fn_total < 4096) \{ rt_fn_name[rt_fn_total] = name; rt_fn_count[rt_fn_total++] = 1; }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "static void rt_print_stats(void) \{")
    lines = List.append(lines, "    for (int i = 0; i < 16; i++) \{")
    lines = List.append(lines, "        if (rt_stat_names[i][0]) fprintf(stderr, \"stat %-14s %llu\\n\", rt_stat_names[i], rt_stat[i]);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int round = 0; round < 25; round++) \{")
    lines = List.append(lines, "        int best = -1;")
    lines = List.append(lines, "        for (int i = 0; i < rt_fn_total; i++) \{")
    lines = List.append(lines, "            if (best < 0 || rt_fn_count[i] > rt_fn_count[best]) best = i;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        if (best < 0 || rt_fn_count[best] == 0) break;")
    lines = List.append(lines, "        fprintf(stderr, \"fn %-28s %llu\\n\", rt_fn_name[best], rt_fn_count[best]);")
    lines = List.append(lines, "        rt_fn_count[best] = 0;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "#define RT_COUNT(i) ((void)0)")
    lines = List.append(lines, "#define RT_COUNT_BY(i, n) ((void)0)")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{")
    lines = List.append(lines, "    const char *p;")
    lines = List.append(lines, "    int64_t bytes;")
    lines = List.append(lines, "    int64_t len; /* code points: what Text.length counts */")
    lines = List.append(lines, "} rt_text;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The files of the program: the one that runs and the modules it imports. A diagnostic quotes the file of the function that")
    lines = List.append(lines, " * failed, so each one is kept with its path and its lines. */")
    lines = List.append(lines, "static const char *rt_path = \"\";          /* the file the diagnostic being drawn is about */")
    lines = List.append(lines, "static const char *const *rt_src = 0;")
    lines = List.append(lines, "static int rt_src_lines = 0;")
    lines = List.append(lines, "static const char *rt_entry = \"\";         /* the path the program was given, which `nex run` closes its report with */")
    lines = List.append(lines, "static int rt_nfiles = 0;")
    lines = List.append(lines, "static const char *const *rt_file_path = 0;")
    lines = List.append(lines, "static const char *const *const *rt_file_lines = 0;")
    lines = List.append(lines, "static const int *rt_file_count = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Memory. A small block (up to 256 bytes) comes from a page of blocks of its size, and a free one is taken from a list in a few")
    lines = List.append(lines, " * instructions; a big one comes from malloc and is kept in a table. When a good deal has been allocated, the stack is searched")
    lines = List.append(lines, " * for what still points into a block (any word that does, whatever it is: the search is conservative), what those blocks point")
    lines = List.append(lines, " * to is searched in turn, and the rest is given back. A block of text bytes is `raw`: it points to nothing, so it is not")
    lines = List.append(lines, " * searched. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "#include <setjmp.h>")
    lines = List.append(lines, "#include <time.h>")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "#include <malloc.h>")
    lines = List.append(lines, "#define rt_page_alloc(size) _aligned_malloc((size), (size))")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "#define rt_page_alloc(size) aligned_alloc((size), (size))")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "#define RT_PAGE ((size_t)1 << 16)")
    lines = List.append(lines, "#define RT_PAGE_HEADER ((size_t)8224) /* the header, then 4,096 marks and 4,096 \"in use\" bytes: the most blocks a page holds */")
    lines = List.append(lines, "#define RT_SMALL_MAX 256")
    lines = List.append(lines, "#define RT_CLASSES 16 /* sizes 16, 32, ... 256 */")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct rt_page \{")
    lines = List.append(lines, "    struct rt_page *next;")
    lines = List.append(lines, "    uint32_t size;")
    lines = List.append(lines, "    uint32_t count;")
    lines = List.append(lines, "    uint32_t inverse; /* 2^32 / size, to find which block an address is in without dividing */")
    lines = List.append(lines, "    unsigned char raw;")
    lines = List.append(lines, "} rt_page;")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{ char *p; size_t size; unsigned char raw, mark; } rt_block; /* the big ones */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_page *rt_pages = 0;")
    lines = List.append(lines, "static void *rt_free_list[2][RT_CLASSES];")
    lines = List.append(lines, "static rt_block *rt_blocks = 0;")
    lines = List.append(lines, "static size_t rt_nblocks = 0, rt_cap_blocks = 0;")
    lines = List.append(lines, "static size_t rt_since_gc = 0, rt_threshold = (size_t)48 << 20, rt_floor = (size_t)48 << 20;")
    lines = List.append(lines, "static void *rt_stack_base = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The addresses of the pages, to tell whether a word points into one. */")
    lines = List.append(lines, "static uintptr_t *rt_page_set = 0;")
    lines = List.append(lines, "static size_t rt_page_set_cap = 0, rt_page_set_count = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{ char *p; size_t size; } rt_mark_item;")
    lines = List.append(lines, "static rt_mark_item *rt_mark_stack = 0;")
    lines = List.append(lines, "static size_t rt_mark_count = 0, rt_mark_cap = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The exit status of the process: what a command-line tool written in NEXORA (nex.nex) sets with `exit_with`. */")
    lines = List.append(lines, "static int rt_exit_status = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* What to write when memory runs out, if the program has one (the worker of the playground answers with a result that says so). */")
    lines = List.append(lines, "static const char *rt_oom_reply = 0;")
    lines = List.append(lines, "/* What a command-line tool writes on the standard error when memory runs out, and the status it ends with (nex run --max-memory). */")
    lines = List.append(lines, "static const char *rt_oom_stderr = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_out_of_memory(void) \{")
    lines = List.append(lines, "    if (rt_oom_stderr) \{")
    lines = List.append(lines, "        fflush(stdout);")
    lines = List.append(lines, "        fputs(rt_oom_stderr, stderr);")
    lines = List.append(lines, "        fputc('\\n', stderr);")
    lines = List.append(lines, "        exit(3);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (rt_oom_reply) \{")
    lines = List.append(lines, "        fputs(rt_oom_reply, stdout);")
    lines = List.append(lines, "        fflush(stdout);")
    lines = List.append(lines, "        exit(0);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fputs(\"error: out of memory\\n\", stderr);")
    lines = List.append(lines, "    exit(3);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static size_t rt_page_hash(uintptr_t page, size_t cap) \{ return (size_t)((page >> 16) * 0x9E3779B97F4A7C15ULL) & (cap - 1); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_page_set_add(uintptr_t page) \{")
    lines = List.append(lines, "    if ((rt_page_set_count + 1) * 2 > rt_page_set_cap) \{")
    lines = List.append(lines, "        size_t cap = rt_page_set_cap ? rt_page_set_cap * 2 : 1024;")
    lines = List.append(lines, "        uintptr_t *set = (uintptr_t *)calloc(cap, sizeof(uintptr_t));")
    lines = List.append(lines, "        if (!set) rt_out_of_memory();")
    lines = List.append(lines, "        for (size_t i = 0; i < rt_page_set_cap; i++) \{")
    lines = List.append(lines, "            if (rt_page_set[i]) \{")
    lines = List.append(lines, "                size_t at = rt_page_hash(rt_page_set[i], cap);")
    lines = List.append(lines, "                while (set[at]) at = (at + 1) & (cap - 1);")
    lines = List.append(lines, "                set[at] = rt_page_set[i];")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        free(rt_page_set);")
    lines = List.append(lines, "        rt_page_set = set;")
    lines = List.append(lines, "        rt_page_set_cap = cap;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    size_t at = rt_page_hash(page, rt_page_set_cap);")
    lines = List.append(lines, "    while (rt_page_set[at]) at = (at + 1) & (rt_page_set_cap - 1);")
    lines = List.append(lines, "    rt_page_set[at] = page;")
    lines = List.append(lines, "    rt_page_set_count++;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int rt_is_page(uintptr_t page) \{")
    lines = List.append(lines, "    if (!rt_page_set_cap) return 0;")
    lines = List.append(lines, "    size_t at = rt_page_hash(page, rt_page_set_cap);")
    lines = List.append(lines, "    while (rt_page_set[at]) \{")
    lines = List.append(lines, "        if (rt_page_set[at] == page) return 1;")
    lines = List.append(lines, "        at = (at + 1) & (rt_page_set_cap - 1);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static unsigned char *rt_page_marks(rt_page *page) \{ return (unsigned char *)page + sizeof(rt_page); }")
    lines = List.append(lines, "/* Whether each block is in use: a free block holds the link of the list of free blocks, which must not be followed. */")
    lines = List.append(lines, "static unsigned char *rt_page_in_use(rt_page *page) \{ return (unsigned char *)page + sizeof(rt_page) + 4096; }")
    lines = List.append(lines, "static uint32_t rt_block_index(rt_page *page, uintptr_t address) \{")
    lines = List.append(lines, "    return (uint32_t)(((uint64_t)(address - (uintptr_t)page - RT_PAGE_HEADER) * page->inverse) >> 32);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "static char *rt_page_first(rt_page *page) \{ return (char *)page + RT_PAGE_HEADER; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_collect(void);")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A new page of blocks of one size, all of them free. */")
    lines = List.append(lines, "static void rt_new_page(int raw, int class_index) \{")
    lines = List.append(lines, "    rt_page *page = (rt_page *)rt_page_alloc(RT_PAGE);")
    lines = List.append(lines, "    if (!page) \{")
    lines = List.append(lines, "        rt_collect();")
    lines = List.append(lines, "        page = (rt_page *)rt_page_alloc(RT_PAGE);")
    lines = List.append(lines, "        if (!page) rt_out_of_memory();")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    uint32_t size = (uint32_t)((class_index + 1) * 16);")
    lines = List.append(lines, "    page->next = rt_pages;")
    lines = List.append(lines, "    page->size = size;")
    lines = List.append(lines, "    page->count = (uint32_t)((RT_PAGE - RT_PAGE_HEADER) / size);")
    lines = List.append(lines, "    page->raw = (unsigned char)raw;")
    lines = List.append(lines, "    page->inverse = (uint32_t)(((uint64_t)1 << 32) / size + 1);")
    lines = List.append(lines, "    rt_pages = page;")
    lines = List.append(lines, "    memset(rt_page_marks(page), 0, page->count);")
    lines = List.append(lines, "    memset(rt_page_in_use(page), 0, page->count);")
    lines = List.append(lines, "    rt_page_set_add((uintptr_t)page);")
    lines = List.append(lines, "    char *at = rt_page_first(page);")
    lines = List.append(lines, "    for (uint32_t i = page->count; i > 0; i--) \{")
    lines = List.append(lines, "        char *block = at + (size_t)(i - 1) * size;")
    lines = List.append(lines, "        *(void **)block = rt_free_list[raw][class_index];")
    lines = List.append(lines, "        rt_free_list[raw][class_index] = block;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int rt_block_order(const void *x, const void *y) \{")
    lines = List.append(lines, "    const rt_block *a = (const rt_block *)x, *b = (const rt_block *)y;")
    lines = List.append(lines, "    return a->p < b->p ? -1 : (a->p > b->p ? 1 : 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The big block that holds an address, or -1. The table is sorted while a collection runs. */")
    lines = List.append(lines, "static long rt_find_block(const char *address) \{")
    lines = List.append(lines, "    long lo = 0, hi = (long)rt_nblocks - 1, found = -1;")
    lines = List.append(lines, "    while (lo <= hi) \{")
    lines = List.append(lines, "        long mid = (lo + hi) / 2;")
    lines = List.append(lines, "        if (rt_blocks[mid].p <= address) \{ found = mid; lo = mid + 1; } else \{ hi = mid - 1; }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (found >= 0 && address < rt_blocks[found].p + rt_blocks[found].size) return found;")
    lines = List.append(lines, "    return -1;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_mark_push(char *p, size_t size) \{")
    lines = List.append(lines, "    if (rt_mark_count == rt_mark_cap) \{")
    lines = List.append(lines, "        rt_mark_cap = rt_mark_cap ? rt_mark_cap * 2 : 4096;")
    lines = List.append(lines, "        rt_mark_stack = (rt_mark_item *)realloc(rt_mark_stack, rt_mark_cap * sizeof(rt_mark_item));")
    lines = List.append(lines, "        if (!rt_mark_stack) rt_out_of_memory();")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_mark_stack[rt_mark_count].p = p;")
    lines = List.append(lines, "    rt_mark_stack[rt_mark_count].size = size;")
    lines = List.append(lines, "    rt_mark_count++;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Marks what a word points to, if it points into a block that is in use. */")
    lines = List.append(lines, "static void rt_mark_word(uintptr_t word) \{")
    lines = List.append(lines, "    uintptr_t page_address = word & ~(uintptr_t)(RT_PAGE - 1);")
    lines = List.append(lines, "    if (rt_is_page(page_address)) \{")
    lines = List.append(lines, "        rt_page *page = (rt_page *)page_address;")
    lines = List.append(lines, "        if (word < page_address + RT_PAGE_HEADER) return;")
    lines = List.append(lines, "        size_t index = rt_block_index(page, word);")
    lines = List.append(lines, "        if (index >= page->count || !rt_page_in_use(page)[index]) return;")
    lines = List.append(lines, "        unsigned char *mark = &rt_page_marks(page)[index];")
    lines = List.append(lines, "        if (!*mark) \{")
    lines = List.append(lines, "            *mark = 1;")
    lines = List.append(lines, "            if (!page->raw) rt_mark_push(rt_page_first(page) + index * page->size, page->size);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (rt_nblocks == 0) return;")
    lines = List.append(lines, "    long found = rt_find_block((const char *)word);")
    lines = List.append(lines, "    if (found >= 0 && !rt_blocks[found].mark) \{")
    lines = List.append(lines, "        rt_blocks[found].mark = 1;")
    lines = List.append(lines, "        if (!rt_blocks[found].raw) rt_mark_push(rt_blocks[found].p, rt_blocks[found].size);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_mark_words(const char *lo, const char *hi) \{")
    lines = List.append(lines, "    uintptr_t start = ((uintptr_t)lo + sizeof(void *) - 1) & ~(uintptr_t)(sizeof(void *) - 1);")
    lines = List.append(lines, "    for (uintptr_t at = start; at + sizeof(void *) <= (uintptr_t)hi; at += sizeof(void *)) \{")
    lines = List.append(lines, "        rt_mark_word(*(const uintptr_t *)at);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_collect(void) \{")
    lines = List.append(lines, "    RT_COUNT(2);")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "    clock_t gc_started = clock();")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    if (!rt_stack_base) \{ rt_since_gc = 0; return; }")
    lines = List.append(lines, "    if (rt_nblocks > 1) qsort(rt_blocks, rt_nblocks, sizeof(rt_block), rt_block_order);")
    lines = List.append(lines, "    for (size_t i = 0; i < rt_nblocks; i++) rt_blocks[i].mark = 0;")
    lines = List.append(lines, "    jmp_buf registers;")
    lines = List.append(lines, "    setjmp(registers);")
    lines = List.append(lines, "    const char *here = (const char *)&registers;")
    lines = List.append(lines, "    const char *base = (const char *)rt_stack_base;")
    lines = List.append(lines, "    if (here < base) rt_mark_words(here, base + sizeof(void *)); else rt_mark_words(base, here + sizeof registers);")
    lines = List.append(lines, "    while (rt_mark_count > 0) \{")
    lines = List.append(lines, "        rt_mark_item item = rt_mark_stack[--rt_mark_count];")
    lines = List.append(lines, "        rt_mark_words(item.p, item.p + item.size);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    size_t live = 0;")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "    \{")
    lines = List.append(lines, "        size_t sizes[8] = \{0}, counts[8] = \{0};")
    lines = List.append(lines, "        int distinct = 0;")
    lines = List.append(lines, "        for (size_t i = 0; i < rt_nblocks; i++) \{")
    lines = List.append(lines, "            if (!rt_blocks[i].mark) continue;")
    lines = List.append(lines, "            int at = -1;")
    lines = List.append(lines, "            for (int k = 0; k < distinct; k++) if (sizes[k] == rt_blocks[i].size) at = k;")
    lines = List.append(lines, "            if (at < 0 && distinct < 8) \{ sizes[distinct] = rt_blocks[i].size; at = distinct++; }")
    lines = List.append(lines, "            if (at >= 0) counts[at]++;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        fprintf(stderr, \"  live big blocks by size:\");")
    lines = List.append(lines, "        for (int k = 0; k < distinct; k++) fprintf(stderr, \" %zu x%zu\", sizes[k], counts[k]);")
    lines = List.append(lines, "        fprintf(stderr, \"\\n\");")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    /* The big blocks that nothing points to are freed. */")
    lines = List.append(lines, "    size_t kept = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i < rt_nblocks; i++) \{")
    lines = List.append(lines, "        if (rt_blocks[i].mark) \{")
    lines = List.append(lines, "            live += rt_blocks[i].size;")
    lines = List.append(lines, "            rt_blocks[kept++] = rt_blocks[i];")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            free(rt_blocks[i].p);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_nblocks = kept;")
    lines = List.append(lines, "    /* The small ones are put back on the lists of free blocks, and the marks are cleared. */")
    lines = List.append(lines, "    for (int r = 0; r < 2; r++) \{")
    lines = List.append(lines, "        for (int c = 0; c < RT_CLASSES; c++) rt_free_list[r][c] = 0;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (rt_page *page = rt_pages; page; page = page->next) \{")
    lines = List.append(lines, "        unsigned char *marks = rt_page_marks(page);")
    lines = List.append(lines, "        unsigned char *in_use = rt_page_in_use(page);")
    lines = List.append(lines, "        int class_index = (int)(page->size / 16) - 1;")
    lines = List.append(lines, "        char *first = rt_page_first(page);")
    lines = List.append(lines, "        for (uint32_t i = page->count; i > 0; i--) \{")
    lines = List.append(lines, "            if (marks[i - 1]) \{")
    lines = List.append(lines, "                marks[i - 1] = 0;")
    lines = List.append(lines, "                live += page->size;")
    lines = List.append(lines, "            } else \{")
    lines = List.append(lines, "                char *block = first + (size_t)(i - 1) * page->size;")
    lines = List.append(lines, "                in_use[i - 1] = 0;")
    lines = List.append(lines, "                *(void **)block = rt_free_list[page->raw][class_index];")
    lines = List.append(lines, "                rt_free_list[page->raw][class_index] = block;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_since_gc = 0;")
    lines = List.append(lines, "    rt_threshold = live > rt_floor ? live : rt_floor;")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "    fprintf(stderr, \"gc: live %zu bytes, %zu big blocks, %.1f ms\\n\", live, rt_nblocks, (double)(clock() - gc_started) * 1000.0 / CLOCKS_PER_SEC);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* NEXORA_GC_FLOOR=<bytes> makes it collect much more often, which is how the collector is tested. */")
    lines = List.append(lines, "static void rt_gc_start(void *stack_base) \{")
    lines = List.append(lines, "    rt_stack_base = stack_base;")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "    atexit(rt_print_stats);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    const char *floor = getenv(\"NEXORA_GC_FLOOR\");")
    lines = List.append(lines, "    if (floor) \{")
    lines = List.append(lines, "        rt_floor = (size_t)atol(floor);")
    lines = List.append(lines, "        rt_threshold = rt_floor;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void *rt_alloc_kind(size_t n, int raw, int zero) \{")
    lines = List.append(lines, "    if (n == 0) n = 1;")
    lines = List.append(lines, "    if (rt_since_gc > rt_threshold) rt_collect();")
    lines = List.append(lines, "    RT_COUNT(0);")
    lines = List.append(lines, "    RT_COUNT_BY(1, n);")
    lines = List.append(lines, "    if (n <= RT_SMALL_MAX) \{")
    lines = List.append(lines, "        int class_index = (int)((n + 15) / 16) - 1;")
    lines = List.append(lines, "        void *p = rt_free_list[raw][class_index];")
    lines = List.append(lines, "        if (!p) \{")
    lines = List.append(lines, "            rt_new_page(raw, class_index);")
    lines = List.append(lines, "            p = rt_free_list[raw][class_index];")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        rt_free_list[raw][class_index] = *(void **)p;")
    lines = List.append(lines, "        \{")
    lines = List.append(lines, "            rt_page *page = (rt_page *)((uintptr_t)p & ~(uintptr_t)(RT_PAGE - 1));")
    lines = List.append(lines, "            rt_page_in_use(page)[rt_block_index(page, (uintptr_t)p)] = 1;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        size_t size = (size_t)(class_index + 1) * 16;")
    lines = List.append(lines, "        if (zero) memset(p, 0, size);")
    lines = List.append(lines, "        rt_since_gc += size;")
    lines = List.append(lines, "        return p;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    char *p = (char *)(zero ? calloc(1, n) : malloc(n));")
    lines = List.append(lines, "    if (!p) \{")
    lines = List.append(lines, "        rt_collect();")
    lines = List.append(lines, "        p = (char *)(zero ? calloc(1, n) : malloc(n));")
    lines = List.append(lines, "        if (!p) rt_out_of_memory();")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (rt_nblocks == rt_cap_blocks) \{")
    lines = List.append(lines, "        rt_cap_blocks = rt_cap_blocks ? rt_cap_blocks * 2 : 4096;")
    lines = List.append(lines, "        rt_blocks = (rt_block *)realloc(rt_blocks, rt_cap_blocks * sizeof(rt_block));")
    lines = List.append(lines, "        if (!rt_blocks) rt_out_of_memory();")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_block *block = &rt_blocks[rt_nblocks++];")
    lines = List.append(lines, "    block->p = p;")
    lines = List.append(lines, "    block->size = n;")
    lines = List.append(lines, "    block->raw = (unsigned char)raw;")
    lines = List.append(lines, "    block->mark = 0;")
    lines = List.append(lines, "    rt_since_gc += n;")
    lines = List.append(lines, "    return p;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void *rt_alloc(size_t n) \{ return rt_alloc_kind(n, 0, 1); }")
    lines = List.append(lines, "/* A block that its caller fills at once: it is not cleared. */")
    lines = List.append(lines, "static void *rt_alloc_scan(size_t n) \{ return rt_alloc_kind(n, 0, 0); }")
    lines = List.append(lines, "static void *rt_alloc_raw(size_t n) \{ return rt_alloc_kind(n, 1, 0); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A raw block that grows: the new one is a copy, and the old one is left for the collector. */")
    lines = List.append(lines, "static void *rt_grow_raw(void *old, size_t old_size, size_t size) \{")
    lines = List.append(lines, "    void *p = rt_alloc_raw(size);")
    lines = List.append(lines, "    if (old) memcpy(p, old, old_size < size ? old_size : size);")
    lines = List.append(lines, "    return p;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Text */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int64_t rt_count_points(const char *p, int64_t bytes) \{")
    lines = List.append(lines, "    int64_t n = 0;")
    lines = List.append(lines, "    for (int64_t i = 0; i < bytes; i++) \{")
    lines = List.append(lines, "        if (((unsigned char)p[i] & 0xC0) != 0x80) n++;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return n;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_lit(const char *s) \{")
    lines = List.append(lines, "    rt_text t;")
    lines = List.append(lines, "    t.p = s;")
    lines = List.append(lines, "    t.bytes = (int64_t)strlen(s);")
    lines = List.append(lines, "    t.len = rt_count_points(s, t.bytes);")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_concat(rt_text a, rt_text b) \{")
    lines = List.append(lines, "    rt_text t;")
    lines = List.append(lines, "    char *p = (char *)rt_alloc_raw((size_t)(a.bytes + b.bytes + 1));")
    lines = List.append(lines, "    memcpy(p, a.p, (size_t)a.bytes);")
    lines = List.append(lines, "    memcpy(p + a.bytes, b.p, (size_t)b.bytes);")
    lines = List.append(lines, "    p[a.bytes + b.bytes] = 0;")
    lines = List.append(lines, "    t.p = p;")
    lines = List.append(lines, "    t.bytes = a.bytes + b.bytes;")
    lines = List.append(lines, "    t.len = a.len + b.len;")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int rt_text_compare(rt_text a, rt_text b) \{")
    lines = List.append(lines, "    RT_COUNT(11);")
    lines = List.append(lines, "    if (a.p == b.p && a.bytes == b.bytes) return 0;")
    lines = List.append(lines, "    int64_t n = a.bytes < b.bytes ? a.bytes : b.bytes;")
    lines = List.append(lines, "    int c = memcmp(a.p, b.p, (size_t)n);")
    lines = List.append(lines, "    if (c != 0) return c < 0 ? -1 : 1;")
    lines = List.append(lines, "    return a.bytes < b.bytes ? -1 : (a.bytes > b.bytes ? 1 : 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_int_text(int64_t n) \{")
    lines = List.append(lines, "    char buffer[32];")
    lines = List.append(lines, "    int len = snprintf(buffer, sizeof buffer, \"%lld\", (long long)n);")
    lines = List.append(lines, "    char *p = (char *)rt_alloc_raw((size_t)len + 1);")
    lines = List.append(lines, "    memcpy(p, buffer, (size_t)len + 1);")
    lines = List.append(lines, "    rt_text t = \{p, len, len};")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_bool_text(bool b) \{")
    lines = List.append(lines, "    return b ? rt_lit(\"true\") : rt_lit(\"false\");")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The text of a value as a diagnostic shows it: a Text is quoted and escaped (parser.quote). */")
    lines = List.append(lines, "static rt_text rt_quote(rt_text s) \{")
    lines = List.append(lines, "    char *p = (char *)rt_alloc_raw((size_t)(s.bytes * 2 + 3));")
    lines = List.append(lines, "    int64_t n = 0;")
    lines = List.append(lines, "    p[n++] = '\"';")
    lines = List.append(lines, "    for (int64_t i = 0; i < s.bytes; i++) \{")
    lines = List.append(lines, "        char c = s.p[i];")
    lines = List.append(lines, "        if (c == '\\\\') \{ p[n++] = '\\\\'; p[n++] = '\\\\'; }")
    lines = List.append(lines, "        else if (c == '\"') \{ p[n++] = '\\\\'; p[n++] = '\"'; }")
    lines = List.append(lines, "        else if (c == '\\n') \{ p[n++] = '\\\\'; p[n++] = 'n'; }")
    lines = List.append(lines, "        else if (c == '\\t') \{ p[n++] = '\\\\'; p[n++] = 't'; }")
    lines = List.append(lines, "        else p[n++] = c;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    p[n++] = '\"';")
    lines = List.append(lines, "    p[n] = 0;")
    lines = List.append(lines, "    rt_text t = \{p, n, rt_count_points(p, n)};")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The stack of calls and loops, which is what an error explains itself with. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "enum \{ RT_CALL, RT_COND, RT_MEASURE, RT_BODY };")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{")
    lines = List.append(lines, "    int kind;")
    lines = List.append(lines, "    const char *name;")
    lines = List.append(lines, "    int file; /* the file of the function, for a call */")
    lines = List.append(lines, "    int64_t line;")
    lines = List.append(lines, "    int64_t column; /* for a call; for a loop, the turn */")
    lines = List.append(lines, "} rt_frame;")
    lines = List.append(lines, "")
    lines = List.append(lines, "#define RT_MAX_FRAMES 200000")
    lines = List.append(lines, "#define RT_MAX_CALLS 1000")
    lines = List.append(lines, "#define RT_TRACE 6")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_frame rt_frames[RT_MAX_FRAMES];")
    lines = List.append(lines, "static int rt_top = 0;")
    lines = List.append(lines, "static int rt_calls = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Pieces of text built for a note. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{")
    lines = List.append(lines, "    char *items[128];")
    lines = List.append(lines, "    int count;")
    lines = List.append(lines, "} rt_notes;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static char *rt_format(const char *format, ...);")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_note(rt_notes *notes, char *text) \{")
    lines = List.append(lines, "    if (notes->count < 128) notes->items[notes->count++] = text;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "#include <stdarg.h>")
    lines = List.append(lines, "")
    lines = List.append(lines, "static char *rt_format(const char *format, ...) \{")
    lines = List.append(lines, "    va_list args;")
    lines = List.append(lines, "    va_start(args, format);")
    lines = List.append(lines, "    va_list again;")
    lines = List.append(lines, "    va_copy(again, args);")
    lines = List.append(lines, "    int n = vsnprintf(0, 0, format, args);")
    lines = List.append(lines, "    va_end(args);")
    lines = List.append(lines, "    char *p = (char *)rt_alloc_raw((size_t)n + 1);")
    lines = List.append(lines, "    vsnprintf(p, (size_t)n + 1, format, again);")
    lines = List.append(lines, "    va_end(again);")
    lines = List.append(lines, "    return p;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A buffer for what a note shows: \"a = 1, b = \\\"x\\\"\". */")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct \{")
    lines = List.append(lines, "    char *p;")
    lines = List.append(lines, "    size_t n, cap;")
    lines = List.append(lines, "    int pairs;")
    lines = List.append(lines, "} rt_buf;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_buf_add(rt_buf *b, const char *s, size_t n) \{")
    lines = List.append(lines, "    if (b->n + n + 1 > b->cap) \{")
    lines = List.append(lines, "        size_t cap = (b->n + n + 1) * 2;")
    lines = List.append(lines, "        b->p = (char *)rt_grow_raw(b->p, b->cap, cap);")
    lines = List.append(lines, "        b->cap = cap;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    memcpy(b->p + b->n, s, n);")
    lines = List.append(lines, "    b->n += n;")
    lines = List.append(lines, "    b->p[b->n] = 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_buf_pair(rt_buf *b, const char *name, rt_text shown) \{")
    lines = List.append(lines, "    if (b->pairs++ > 0) rt_buf_add(b, \", \", 2);")
    lines = List.append(lines, "    rt_buf_add(b, name, strlen(name));")
    lines = List.append(lines, "    rt_buf_add(b, \" = \", 3);")
    lines = List.append(lines, "    rt_buf_add(b, shown.p, (size_t)shown.bytes);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_buf_int(rt_buf *b, const char *name, int64_t v) \{ rt_buf_pair(b, name, rt_int_text(v)); }")
    lines = List.append(lines, "static void rt_buf_bool(rt_buf *b, const char *name, bool v) \{ rt_buf_pair(b, name, rt_bool_text(v)); }")
    lines = List.append(lines, "static void rt_buf_text(rt_buf *b, const char *name, rt_text v) \{ rt_buf_pair(b, name, rt_quote(v)); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* \"The values: a = 1\" or \"It was called with: a = 1\", or nothing when there are no pairs. */")
    lines = List.append(lines, "static void rt_buf_note(rt_notes *notes, const char *prefix, rt_buf *b) \{")
    lines = List.append(lines, "    if (b->pairs > 0) rt_note(notes, rt_format(\"%s%s\", prefix, b->p));")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static char *rt_loop_note(const rt_frame *f) \{")
    lines = List.append(lines, "    if (f->kind == RT_COND) \{")
    lines = List.append(lines, "        if (f->column == 0) return rt_format(\"Before the first turn of the loop at line %lld.\", (long long)f->line);")
    lines = List.append(lines, "        return rt_format(\"After turn %lld of the loop at line %lld.\", (long long)f->column, (long long)f->line);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (f->kind == RT_MEASURE) return rt_format(\"Before turn %lld of the loop at line %lld.\", (long long)f->column, (long long)f->line);")
    lines = List.append(lines, "    return rt_format(\"In turn %lld of the loop at line %lld.\", (long long)f->column, (long long)f->line);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_is_loop_note(const char *s) \{")
    lines = List.append(lines, "    return strstr(s, \" of the loop at line \") != 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The notes of an error: its own, the calls that led to it (innermost first, the first `skip` left out) and the loops it left")
    lines = List.append(lines, " * (innermost first). Both lists stop at six entries, as the interpreter cuts them. */")
    lines = List.append(lines, "static void rt_all_notes(rt_notes *out, rt_notes *own, int skip) \{")
    lines = List.append(lines, "    rt_notes calls = \{\{0}, 0}, loops = \{\{0}, 0};")
    lines = List.append(lines, "    int total = 0, skipped = 0, loop_count = 0;")
    lines = List.append(lines, "    bool more_added = false;")
    lines = List.append(lines, "    for (int i = 0; i < own->count; i++) \{")
    lines = List.append(lines, "        if (rt_is_loop_note(own->items[i])) loop_count++;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int i = rt_top - 1; i >= 0; i--) \{")
    lines = List.append(lines, "        const rt_frame *f = &rt_frames[i];")
    lines = List.append(lines, "        if (f->kind == RT_CALL) \{")
    lines = List.append(lines, "            if (skipped < skip) \{")
    lines = List.append(lines, "                skipped++;")
    lines = List.append(lines, "            } else if (f->line > 0) \{")
    lines = List.append(lines, "                total++;")
    lines = List.append(lines, "                if (total <= RT_TRACE) \{")
    lines = List.append(lines, "                    rt_note(&calls, rt_format(\"In '%s', called at line %lld, column %lld.\", f->name, (long long)f->line,")
    lines = List.append(lines, "                                              (long long)f->column));")
    lines = List.append(lines, "                }")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        } else if (!more_added) \{")
    lines = List.append(lines, "            if (loop_count < RT_TRACE) \{")
    lines = List.append(lines, "                rt_note(&loops, rt_loop_note(f));")
    lines = List.append(lines, "                loop_count++;")
    lines = List.append(lines, "            } else \{")
    lines = List.append(lines, "                rt_note(&loops, rt_format(\"... and more loops.\"));")
    lines = List.append(lines, "                more_added = true;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int i = 0; i < own->count; i++) rt_note(out, own->items[i]);")
    lines = List.append(lines, "    for (int i = 0; i < calls.count; i++) rt_note(out, calls.items[i]);")
    lines = List.append(lines, "    if (total > RT_TRACE) \{")
    lines = List.append(lines, "        int hidden = total - RT_TRACE;")
    lines = List.append(lines, "        rt_note(out, rt_format(\"... and %d more call%s.\", hidden, hidden == 1 ? \"\" : \"s\"));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int i = 0; i < loops.count; i++) rt_note(out, loops.items[i]);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A diagnostic, drawn as render() does: the line it points at, carets under the span, the notes and the hint. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static const char *rt_src_line(int64_t line) \{")
    lines = List.append(lines, "    if (line < 1 || line > rt_src_lines) return \"\";")
    lines = List.append(lines, "    return rt_src[line - 1];")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_spaces(FILE *out, int n) \{")
    lines = List.append(lines, "    for (int i = 0; i < n; i++) fputc(' ', out);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int rt_digits(int64_t n) \{")
    lines = List.append(lines, "    char buffer[32];")
    lines = List.append(lines, "    return snprintf(buffer, sizeof buffer, \"%lld\", (long long)n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_render(const char *category, const char *severity, const char *code, const char *title, const char *label,")
    lines = List.append(lines, "                      const char *hint, rt_notes *notes, int64_t line, int64_t column, int64_t end_line,")
    lines = List.append(lines, "                      int64_t end_column) \{")
    lines = List.append(lines, "    fprintf(stderr, \"%s %s[%s]: %s\\n\", category, severity, code, title);")
    lines = List.append(lines, "    if (line <= 0) \{")
    lines = List.append(lines, "        fprintf(stderr, \" --> %s\\n  = %s\\n\", rt_path, label);")
    lines = List.append(lines, "        for (int i = 0; i < notes->count; i++) fprintf(stderr, \"  = note: %s\\n\", notes->items[i]);")
    lines = List.append(lines, "        if (hint && hint[0]) fprintf(stderr, \"  = hint: %s\\n\", hint);")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    const char *text = rt_src_line(line);")
    lines = List.append(lines, "    int gutter = rt_digits(line);")
    lines = List.append(lines, "    int64_t text_points = rt_count_points(text, (int64_t)strlen(text));")
    lines = List.append(lines, "    int64_t width = end_line == line ? end_column - column : text_points - column + 1;")
    lines = List.append(lines, "    if (width < 1) width = 1;")
    lines = List.append(lines, "    rt_spaces(stderr, gutter);")
    lines = List.append(lines, "    fprintf(stderr, \"--> %s:%lld:%lld\\n\", rt_path, (long long)line, (long long)column);")
    lines = List.append(lines, "    rt_spaces(stderr, gutter);")
    lines = List.append(lines, "    fputs(\" |\\n\", stderr);")
    lines = List.append(lines, "    fprintf(stderr, \"%lld | %s\\n\", (long long)line, text);")
    lines = List.append(lines, "    rt_spaces(stderr, gutter);")
    lines = List.append(lines, "    fputs(\" | \", stderr);")
    lines = List.append(lines, "    /* The space in front of the carets copies a tab as a tab, so they line up whatever the terminal draws. */")
    lines = List.append(lines, "    const char *q = text;")
    lines = List.append(lines, "    for (int64_t i = 0; i < column - 1; i++) \{")
    lines = List.append(lines, "        if (*q) \{")
    lines = List.append(lines, "            fputc(*q == '\\t' ? '\\t' : ' ', stderr);")
    lines = List.append(lines, "            q++;")
    lines = List.append(lines, "            while (((unsigned char)*q & 0xC0) == 0x80) q++;")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            fputc(' ', stderr);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int64_t i = 0; i < width; i++) fputc('^', stderr);")
    lines = List.append(lines, "    fprintf(stderr, \" %s\\n\", label);")
    lines = List.append(lines, "    for (int i = 0; i < notes->count; i++) \{")
    lines = List.append(lines, "        rt_spaces(stderr, gutter);")
    lines = List.append(lines, "        fprintf(stderr, \" = note: %s\\n\", notes->items[i]);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (hint && hint[0]) \{")
    lines = List.append(lines, "        rt_spaces(stderr, gutter);")
    lines = List.append(lines, "        fprintf(stderr, \" = hint: %s\\n\", hint);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* An error of the program: the diagnostic, then the line `nex run` closes with, and the exit status of `nex run`. */")
    lines = List.append(lines, "static void rt_fail(const char *category, const char *code, const char *title, const char *label, const char *hint,")
    lines = List.append(lines, "                    rt_notes *own, int skip, int64_t line, int64_t column, int64_t end_line, int64_t end_column) \{")
    lines = List.append(lines, "    rt_notes notes = \{\{0}, 0};")
    lines = List.append(lines, "    rt_all_notes(&notes, own, skip);")
    lines = List.append(lines, "    fflush(stdout);")
    lines = List.append(lines, "    \{")
    lines = List.append(lines, "        /* The file of the function that was running: the caller's when the first `skip` calls are left out. */")
    lines = List.append(lines, "        int index = 0, seen = 0;")
    lines = List.append(lines, "        for (int i = rt_top - 1; i >= 0; i--) \{")
    lines = List.append(lines, "            if (rt_frames[i].kind == RT_CALL) \{")
    lines = List.append(lines, "                if (seen == skip) \{ index = rt_frames[i].file; break; }")
    lines = List.append(lines, "                seen++;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        if (index >= 0 && index < rt_nfiles) \{")
    lines = List.append(lines, "            rt_path = rt_file_path[index];")
    lines = List.append(lines, "            rt_src = rt_file_lines[index];")
    lines = List.append(lines, "            rt_src_lines = rt_file_count[index];")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_render(category, \"error\", code, title, label, hint, &notes, line, column, end_line, end_column);")
    lines = List.append(lines, "    fputc('\\n', stderr);")
    lines = List.append(lines, "    bool contract = strcmp(category, \"contract\") == 0;")
    lines = List.append(lines, "    fprintf(stderr, \"error: %s: the program stopped because %s\\n\", rt_entry,")
    lines = List.append(lines, "            contract ? \"a contract was broken\" : \"of a runtime error\");")
    lines = List.append(lines, "    exit(contract ? 5 : 3);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "#define RT_SPAN int64_t l, int64_t c, int64_t el, int64_t ec")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_runtime(const char *code, const char *title, const char *label, const char *hint, RT_SPAN) \{")
    lines = List.append(lines, "    rt_notes own = \{\{0}, 0};")
    lines = List.append(lines, "    rt_fail(\"runtime\", code, title, label, hint, &own, 0, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Values. Every value of a program is an `rv`: the type was checked before, so the generated code does not carry it, and")
    lines = List.append(lines, " * what a value is (an Int, a record, a variant) is read from its tag when it is shown, compared or matched. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "#include <math.h>")
    lines = List.append(lines, "")
    lines = List.append(lines, "enum \{ RT_UNIT, RT_INT, RT_FLOAT, RT_BOOL, RT_TEXT, RT_LIST, RT_RECORD, RT_VARIANT };")
    lines = List.append(lines, "")
    lines = List.append(lines, "typedef struct rv \{")
    lines = List.append(lines, "    int tag;")
    lines = List.append(lines, "    union \{")
    lines = List.append(lines, "        int64_t i;")
    lines = List.append(lines, "        double f;")
    lines = List.append(lines, "        bool b;")
    lines = List.append(lines, "        rt_text t;")
    lines = List.append(lines, "        void *o;")
    lines = List.append(lines, "    } u;")
    lines = List.append(lines, "} rv;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A list is a count and a view of a buffer of items. The buffer is shared by the lists that were made from each other by adding to")
    lines = List.append(lines, " * the end: `used` says how much of it some list already sees, so a list that sees all of it can be given one more item without")
    lines = List.append(lines, " * copying anything, and an older list, which sees less, is never changed. */")
    lines = List.append(lines, "typedef struct \{ int64_t used, cap; rv items[]; } rt_listbuf;")
    lines = List.append(lines, "typedef struct \{ int64_t n; rv *items; rt_listbuf *buf; } rt_list;")
    lines = List.append(lines, "typedef struct \{ const char *name; int n; const char *const *names; rv f[]; } rt_record;")
    lines = List.append(lines, "/* `owner` is the enum a variant belongs to, or \"\" for the variants of Option and Result. */")
    lines = List.append(lines, "typedef struct \{ const char *owner; const char *kind; int n; rv a[]; } rt_variant;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_unit(void) \{ rv v = \{0}; v.tag = RT_UNIT; v.u.i = 0; return v; }")
    lines = List.append(lines, "static rv rt_int(int64_t n) \{ rv v = \{0}; v.tag = RT_INT; v.u.i = n; return v; }")
    lines = List.append(lines, "static rv rt_float(double x) \{ rv v = \{0}; v.tag = RT_FLOAT; v.u.f = x; return v; }")
    lines = List.append(lines, "static rv rt_bool(bool b) \{ rv v = \{0}; v.tag = RT_BOOL; v.u.b = b; return v; }")
    lines = List.append(lines, "static rv rt_txt(rt_text t) \{ rv v = \{0}; v.tag = RT_TEXT; v.u.t = t; return v; }")
    lines = List.append(lines, "static rv rt_str(const char *s) \{ return rt_txt(rt_lit(s)); }")
    lines = List.append(lines, "static bool rt_truth(rv v) \{ return v.u.b; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv *rt_copy_values(const rv *items, int64_t n) \{")
    lines = List.append(lines, "    rv *copy = (rv *)rt_alloc((size_t)(n > 0 ? n : 1) * sizeof(rv));")
    lines = List.append(lines, "    for (int64_t i = 0; i < n; i++) copy[i] = items[i];")
    lines = List.append(lines, "    return copy;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_listbuf *rt_new_listbuf(int64_t cap) \{")
    lines = List.append(lines, "    rt_listbuf *buf = (rt_listbuf *)rt_alloc(sizeof(rt_listbuf) + (size_t)(cap > 0 ? cap : 1) * sizeof(rv));")
    lines = List.append(lines, "    buf->used = 0;")
    lines = List.append(lines, "    buf->cap = cap;")
    lines = List.append(lines, "    return buf;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_view(rt_listbuf *buf, int64_t n) \{")
    lines = List.append(lines, "    RT_COUNT(8);")
    lines = List.append(lines, "    rt_list *l = (rt_list *)rt_alloc(sizeof(rt_list));")
    lines = List.append(lines, "    l->n = n;")
    lines = List.append(lines, "    l->buf = buf;")
    lines = List.append(lines, "    l->items = buf ? buf->items : 0;")
    lines = List.append(lines, "    rv v = \{0};")
    lines = List.append(lines, "    v.tag = RT_LIST;")
    lines = List.append(lines, "    v.u.o = l;")
    lines = List.append(lines, "    return v;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_from(const rv *items, int64_t n) \{")
    lines = List.append(lines, "    if (n == 0) return rt_list_view(0, 0);")
    lines = List.append(lines, "    rt_listbuf *buf = rt_new_listbuf(n);")
    lines = List.append(lines, "    for (int64_t i = 0; i < n; i++) buf->items[i] = items[i];")
    lines = List.append(lines, "    buf->used = n;")
    lines = List.append(lines, "    return rt_list_view(buf, n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_record_new(const char *name, const char *const *names, int n, const rv *fields) \{")
    lines = List.append(lines, "    RT_COUNT(6);")
    lines = List.append(lines, "    rt_record *r = (rt_record *)rt_alloc_scan(sizeof(rt_record) + (size_t)n * sizeof(rv));")
    lines = List.append(lines, "    r->name = name;")
    lines = List.append(lines, "    r->n = n;")
    lines = List.append(lines, "    r->names = names;")
    lines = List.append(lines, "    for (int i = 0; i < n; i++) r->f[i] = fields[i];")
    lines = List.append(lines, "    rv v = \{0};")
    lines = List.append(lines, "    v.tag = RT_RECORD;")
    lines = List.append(lines, "    v.u.o = r;")
    lines = List.append(lines, "    return v;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A variant with no payload (`None`, a unit case of an enum) is always the same value, so there is one of each, never freed. */")
    lines = List.append(lines, "typedef struct \{ const char *owner, *kind; rt_variant *value; } rt_nullary_entry;")
    lines = List.append(lines, "static rt_nullary_entry rt_nullary[256];")
    lines = List.append(lines, "static int rt_nullary_count = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_variant_new(const char *owner, const char *kind, int n, const rv *args) \{")
    lines = List.append(lines, "    RT_COUNT(7);")
    lines = List.append(lines, "    if (n == 0) \{")
    lines = List.append(lines, "        for (int i = 0; i < rt_nullary_count; i++) \{")
    lines = List.append(lines, "            if (rt_nullary[i].owner == owner && rt_nullary[i].kind == kind) \{")
    lines = List.append(lines, "                rv shared = \{0};")
    lines = List.append(lines, "                shared.tag = RT_VARIANT;")
    lines = List.append(lines, "                shared.u.o = rt_nullary[i].value;")
    lines = List.append(lines, "                return shared;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        if (rt_nullary_count < 256) \{")
    lines = List.append(lines, "            rt_variant *x = (rt_variant *)malloc(sizeof(rt_variant));")
    lines = List.append(lines, "            if (!x) rt_out_of_memory();")
    lines = List.append(lines, "            x->owner = owner;")
    lines = List.append(lines, "            x->kind = kind;")
    lines = List.append(lines, "            x->n = 0;")
    lines = List.append(lines, "            rt_nullary[rt_nullary_count].owner = owner;")
    lines = List.append(lines, "            rt_nullary[rt_nullary_count].kind = kind;")
    lines = List.append(lines, "            rt_nullary[rt_nullary_count].value = x;")
    lines = List.append(lines, "            rt_nullary_count++;")
    lines = List.append(lines, "            rv first = \{0};")
    lines = List.append(lines, "            first.tag = RT_VARIANT;")
    lines = List.append(lines, "            first.u.o = x;")
    lines = List.append(lines, "            return first;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_variant *x = (rt_variant *)rt_alloc_scan(sizeof(rt_variant) + (size_t)n * sizeof(rv));")
    lines = List.append(lines, "    x->owner = owner;")
    lines = List.append(lines, "    x->kind = kind;")
    lines = List.append(lines, "    x->n = n;")
    lines = List.append(lines, "    for (int i = 0; i < n; i++) x->a[i] = args[i];")
    lines = List.append(lines, "    rv v = \{0};")
    lines = List.append(lines, "    v.tag = RT_VARIANT;")
    lines = List.append(lines, "    v.u.o = x;")
    lines = List.append(lines, "    return v;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_list *rt_as_list(rv v) \{ return (rt_list *)v.u.o; }")
    lines = List.append(lines, "static rt_record *rt_as_record(rv v) \{ return (rt_record *)v.u.o; }")
    lines = List.append(lines, "static rt_variant *rt_as_variant(rv v) \{ return (rt_variant *)v.u.o; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A Float as its shortest text that reads back as the same number, as Python's repr writes it. */")
    lines = List.append(lines, "static rt_text rt_float_text(double x) \{")
    lines = List.append(lines, "    char buf[64], digits[32];")
    lines = List.append(lines, "    int prec, k = 0, exponent;")
    lines = List.append(lines, "    if (x == 0.0) return signbit(x) ? rt_lit(\"-0.0\") : rt_lit(\"0.0\");")
    lines = List.append(lines, "    for (prec = 1; prec <= 17; prec++) \{")
    lines = List.append(lines, "        snprintf(buf, sizeof buf, \"%.*e\", prec - 1, x);")
    lines = List.append(lines, "        if (strtod(buf, 0) == x) break;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    const char *p = buf;")
    lines = List.append(lines, "    bool negative = false;")
    lines = List.append(lines, "    if (*p == '-') \{ negative = true; p++; }")
    lines = List.append(lines, "    for (; *p && *p != 'e'; p++) \{")
    lines = List.append(lines, "        if (*p != '.') digits[k++] = *p;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    digits[k] = 0;")
    lines = List.append(lines, "    exponent = atoi(p + 1);")
    lines = List.append(lines, "    while (k > 1 && digits[k - 1] == '0') digits[--k] = 0;")
    lines = List.append(lines, "    char out[96];")
    lines = List.append(lines, "    int n = 0;")
    lines = List.append(lines, "    if (negative) out[n++] = '-';")
    lines = List.append(lines, "    if (exponent >= -4 && exponent < 16) \{")
    lines = List.append(lines, "        if (exponent >= 0) \{")
    lines = List.append(lines, "            for (int i = 0; i <= exponent; i++) out[n++] = i < k ? digits[i] : '0';")
    lines = List.append(lines, "            out[n++] = '.';")
    lines = List.append(lines, "            if (k > exponent + 1) \{")
    lines = List.append(lines, "                for (int i = exponent + 1; i < k; i++) out[n++] = digits[i];")
    lines = List.append(lines, "            } else \{")
    lines = List.append(lines, "                out[n++] = '0';")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            out[n++] = '0';")
    lines = List.append(lines, "            out[n++] = '.';")
    lines = List.append(lines, "            for (int i = 0; i < -exponent - 1; i++) out[n++] = '0';")
    lines = List.append(lines, "            for (int i = 0; i < k; i++) out[n++] = digits[i];")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    } else \{")
    lines = List.append(lines, "        out[n++] = digits[0];")
    lines = List.append(lines, "        if (k > 1) \{")
    lines = List.append(lines, "            out[n++] = '.';")
    lines = List.append(lines, "            for (int i = 1; i < k; i++) out[n++] = digits[i];")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        n += snprintf(out + n, sizeof out - (size_t)n, \"e%c%02d\", exponent < 0 ? '-' : '+', abs(exponent));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    out[n] = 0;")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw((size_t)n + 1);")
    lines = List.append(lines, "    memcpy(copy, out, (size_t)n + 1);")
    lines = List.append(lines, "    rt_text t = \{copy, n, n};")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The text of a value: what `print` writes and `to_text` gives, or, when `shown`, how a diagnostic writes it (a Text quoted). */")
    lines = List.append(lines, "static void rt_show_into(rt_buf *b, rv v, bool shown) \{")
    lines = List.append(lines, "    rt_text t;")
    lines = List.append(lines, "    switch (v.tag) \{")
    lines = List.append(lines, "    case RT_UNIT:")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    case RT_INT:")
    lines = List.append(lines, "        t = rt_int_text(v.u.i);")
    lines = List.append(lines, "        break;")
    lines = List.append(lines, "    case RT_FLOAT:")
    lines = List.append(lines, "        t = rt_float_text(v.u.f);")
    lines = List.append(lines, "        break;")
    lines = List.append(lines, "    case RT_BOOL:")
    lines = List.append(lines, "        t = rt_bool_text(v.u.b);")
    lines = List.append(lines, "        break;")
    lines = List.append(lines, "    case RT_TEXT:")
    lines = List.append(lines, "        t = shown ? rt_quote(v.u.t) : v.u.t;")
    lines = List.append(lines, "        break;")
    lines = List.append(lines, "    case RT_LIST: \{")
    lines = List.append(lines, "        rt_list *l = rt_as_list(v);")
    lines = List.append(lines, "        rt_buf_add(b, \"[\", 1);")
    lines = List.append(lines, "        for (int64_t i = 0; i < l->n; i++) \{")
    lines = List.append(lines, "            if (i > 0) rt_buf_add(b, \", \", 2);")
    lines = List.append(lines, "            rt_show_into(b, l->items[i], shown);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        rt_buf_add(b, \"]\", 1);")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    case RT_RECORD: \{")
    lines = List.append(lines, "        rt_record *r = rt_as_record(v);")
    lines = List.append(lines, "        rt_buf_add(b, r->name, strlen(r->name));")
    lines = List.append(lines, "        rt_buf_add(b, \"(\", 1);")
    lines = List.append(lines, "        for (int i = 0; i < r->n; i++) \{")
    lines = List.append(lines, "            if (i > 0) rt_buf_add(b, \", \", 2);")
    lines = List.append(lines, "            rt_buf_add(b, r->names[i], strlen(r->names[i]));")
    lines = List.append(lines, "            rt_buf_add(b, \": \", 2);")
    lines = List.append(lines, "            rt_show_into(b, r->f[i], shown);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        rt_buf_add(b, \")\", 1);")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    default: \{")
    lines = List.append(lines, "        rt_variant *x = rt_as_variant(v);")
    lines = List.append(lines, "        if (x->owner[0]) \{")
    lines = List.append(lines, "            rt_buf_add(b, x->owner, strlen(x->owner));")
    lines = List.append(lines, "            rt_buf_add(b, \".\", 1);")
    lines = List.append(lines, "            rt_buf_add(b, x->kind, strlen(x->kind));")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            rt_buf_add(b, x->kind, strlen(x->kind));")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        if (x->n > 0 && (x->owner[0] || strcmp(x->kind, \"None\") != 0)) \{")
    lines = List.append(lines, "            rt_buf_add(b, \"(\", 1);")
    lines = List.append(lines, "            for (int i = 0; i < x->n; i++) \{")
    lines = List.append(lines, "                if (i > 0) rt_buf_add(b, \", \", 2);")
    lines = List.append(lines, "                rt_show_into(b, x->a[i], shown);")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            rt_buf_add(b, \")\", 1);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        return;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_buf_add(b, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_show(rv v, bool shown) \{")
    lines = List.append(lines, "    rt_buf b = \{0, 0, 0, 0};")
    lines = List.append(lines, "    rt_buf_add(&b, \"\", 0);")
    lines = List.append(lines, "    rt_show_into(&b, v, shown);")
    lines = List.append(lines, "    rt_text t = \{b.p, (int64_t)b.n, 0};")
    lines = List.append(lines, "    t.len = rt_count_points(t.p, t.bytes);")
    lines = List.append(lines, "    return t;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rt_text rt_format_value(rv v) \{ return rt_show(v, false); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_buf_val(rt_buf *b, const char *name, rv v) \{ rt_buf_pair(b, name, rt_show(v, true)); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The limits of resources the user may give (`--max-text`, `--max-output`, `--max-input`); zero is no limit. */")
    lines = List.append(lines, "static int64_t rt_max_text = 0, rt_max_output = 0, rt_max_input = 0;")
    lines = List.append(lines, "static int64_t rt_written = 0, rt_input_bytes = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The program stopped by a limit of the environment: the diagnostic has no position, and `nex run` ends with it alone. */")
    lines = List.append(lines, "static void rt_limit_fail(const char *label) \{")
    lines = List.append(lines, "    fflush(stdout);")
    lines = List.append(lines, "    rt_notes none = \{\{0}, 0};")
    lines = List.append(lines, "    rt_path = rt_entry;")
    lines = List.append(lines, "    rt_render(\"runtime\", \"error\", \"E3015\", \"Resource limit exceeded\", label, \"\", &none, 0, 0, 0, 0);")
    lines = List.append(lines, "    exit(3);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_emit(const char *data, size_t n) \{")
    lines = List.append(lines, "    if (rt_max_output > 0) \{")
    lines = List.append(lines, "        int64_t room = rt_max_output - rt_written;")
    lines = List.append(lines, "        if ((int64_t)n > room) \{")
    lines = List.append(lines, "            /* What fits is printed, without cutting a character in two, and then the program stops. */")
    lines = List.append(lines, "            size_t keep = (size_t)(room > 0 ? room : 0);")
    lines = List.append(lines, "            while (keep > 0 && keep < n && (((unsigned char)data[keep]) & 0xC0) == 0x80) keep--;")
    lines = List.append(lines, "            fwrite(data, 1, keep, stdout);")
    lines = List.append(lines, "            rt_limit_fail(rt_format(\"output limit exceeded (%lld)\", (long long)rt_max_output));")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        rt_written += (int64_t)n;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fwrite(data, 1, n, stdout);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_print(rv v) \{")
    lines = List.append(lines, "    rt_text t = rt_show(v, false);")
    lines = List.append(lines, "    rt_buf b = \{0, 0, 0, 0};")
    lines = List.append(lines, "    rt_buf_add(&b, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "    rt_buf_add(&b, \"\\n\", 1);")
    lines = List.append(lines, "    rt_emit(b.p, b.n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Equality and order, as the interpreter has them. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_eq(rv a, rv b) \{")
    lines = List.append(lines, "    RT_COUNT(5);")
    lines = List.append(lines, "    if (a.tag != b.tag) return false;")
    lines = List.append(lines, "    switch (a.tag) \{")
    lines = List.append(lines, "    case RT_UNIT: return true;")
    lines = List.append(lines, "    case RT_INT: return a.u.i == b.u.i;")
    lines = List.append(lines, "    case RT_FLOAT: return a.u.f == b.u.f;")
    lines = List.append(lines, "    case RT_BOOL: return a.u.b == b.u.b;")
    lines = List.append(lines, "    case RT_TEXT: return a.u.t.bytes == b.u.t.bytes && (a.u.t.p == b.u.t.p || memcmp(a.u.t.p, b.u.t.p, (size_t)a.u.t.bytes) == 0);")
    lines = List.append(lines, "    case RT_LIST: \{")
    lines = List.append(lines, "        rt_list *x = rt_as_list(a), *y = rt_as_list(b);")
    lines = List.append(lines, "        if (x->n != y->n) return false;")
    lines = List.append(lines, "        for (int64_t i = 0; i < x->n; i++) \{")
    lines = List.append(lines, "            if (!rt_eq(x->items[i], y->items[i])) return false;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    case RT_RECORD: \{")
    lines = List.append(lines, "        rt_record *x = rt_as_record(a), *y = rt_as_record(b);")
    lines = List.append(lines, "        if (strcmp(x->name, y->name) != 0 || x->n != y->n) return false;")
    lines = List.append(lines, "        for (int i = 0; i < x->n; i++) \{")
    lines = List.append(lines, "            if (!rt_eq(x->f[i], y->f[i])) return false;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    default: \{")
    lines = List.append(lines, "        rt_variant *x = rt_as_variant(a), *y = rt_as_variant(b);")
    lines = List.append(lines, "        if (strcmp(x->owner, y->owner) != 0 || strcmp(x->kind, y->kind) != 0 || x->n != y->n) return false;")
    lines = List.append(lines, "        for (int i = 0; i < x->n; i++) \{")
    lines = List.append(lines, "            if (!rt_eq(x->a[i], y->a[i])) return false;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_less(rv a, rv b) \{")
    lines = List.append(lines, "    if (a.tag != b.tag) return false;")
    lines = List.append(lines, "    if (a.tag == RT_INT) return a.u.i < b.u.i;")
    lines = List.append(lines, "    if (a.tag == RT_FLOAT) return a.u.f < b.u.f;")
    lines = List.append(lines, "    if (a.tag == RT_TEXT) return rt_text_compare(a.u.t, b.u.t) < 0;")
    lines = List.append(lines, "    return false;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Arithmetic. Each operator names the span an error points at. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_overflow(RT_SPAN) \{")
    lines = List.append(lines, "    rt_runtime(\"E3002\", \"Integer overflow\", \"The result of this operation does not fit in an Int\",")
    lines = List.append(lines, "               \"Int holds whole numbers from -9223372036854775808 to 9223372036854775807.\", l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_float_range(RT_SPAN) \{")
    lines = List.append(lines, "    rt_runtime(\"E3003\", \"Float result out of range\", \"The result of this operation is too large for a Float\", \"\", l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_float_checked(double r, RT_SPAN) \{")
    lines = List.append(lines, "    if (!isfinite(r)) rt_float_range(l, c, el, ec);")
    lines = List.append(lines, "    return rt_float(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A Text longer than the limit of the environment stops the program, wherever it was made. */")
    lines = List.append(lines, "static rv rt_check_text(rv v, RT_SPAN) \{")
    lines = List.append(lines, "    if (rt_max_text > 0 && v.tag == RT_TEXT && v.u.t.len > rt_max_text) \{")
    lines = List.append(lines, "        rt_runtime(\"E3006\", \"Text too long\",")
    lines = List.append(lines, "                   rt_format(\"This Text is longer than the environment limit of %lld characters\", (long long)rt_max_text),")
    lines = List.append(lines, "                   \"Use a smaller Text value or increase the environment's text limit.\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return v;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_str_at(const char *s, RT_SPAN) \{ return rt_check_text(rt_str(s), l, c, el, ec); }")
    lines = List.append(lines, "static rv rt_to_text(rv v, RT_SPAN) \{ return rt_check_text(rt_txt(rt_format_value(v)), l, c, el, ec); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_add(rv a, rv b, RT_SPAN) \{")
    lines = List.append(lines, "    if (a.tag == RT_INT) \{")
    lines = List.append(lines, "        int64_t r;")
    lines = List.append(lines, "        if (__builtin_add_overflow(a.u.i, b.u.i, &r)) rt_overflow(l, c, el, ec);")
    lines = List.append(lines, "        return rt_int(r);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (a.tag == RT_FLOAT) return rt_float_checked(a.u.f + b.u.f, l, c, el, ec);")
    lines = List.append(lines, "    return rt_check_text(rt_txt(rt_concat(a.u.t, b.u.t)), l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_sub(rv a, rv b, RT_SPAN) \{")
    lines = List.append(lines, "    if (a.tag == RT_INT) \{")
    lines = List.append(lines, "        int64_t r;")
    lines = List.append(lines, "        if (__builtin_sub_overflow(a.u.i, b.u.i, &r)) rt_overflow(l, c, el, ec);")
    lines = List.append(lines, "        return rt_int(r);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_float_checked(a.u.f - b.u.f, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_mul(rv a, rv b, RT_SPAN) \{")
    lines = List.append(lines, "    if (a.tag == RT_INT) \{")
    lines = List.append(lines, "        int64_t r;")
    lines = List.append(lines, "        if (__builtin_mul_overflow(a.u.i, b.u.i, &r)) rt_overflow(l, c, el, ec);")
    lines = List.append(lines, "        return rt_int(r);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_float_checked(a.u.f * b.u.f, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The first span is the whole operation, the second the right-hand side. */")
    lines = List.append(lines, "static rv rt_div(rv a, rv b, RT_SPAN, int64_t rl, int64_t rc, int64_t rel, int64_t rec) \{")
    lines = List.append(lines, "    if (a.tag == RT_INT) \{")
    lines = List.append(lines, "        if (b.u.i == 0) rt_runtime(\"E3001\", \"Division by zero\", \"The right-hand side of this division is zero\", \"\", rl, rc, rel, rec);")
    lines = List.append(lines, "        if (a.u.i == INT64_MIN && b.u.i == -1) rt_overflow(l, c, el, ec);")
    lines = List.append(lines, "        return rt_int(a.u.i / b.u.i);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (b.u.f == 0.0) rt_runtime(\"E3001\", \"Division by zero\", \"The right-hand side of this division is zero\", \"\", rl, rc, rel, rec);")
    lines = List.append(lines, "    return rt_float_checked(a.u.f / b.u.f, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_neg(rv a, RT_SPAN) \{")
    lines = List.append(lines, "    if (a.tag == RT_FLOAT) return rt_float(-a.u.f);")
    lines = List.append(lines, "    if (a.u.i == INT64_MIN) rt_overflow(l, c, el, ec);")
    lines = List.append(lines, "    return rt_int(-a.u.i);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Patterns, fields and loops over lists. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_is_kind(rv v, const char *kind) \{")
    lines = List.append(lines, "    RT_COUNT(4);")
    lines = List.append(lines, "    if (v.tag != RT_VARIANT) return false;")
    lines = List.append(lines, "    const char *own = rt_as_variant(v)->kind;")
    lines = List.append(lines, "    return own == kind || strcmp(own, kind) == 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_arg(rv v, int i) \{ return rt_as_variant(v)->a[i]; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_field(rv v, const char *name) \{")
    lines = List.append(lines, "    RT_COUNT(3);")
    lines = List.append(lines, "    rt_record *r = rt_as_record(v);")
    lines = List.append(lines, "    for (int i = 0; i < r->n; i++) \{")
    lines = List.append(lines, "        if (r->names[i] == name) return r->f[i];")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (int i = 0; i < r->n; i++) \{")
    lines = List.append(lines, "        if (strcmp(r->names[i], name) == 0) return r->f[i];")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int64_t rt_list_len(rv v) \{ return rt_as_list(v)->n; }")
    lines = List.append(lines, "static rv rt_list_at(rv v, int64_t i) \{ return rt_as_list(v)->items[i]; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The `needs` of a built-in function that is false: the same E4001 as for a function of the program. */")
    lines = List.append(lines, "static void rt_builtin_needs(const char *callee, const char *condition, const char *reason, int count,")
    lines = List.append(lines, "                             const char *const *names, const rv *args, const char *hint, RT_SPAN) \{")
    lines = List.append(lines, "    rt_notes own = \{\{0}, 0};")
    lines = List.append(lines, "    rt_note(&own, rt_format(\"The condition of the built-in function is false: needs %s\", condition));")
    lines = List.append(lines, "    rt_note(&own, rt_format(\"Reason: %s\", reason));")
    lines = List.append(lines, "    rt_buf b = \{0, 0, 0, 0};")
    lines = List.append(lines, "    for (int i = 0; i < count; i++) rt_buf_val(&b, names[i], args[i]);")
    lines = List.append(lines, "    rt_note(&own, rt_format(\"It was called with: %s\", b.p ? b.p : \"\"));")
    lines = List.append(lines, "    rt_fail(\"contract\", \"E4001\", \"Precondition violated\",")
    lines = List.append(lines, "            rt_format(\"This call breaks a 'needs' condition of '%s'\", callee), hint, &own, 0, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Text */")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Where the code point number `point` starts, as a byte. A text that is all ASCII (as many bytes as code points) needs no search. For")
    lines = List.append(lines, " * another one that is long, a table of where every 32nd code point starts is made once and kept for the last such text, so that")
    lines = List.append(lines, " * the lexer, which cuts one character at a time out of the same source, does not read the text from its start every time. */")
    lines = List.append(lines, "static const char *rt_index_text = 0;")
    lines = List.append(lines, "static int64_t rt_index_bytes = 0;")
    lines = List.append(lines, "static int64_t *rt_index_offsets = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int64_t rt_byte_of_point(rt_text t, int64_t point) \{")
    lines = List.append(lines, "    if (t.len == t.bytes) return point;")
    lines = List.append(lines, "    int64_t byte = 0, seen = 0;")
    lines = List.append(lines, "    if (t.bytes >= 256) \{")
    lines = List.append(lines, "        if (rt_index_text != t.p || rt_index_bytes != t.bytes) \{")
    lines = List.append(lines, "            free(rt_index_offsets);")
    lines = List.append(lines, "            rt_index_offsets = (int64_t *)malloc((size_t)(t.len / 32 + 2) * sizeof(int64_t));")
    lines = List.append(lines, "            if (!rt_index_offsets) rt_out_of_memory();")
    lines = List.append(lines, "            int64_t points = 0;")
    lines = List.append(lines, "            for (int64_t i = 0; i < t.bytes; i++) \{")
    lines = List.append(lines, "                if (((unsigned char)t.p[i] & 0xC0) != 0x80) \{")
    lines = List.append(lines, "                    if (points % 32 == 0) rt_index_offsets[points / 32] = i;")
    lines = List.append(lines, "                    points++;")
    lines = List.append(lines, "                }")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            rt_index_text = t.p;")
    lines = List.append(lines, "            rt_index_bytes = t.bytes;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        if (point >= t.len) return t.bytes;")
    lines = List.append(lines, "        seen = (point / 32) * 32;")
    lines = List.append(lines, "        byte = rt_index_offsets[point / 32];")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    while (byte < t.bytes && seen < point) \{")
    lines = List.append(lines, "        byte++;")
    lines = List.append(lines, "        while (byte < t.bytes && (((unsigned char)t.p[byte]) & 0xC0) == 0x80) byte++;")
    lines = List.append(lines, "        seen++;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return byte;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_text_slice(rv text, rv start, rv end, RT_SPAN) \{")
    lines = List.append(lines, "    static const char *const names[] = \{\"text\", \"start\", \"end\"};")
    lines = List.append(lines, "    rv args[3];")
    lines = List.append(lines, "    args[0] = text;")
    lines = List.append(lines, "    args[1] = start;")
    lines = List.append(lines, "    args[2] = end;")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    if (start.u.i < 0) \{")
    lines = List.append(lines, "        rt_builtin_needs(\"Text.slice\", \"start >= 0\", \"A slice cannot start before the first character\", 3, names, args, \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (start.u.i > end.u.i) \{")
    lines = List.append(lines, "        rt_builtin_needs(\"Text.slice\", \"start <= end\", \"A slice cannot end before it starts\", 3, names, args, \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (end.u.i > t.len) \{")
    lines = List.append(lines, "        rt_builtin_needs(\"Text.slice\", \"end <= Text.length(text)\", \"A slice cannot end after the last character\", 3, names, args, \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    int64_t from = rt_byte_of_point(t, start.u.i), to = rt_byte_of_point(t, end.u.i);")
    lines = List.append(lines, "    char *p = (char *)rt_alloc_raw((size_t)(to - from) + 1);")
    lines = List.append(lines, "    memcpy(p, t.p + from, (size_t)(to - from));")
    lines = List.append(lines, "    p[to - from] = 0;")
    lines = List.append(lines, "    rt_text out = \{p, to - from, end.u.i - start.u.i};")
    lines = List.append(lines, "    return rt_txt(out);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_has(rt_text t, rt_text part) \{")
    lines = List.append(lines, "    if (part.bytes == 0) return true;")
    lines = List.append(lines, "    for (int64_t i = 0; i + part.bytes <= t.bytes; i++) \{")
    lines = List.append(lines, "        if (memcmp(t.p + i, part.p, (size_t)part.bytes) == 0) return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return false;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_text_contains(rv t, rv part) \{ return rt_bool(rt_has(t.u.t, part.u.t)); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_text_starts(rv t, rv part) \{")
    lines = List.append(lines, "    return rt_bool(part.u.t.bytes <= t.u.t.bytes && memcmp(t.u.t.p, part.u.t.p, (size_t)part.u.t.bytes) == 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_text_ends(rv t, rv part) \{")
    lines = List.append(lines, "    return rt_bool(part.u.t.bytes <= t.u.t.bytes &&")
    lines = List.append(lines, "                   memcmp(t.u.t.p + t.u.t.bytes - part.u.t.bytes, part.u.t.p, (size_t)part.u.t.bytes) == 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Numbers written in a text (decision 0011): `-?[0-9]+` for an Int, and a decimal with a fraction or an exponent for a Float. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_is_integer_text(rt_text t) \{")
    lines = List.append(lines, "    int64_t i = 0;")
    lines = List.append(lines, "    if (i < t.bytes && t.p[i] == '-') i++;")
    lines = List.append(lines, "    if (i >= t.bytes) return false;")
    lines = List.append(lines, "    for (; i < t.bytes; i++) \{")
    lines = List.append(lines, "        if (t.p[i] < '0' || t.p[i] > '9') return false;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return true;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_int_value(rt_text t, int64_t *out) \{")
    lines = List.append(lines, "    if (!rt_is_integer_text(t)) return false;")
    lines = List.append(lines, "    int64_t i = 0;")
    lines = List.append(lines, "    bool negative = false;")
    lines = List.append(lines, "    if (t.p[0] == '-') \{ negative = true; i = 1; }")
    lines = List.append(lines, "    unsigned long long limit = negative ? 9223372036854775808ULL : 9223372036854775807ULL, value = 0;")
    lines = List.append(lines, "    for (; i < t.bytes; i++) \{")
    lines = List.append(lines, "        unsigned digit = (unsigned)(t.p[i] - '0');")
    lines = List.append(lines, "        if (value > (limit - digit) / 10) return false;")
    lines = List.append(lines, "        value = value * 10 + digit;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    *out = negative ? (int64_t)(0 - value) : (int64_t)value;")
    lines = List.append(lines, "    return true;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_is_decimal_text(rt_text t) \{")
    lines = List.append(lines, "    int64_t i = 0;")
    lines = List.append(lines, "    if (i < t.bytes && t.p[i] == '-') i++;")
    lines = List.append(lines, "    int64_t digits = 0;")
    lines = List.append(lines, "    while (i < t.bytes && t.p[i] >= '0' && t.p[i] <= '9') \{ i++; digits++; }")
    lines = List.append(lines, "    if (digits == 0 || i >= t.bytes) return false;")
    lines = List.append(lines, "    bool fraction = false;")
    lines = List.append(lines, "    if (t.p[i] == '.') \{")
    lines = List.append(lines, "        i++;")
    lines = List.append(lines, "        int64_t more = 0;")
    lines = List.append(lines, "        while (i < t.bytes && t.p[i] >= '0' && t.p[i] <= '9') \{ i++; more++; }")
    lines = List.append(lines, "        if (more == 0) return false;")
    lines = List.append(lines, "        fraction = true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (i == t.bytes) return fraction;")
    lines = List.append(lines, "    if (t.p[i] != 'e' && t.p[i] != 'E') return false;")
    lines = List.append(lines, "    i++;")
    lines = List.append(lines, "    if (i < t.bytes && (t.p[i] == '+' || t.p[i] == '-')) i++;")
    lines = List.append(lines, "    int64_t exponent = 0;")
    lines = List.append(lines, "    while (i < t.bytes && t.p[i] >= '0' && t.p[i] <= '9') \{ i++; exponent++; }")
    lines = List.append(lines, "    return exponent > 0 && i == t.bytes;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_float_value(rt_text t, double *out) \{")
    lines = List.append(lines, "    if (!rt_is_decimal_text(t)) return false;")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw((size_t)t.bytes + 1);")
    lines = List.append(lines, "    memcpy(copy, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "    copy[t.bytes] = 0;")
    lines = List.append(lines, "    double x = strtod(copy, 0);")
    lines = List.append(lines, "    if (isinf(x)) return false;")
    lines = List.append(lines, "    *out = x;")
    lines = List.append(lines, "    return true;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_int_can_parse(rv t) \{ int64_t n; return rt_bool(rt_int_value(t.u.t, &n)); }")
    lines = List.append(lines, "static rv rt_float_can_parse(rv t) \{ double x; return rt_bool(rt_float_value(t.u.t, &x)); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_int_parse(rv t, RT_SPAN) \{")
    lines = List.append(lines, "    static const char *const names[] = \{\"text\"};")
    lines = List.append(lines, "    int64_t n;")
    lines = List.append(lines, "    if (!rt_int_value(t.u.t, &n)) \{")
    lines = List.append(lines, "        rt_builtin_needs(\"Int.parse\", \"Int.can_parse(text)\", \"Only a whole number within the range of Int can be read as an Int\", 1,")
    lines = List.append(lines, "                         names, &t, rt_is_integer_text(t.u.t)")
    lines = List.append(lines, "                             ? \"Int holds whole numbers from -9223372036854775808 to 9223372036854775807.\"")
    lines = List.append(lines, "                             : \"Check the text first with Int.can_parse(...), and call Int.parse only when it is true.\",")
    lines = List.append(lines, "                         l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_int(n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_float_parse(rv t, RT_SPAN) \{")
    lines = List.append(lines, "    static const char *const names[] = \{\"text\"};")
    lines = List.append(lines, "    double x;")
    lines = List.append(lines, "    if (!rt_float_value(t.u.t, &x)) \{")
    lines = List.append(lines, "        const char *hint = \"Check the text first with Float.can_parse(...), and call Float.parse only when it is true.\";")
    lines = List.append(lines, "        if (rt_is_integer_text(t.u.t)) hint = \"This text is a whole number: read it with to_float(Int.parse(...)).\";")
    lines = List.append(lines, "        else if (rt_is_decimal_text(t.u.t)) hint = \"The number is too large for a Float.\";")
    lines = List.append(lines, "        rt_builtin_needs(\"Float.parse\", \"Float.can_parse(text)\",")
    lines = List.append(lines, "                         \"Only a decimal number that fits in a Float can be read as a Float\", 1, names, &t, hint, l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_float(x);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_to_float(rv n) \{ return rt_float((double)n.u.i); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The span of the argument is the one an out-of-range conversion points at. */")
    lines = List.append(lines, "static rv rt_to_int(rv x, RT_SPAN) \{")
    lines = List.append(lines, "    if (x.u.f >= 9223372036854775808.0 || x.u.f < -9223372036854775808.0) \{")
    lines = List.append(lines, "        rt_runtime(\"E3005\", \"Conversion out of range\", rt_format(\"%s is outside the range of Int\", rt_float_text(x.u.f).p),")
    lines = List.append(lines, "                   \"Int holds whole numbers from -9223372036854775808 to 9223372036854775807.\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_int((int64_t)x.u.f);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Lists */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_get(rv list, rv index, RT_SPAN) \{")
    lines = List.append(lines, "    static const char *const names[] = \{\"xs\", \"i\"};")
    lines = List.append(lines, "    rv args[2];")
    lines = List.append(lines, "    args[0] = list;")
    lines = List.append(lines, "    args[1] = index;")
    lines = List.append(lines, "    rt_list *x = rt_as_list(list);")
    lines = List.append(lines, "    if (index.u.i < 0 || index.u.i >= x->n) \{")
    lines = List.append(lines, "        rt_builtin_needs(\"List.get\", \"0 <= i and i < List.length(xs)\", \"An index must be inside the list\", 2, names, args, \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return x->items[index.u.i];")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_append(rv list, rv item) \{")
    lines = List.append(lines, "    RT_COUNT(9);")
    lines = List.append(lines, "    rt_list *x = rt_as_list(list);")
    lines = List.append(lines, "    rt_listbuf *buf = x->buf;")
    lines = List.append(lines, "    static int no_share = -1;")
    lines = List.append(lines, "    if (no_share < 0) no_share = getenv(\"NEXORA_NO_SHARE\") != 0;")
    lines = List.append(lines, "    if (!no_share && buf && x->n == buf->used && buf->used < buf->cap) \{")
    lines = List.append(lines, "        buf->items[buf->used++] = item;")
    lines = List.append(lines, "        return rt_list_view(buf, x->n + 1);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_listbuf *copy = rt_new_listbuf(x->n < 4 ? 8 : x->n * 2);")
    lines = List.append(lines, "    for (int64_t i = 0; i < x->n; i++) copy->items[i] = x->items[i];")
    lines = List.append(lines, "    copy->items[x->n] = item;")
    lines = List.append(lines, "    copy->used = x->n + 1;")
    lines = List.append(lines, "    return rt_list_view(copy, x->n + 1);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_concat(rv a, rv b) \{")
    lines = List.append(lines, "    rt_list *x = rt_as_list(a), *y = rt_as_list(b);")
    lines = List.append(lines, "    if (y->n == 0) return a;")
    lines = List.append(lines, "    if (x->n == 0) return b;")
    lines = List.append(lines, "    rt_listbuf *buf = x->buf;")
    lines = List.append(lines, "    if (buf && x->n == buf->used && buf->used + y->n <= buf->cap) \{")
    lines = List.append(lines, "        for (int64_t i = 0; i < y->n; i++) buf->items[buf->used + i] = y->items[i];")
    lines = List.append(lines, "        buf->used += y->n;")
    lines = List.append(lines, "        return rt_list_view(buf, x->n + y->n);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_listbuf *copy = rt_new_listbuf((x->n + y->n) * 2);")
    lines = List.append(lines, "    for (int64_t i = 0; i < x->n; i++) copy->items[i] = x->items[i];")
    lines = List.append(lines, "    for (int64_t i = 0; i < y->n; i++) copy->items[x->n + i] = y->items[i];")
    lines = List.append(lines, "    copy->used = x->n + y->n;")
    lines = List.append(lines, "    return rt_list_view(copy, x->n + y->n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_list_contains(rv list, rv item) \{")
    lines = List.append(lines, "    rt_list *x = rt_as_list(list);")
    lines = List.append(lines, "    for (int64_t i = 0; i < x->n; i++) \{")
    lines = List.append(lines, "        if (rt_eq(x->items[i], item)) return rt_bool(true);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_bool(false);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Option and Result */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_some(rv x) \{ return rt_variant_new(\"\", \"Some\", 1, &x); }")
    lines = List.append(lines, "static rv rt_none(void) \{ return rt_variant_new(\"\", \"None\", 0, 0); }")
    lines = List.append(lines, "static rv rt_ok(rv x) \{ return rt_variant_new(\"\", \"Ok\", 1, &x); }")
    lines = List.append(lines, "static rv rt_err(rv x) \{ return rt_variant_new(\"\", \"Err\", 1, &x); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_option_value(rv v, RT_SPAN) \{")
    lines = List.append(lines, "    if (rt_is_kind(v, \"Some\")) return rt_arg(v, 0);")
    lines = List.append(lines, "    rt_runtime(\"E3011\", \"Option has no value\", \"This Option has no value\",")
    lines = List.append(lines, "               \"Check it with Option.is_none(...) before reading it, or use Option.value_or(...) to give a value for the case of no value.\",")
    lines = List.append(lines, "               l, c, el, ec);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_result_value(rv v, RT_SPAN) \{")
    lines = List.append(lines, "    if (rt_is_kind(v, \"Err\")) \{")
    lines = List.append(lines, "        rt_runtime(\"E3012\", \"Result is an error\", rt_format(\"This Result is an error: %s\", rt_show(rt_arg(v, 0), true).p),")
    lines = List.append(lines, "                   \"Check it with Result.is_err(...) before reading it, or use Result.value_or(...) to give a value for the case of error.\",")
    lines = List.append(lines, "                   l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_arg(v, 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_result_error(rv v, RT_SPAN) \{")
    lines = List.append(lines, "    if (rt_is_kind(v, \"Ok\")) \{")
    lines = List.append(lines, "        rt_runtime(\"E3013\", \"Result is not an error\", \"This Result is not an error\",")
    lines = List.append(lines, "                   \"Check it with Result.is_ok(...) before reading the error.\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_arg(v, 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A refined type: the value is let through only if it satisfies the condition of every type in its chain. */")
    lines = List.append(lines, "static void rt_refine_fail(const char *written, const char *declared, const char *condition, rv value, const char *reason,")
    lines = List.append(lines, "                           RT_SPAN) \{")
    lines = List.append(lines, "    rt_notes own = \{\{0}, 0};")
    lines = List.append(lines, "    if (strcmp(written, declared) == 0) \{")
    lines = List.append(lines, "        rt_note(&own, rt_format(\"The condition of '%s' is false: where %s\", written, condition));")
    lines = List.append(lines, "    } else \{")
    lines = List.append(lines, "        rt_note(&own, rt_format(\"'%s' refines '%s', and the condition of '%s' is false: where %s\", written, declared, declared,")
    lines = List.append(lines, "                                condition));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_note(&own, rt_format(\"The value: %s\", rt_show(value, true).p));")
    lines = List.append(lines, "    if (reason && reason[0]) rt_note(&own, rt_format(\"Reason: %s\", reason));")
    lines = List.append(lines, "    rt_fail(\"contract\", \"E4003\", \"Refinement violated\", rt_format(\"This value is not a valid %s\", written), \"\", &own, 0, l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Entering and leaving a function. The call that would be the 1,001st nested stops the program. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "#ifdef RT_NO_FRAMES")
    lines = List.append(lines, "/* A tool of selfhost/ compiled for speed: calls and loops keep no frames, so an error is not explained by them. */")
    lines = List.append(lines, "static int rt_enter(const char *name, int file, int64_t line, int64_t column, int64_t end_line, int64_t end_column) \{")
    lines = List.append(lines, "    (void)name; (void)file; (void)line; (void)column; (void)end_line; (void)end_column;")
    lines = List.append(lines, "    return 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "static void rt_leave(int saved) \{ (void)saved; }")
    lines = List.append(lines, "static void rt_push_loop(int kind, int64_t line, int64_t turn) \{ (void)kind; (void)line; (void)turn; }")
    lines = List.append(lines, "static void rt_pop(void) \{}")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "static int rt_enter(const char *name, int file, int64_t line, int64_t column, int64_t end_line, int64_t end_column) \{")
    lines = List.append(lines, "    RT_COUNT(10);")
    lines = List.append(lines, "#ifdef RT_STATS")
    lines = List.append(lines, "    rt_count_function(name);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    if (rt_calls >= RT_MAX_CALLS) \{")
    lines = List.append(lines, "        rt_notes own = \{\{0}, 0};")
    lines = List.append(lines, "        rt_fail(\"runtime\", \"E3004\", \"Too many nested calls\", \"The program nested more than 1000 calls\",")
    lines = List.append(lines, "                \"A recursive function probably never reaches the case where it stops calling itself.\", &own, 0, line,")
    lines = List.append(lines, "                column, end_line, end_column);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    int saved = rt_top;")
    lines = List.append(lines, "    rt_frames[rt_top].kind = RT_CALL;")
    lines = List.append(lines, "    rt_frames[rt_top].name = name;")
    lines = List.append(lines, "    rt_frames[rt_top].file = file;")
    lines = List.append(lines, "    rt_frames[rt_top].line = line;")
    lines = List.append(lines, "    rt_frames[rt_top].column = column;")
    lines = List.append(lines, "    rt_top++;")
    lines = List.append(lines, "    rt_calls++;")
    lines = List.append(lines, "    return saved;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_leave(int saved) \{")
    lines = List.append(lines, "    rt_top = saved;")
    lines = List.append(lines, "    rt_calls--;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_push_loop(int kind, int64_t line, int64_t turn) \{")
    lines = List.append(lines, "    rt_frames[rt_top].kind = kind;")
    lines = List.append(lines, "    rt_frames[rt_top].name = \"\";")
    lines = List.append(lines, "    rt_frames[rt_top].file = 0;")
    lines = List.append(lines, "    rt_frames[rt_top].line = line;")
    lines = List.append(lines, "    rt_frames[rt_top].column = turn;")
    lines = List.append(lines, "    rt_top++;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_pop(void) \{")
    lines = List.append(lines, "    rt_top--;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The accessors of the syntax tree (parser.Node), written in C. The compiler and the interpreter of selfhost/ are programs that")
    lines = List.append(lines, " * read that tree all the time, and each of these functions is small enough that the frame of a call costs more than the work.")
    lines = List.append(lines, " * cgen.nex puts them in place of the NEXORA functions of the same name in those files only; the NEXORA definitions say what they")
    lines = List.append(lines, " * do and are what runs under Python, and the comparisons check that the two agree. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_intr_is(rv v, const char *kind) \{ return v.tag == RT_VARIANT && strcmp(rt_as_variant(v)->kind, kind) == 0; }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_kind_of(rv node) \{")
    lines = List.append(lines, "    if (rt_intr_is(node, \"Obj\")) return rt_arg(node, 0);")
    lines = List.append(lines, "    return rt_str(\"\");")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_null(void) \{ return rt_variant_new(\"parser.Node\", \"Null\", 0, 0); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_index_of(rv names, rv name) \{")
    lines = List.append(lines, "    rt_list *list = rt_as_list(names);")
    lines = List.append(lines, "    for (int64_t i = 0; i < list->n; i++) \{")
    lines = List.append(lines, "        rt_text a = list->items[i].u.t, b = name.u.t;")
    lines = List.append(lines, "        if (a.bytes == b.bytes && (a.p == b.p || memcmp(a.p, b.p, (size_t)a.bytes) == 0)) return rt_int(i);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_int(-1);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_field_at(rv names, rv values, rv name) \{")
    lines = List.append(lines, "    int64_t at = rt_intr_index_of(names, name).u.i;")
    lines = List.append(lines, "    if (at < 0) return rt_intr_null();")
    lines = List.append(lines, "    return rt_as_list(values)->items[at];")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_field(rv node, rv name) \{")
    lines = List.append(lines, "    if (!rt_intr_is(node, \"Obj\")) return rt_intr_null();")
    lines = List.append(lines, "    return rt_intr_field_at(rt_arg(node, 1), rt_arg(node, 2), name);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The same list with one item replaced. */")
    lines = List.append(lines, "static rv rt_intr_replace_val(rv vals, rv at, rv value) \{")
    lines = List.append(lines, "    rt_list *x = rt_as_list(vals);")
    lines = List.append(lines, "    if (x->n == 0) return vals;")
    lines = List.append(lines, "    rt_listbuf *copy = rt_new_listbuf(x->n);")
    lines = List.append(lines, "    for (int64_t i = 0; i < x->n; i++) copy->items[i] = i == at.u.i ? value : x->items[i];")
    lines = List.append(lines, "    copy->used = x->n;")
    lines = List.append(lines, "    return rt_list_view(copy, x->n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* `assign` of the interpreter: the environment is a list of frames, each a record of names and values (in that order). The")
    lines = List.append(lines, " * innermost frame that has the name gets the new value; the new frame is made like the old one. */")
    lines = List.append(lines, "static rv rt_intr_assign(rv env, rv name, rv value) \{")
    lines = List.append(lines, "    rt_list *frames = rt_as_list(env);")
    lines = List.append(lines, "    int64_t found = -1, place = -1;")
    lines = List.append(lines, "    for (int64_t i = frames->n - 1; i >= 0 && found < 0; i--) \{")
    lines = List.append(lines, "        rt_record *frame = rt_as_record(frames->items[i]);")
    lines = List.append(lines, "        rt_list *names = rt_as_list(frame->f[0]);")
    lines = List.append(lines, "        for (int64_t k = 0; k < names->n; k++) \{")
    lines = List.append(lines, "            rt_text a = names->items[k].u.t, b = name.u.t;")
    lines = List.append(lines, "            if (a.bytes == b.bytes && (a.p == b.p || memcmp(a.p, b.p, (size_t)a.bytes) == 0)) \{ found = i; place = k; break; }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (found < 0) return env;")
    lines = List.append(lines, "    rt_record *old = rt_as_record(frames->items[found]);")
    lines = List.append(lines, "    rv fields[2];")
    lines = List.append(lines, "    fields[0] = old->f[0];")
    lines = List.append(lines, "    fields[1] = rt_intr_replace_val(old->f[1], rt_int(place), value);")
    lines = List.append(lines, "    rv frame = rt_record_new(old->name, old->names, 2, fields);")
    lines = List.append(lines, "    rt_listbuf *copy = rt_new_listbuf(frames->n);")
    lines = List.append(lines, "    for (int64_t i = 0; i < frames->n; i++) copy->items[i] = i == found ? frame : frames->items[i];")
    lines = List.append(lines, "    copy->used = frames->n;")
    lines = List.append(lines, "    return rt_list_view(copy, frames->n);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The code of the first character of a text, and the character of a code (selfhost/json.nex). */")
    lines = List.append(lines, "static rv rt_intr_code_of(rv text) \{")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    if (t.bytes == 0) return rt_int(0);")
    lines = List.append(lines, "    const unsigned char *p = (const unsigned char *)t.p;")
    lines = List.append(lines, "    int64_t code;")
    lines = List.append(lines, "    if (p[0] < 0x80) code = p[0];")
    lines = List.append(lines, "    else if ((p[0] >> 5) == 6 && t.bytes >= 2) code = ((p[0] & 0x1F) << 6) | (p[1] & 0x3F);")
    lines = List.append(lines, "    else if ((p[0] >> 4) == 14 && t.bytes >= 3) code = ((p[0] & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F);")
    lines = List.append(lines, "    else if ((p[0] >> 3) == 30 && t.bytes >= 4)")
    lines = List.append(lines, "        code = ((int64_t)(p[0] & 0x07) << 18) | ((p[1] & 0x3F) << 12) | ((p[2] & 0x3F) << 6) | (p[3] & 0x3F);")
    lines = List.append(lines, "    else code = -1;")
    lines = List.append(lines, "    return rt_int(code);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_char_from_code(rv code) \{")
    lines = List.append(lines, "    int64_t c = code.u.i;")
    lines = List.append(lines, "    char buffer[5];")
    lines = List.append(lines, "    int n = 0;")
    lines = List.append(lines, "    if (c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF)) return rt_str(\"\");")
    lines = List.append(lines, "    if (c < 0x80) \{ buffer[n++] = (char)c; }")
    lines = List.append(lines, "    else if (c < 0x800) \{ buffer[n++] = (char)(0xC0 | (c >> 6)); buffer[n++] = (char)(0x80 | (c & 0x3F)); }")
    lines = List.append(lines, "    else if (c < 0x10000) \{")
    lines = List.append(lines, "        buffer[n++] = (char)(0xE0 | (c >> 12)); buffer[n++] = (char)(0x80 | ((c >> 6) & 0x3F)); buffer[n++] = (char)(0x80 | (c & 0x3F));")
    lines = List.append(lines, "    } else \{")
    lines = List.append(lines, "        buffer[n++] = (char)(0xF0 | (c >> 18)); buffer[n++] = (char)(0x80 | ((c >> 12) & 0x3F));")
    lines = List.append(lines, "        buffer[n++] = (char)(0x80 | ((c >> 6) & 0x3F)); buffer[n++] = (char)(0x80 | (c & 0x3F));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    buffer[n] = 0;")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw((size_t)n + 1);")
    lines = List.append(lines, "    memcpy(copy, buffer, (size_t)n + 1);")
    lines = List.append(lines, "    rt_text t = \{copy, n, 1};")
    lines = List.append(lines, "    return rt_txt(t);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The limits the worker of the playground puts on itself (nexora/src/nexora/worker.py, `_apply_os_limits`): the address space,")
    lines = List.append(lines, " * the seconds of CPU and of the clock, and no files, no core and no processes. The host (the container) imposes them too; this")
    lines = List.append(lines, " * makes them a fact of the process. A value of 0 leaves that limit alone. They are POSIX: on Windows nothing is applied. */")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "#include <signal.h>")
    lines = List.append(lines, "#include <sys/resource.h>")
    lines = List.append(lines, "#include <unistd.h>")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "/* The memory a container gives its processes, if the system says so (cgroup v2, then v1): 0 when there is no limit. A process that")
    lines = List.append(lines, " * crosses it is killed by the kernel with nothing said; limiting the address space a little below makes the allocation fail")
    lines = List.append(lines, " * inside the program, which can answer. */")
    lines = List.append(lines, "static int64_t rt_read_limit(const char *path) \{")
    lines = List.append(lines, "    FILE *file = fopen(path, \"r\");")
    lines = List.append(lines, "    char text[64];")
    lines = List.append(lines, "    if (!file) return 0;")
    lines = List.append(lines, "    if (!fgets(text, sizeof text, file)) \{ fclose(file); return 0; }")
    lines = List.append(lines, "    fclose(file);")
    lines = List.append(lines, "    if (text[0] < '0' || text[0] > '9') return 0; /* \"max\" */")
    lines = List.append(lines, "    long long value = atoll(text);")
    lines = List.append(lines, "    return value > 0 && value < ((long long)1 << 50) ? (int64_t)value : 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static int64_t rt_cgroup_limit(void) \{")
    lines = List.append(lines, "    char line[512], path[600];")
    lines = List.append(lines, "    FILE *file = fopen(\"/proc/self/cgroup\", \"r\");")
    lines = List.append(lines, "    if (file) \{")
    lines = List.append(lines, "        while (fgets(line, sizeof line, file)) \{")
    lines = List.append(lines, "            if (strncmp(line, \"0::\", 3) != 0) continue;")
    lines = List.append(lines, "            size_t n = strlen(line);")
    lines = List.append(lines, "            while (n > 0 && (line[n - 1] == '\\n' || line[n - 1] == '\\r')) line[--n] = 0;")
    lines = List.append(lines, "            snprintf(path, sizeof path, \"/sys/fs/cgroup%s/memory.max\", line + 3);")
    lines = List.append(lines, "            int64_t value = rt_read_limit(path);")
    lines = List.append(lines, "            if (value) \{ fclose(file); return value; }")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        fclose(file);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    int64_t value = rt_read_limit(\"/sys/fs/cgroup/memory.max\");")
    lines = List.append(lines, "    if (value) return value;")
    lines = List.append(lines, "    return rt_read_limit(\"/sys/fs/cgroup/memory/memory.limit_in_bytes\");")
    lines = List.append(lines, "}")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_apply_limits(rv memory, rv cpu, rv wall, rv reply) \{")
    lines = List.append(lines, "    rt_text r = reply.u.t;")
    lines = List.append(lines, "    char *copy = (char *)malloc((size_t)r.bytes + 1);")
    lines = List.append(lines, "    if (copy) \{")
    lines = List.append(lines, "        memcpy(copy, r.p, (size_t)r.bytes);")
    lines = List.append(lines, "        copy[r.bytes] = 0;")
    lines = List.append(lines, "        rt_oom_reply = copy;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "    struct rlimit limit;")
    lines = List.append(lines, "    int64_t space = memory.u.i;")
    lines = List.append(lines, "    int64_t container = rt_cgroup_limit();")
    lines = List.append(lines, "    if (container > 0) \{")
    lines = List.append(lines, "        int64_t room = container - container / 8;")
    lines = List.append(lines, "        if (room >= ((int64_t)64 << 20) && (space <= 0 || space > room)) space = room;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (space > 0) \{ limit.rlim_cur = limit.rlim_max = (rlim_t)space; setrlimit(RLIMIT_AS, &limit); }")
    lines = List.append(lines, "    if (cpu.u.i > 0) \{ limit.rlim_cur = limit.rlim_max = (rlim_t)cpu.u.i; setrlimit(RLIMIT_CPU, &limit); }")
    lines = List.append(lines, "    limit.rlim_cur = limit.rlim_max = 0;")
    lines = List.append(lines, "    setrlimit(RLIMIT_FSIZE, &limit);")
    lines = List.append(lines, "    setrlimit(RLIMIT_CORE, &limit);")
    lines = List.append(lines, "#ifdef RLIMIT_NPROC")
    lines = List.append(lines, "    setrlimit(RLIMIT_NPROC, &limit);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    if (wall.u.i > 0) alarm((unsigned)wall.u.i);")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "    (void)memory; (void)cpu; (void)wall;")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The JSON of a text (selfhost/json.nex, `escaped`) and the join of many texts (selfhost/parser.nex, `join_texts`), each in one")
    lines = List.append(lines, " * pass: building them one piece at a time copies the text again at every piece, which for the output of a program is the")
    lines = List.append(lines, " * longest thing the worker writes. */")
    lines = List.append(lines, "static rv rt_intr_json_escaped(rv text) \{")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    char *out = (char *)rt_alloc_raw((size_t)t.bytes * 6 + 3);")
    lines = List.append(lines, "    size_t n = 0;")
    lines = List.append(lines, "    int64_t points = 2;")
    lines = List.append(lines, "    out[n++] = '\"';")
    lines = List.append(lines, "    for (int64_t i = 0; i < t.bytes; i++) \{")
    lines = List.append(lines, "        unsigned char c = (unsigned char)t.p[i];")
    lines = List.append(lines, "        const char *escape = 0;")
    lines = List.append(lines, "        char hex[8];")
    lines = List.append(lines, "        if (c == '\"') escape = \"\\\\\\\"\";")
    lines = List.append(lines, "        else if (c == '\\\\') escape = \"\\\\\\\\\";")
    lines = List.append(lines, "        else if (c == 10) escape = \"\\\\n\";")
    lines = List.append(lines, "        else if (c == 9) escape = \"\\\\t\";")
    lines = List.append(lines, "        else if (c == 13) escape = \"\\\\r\";")
    lines = List.append(lines, "        else if (c == 8) escape = \"\\\\b\";")
    lines = List.append(lines, "        else if (c == 12) escape = \"\\\\f\";")
    lines = List.append(lines, "        else if (c < 32) \{ snprintf(hex, sizeof hex, \"\\\\u%04x\", c); escape = hex; }")
    lines = List.append(lines, "        if (escape) \{")
    lines = List.append(lines, "            size_t k = strlen(escape);")
    lines = List.append(lines, "            memcpy(out + n, escape, k);")
    lines = List.append(lines, "            n += k;")
    lines = List.append(lines, "            points += (int64_t)k;")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            out[n++] = (char)c;")
    lines = List.append(lines, "            if ((c & 0xC0) != 0x80) points++;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    out[n++] = '\"';")
    lines = List.append(lines, "    out[n] = 0; /* a Text is also read as a C string (file names) */")
    lines = List.append(lines, "    rt_text r = \{out, (int64_t)n, points};")
    lines = List.append(lines, "    return rt_txt(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_join_texts(rv items, rv separator) \{")
    lines = List.append(lines, "    int64_t count = rt_list_len(items);")
    lines = List.append(lines, "    rt_text s = separator.u.t;")
    lines = List.append(lines, "    size_t total = 0;")
    lines = List.append(lines, "    int64_t points = 0;")
    lines = List.append(lines, "    for (int64_t i = 0; i < count; i++) \{")
    lines = List.append(lines, "        rt_text piece = rt_list_at(items, i).u.t;")
    lines = List.append(lines, "        total += (size_t)piece.bytes;")
    lines = List.append(lines, "        points += piece.len;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (count > 1) \{")
    lines = List.append(lines, "        total += (size_t)s.bytes * (size_t)(count - 1);")
    lines = List.append(lines, "        points += s.len * (count - 1);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    char *out = (char *)rt_alloc_raw(total + 1);")
    lines = List.append(lines, "    size_t n = 0;")
    lines = List.append(lines, "    for (int64_t i = 0; i < count; i++) \{")
    lines = List.append(lines, "        if (i > 0) \{ memcpy(out + n, s.p, (size_t)s.bytes); n += (size_t)s.bytes; }")
    lines = List.append(lines, "        rt_text piece = rt_list_at(items, i).u.t;")
    lines = List.append(lines, "        memcpy(out + n, piece.p, (size_t)piece.bytes);")
    lines = List.append(lines, "        n += (size_t)piece.bytes;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    out[n] = 0;")
    lines = List.append(lines, "    rt_text r = \{out, (int64_t)n, points};")
    lines = List.append(lines, "    return rt_txt(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Three things a command-line tool written in NEXORA needs and the language does not have (selfhost/nex.nex): a line on the")
    lines = List.append(lines, " * standard error, the exit status of the process, and the reason why a file cannot be read (\"\" when it can). */")
    lines = List.append(lines, "static rv rt_intr_eprint(rv text) \{")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    fflush(stdout); /* what was printed before reaches the terminal before the error does */")
    lines = List.append(lines, "    fwrite(t.p, 1, (size_t)t.bytes, stderr);")
    lines = List.append(lines, "    fputc('\\n', stderr);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The prompt of `nex debug`: text on the standard error without a line break, shown at once. */")
    lines = List.append(lines, "static rv rt_intr_eprint_raw(rv text) \{")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    fflush(stdout);")
    lines = List.append(lines, "    fwrite(t.p, 1, (size_t)t.bytes, stderr);")
    lines = List.append(lines, "    fflush(stderr);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_exit_with(rv code) \{")
    lines = List.append(lines, "    rt_exit_status = (int)code.u.i;")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_file_problem(rv path) \{")
    lines = List.append(lines, "    rt_text t = path.u.t;")
    lines = List.append(lines, "    char *name = (char *)malloc((size_t)t.bytes + 1);")
    lines = List.append(lines, "    if (!name) return rt_str(\"\");")
    lines = List.append(lines, "    memcpy(name, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "    name[t.bytes] = 0;")
    lines = List.append(lines, "    errno = 0;")
    lines = List.append(lines, "    FILE *file = fopen(name, \"rb\");")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    if (file) \{ fclose(file); return rt_str(\"\"); }")
    lines = List.append(lines, "    const char *reason = strerror(errno);")
    lines = List.append(lines, "    size_t n = strlen(reason);")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw(n + 1);")
    lines = List.append(lines, "    memcpy(copy, reason, n + 1);")
    lines = List.append(lines, "    rt_text r = \{copy, (int64_t)n, (int64_t)n};")
    lines = List.append(lines, "    return rt_txt(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* One line of the standard input for the program a tool runs (selfhost/interpreter.nex, `read_stdin_line`): a list with the line, without")
    lines = List.append(lines, " * its line break, or an empty list at the end of the input. */")
    lines = List.append(lines, "static rv rt_intr_read_stdin_line(void) \{")
    lines = List.append(lines, "    fflush(stdout);")
    lines = List.append(lines, "    size_t cap = 128, n = 0;")
    lines = List.append(lines, "    char *line = (char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    bool any = false;")
    lines = List.append(lines, "    while ((ch = getc(stdin)) != EOF) \{")
    lines = List.append(lines, "        any = true;")
    lines = List.append(lines, "        if (ch == '\\n') break;")
    lines = List.append(lines, "        if (n + 2 > cap) \{")
    lines = List.append(lines, "            char *bigger = (char *)rt_alloc_raw(cap * 2);")
    lines = List.append(lines, "            memcpy(bigger, line, n);")
    lines = List.append(lines, "            line = bigger;")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        line[n++] = (char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!any) return rt_list_from(0, 0);")
    lines = List.append(lines, "    if (n > 0 && line[n - 1] == '\\r') n--;")
    lines = List.append(lines, "    line[n] = 0;")
    lines = List.append(lines, "    int64_t points = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i < n; i++) if (((unsigned char)line[i] & 0xC0) != 0x80) points++;")
    lines = List.append(lines, "    rt_text t = \{line, (int64_t)n, points};")
    lines = List.append(lines, "    rv item = rt_txt(t);")
    lines = List.append(lines, "    return rt_list_from(&item, 1);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* `nex run --timeout` and `--max-memory` (selfhost/nex.nex). The time limit is a timer that stops the process with the message of")
    lines = List.append(lines, " * the diagnostic and status 3; it counts from `start_timeout`, as Python's counts from the run. Both answer whether the system can do it")
    lines = List.append(lines, " * (the timer needs POSIX, the address-space limit needs Linux), which is what Python's usage errors say. */")
    lines = List.append(lines, "static const char *rt_timeout_text = 0, *rt_timeout_message = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "#include <sys/time.h>")
    lines = List.append(lines, "static void rt_on_timeout(int sig) \{")
    lines = List.append(lines, "    (void)sig;")
    lines = List.append(lines, "    fflush(stdout);")
    lines = List.append(lines, "    if (rt_timeout_message) \{")
    lines = List.append(lines, "        size_t n = strlen(rt_timeout_message);")
    lines = List.append(lines, "        if (write(2, rt_timeout_message, n) < 0) \{ /* nothing to do */ }")
    lines = List.append(lines, "        if (write(2, \"\\n\", 1) < 0) \{ /* nothing to do */ }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    _exit(3);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "static char *rt_copy_text(rt_text t) \{")
    lines = List.append(lines, "    char *copy = (char *)malloc((size_t)t.bytes + 1);")
    lines = List.append(lines, "    if (!copy) return 0;")
    lines = List.append(lines, "    memcpy(copy, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "    copy[t.bytes] = 0;")
    lines = List.append(lines, "    return copy;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_prepare_timeout(rv seconds, rv message) \{")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "    (void)seconds; (void)message;")
    lines = List.append(lines, "    return rt_bool(false);")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "    rt_timeout_text = rt_copy_text(seconds.u.t);")
    lines = List.append(lines, "    rt_timeout_message = rt_copy_text(message.u.t);")
    lines = List.append(lines, "    return rt_bool(true);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_start_timeout(void) \{")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "    if (!rt_timeout_text) return rt_unit();")
    lines = List.append(lines, "    struct sigaction action;")
    lines = List.append(lines, "    memset(&action, 0, sizeof action);")
    lines = List.append(lines, "    action.sa_handler = rt_on_timeout;")
    lines = List.append(lines, "    sigemptyset(&action.sa_mask);")
    lines = List.append(lines, "    sigaction(SIGALRM, &action, 0);")
    lines = List.append(lines, "    double value = strtod(rt_timeout_text, 0);")
    lines = List.append(lines, "    struct itimerval timer;")
    lines = List.append(lines, "    timer.it_interval.tv_sec = 0;")
    lines = List.append(lines, "    timer.it_interval.tv_usec = 0;")
    lines = List.append(lines, "    timer.it_value.tv_sec = (time_t)value;")
    lines = List.append(lines, "    timer.it_value.tv_usec = (suseconds_t)((value - (double)(time_t)value) * 1e6);")
    lines = List.append(lines, "    if (timer.it_value.tv_sec == 0 && timer.it_value.tv_usec == 0) timer.it_value.tv_usec = 1;")
    lines = List.append(lines, "    setitimer(ITIMER_REAL, &timer, 0);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* `nex debug` (selfhost/nex.nex): the commands come from the controlling terminal, so the program keeps the standard input. The")
    lines = List.append(lines, " * variable NEXORA_DEBUG_CONSOLE names a file to read them from instead, which is how the debugger is tested. `console_line` answers with")
    lines = List.append(lines, " * a list with the line, without its line break, or with an empty list at the end of the commands. */")
    lines = List.append(lines, "static FILE *rt_console = 0;")
    lines = List.append(lines, "static bool rt_console_tried = false;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_console_open(void) \{")
    lines = List.append(lines, "    if (!rt_console_tried) \{")
    lines = List.append(lines, "        rt_console_tried = true;")
    lines = List.append(lines, "        const char *named = getenv(\"NEXORA_DEBUG_CONSOLE\");")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "        rt_console = fopen(named && named[0] ? named : \"CONIN$\", \"rb\");")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "        rt_console = fopen(named && named[0] ? named : \"/dev/tty\", \"rb\");")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return rt_bool(rt_console != 0);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_console_line(void) \{")
    lines = List.append(lines, "    if (!rt_console) return rt_list_from(0, 0);")
    lines = List.append(lines, "    size_t cap = 128, n = 0;")
    lines = List.append(lines, "    char *line = (char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    bool any = false;")
    lines = List.append(lines, "    while ((ch = getc(rt_console)) != EOF) \{")
    lines = List.append(lines, "        any = true;")
    lines = List.append(lines, "        if (ch == '\\n') break;")
    lines = List.append(lines, "        if (n + 2 > cap) \{")
    lines = List.append(lines, "            char *bigger = (char *)rt_alloc_raw(cap * 2);")
    lines = List.append(lines, "            memcpy(bigger, line, n);")
    lines = List.append(lines, "            line = bigger;")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        line[n++] = (char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!any) return rt_list_from(0, 0);")
    lines = List.append(lines, "    if (n > 0 && line[n - 1] == '\\r') n--;")
    lines = List.append(lines, "    line[n] = 0;")
    lines = List.append(lines, "    int64_t points = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i < n; i++) if (((unsigned char)line[i] & 0xC0) != 0x80) points++;")
    lines = List.append(lines, "    rt_text t = \{line, (int64_t)n, points};")
    lines = List.append(lines, "    rv item = rt_txt(t);")
    lines = List.append(lines, "    return rt_list_from(&item, 1);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The time limit counts the time the program runs, not the time at the prompt of the debugger: it is stopped while the commands are")
    lines = List.append(lines, " * read and started again with what was left. */")
    lines = List.append(lines, "static double rt_timeout_left = -1.0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_pause_timeout(void) \{")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "    if (rt_timeout_text) \{")
    lines = List.append(lines, "        struct itimerval timer;")
    lines = List.append(lines, "        if (getitimer(ITIMER_REAL, &timer) == 0) \{")
    lines = List.append(lines, "            rt_timeout_left = (double)timer.it_value.tv_sec + (double)timer.it_value.tv_usec / 1e6;")
    lines = List.append(lines, "            memset(&timer, 0, sizeof timer);")
    lines = List.append(lines, "            setitimer(ITIMER_REAL, &timer, 0);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_resume_timeout(void) \{")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "    if (rt_timeout_text && rt_timeout_left >= 0.0) \{")
    lines = List.append(lines, "        struct itimerval timer;")
    lines = List.append(lines, "        timer.it_interval.tv_sec = 0;")
    lines = List.append(lines, "        timer.it_interval.tv_usec = 0;")
    lines = List.append(lines, "        timer.it_value.tv_sec = (time_t)rt_timeout_left;")
    lines = List.append(lines, "        timer.it_value.tv_usec = (suseconds_t)((rt_timeout_left - (double)(time_t)rt_timeout_left) * 1e6);")
    lines = List.append(lines, "        if (timer.it_value.tv_sec == 0 && timer.it_value.tv_usec == 0) timer.it_value.tv_usec = 1;")
    lines = List.append(lines, "        setitimer(ITIMER_REAL, &timer, 0);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* `nex migrate --write` (selfhost/nex.nex, decision 0019, G7): the only operations on files that the tool does besides reading. Each one")
    lines = List.append(lines, " * answers \"\" when it worked, or the reason the system gives. A file is written as bytes, with no translation of line endings. */")
    lines = List.append(lines, "#include <fcntl.h>")
    lines = List.append(lines, "#include <signal.h>")
    lines = List.append(lines, "#include <sys/stat.h>")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "#include <io.h>")
    lines = List.append(lines, "#ifndef O_BINARY")
    lines = List.append(lines, "#define O_BINARY _O_BINARY")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "#ifndef O_BINARY")
    lines = List.append(lines, "#define O_BINARY 0")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_from_cstr(const char *s) \{")
    lines = List.append(lines, "    size_t n = strlen(s);")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw(n + 1);")
    lines = List.append(lines, "    memcpy(copy, s, n + 1);")
    lines = List.append(lines, "    int64_t points = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i < n; i++) if (((unsigned char)copy[i] & 0xC0) != 0x80) points++;")
    lines = List.append(lines, "    rt_text r = \{copy, (int64_t)n, points};")
    lines = List.append(lines, "    return rt_txt(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_valid_utf8(const unsigned char *s, size_t n);")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The bytes of a file as they are, with no translation of line endings (`nex migrate` keeps the endings the file has): a list with the text,")
    lines = List.append(lines, " * or an empty list when the file cannot be read or is not UTF-8. */")
    lines = List.append(lines, "static rv rt_intr_read_exact(rv path) \{")
    lines = List.append(lines, "    char *name = rt_copy_text(path.u.t);")
    lines = List.append(lines, "    if (!name) return rt_list_from(0, 0);")
    lines = List.append(lines, "    FILE *f = fopen(name, \"rb\");")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    if (!f) return rt_list_from(0, 0);")
    lines = List.append(lines, "    size_t cap = 4096, n = 0;")
    lines = List.append(lines, "    unsigned char *data = (unsigned char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    while ((ch = fgetc(f)) != EOF) \{")
    lines = List.append(lines, "        if (n + 1 >= cap) \{")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "            data = (unsigned char *)rt_grow_raw(data, cap / 2, cap);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        data[n++] = (unsigned char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fclose(f);")
    lines = List.append(lines, "    data[n] = 0;")
    lines = List.append(lines, "    if (!rt_valid_utf8(data, n)) return rt_list_from(0, 0);")
    lines = List.append(lines, "    rt_text t = \{(const char *)data, (int64_t)n, rt_count_points((const char *)data, (int64_t)n)};")
    lines = List.append(lines, "    rv item = rt_txt(t);")
    lines = List.append(lines, "    return rt_list_from(&item, 1);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Why a module cannot be read (selfhost/project.nex): \"\" when it can, `E0001|reason` when the system refuses, `E0002|` when it is not UTF-8. */")
    lines = List.append(lines, "static rv rt_intr_module_problem(rv path) \{")
    lines = List.append(lines, "    char *name = rt_copy_text(path.u.t);")
    lines = List.append(lines, "    if (!name) return rt_str(\"\");")
    lines = List.append(lines, "    FILE *f = fopen(name, \"rb\");")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    if (!f) \{")
    lines = List.append(lines, "        char buffer[512];")
    lines = List.append(lines, "        snprintf(buffer, sizeof buffer, \"E0001|%s\", strerror(errno));")
    lines = List.append(lines, "        return rt_from_cstr(buffer);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    size_t cap = 4096, n = 0;")
    lines = List.append(lines, "    unsigned char *data = (unsigned char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    while ((ch = fgetc(f)) != EOF) \{")
    lines = List.append(lines, "        if (n + 1 >= cap) \{")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "            data = (unsigned char *)rt_grow_raw(data, cap / 2, cap);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        data[n++] = (unsigned char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fclose(f);")
    lines = List.append(lines, "    if (!rt_valid_utf8(data, n)) return rt_str(\"E0002|\");")
    lines = List.append(lines, "    return rt_str(\"\");")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The absolute path of a file, to order the modules of a program as Python does (selfhost/nex.nex, `nex migrate`). */")
    lines = List.append(lines, "static rv rt_intr_absolute_path(rv path) \{")
    lines = List.append(lines, "    char *name = rt_copy_text(path.u.t);")
    lines = List.append(lines, "    if (!name) return path;")
    lines = List.append(lines, "    char buffer[4096];")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "    char *full = _fullpath(buffer, name, sizeof buffer);")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "    char *full = realpath(name, buffer);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    rv answer = full ? rt_from_cstr(full) : path;")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    return answer;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_write_exclusive(rv path, rv text) \{")
    lines = List.append(lines, "    char *name = rt_copy_text(path.u.t);")
    lines = List.append(lines, "    if (!name) return rt_from_cstr(\"Cannot allocate memory\");")
    lines = List.append(lines, "    int fd = open(name, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);")
    lines = List.append(lines, "    if (fd < 0) \{")
    lines = List.append(lines, "        const char *why = strerror(errno);")
    lines = List.append(lines, "        free(name);")
    lines = List.append(lines, "        return rt_from_cstr(why);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    size_t done = 0;")
    lines = List.append(lines, "    while (done < (size_t)t.bytes) \{")
    lines = List.append(lines, "        int k = (int)write(fd, t.p + done, (unsigned)((size_t)t.bytes - done));")
    lines = List.append(lines, "        if (k <= 0) \{")
    lines = List.append(lines, "            const char *why = strerror(errno);")
    lines = List.append(lines, "            close(fd);")
    lines = List.append(lines, "            free(name);")
    lines = List.append(lines, "            return rt_from_cstr(why);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        done += (size_t)k;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    close(fd);")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    return rt_str(\"\");")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_copy_permissions(rv source, rv target) \{")
    lines = List.append(lines, "    char *from = rt_copy_text(source.u.t);")
    lines = List.append(lines, "    char *to = rt_copy_text(target.u.t);")
    lines = List.append(lines, "    rv answer = rt_str(\"\");")
    lines = List.append(lines, "    struct stat info;")
    lines = List.append(lines, "    if (!from || !to) \{")
    lines = List.append(lines, "        answer = rt_from_cstr(\"Cannot allocate memory\");")
    lines = List.append(lines, "    } else if (stat(from, &info) != 0 || chmod(to, info.st_mode & 07777) != 0) \{")
    lines = List.append(lines, "        answer = rt_from_cstr(strerror(errno));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    free(from);")
    lines = List.append(lines, "    free(to);")
    lines = List.append(lines, "    return answer;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_replace_file(rv source, rv target) \{")
    lines = List.append(lines, "    char *from = rt_copy_text(source.u.t);")
    lines = List.append(lines, "    char *to = rt_copy_text(target.u.t);")
    lines = List.append(lines, "    rv answer = rt_str(\"\");")
    lines = List.append(lines, "    if (!from || !to) \{")
    lines = List.append(lines, "        answer = rt_from_cstr(\"Cannot allocate memory\");")
    lines = List.append(lines, "    } else \{")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "        remove(to);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "        if (rename(from, to) != 0) answer = rt_from_cstr(strerror(errno));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    free(from);")
    lines = List.append(lines, "    free(to);")
    lines = List.append(lines, "    return answer;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* \"\" when the file is gone, \"missing\" when there was none, else the reason. */")
    lines = List.append(lines, "static rv rt_intr_remove_file(rv path) \{")
    lines = List.append(lines, "    char *name = rt_copy_text(path.u.t);")
    lines = List.append(lines, "    rv answer = rt_str(\"\");")
    lines = List.append(lines, "    if (!name) \{")
    lines = List.append(lines, "        answer = rt_from_cstr(\"Cannot allocate memory\");")
    lines = List.append(lines, "    } else if (remove(name) != 0) \{")
    lines = List.append(lines, "        answer = errno == ENOENT ? rt_str(\"missing\") : rt_from_cstr(strerror(errno));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    free(name);")
    lines = List.append(lines, "    return answer;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The name of a temporary file beside `path`: the path, a random part and `.tmp`. */")
    lines = List.append(lines, "static rv rt_intr_temp_name(rv path) \{")
    lines = List.append(lines, "    static unsigned long counter = 0;")
    lines = List.append(lines, "    char suffix[40];")
    lines = List.append(lines, "    unsigned long seed = (unsigned long)time(0) * 2654435761UL + (unsigned long)clock() + (++counter) * 40503UL;")
    lines = List.append(lines, "#ifndef _WIN32")
    lines = List.append(lines, "    seed += (unsigned long)getpid() * 7919UL;")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    snprintf(suffix, sizeof suffix, \".%08lx.tmp\", seed & 0xffffffffUL);")
    lines = List.append(lines, "    rt_text t = path.u.t;")
    lines = List.append(lines, "    size_t extra = strlen(suffix);")
    lines = List.append(lines, "    char *copy = (char *)rt_alloc_raw((size_t)t.bytes + extra + 1);")
    lines = List.append(lines, "    memcpy(copy, t.p, (size_t)t.bytes);")
    lines = List.append(lines, "    memcpy(copy + t.bytes, suffix, extra + 1);")
    lines = List.append(lines, "    rt_text r = \{copy, (int64_t)((size_t)t.bytes + extra), t.len + (int64_t)extra};")
    lines = List.append(lines, "    return rt_txt(r);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Ctrl+C is noted and the tool decides where to stop, between two files. */")
    lines = List.append(lines, "static volatile int rt_interrupted = 0;")
    lines = List.append(lines, "static void rt_on_interrupt(int sig) \{ (void)sig; rt_interrupted = 1; }")
    lines = List.append(lines, "static rv rt_intr_watch_interrupt(void) \{")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "    signal(SIGINT, rt_on_interrupt);")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "    struct sigaction action;")
    lines = List.append(lines, "    memset(&action, 0, sizeof action);")
    lines = List.append(lines, "    action.sa_handler = rt_on_interrupt;")
    lines = List.append(lines, "    sigemptyset(&action.sa_mask);")
    lines = List.append(lines, "    sigaction(SIGINT, &action, 0);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "static rv rt_intr_was_interrupted(void) \{ return rt_bool(rt_interrupted != 0); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_set_memory_limit(rv bytes, rv message) \{")
    lines = List.append(lines, "#if defined(__linux__)")
    lines = List.append(lines, "    struct rlimit limit;")
    lines = List.append(lines, "    limit.rlim_cur = limit.rlim_max = (rlim_t)bytes.u.i;")
    lines = List.append(lines, "    if (setrlimit(RLIMIT_AS, &limit) != 0) return rt_bool(false);")
    lines = List.append(lines, "    rt_oom_stderr = rt_copy_text(message.u.t);")
    lines = List.append(lines, "    return rt_bool(true);")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "    (void)bytes; (void)message;")
    lines = List.append(lines, "    return rt_bool(false);")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* What a program printed, written as it is printed (selfhost/interpreter.nex): without a line break of its own. */")
    lines = List.append(lines, "static rv rt_intr_can_stream(void) \{ return rt_bool(true); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_stream_text(rv text) \{")
    lines = List.append(lines, "    rt_text t = text.u.t;")
    lines = List.append(lines, "    fwrite(t.p, 1, (size_t)t.bytes, stdout);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_byte_length(rv text) \{ return rt_int(text.u.t.bytes); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_intr_text_of(rv node) \{ return rt_intr_is(node, \"Str\") ? rt_arg(node, 0) : rt_str(\"\"); }")
    lines = List.append(lines, "static rv rt_intr_items_of(rv node) \{ return rt_intr_is(node, \"Items\") ? rt_arg(node, 0) : rt_list_from(0, 0); }")
    lines = List.append(lines, "static rv rt_intr_is_null(rv node) \{ return rt_bool(rt_intr_is(node, \"Null\")); }")
    lines = List.append(lines, "static rv rt_intr_flag_of(rv node) \{ return rt_intr_is(node, \"Flag\") ? rt_arg(node, 0) : rt_bool(false); }")
    lines = List.append(lines, "static rv rt_intr_int_of(rv node) \{ return rt_intr_is(node, \"Whole\") ? rt_arg(node, 0) : rt_int(0); }")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The host: what the program may do besides computing. A program declares what it needs (`uses read \"data\"`), the user allows it")
    lines = List.append(lines, " * with options of the executable (`--allow-read data`), and both have to cover a path for the program to use it (decision 0015). */")
    lines = List.append(lines, "")
    lines = List.append(lines, "#ifdef _WIN32")
    lines = List.append(lines, "#include <direct.h>")
    lines = List.append(lines, "#define rt_getcwd _getcwd")
    lines = List.append(lines, "#else")
    lines = List.append(lines, "#include <unistd.h>")
    lines = List.append(lines, "#define rt_getcwd getcwd")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "#include <errno.h>")
    lines = List.append(lines, "")
    lines = List.append(lines, "#define RT_MAX_SCOPES 64")
    lines = List.append(lines, "static const char *rt_declared_kind[RT_MAX_SCOPES], *rt_declared_path[RT_MAX_SCOPES];")
    lines = List.append(lines, "static int rt_declared = 0;")
    lines = List.append(lines, "static const char *rt_granted_kind[RT_MAX_SCOPES], *rt_granted_path[RT_MAX_SCOPES];")
    lines = List.append(lines, "static int rt_granted = 0;")
    lines = List.append(lines, "static const char *const *rt_args_list = 0;")
    lines = List.append(lines, "static int rt_args_count = 0;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_declare(const char *kind, const char *path) \{")
    lines = List.append(lines, "    if (rt_declared < RT_MAX_SCOPES) \{")
    lines = List.append(lines, "        rt_declared_kind[rt_declared] = kind;")
    lines = List.append(lines, "        rt_declared_path[rt_declared] = path;")
    lines = List.append(lines, "        rt_declared++;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* A path split in its root and its segments, with `.` and `..` resolved and without touching the file system. */")
    lines = List.append(lines, "typedef struct \{")
    lines = List.append(lines, "    char root[8];")
    lines = List.append(lines, "    char *seg[128];")
    lines = List.append(lines, "    int n;")
    lines = List.append(lines, "} rt_parts;")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_split(const char *path, rt_parts *p) \{")
    lines = List.append(lines, "    size_t len = strlen(path);")
    lines = List.append(lines, "    char *text = (char *)rt_alloc_raw(len + 1);")
    lines = List.append(lines, "    for (size_t i = 0; i <= len; i++) text[i] = path[i] == '\\\\' ? '/' : path[i];")
    lines = List.append(lines, "    p->root[0] = 0;")
    lines = List.append(lines, "    p->n = 0;")
    lines = List.append(lines, "    char *cursor = text;")
    lines = List.append(lines, "    if (text[0] == '/') \{")
    lines = List.append(lines, "        strcpy(p->root, \"/\");")
    lines = List.append(lines, "        cursor = text + 1;")
    lines = List.append(lines, "    } else if (len > 1 && text[1] == ':') \{")
    lines = List.append(lines, "        p->root[0] = (text[0] >= 'a' && text[0] <= 'z') ? (char)(text[0] - 32) : text[0];")
    lines = List.append(lines, "        p->root[1] = ':';")
    lines = List.append(lines, "        p->root[2] = 0;")
    lines = List.append(lines, "        cursor = text + 2;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    char *start = cursor;")
    lines = List.append(lines, "    for (;; cursor++) \{")
    lines = List.append(lines, "        if (*cursor == '/' || *cursor == 0) \{")
    lines = List.append(lines, "            bool last = *cursor == 0;")
    lines = List.append(lines, "            *cursor = 0;")
    lines = List.append(lines, "            if (start[0] != 0 && strcmp(start, \".\") != 0) \{")
    lines = List.append(lines, "                if (strcmp(start, \"..\") == 0) \{")
    lines = List.append(lines, "                    if (p->n > 0 && strcmp(p->seg[p->n - 1], \"..\") != 0) p->n--;")
    lines = List.append(lines, "                    else if (p->root[0] == 0 && p->n < 128) p->seg[p->n++] = start;")
    lines = List.append(lines, "                } else if (p->n < 128) \{")
    lines = List.append(lines, "                    p->seg[p->n++] = start;")
    lines = List.append(lines, "                }")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            start = cursor + 1;")
    lines = List.append(lines, "            if (last) break;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static const char *rt_absolute(const char *path) \{")
    lines = List.append(lines, "    bool absolute = path[0] == '/' || path[0] == '\\\\' || (strlen(path) > 1 && path[1] == ':');")
    lines = List.append(lines, "    if (absolute) return path;")
    lines = List.append(lines, "    char cwd[1024];")
    lines = List.append(lines, "    if (!rt_getcwd(cwd, sizeof cwd)) return path;")
    lines = List.append(lines, "    return rt_format(\"%s/%s\", cwd, path);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_inside(const char *scope, const char *path) \{")
    lines = List.append(lines, "    if (scope[0] == 0) return false;")
    lines = List.append(lines, "    rt_parts inner, outer;")
    lines = List.append(lines, "    rt_split(rt_absolute(scope), &inner);")
    lines = List.append(lines, "    rt_split(rt_absolute(path), &outer);")
    lines = List.append(lines, "    if (strcmp(inner.root, outer.root) != 0 || outer.n < inner.n) return false;")
    lines = List.append(lines, "    for (int i = 0; i < inner.n; i++) \{")
    lines = List.append(lines, "        if (strcmp(inner.seg[i], outer.seg[i]) != 0) return false;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return true;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* Why the program may not use a path, or 0 when it may. */")
    lines = List.append(lines, "static const char *rt_denied(const char *kind, const char *path) \{")
    lines = List.append(lines, "#ifdef RT_CLI")
    lines = List.append(lines, "    /* A command-line tool (nex.nex) reads and writes the files it is asked to; what the program it runs may do is its own host. */")
    lines = List.append(lines, "    (void)kind; (void)path;")
    lines = List.append(lines, "    return 0;")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    bool declared = false, granted = false;")
    lines = List.append(lines, "    for (int i = 0; i < rt_declared; i++) \{")
    lines = List.append(lines, "        if (strcmp(rt_declared_kind[i], kind) == 0 && rt_inside(rt_declared_path[i], path)) declared = true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!declared) return rt_format(\"this program does not declare that it needs to %s '%s'\", kind, path);")
    lines = List.append(lines, "    for (int i = 0; i < rt_granted; i++) \{")
    lines = List.append(lines, "        if (strcmp(rt_granted_kind[i], kind) == 0 && rt_inside(rt_granted_path[i], path)) granted = true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!granted) return rt_format(\"'%s' is not among the paths the user allowed to %s\", path, kind);")
    lines = List.append(lines, "    return 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static void rt_denied_fail(const char *message, const char *kind, RT_SPAN) \{")
    lines = List.append(lines, "    rt_runtime(\"E3008\", \"Permission denied\", message,")
    lines = List.append(lines, "               strcmp(kind, \"read\") == 0")
    lines = List.append(lines, "                   ? \"A program reads a file when it declares it with 'uses read' and the user allows it with --allow-read.\"")
    lines = List.append(lines, "                   : \"A program writes a file when it declares it with 'uses write' and the user allows it with --allow-write.\",")
    lines = List.append(lines, "               l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_valid_utf8(const unsigned char *s, size_t n) \{")
    lines = List.append(lines, "    size_t i = 0;")
    lines = List.append(lines, "    while (i < n) \{")
    lines = List.append(lines, "        unsigned char b = s[i];")
    lines = List.append(lines, "        size_t more = b < 0x80 ? 0 : (b >> 5) == 6 ? 1 : (b >> 4) == 14 ? 2 : (b >> 3) == 30 ? 3 : 99;")
    lines = List.append(lines, "        if (more == 99) return false;")
    lines = List.append(lines, "        for (size_t k = 1; k <= more; k++) \{")
    lines = List.append(lines, "            if (i + k >= n || (s[i + k] & 0xC0) != 0x80) return false;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        i += more + 1;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return true;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_read_file(rv path, RT_SPAN) \{")
    lines = List.append(lines, "    const char *name = path.u.t.p;")
    lines = List.append(lines, "    const char *why = rt_denied(\"read\", name);")
    lines = List.append(lines, "    if (why) rt_denied_fail(why, \"read\", l, c, el, ec);")
    lines = List.append(lines, "    FILE *f = fopen(name, \"rb\");")
    lines = List.append(lines, "    if (!f) \{")
    lines = List.append(lines, "        rt_runtime(\"E3010\", \"File error\", rt_format(\"The file '%s' could not be read: %s\", name, strerror(errno)), \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    size_t cap = 4096, n = 0;")
    lines = List.append(lines, "    unsigned char *data = (unsigned char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    while ((ch = fgetc(f)) != EOF) \{")
    lines = List.append(lines, "        if (n + 1 >= cap) \{")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "            data = (unsigned char *)rt_grow_raw(data, cap / 2, cap);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        data[n++] = (unsigned char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fclose(f);")
    lines = List.append(lines, "    /* Universal line breaks, as Python reads a text file: \\r\\n and \\r become \\n. */")
    lines = List.append(lines, "    size_t out = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i < n; i++) \{")
    lines = List.append(lines, "        if (data[i] == '\\r') \{")
    lines = List.append(lines, "            data[out++] = '\\n';")
    lines = List.append(lines, "            if (i + 1 < n && data[i + 1] == '\\n') i++;")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            data[out++] = data[i];")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    data[out] = 0;")
    lines = List.append(lines, "    if (!rt_valid_utf8(data, out)) \{")
    lines = List.append(lines, "        rt_runtime(\"E3010\", \"File error\", rt_format(\"The file '%s' is not UTF-8 text\", name),")
    lines = List.append(lines, "                   \"NEXORA reads text files: the file has to be saved as UTF-8.\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_text t = \{(const char *)data, (int64_t)out, rt_count_points((const char *)data, (int64_t)out)};")
    lines = List.append(lines, "    return rt_check_text(rt_txt(t), l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_write_file(rv path, rv text, RT_SPAN) \{")
    lines = List.append(lines, "    const char *name = path.u.t.p;")
    lines = List.append(lines, "    const char *why = rt_denied(\"write\", name);")
    lines = List.append(lines, "    if (why) rt_denied_fail(why, \"write\", l, c, el, ec);")
    lines = List.append(lines, "    FILE *f = fopen(name, \"w\");")
    lines = List.append(lines, "    if (!f) \{")
    lines = List.append(lines, "        rt_runtime(\"E3010\", \"File error\", rt_format(\"The file '%s' could not be written: %s\", name, strerror(errno)), \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    fwrite(text.u.t.p, 1, (size_t)text.u.t.bytes, f);")
    lines = List.append(lines, "    fclose(f);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_input(RT_SPAN) \{")
    lines = List.append(lines, "    fflush(stdout); /* what was printed reaches whoever answers this input (a controller that waits for it) */")
    lines = List.append(lines, "    size_t cap = 128, n = 0;")
    lines = List.append(lines, "    char *line = (char *)rt_alloc_raw(cap);")
    lines = List.append(lines, "    int ch;")
    lines = List.append(lines, "    bool any = false;")
    lines = List.append(lines, "    /* The line is read in one piece of at most the room left in the input, or of what a Text may be (four bytes a character). */")
    lines = List.append(lines, "    int64_t remaining = rt_max_input > 0 ? rt_max_input - rt_input_bytes : -1;")
    lines = List.append(lines, "    int64_t piece = remaining >= 0 ? remaining + 1 : -1;")
    lines = List.append(lines, "    if (rt_max_text > 0) \{")
    lines = List.append(lines, "        int64_t text_piece = 4 * (rt_max_text + 1) + 1;")
    lines = List.append(lines, "        if (piece < 0 || text_piece < piece) piece = text_piece;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    int64_t raw = 0;")
    lines = List.append(lines, "    while ((piece < 0 || raw < piece) && (ch = fgetc(stdin)) != EOF) \{")
    lines = List.append(lines, "        any = true;")
    lines = List.append(lines, "        raw++;")
    lines = List.append(lines, "        if (ch == '\\n') break;")
    lines = List.append(lines, "        if (n + 1 >= cap) \{")
    lines = List.append(lines, "            cap *= 2;")
    lines = List.append(lines, "            line = (char *)rt_grow_raw(line, cap / 2, cap);")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        line[n++] = (char)ch;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (any && remaining >= 0 && raw > remaining) \{")
    lines = List.append(lines, "        rt_limit_fail(rt_format(\"input limit exceeded (%lld)\", (long long)rt_max_input));")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (any) rt_input_bytes += raw;")
    lines = List.append(lines, "    if (!any) \{")
    lines = List.append(lines, "        rt_runtime(\"E3009\", \"No more input\", \"There is no more input to read\", \"The standard input ended. Check it before reading again.\",")
    lines = List.append(lines, "                   l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (n > 0 && line[n - 1] == '\\r') n--;")
    lines = List.append(lines, "    line[n] = 0;")
    lines = List.append(lines, "    rt_text t = \{line, (int64_t)n, rt_count_points(line, (int64_t)n)};")
    lines = List.append(lines, "    return rt_check_text(rt_txt(t), l, c, el, ec);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* `Net.get` and `Process.run`. The decisions are the ones of the Python host (an HTTPS URL without credentials and on port 443;")
    lines = List.append(lines, " * what the program declares and what the user allowed). Doing the request or starting the process needs a TLS library and a")
    lines = List.append(lines, " * process supervisor that these executables do not have yet, so when every rule allows the operation the program stops with a")
    lines = List.append(lines, " * diagnostic that says so, instead of pretending. */")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The origin an HTTPS URL goes to, as urlsplit and the idna codec read it, or 0 when it is not one this host admits. */")
    lines = List.append(lines, "static const char *rt_origin(const char *url, int *port_out) \{")
    lines = List.append(lines, "    size_t n = strlen(url);")
    lines = List.append(lines, "    if (n < 8 || (url[0] | 32) != 'h' || (url[1] | 32) != 't' || (url[2] | 32) != 't' || (url[3] | 32) != 'p' ||")
    lines = List.append(lines, "        (url[4] | 32) != 's' || url[5] != ':' || url[6] != '/' || url[7] != '/') return 0;")
    lines = List.append(lines, "    const char *authority = url + 8;")
    lines = List.append(lines, "    size_t end = 0;")
    lines = List.append(lines, "    while (authority[end] && authority[end] != '/' && authority[end] != '?' && authority[end] != '#') end++;")
    lines = List.append(lines, "    char *text = (char *)rt_alloc_raw(end + 1);")
    lines = List.append(lines, "    memcpy(text, authority, end);")
    lines = List.append(lines, "    text[end] = 0;")
    lines = List.append(lines, "    char *at = strrchr(text, '@');")
    lines = List.append(lines, "    char *hostport = text;")
    lines = List.append(lines, "    if (at) \{")
    lines = List.append(lines, "        for (char *c = text; c < at; c++) \{")
    lines = List.append(lines, "            if (*c != ':') return 0;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        hostport = at + 1;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (char *c = hostport; *c; c++) \{")
    lines = List.append(lines, "        if ((unsigned char)*c < 0x21 || (unsigned char)*c > 0x7e || *c == '[' || *c == ']') return 0;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    char *colon = strrchr(hostport, ':');")
    lines = List.append(lines, "    int port = 443;")
    lines = List.append(lines, "    if (colon) \{")
    lines = List.append(lines, "        *colon = 0;")
    lines = List.append(lines, "        const char *digits = colon + 1;")
    lines = List.append(lines, "        if (digits[0]) \{")
    lines = List.append(lines, "            long value = 0;")
    lines = List.append(lines, "            for (const char *c = digits; *c; c++) \{")
    lines = List.append(lines, "                if (*c < '0' || *c > '9') return 0;")
    lines = List.append(lines, "                value = value * 10 + (*c - '0');")
    lines = List.append(lines, "                if (value > 65535) return 0;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            port = (int)value;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (port != 443 || hostport[0] == 0) return 0;")
    lines = List.append(lines, "    size_t length = strlen(hostport);")
    lines = List.append(lines, "    size_t label = 0;")
    lines = List.append(lines, "    for (size_t i = 0; i <= length; i++) \{")
    lines = List.append(lines, "        if (i == length || hostport[i] == '.') \{")
    lines = List.append(lines, "            if ((label < 1 && !(i == length && length > 0 && hostport[length - 1] == '.')) || label > 63) return 0;")
    lines = List.append(lines, "            label = 0;")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            label++;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    for (size_t i = 0; i < length; i++) \{")
    lines = List.append(lines, "        if (hostport[i] >= 'A' && hostport[i] <= 'Z') hostport[i] = (char)(hostport[i] + 32);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    *port_out = port;")
    lines = List.append(lines, "    return rt_format(\"https://%s\", hostport);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_scope_allows_origin(const char *scope, const char *origin) \{")
    lines = List.append(lines, "    int a, b;")
    lines = List.append(lines, "    const char *declared = rt_origin(scope, &a);")
    lines = List.append(lines, "    const char *wanted = rt_origin(origin, &b);")
    lines = List.append(lines, "    return declared && wanted && strcmp(declared, wanted) == 0;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_has_scope(const char *const *kinds, const char *const *paths, int count, const char *kind, const char *origin) \{")
    lines = List.append(lines, "    for (int i = 0; i < count; i++) \{")
    lines = List.append(lines, "        if (strcmp(kinds[i], kind) == 0 && rt_scope_allows_origin(paths[i], origin)) return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return false;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_net_get(rv url, RT_SPAN) \{")
    lines = List.append(lines, "    int port;")
    lines = List.append(lines, "    const char *origin = rt_origin(url.u.t.p, &port);")
    lines = List.append(lines, "    static const char *hint = \"A program needs 'uses network' and the matching --allow-network origin; the environment may still deny network access.\";")
    lines = List.append(lines, "    if (!origin) \{")
    lines = List.append(lines, "        rt_runtime(\"E3014\", \"External operation failed\", \"only HTTPS URLs without credentials and on port 443 are allowed\", \"\", l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!rt_has_scope(rt_declared_kind, rt_declared_path, rt_declared, \"network\", origin)) \{")
    lines = List.append(lines, "        rt_runtime(\"E3008\", \"Permission denied\", rt_format(\"this program does not declare network access to '%s'\", origin), hint, l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!rt_has_scope(rt_granted_kind, rt_granted_path, rt_granted, \"network\", origin)) \{")
    lines = List.append(lines, "        rt_runtime(\"E3008\", \"Permission denied\", rt_format(\"'%s' is not among the network origins the user allowed\", origin), hint, l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_runtime(\"E3014\", \"External operation failed\", \"HTTPS requests are not available in a program built by the C generator yet\",")
    lines = List.append(lines, "               \"Run the program with `nex run`, which can make them.\", l, c, el, ec);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static bool rt_has_command(const char *const *kinds, const char *const *paths, int count, const char *command) \{")
    lines = List.append(lines, "    for (int i = 0; i < count; i++) \{")
    lines = List.append(lines, "        if (strcmp(kinds[i], \"process\") == 0 && strcmp(paths[i], command) == 0) return true;")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    return false;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_process_run(rv command, RT_SPAN) \{")
    lines = List.append(lines, "    const char *name = command.u.t.p;")
    lines = List.append(lines, "    static const char *hint = \"A program needs 'uses process' and the matching --allow-process command; the environment may still deny external processes.\";")
    lines = List.append(lines, "    if (!rt_has_command(rt_declared_kind, rt_declared_path, rt_declared, name)) \{")
    lines = List.append(lines, "        rt_runtime(\"E3008\", \"Permission denied\", rt_format(\"this program does not declare permission to run '%s'\", name), hint, l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    if (!rt_has_command(rt_granted_kind, rt_granted_path, rt_granted, name)) \{")
    lines = List.append(lines, "        rt_runtime(\"E3008\", \"Permission denied\", rt_format(\"'%s' is not among the commands the user allowed\", name), hint, l, c, el, ec);")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_runtime(\"E3014\", \"External operation failed\", \"external processes are not available in a program built by the C generator yet\",")
    lines = List.append(lines, "               \"Run the program with `nex run`, which can start them.\", l, c, el, ec);")
    lines = List.append(lines, "    return rt_unit();")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "static rv rt_args(RT_SPAN) \{")
    lines = List.append(lines, "    rv *items = (rv *)rt_alloc((size_t)(rt_args_count > 0 ? rt_args_count : 1) * sizeof(rv));")
    lines = List.append(lines, "    for (int i = 0; i < rt_args_count; i++) items[i] = rt_check_text(rt_str(rt_args_list[i]), l, c, el, ec);")
    lines = List.append(lines, "    return rt_list_from(items, rt_args_count);")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The command line of an executable is the one of `nex run`: the options of the user, then `--`, then the arguments of the")
    lines = List.append(lines, " * program. */")
    lines = List.append(lines, "static void rt_options(int argc, char **argv) \{")
    lines = List.append(lines, "#ifdef RT_CLI")
    lines = List.append(lines, "    /* Every argument belongs to the tool: `nex run --max-output 5 file` is not an option of the runtime. */")
    lines = List.append(lines, "    rt_args_list = (const char *const *)(argv + 1);")
    lines = List.append(lines, "    rt_args_count = argc - 1;")
    lines = List.append(lines, "    return;")
    lines = List.append(lines, "#endif")
    lines = List.append(lines, "    int i = 1;")
    lines = List.append(lines, "    for (; i < argc; i++) \{")
    lines = List.append(lines, "        const char *a = argv[i];")
    lines = List.append(lines, "        if (strcmp(a, \"--\") == 0) \{ i++; break; }")
    lines = List.append(lines, "        if ((strcmp(a, \"--max-text\") == 0 || strcmp(a, \"--max-output\") == 0 || strcmp(a, \"--max-input\") == 0) && i + 1 < argc) \{")
    lines = List.append(lines, "            int64_t value = (int64_t)atoll(argv[i + 1]);")
    lines = List.append(lines, "            if (value <= 0) \{")
    lines = List.append(lines, "                fprintf(stderr, \"error: %s must be greater than zero\\n\", a);")
    lines = List.append(lines, "                exit(2);")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            if (strcmp(a, \"--max-text\") == 0) rt_max_text = value;")
    lines = List.append(lines, "            else if (strcmp(a, \"--max-output\") == 0) rt_max_output = value;")
    lines = List.append(lines, "            else rt_max_input = value;")
    lines = List.append(lines, "            i++;")
    lines = List.append(lines, "            continue;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "        const char *kind = strcmp(a, \"--allow-read\") == 0 ? \"read\" : strcmp(a, \"--allow-write\") == 0 ? \"write\"")
    lines = List.append(lines, "                         : strcmp(a, \"--allow-network\") == 0 ? \"network\" : strcmp(a, \"--allow-process\") == 0 ? \"process\" : 0;")
    lines = List.append(lines, "        if (kind && i + 1 < argc) \{")
    lines = List.append(lines, "            if (rt_granted < RT_MAX_SCOPES) \{")
    lines = List.append(lines, "                rt_granted_kind[rt_granted] = kind;")
    lines = List.append(lines, "                rt_granted_path[rt_granted] = argv[i + 1];")
    lines = List.append(lines, "                rt_granted++;")
    lines = List.append(lines, "            }")
    lines = List.append(lines, "            i++;")
    lines = List.append(lines, "        } else \{")
    lines = List.append(lines, "            break;")
    lines = List.append(lines, "        }")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "    rt_args_list = (const char *const *)(argv + i);")
    lines = List.append(lines, "    rt_args_count = argc - i;")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    lines = List.append(lines, "/* The program: the path it was given and the files it is made of, for the lines a diagnostic quotes. */")
    lines = List.append(lines, "static void rt_setup(const char *entry, int count, const char *const *paths, const char *const *const *lines, const int *counts) \{")
    lines = List.append(lines, "    rt_entry = entry;")
    lines = List.append(lines, "    rt_nfiles = count;")
    lines = List.append(lines, "    rt_file_path = paths;")
    lines = List.append(lines, "    rt_file_lines = lines;")
    lines = List.append(lines, "    rt_file_count = counts;")
    lines = List.append(lines, "    if (count > 0) \{")
    lines = List.append(lines, "        rt_path = paths[0];")
    lines = List.append(lines, "        rt_src = lines[0];")
    lines = List.append(lines, "        rt_src_lines = counts[0];")
    lines = List.append(lines, "    }")
    lines = List.append(lines, "}")
    lines = List.append(lines, "")
    return lines
}
