// A project written in NEXORA: the program that runs and the modules it imports (decision 0018, decision 0025).
//
// It follows nexora/src/nexora/modules.py. It reads a file and, before it, the files it imports; each file is read once
// however many import it; the modules come out in the order they are checked (the imports of a module before it, the
// program that runs last); and the errors of the loading itself (two modules that import each other, two files with the
// same name) are reported on the import that causes them. Then it checks the modules one after the other, each with
// what the ones before it made available.
//
// A file that does not exist ends the run of this program instead of becoming a value (there is no way to try a read),
// so the error of reading an import (E0001) is not reported here.

import "lexer.nex"
import "parser.nex"
import "checker.nex"

uses read "."

// One file of the project.
pub type Module = {
    path: Text, name: Text, program: parser.Node, imports: List[Text], clean: Bool, reason: Text,
    pending: List[parser.Problem], problems: List[parser.Problem]
}

// What has been read so far.
// `over` is the file that was bigger than the limit of --max-source, or the file whose size cannot be counted (it is written
// with a `?` in front), and it stops the reading.
pub type Project = { modules: List[Module], names: List[Text], over: Text }

// The files of a project that is not on disk (the worker of the playground): `on` is true, and a path that is not in `paths`
// is not part of the project.
type Virtual = { on: Bool, solo: Bool, paths: List[Text], texts: List[Text] }

type Loader = {
    modules: List[Module], stack: List[Text], keys: List[Text], names: List[Text], name_keys: List[Text],
    limit: Int, virt: Virtual, over: Text
}

// Reading the tree

fn kind_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Obj(kind, names, values) => kind
        _ => ""
    }
}

fn index_of(names: List[Text], name: Text) gives Int {
    var i = 0
    while i < List.length(names)
        shrinks List.length(names) - i
    {
        if List.get(names, i) == name {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn field(node: parser.Node, name: Text) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => field_at(names, values, name)
        _ => parser.Node.Null()
    }
}

fn field_at(names: List[Text], values: List[parser.Node], name: Text) gives parser.Node {
    let index = index_of(names, name)
    if index < 0 {
        return parser.Node.Null()
    }
    return List.get(values, index)
}

fn text_of(node: parser.Node) gives Text {
    return match node {
        parser.Node.Str(value) => value
        _ => ""
    }
}

fn items_of(node: parser.Node) gives List[parser.Node] {
    return match node {
        parser.Node.Items(items) => items
        _ => []
    }
}

fn span_of(node: parser.Node) gives parser.Span {
    return match node {
        parser.Node.Place(line, column, end_line, end_column) => parser.Span(
            line: line, column: column, end_line: end_line, end_column: end_column
        )
        _ => parser.no_span()
    }
}

// Paths: the separator is "/", an import is relative to the file that has it, and `.` and `..` are resolved.

fn split_path(path: Text) gives List[Text] {
    var parts: List[Text] = []
    var start = 0
    var i = 0
    while i < Text.length(path)
        shrinks Text.length(path) - i
    {
        if Text.slice(path, i, i + 1) == "/" {
            parts = List.append(parts, Text.slice(path, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return List.append(parts, Text.slice(path, start, Text.length(path)))
}

fn join_parts(parts: List[Text]) gives Text {
    return parser.join_texts(parts, "/")
}

// The path of the file an import names, from the file that has the import.
fn resolve_import(importing: Text, written: Text) gives Text {
    let parts = split_path(importing)
    var kept: List[Text] = []
    var i = 0
    while i < List.length(parts) - 1
        shrinks List.length(parts) - i
    {
        kept = List.append(kept, List.get(parts, i))
        i = i + 1
    }
    for part in split_path(written) {
        if part == "" or part == "." {
            kept = kept
        } else if part == ".." and List.length(kept) > 0 and List.get(kept, List.length(kept) - 1) != ".." {
            kept = drop_last(kept)
        } else {
            kept = List.append(kept, part)
        }
    }
    return join_parts(kept)
}

fn drop_last(items: List[Text]) gives List[Text] {
    var result: List[Text] = []
    var i = 0
    while i < List.length(items) - 1
        shrinks List.length(items) - i
    {
        result = List.append(result, List.get(items, i))
        i = i + 1
    }
    return result
}

// The name of a file without the directories in front of it.
fn leaf(path: Text) gives Text {
    let parts = split_path(path)
    return List.get(parts, List.length(parts) - 1)
}

// The namespace a module binds: the name of its file without its extension.
fn namespace_of(path: Text) gives Text {
    let file = leaf(path)
    var dot = 0 - 1
    var i = 0
    while i < Text.length(file)
        shrinks Text.length(file) - i
    {
        if Text.slice(file, i, i + 1) == "." {
            dot = i
        }
        i = i + 1
    }
    if dot <= 0 {
        return file
    }
    return Text.slice(file, 0, dot)
}

fn problem_at(code: Text, label: Text, hint: Text, span: parser.Span) gives parser.Problem {
    return parser.Problem(
        code: code, label: label, hint: hint, notes: [], line: span.line, column: span.column,
        end_line: span.end_line, end_column: span.end_column
    )
}

fn leaves(paths: List[Text]) gives List[Text] {
    var result: List[Text] = []
    for path in paths {
        result = List.append(result, leaf(path))
    }
    return result
}

// Reading

// Whether a text is made of ASCII characters only, which is the only case where its bytes can be counted.
// The bytes of a text in UTF-8. This definition is the reference for a text that is all ASCII and answers -1 for another one
// (it has no way to read a code); the executables that cgen.nex makes count the bytes of any text.
pub fn byte_length(text: Text) gives Int {
    if is_ascii_text(text) {
        return Text.length(text)
    }
    return 0 - 1
}

pub fn is_ascii_text(text: Text) gives Bool {
    let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|}~\t\n"
    var i = 0
    while i < Text.length(text)
        shrinks Text.length(text) - i
    {
        if not Text.contains(ascii, Text.slice(text, i, i + 1)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn source_of(virt: Virtual, path: Text) gives Text {
    if virt.on {
        return List.get(virt.texts, index_of(virt.paths, path))
    }
    return read_file(path)
}

fn read_module(loader: Loader, path: Text) gives Loader {
    if List.contains(loader.keys, path) or loader.over != "" {
        return loader
    }
    let text = source_of(loader.virt, path)
    if loader.limit > 0 {
        if not is_ascii_text(text) {
            return Loader(
                modules: loader.modules, stack: loader.stack, keys: loader.keys, names: loader.names,
                name_keys: loader.name_keys, limit: loader.limit, virt: loader.virt, over: "?" + path
            )
        }
        if Text.length(text) > loader.limit {
            return Loader(
                modules: loader.modules, stack: loader.stack, keys: loader.keys, names: loader.names,
                name_keys: loader.name_keys, limit: loader.limit, virt: loader.virt, over: path
            )
        }
    }
    let lexed = lexer.tokenize(text)
    var program = parser.Node.Null()
    var clean = false
    var reason = "lexical"
    var found: List[parser.Problem] = []
    for diagnostic in lexed.diagnostics {
        found = List.append(
            found,
            parser.Problem(
                code: diagnostic.code, label: diagnostic.label, hint: diagnostic.hint, notes: [],
                line: diagnostic.line, column: diagnostic.column, end_line: diagnostic.end_line,
                end_column: diagnostic.end_column
            )
        )
    }
    if List.length(lexed.diagnostics) == 0 {
        let outcome = parser.parse_program(lexed.tokens)
        program = outcome.program
        clean = List.length(outcome.diagnostics) == 0
        reason = "syntax"
        found = outcome.diagnostics
    }
    var current = Loader(
        modules: loader.modules, stack: List.append(loader.stack, path), keys: loader.keys, names: loader.names,
        name_keys: loader.name_keys, limit: loader.limit, virt: loader.virt, over: loader.over
    )
    var imports: List[Text] = []
    var pending: List[parser.Problem] = []
    if clean {
        for declaration in items_of(field(program, "imports")) {
            let written = text_of(field(declaration, "path"))
            let span = span_of(field(declaration, "path_span"))
            let target = resolve_import(path, written)
            let name = namespace_of(target)
            if current.virt.solo {
                pending = List.append(
                    pending,
                    problem_at(
                        "E0001", "This program imports modules, and they cannot be read here",
                        "An import names a file relative to the file that has it: run the program as 'nex run programa.nex', with the files beside it.",
                        span
                    )
                )
            } else if current.virt.on and (Text.starts_with(written, "/") or not List.contains(current.virt.paths, target)) {
                pending = List.append(
                    pending,
                    problem_at(
                        "E0001", "Module '" + written + "' is not part of this project",
                        "Add the imported .nex file to this project.", span
                    )
                )
            } else if List.contains(current.stack, target) {
                let chain = List.append(current.stack, target)
                pending = List.append(
                    pending,
                    problem_at(
                        "E2029", "The modules import each other: " + parser.join_texts(leaves(chain), " -> "),
                        "A module cannot be its own ancestor. Move what the two share into a third module that both of them import.",
                        span
                    )
                )
            } else if index_of(current.names, name) >= 0 and List.get(current.name_keys, index_of(current.names, name)) != target {
                let known = List.get(current.name_keys, index_of(current.names, name))
                pending = List.append(
                    pending,
                    problem_at(
                        "E2030", "Two modules are both called '" + name + "'",
                        "A module takes its name from its file, and two files cannot share one. Rename one of them: "
                        + known + " or " + target + ".",
                        span
                    )
                )
            } else {
                let registered = Loader(
                    modules: current.modules, stack: current.stack, keys: current.keys,
                    names: List.append(current.names, name), name_keys: List.append(current.name_keys, target),
                    limit: current.limit, virt: current.virt, over: current.over
                )
                current = read_module(registered, target)
                imports = List.append(imports, target)
            }
        }
    }
    let module = Module(
        path: path, name: namespace_of(path), program: program, imports: imports, clean: clean, reason: reason,
        pending: pending, problems: found
    )
    return Loader(
        modules: List.append(current.modules, module), stack: loader.stack, keys: List.append(current.keys, path),
        names: current.names, name_keys: current.name_keys, limit: current.limit, virt: current.virt, over: current.over
    )
}

// The modules of a project in the order they are checked.
pub fn load(entry: Text) gives Project {
    return load_limited(entry, 0)
}

// The same, stopping at the first file bigger than `limit` bytes (0 is no limit), in the order they are read.
pub fn load_limited(entry: Text, limit: Int) gives Project {
    let start = Loader(
        modules: [], stack: [], keys: [], names: [], name_keys: [], limit: limit,
        virt: Virtual(on: false, solo: false, paths: [], texts: []), over: ""
    )
    let done = read_module(start, entry)
    return Project(modules: done.modules, names: done.names, over: done.over)
}

// A project that is in memory: the files are the paths and their texts, and the entry is one of them. `solo` is a single
// program with no project around it (a request without `files`): an import in it cannot be read at all.
pub fn load_virtual(entry: Text, paths: List[Text], texts: List[Text], solo: Bool) gives Project {
    let start = Loader(
        modules: [], stack: [], keys: [], names: [], name_keys: [], limit: 0,
        virt: Virtual(on: true, solo: solo, paths: paths, texts: texts), over: ""
    )
    let done = read_module(start, entry)
    return Project(modules: done.modules, names: done.names, over: done.over)
}

// A path with every "\\" written as "/".
pub fn slashes(written: Text) gives Text {
    var safe = ""
    var i = 0
    while i < Text.length(written)
        shrinks Text.length(written) - i
    {
        let char = Text.slice(written, i, i + 1)
        if char == "\\" {
            safe = safe + "/"
        } else {
            safe = safe + char
        }
        i = i + 1
    }
    return safe
}

// The path of a file of a project with the separators as "/", or "" if the path cannot name a file of a project
// (nexora/src/nexora/worker.py): .nex, at most 8 parts of at most 64 characters (letters, digits, _ and -), 256 in all.
pub fn project_path(written: Text) gives Text {
    let safe = slashes(written)
    let parts = split_path(safe)
    if Text.length(safe) > 256 or List.length(parts) > 8 or Text.starts_with(safe, "/") or Text.contains(safe, ":") {
        return ""
    }
    if not Text.ends_with(safe, ".nex") {
        return ""
    }
    var k = 0
    while k < List.length(parts)
        shrinks List.length(parts) - k
    {
        var part = List.get(parts, k)
        if k == List.length(parts) - 1 {
            part = Text.slice(part, 0, Text.length(part) - 4)
        }
        if List.get(parts, k) == "." or List.get(parts, k) == ".." or Text.length(part) == 0 or Text.length(part) > 64 {
            return ""
        }
        if not is_name_text(part) {
            return ""
        }
        k = k + 1
    }
    return safe
}

fn is_name_text(part: Text) gives Bool {
    let allowed = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-"
    var i = 0
    while i < Text.length(part)
        shrinks Text.length(part) - i
    {
        let char = Text.slice(part, i, i + 1)
        if not Text.contains(allowed, char) and is_ascii_text(char) {
            return false
        }
        i = i + 1
    }
    return true
}

// The result of checking one module.
// `typed` is the tree with the type of each expression the checker could give one: for a module with syntax errors it is the partial
// tree checked anyway (what it can tell about the code that did parse; its errors are dropped), as the Python implementation does for
// `nex inspect`. `node` is what the rest uses.
pub type Checked = { module: Module, node: parser.Node, typed: parser.Node, problems: List[parser.Problem], unsupported: Text }

fn has_errors(problems: List[parser.Problem]) gives Bool {
    for problem in problems {
        if not Text.starts_with(problem.code, "W") {
            return true
        }
    }
    return false
}

// Checks every module in order, each one with the exports of the modules before it.
pub fn check_all(project: Project, require_main: Bool) gives List[Checked] {
    let modules = project.modules
    var results: List[Checked] = []
    var exports: List[checker.Export] = []
    var errors = false
    var i = 0
    while i < List.length(modules)
        shrinks List.length(modules) - i
    {
        let module = List.get(modules, i)
        if not module.clean {
            var typed = module.program
            if module.reason != "lexical" {
                let last_one = i == List.length(modules) - 1
                let partial = checker.analyze_module(
                    module.program, module.name, last_one and require_main, false, exports, project.names
                )
                typed = partial.node
            }
            results = List.append(
                results,
                Checked(module: module, node: module.program, typed: typed, problems: module.problems, unsupported: "")
            )
        } else {
            let last = i == List.length(modules) - 1
            let analysis = checker.analyze_module(
                module.program, module.name, last and require_main, not errors, exports, project.names
            )
            exports = List.append(exports, analysis.export)
            errors = errors or has_errors(analysis.problems) or List.length(module.pending) > 0
            results = List.append(
                results,
                Checked(
                    module: module, node: analysis.node, typed: analysis.node,
                    problems: List.concat(module.pending, analysis.problems), unsupported: analysis.unsupported
                )
            )
        }
        i = i + 1
    }
    return results
}

// Linking: the interpreter runs one program, and the modules of a project become one. A module writes the names it
// declares bare, and the module is what tells `helper` of one file from `helper` of another, so every node that names
// something of its own module gets a `target` with the name qualified by its module, and every declaration a `key`
// (the analysis of the Python implementation records the same, decision 0018, 5). The program that runs keeps its
// names bare; a name written with a module in front (`models.area`) already is the key.

fn names_of(declarations: parser.Node) gives List[Text] {
    var names: List[Text] = []
    for declaration in items_of(declarations) {
        names = List.append(names, text_of(field(declaration, "name")))
    }
    return names
}

fn add_field(node: parser.Node, name: Text, value: parser.Node) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => parser.Node.Obj(kind, List.append(names, name), List.append(values, value))
        _ => node
    }
}

// What a module declares, to know which bare names are its own.
type Own = { module: Text, file: Text, functions: List[Text], types: List[Text], enums: List[Text] }

fn first_segment(callee: Text) gives Text {
    var i = 0
    while i < Text.length(callee)
        shrinks Text.length(callee) - i
    {
        if Text.slice(callee, i, i + 1) == "." {
            return Text.slice(callee, 0, i)
        }
        i = i + 1
    }
    return ""
}

fn call_target(own: Own, node: parser.Node) gives Text {
    let callee = text_of(field(node, "callee"))
    let segment = first_segment(callee)
    if segment == "" {
        if List.contains(own.functions, callee) or List.contains(own.types, callee) {
            return own.module + "." + callee
        }
        return ""
    }
    if List.contains(own.enums, segment) {
        return own.module + "." + callee
    }
    return ""
}

fn record_target(own: Own, node: parser.Node) gives Text {
    let name = text_of(field(node, "name"))
    let qualifier = text_of(field(node, "qualifier"))
    if qualifier != "" {
        return qualifier + "." + name
    }
    if own.module == "" {
        return ""
    }
    return own.module + "." + name
}

fn annotate(own: Own, node: parser.Node) gives parser.Node {
    return match node {
        parser.Node.Obj(kind, names, values) => annotate_object(own, kind, names, values)
        parser.Node.Items(items) => parser.Node.Items(annotate_all(own, items))
        _ => node
    }
}

fn annotate_all(own: Own, items: List[parser.Node]) gives List[parser.Node] {
    var result: List[parser.Node] = []
    for item in items {
        result = List.append(result, annotate(own, item))
    }
    return result
}

fn annotate_object(own: Own, kind: Text, names: List[Text], values: List[parser.Node]) gives parser.Node {
    let rebuilt = parser.Node.Obj(kind, names, annotate_all(own, values))
    if kind == "Call" and own.module != "" {
        let target = call_target(own, rebuilt)
        if target != "" {
            return add_field(rebuilt, "target", parser.Node.Str(target))
        }
        return rebuilt
    }
    if kind == "RecordConstruction" {
        let target = record_target(own, rebuilt)
        if target != "" {
            return add_field(rebuilt, "target", parser.Node.Str(target))
        }
    }
    return rebuilt
}

// The declarations of a module with their key, and the base of a refined type with its key.
fn keyed(own: Own, declarations: List[parser.Node], refined: Bool) gives List[parser.Node] {
    var result: List[parser.Node] = []
    for declaration in declarations {
        var done = add_field(annotate(own, declaration), "file", parser.Node.Str(own.file))
        if own.module != "" {
            done = add_field(done, "key", parser.Node.Str(own.module + "." + text_of(field(declaration, "name"))))
        }
        if refined {
            let base = field(declaration, "base")
            let qualifier = text_of(field(base, "qualifier"))
            let name = text_of(field(base, "name"))
            if qualifier != "" {
                done = add_field(done, "base_key", parser.Node.Str(qualifier + "." + name))
            } else if List.contains(own.types, name) and own.module != "" {
                done = add_field(done, "base_key", parser.Node.Str(own.module + "." + name))
            }
        }
        result = List.append(result, done)
    }
    return result
}

// One program from the modules of a project, in the order they are checked.
pub fn link(results: List[Checked]) gives parser.Node {
    var functions: List[parser.Node] = []
    var records: List[parser.Node] = []
    var types: List[parser.Node] = []
    var enums: List[parser.Node] = []
    var capabilities: List[parser.Node] = []
    var i = 0
    while i < List.length(results)
        shrinks List.length(results) - i
    {
        let result = List.get(results, i)
        var module = result.module.name
        if i == List.length(results) - 1 {
            module = ""
        }
        let own = Own(
            module: module, file: result.module.path, functions: names_of(field(result.node, "functions")),
            types: names_of(field(result.node, "types")), enums: names_of(field(result.node, "enums"))
        )
        functions = List.concat(functions, keyed(own, items_of(field(result.node, "functions")), false))
        records = List.concat(records, keyed(own, items_of(field(result.node, "records")), false))
        types = List.concat(types, keyed(own, items_of(field(result.node, "types")), true))
        enums = List.concat(enums, keyed(own, items_of(field(result.node, "enums")), false))
        capabilities = List.concat(capabilities, items_of(field(result.node, "uses")))
        i = i + 1
    }
    return parser.Node.Obj(
        "Program", ["functions", "records", "types", "enums", "uses"],
        [
            parser.Node.Items(functions), parser.Node.Items(records), parser.Node.Items(types), parser.Node.Items(enums),
            parser.Node.Items(capabilities)
        ]
    )
}

// Test driver: `--check ENTRY...`. For each entry prints `FILE|entry`, then `SKIP|` when a module has lexical or
// syntax errors or `UNSUPPORTED|` when the checker does not know something yet; otherwise, the name of each module as
// `MODULE|name`, the typed tree of the program that runs as `CHECKED|` and each problem as `D|`.
fn run_checks() {
    let files = args()
    var i = 1
    while i < List.length(files)
        shrinks List.length(files) - i
    {
        let entry = List.get(files, i)
        print("FILE|" + entry)
        let project = load(entry)
        var clean = true
        for module in project.modules {
            if not module.clean {
                clean = false
            }
        }
        if not clean {
            print("SKIP|syntax")
        } else {
            let results = check_all(project, true)
            var unsupported_reason = ""
            for result in results {
                if result.unsupported != "" and unsupported_reason == "" {
                    unsupported_reason = result.unsupported
                }
            }
            if unsupported_reason != "" {
                print("UNSUPPORTED|" + unsupported_reason)
            } else {
                for result in results {
                    print("MODULE|" + result.module.name)
                    for problem in result.problems {
                        var place_text = ""
                        if problem.line > 0 {
                            place_text = parser.span_text(problem.line, problem.column, problem.end_line, problem.end_column)
                        }
                        print(
                            "D|" + problem.code + "|" + problem.label + "|" + problem.hint + "|"
                            + parser.join_texts(problem.notes, "~~") + "|" + place_text
                        )
                    }
                }
                let last = List.get(results, List.length(results) - 1)
                print("CHECKED|" + parser.to_json(last.node))
            }
        }
        i = i + 1
    }
}

fn main() {
    run_checks()
}
