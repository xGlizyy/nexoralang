nostics\":[\{\"code\":\"E0001\",\"message\":\"Cannot read file\",\"category\":\"file\"},\{\"code\":\"E0002\",\"message\":\"File is not valid UTF-8\",\"category\":\"file\"},\{\"code\":\"E1001\",\"message\":\"Unexpected character\",\"category\":\"lexical\"},\{\"code\":\"E1002\",\"message\":\"Unterminated string\",\"category\":\"lexical\"},\{\"code\":\"E1003\",\"message\":\"Invalid escape sequence\",\"category\":\"lexical\"},\{\"code\":\"E1004\",\"message\":\"Invalid number literal\",\"category\":\"lexical\"},\{\"code\":\"E1005\",\"message\":\"Unescaped '\{' in string\",\"category\":\"lexical\"},\{\"code\":\"E1101\",\"message\":\"Unexpected token\",\"category\":\"syntax\"},\{\"code\":\"E1102\",\"message\":\"Unclosed block\",\"category\":\"syntax\"},\{\"code\":\"E1103\",\"message\":\"Reserved word\",\"category\":\"syntax\"},\{\"code\":\"E1105\",\"message\":\"Expression too deeply nested\",\"category\":\"syntax\"},\{\"code\":\"E1106\",\"message\":\"Misplaced contract clause\",\"category\":\"syntax\"},\{\"code\":\"E1107\",\"message\":\"Syntax before 0.12\",\"category\":\"syntax\"},\{\"code\":\"E1108\",\"message\":\"Arrow before the return type\",\"category\":\"syntax\"},\{\"code\":\"E2001\",\"message\":\"Missing main function\",\"category\":\"semantic\"},\{\"code\":\"E2002\",\"message\":\"Duplicate function\",\"category\":\"semantic\"},\{\"code\":\"E2004\",\"message\":\"Invalid return type\",\"category\":\"type\"},\{\"code\":\"E2005\",\"message\":\"Unknown variable\",\"category\":\"semantic\"},\{\"code\":\"E2006\",\"message\":\"Name already declared\",\"category\":\"semantic\"},\{\"code\":\"E2007\",\"message\":\"Cannot reassign variable\",\"category\":\"semantic\"},\{\"code\":\"E2008\",\"message\":\"Unknown function\",\"category\":\"semantic\"},\{\"code\":\"E2009\",\"message\":\"Wrong number of arguments\",\"category\":\"type\"},\{\"code\":\"E2010\",\"message\":\"Unused value\",\"category\":\"semantic\"},\{\"code\":\"E2011\",\"message\":\"Type mismatch\",\"category\":\"ty