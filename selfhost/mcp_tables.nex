// What the MCP server answers that does not depend on the program it is given.
// Generated by selfhost/make_mcp_tables.py: do not edit it by hand.

// The tools, as `tools/list` gives them: a JSON text.
pub fn tools_parts() gives List[Text] {
    return (
    [
        "[\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Check NEXORA source code without running it: syntax, names, scopes, types and return paths.\\n\\n        Returns a nexora.diagnostics/1 document. \\\"ok\\\" is true when the program has no errors.\\n        Each diagnostic has a stable code, a category, an exact position and, when one is\\n        well-founded, a hint.\\n        \",\"inputSchema\":\{\"properties\":\{\"source\":\{\"title\":\"Source\",\"type\":\"string\"},\"filename\":\{\"default\":\"source.nex\",\"title\":\"Filename\",\"type\":\"string\"}},\"required\":[\"source\"],\"type\":\"object\",\"title\":\"nexora_checkArguments\"},\"name\":\"nexora_check\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_checkDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Get only the list of diagnostics of NEXORA source code, without running it.\\n\\n        Same analysis as nexora_check. Returns \{\\\"ok\\\", \\\"count\\\", \\\"diagnostics\\\"}: an empty list\\n        means the static analysis found nothing wrong. Errors that depend on computed values\\n        (division by zero, broken contracts) are not detected by static analysis.\\n        \",\"inputSchema\":\{\"properties\":\{\"source\":\{\"title\":\"Source\",\"type\":\"string\"},\"filename\":\{\"default\":\"source.nex\",\"title\":\"Filename\",\"type\":\"string\"}},\"required\":[\"source\"],\"type\":\"object\",\"title\":\"nexora_get_diagnosticsArguments\"},\"name\":\"nexora_get_diagnostics\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_get_diagnosticsDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Get the syntax tree of NEXORA source code, with the type of every expression. Does not run it.\\n\\n        Returns a nexora.inspect/3 document. If the code has syntax errors the tree is\\n        partial and \\\"complete\\\" is false; \\\"program\\\" is null if it has lexical errors. The tree\\n        can be large; prefer nexora_get_context for an overview.\\n        \",\"inputSchema\":\{\"properties\":\{\"source\":\{\"title\":\"Source\",\"type\":\"string\"},\"filename\":\{\"default\":\"source.nex\",\"title\":\"Filename\",\"type\":\"string\"}},\"required\":[\"source\"],\"type\":\"object\",\"title\":\"nexora_inspectArguments\"},\"name\":\"nexora_inspect\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_inspectDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Get a compact technical summary of NEXORA source code, to understand it before changing it.\\n\\n        Returns a nexora.context/2 document: functions with their signatures, contracts,\\n        variables and types, which function calls which, the language features in use and the\\n        current diagnostics. Computed by static analysis: the program is not run, and nothing\\n        is inferred beyond what the analysis establishes.\\n        \",\"inputSchema\":\{\"properties\":\{\"source\":\{\"title\":\"Source\",\"type\":\"string\"},\"filename\":\{\"default\":\"source.nex\",\"title\":\"Filename\",\"type\":\"string\"}},\"required\":[\"source\"],\"type\":\"object\",\"title\":\"nexora_get_contextArguments\"},\"name\":\"nexora_get_context\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_get_contextDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"List the functions, parameters and variables NEXORA source code declares, and where each is used.\\n\\n        Returns a nexora.symbols/2 document. \\\"name\\\" keeps only the symbols with that name;\\n        \\\"function\\\" keeps one function and what is declared inside it. Does not run the code.\\n        \",\"inputSchema\":\{\"properties\":\{\"source\":\{\"title\":\"Source\",\"type\":\"string\"},\"filename\":\{\"default\":\"source.nex\",\"title\":\"Filename\",\"type\":\"string\"},\"name\":\{\"anyOf\":[\{\"type\":\"string\"},\{\"type\":\"null\"}],\"default\":null,\"title\":\"Name\"},\"function\":\{\"anyOf\":[\{\"type\":\"string\"},\{\"type\":\"null\"}],\"default\":null,\"title\":\"Function\"}},\"required\":[\"source\"],\"type\":\"object\",\"title\":\"nexora_get_symbolsArguments\"},\"name\":\"nexora_get_symbols\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_get_symbolsDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Read the official NEXORA language specification (written in Spanish).\\n\\n        Without arguments, returns the specification version and the list of sections (id and\\n        title). With a section id from that list, also returns the Markdown text of that\\n        section. The text always comes from the specification shipped with NEXORA.\\n        \",\"inputSchema\":\{\"properties\":\{\"section\":\{\"anyOf\":[\{\"type\":\"string\"},\{\"type\":\"null\"}],\"default\":null,\"title\":\"Section\"}},\"type\":\"object\",\"title\":\"nexora_get_language_specArguments\"},\"name\":\"nexora_get_language_spec\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_get_language_specDictOutput\"}},\{\"annotations\":\{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Get the facts about this version of NEXORA: keywords, types, built-in functions, every\\n        diagnostic code with its category, the limits of the implementation and the output formats.\",\"inputSchema\":\{\"properties\":\{},\"type\":\"object\",\"title\":\"nexora_get_capabilitiesArguments\"},\"name\":\"nexora_get_capabilities\",\"outputSchema\":\{\"type\":\"object\",\"additionalProperties\":true,\"title\":\"nexora_get_capabilitiesDictOutput\"}}]"
    ]
    )
}

// What the server says about itself.
pub fn instructions() gives Text {
    return "Static analysis tools for the NEXORA programming language. They check, inspect and summarise NEXORA source code passed as text; they never run it. The rules of the language are decided by these tools, deterministically: use nexora_check after writing or changing NEXORA code, and read the diagnostics (stable codes, exact positions) instead of guessing whether the code is valid. Use nexora_get_language_spec for the official rules of the language."
}

