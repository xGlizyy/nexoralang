ruction\",\"category\":\"type\"},\{\"code\":\"E3001\",\"message\":\"Division by zero\",\"category\":\"runtime\"},\{\"code\":\"E3002\",\"message\":\"Integer overflow\",\"category\":\"runtime\"},\{\"code\":\"E3003\",\"message\":\"Float result out of range\",\"category\":\"runtime\"},\{\"code\":\"E3004\",\"message\":\"Too many nested calls\",\"category\":\"runtime\"},\{\"code\":\"E3005\",\"message\":\"Conversion out of range\",\"category\":\"runtime\"},\{\"code\":\"E3006\",\"message\":\"Text too long\",\"category\":\"runtime\"},\{\"code\":\"E3007\",\"message\":\"Out of memory\",\"category\":\"runtime\"},\{\"code\":\"E3008\",\"message\":\"Permission denied\",\"category\":\"runtime\"},\{\"code\":\"E3009\",\"message\":\"No more input\",\"category\":\"runtime\"},\{\"code\":\"E3010\",\"message\":\"File error\",\"category\":\"runtime\"},\{\"code\":\"E3011\",\"message\":\"Option has no value\",\"category\":\"runtime\"},\{\"code\":\"E3012\",\"message\":\"Result is an error\",\"category\":\"runtime\"},\{\"code\":\"E3013\",\"message\":\"Result is not an error\",\"",
