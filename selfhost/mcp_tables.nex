"return_type\":\"List[T]\",\"contracts\":[]},\{\"name\":\"List.concat\",\"signature\":\"fn List.concat(xs: List[T], ys: List[T]) gives List[T]\",\"params\":[\{\"name\":\"xs\",\"type\":\"List[T]\"},\{\"name\":\"ys\",\"type\":\"List[T]\"}],\"return_type\":\"List[T]\",\"contracts\":[]},\{\"name\":\"List.contains\",\"signature\":\"fn List.contains(xs: List[T], x: T) gives Bool\",\"params\":[\{\"name\":\"xs\",\"type\":\"List[T]\"},\{\"name\":\"x\",\"type\":\"T\"}],\"return_type\":\"Bool\",\"contracts\":[]},\{\"name\":\"List.get\",\"signature\":\"fn List.get(xs: List[T], i: Int) gives T\",\"params\":[\{\"name\":\"xs\",\"type\":\"List[T]\"},\{\"name\":\"i\",\"type\":\"Int\"}],\"return_type\":\"T\",\"contracts\":[\{\"clause\":\"requires\",\"condition\":\"0 <= i and i < List.length(xs)\",\"message\":\"An index must be inside the list\",\"checked_at_run_time\":true}]},\{\"name\":\"List.length\",\"signature\":\"fn List.length(xs: List[T]) gives Int\",\"params\":[\{\"name\":\"xs\",\"type\":\"List[T]\"}],\"return_type\":\"Int\",\"contracts\":[]},\{\"name\":\"Net.get\",\"signature\":\"fn Net.get(url: Text) gives Text\",\"params\":[\{\"name\":\"url\",\"type\":\"Text\"}],\"return_type\":\"Text\",\"contracts\":[]},\{\"name\":\"Ok\",\"signature\":\"fn Ok(value: T) gives Result[T, E]\",\"params\":[\{\"name\":\"value\",\"type\":\"T\"}],\"return_type\":\"Result[T, E]\",\"contracts\":[]},\{\"name\":\"Option.is_none\",\"signature\":\"fn Option.is_none(value: Option[T]) gives Bool\",\"params\":[\{\"name\":\"value\",\"type\":\"Option[T]\"}],\"return_type\":\"Bool\",\"contracts\":[]},\{\"name\":\"Option.is_some\",\"signature\":\"fn Option.is_some(value: Option[T]) gives Bool\",\"params\":[\{\"name\":\"value\",\"type\":\"Option[T]\"}],\"return_type\":\"Bool\",\"contracts\":[]},\{\"name\":\"Option.value\",\"signature\":\"fn Option.value(value: Option[T]) gives T\",\"params\":[\{\"name\":\"value\",\"type\":\"Option[T]\"}],\"return_type\":\"T\",\"contracts\":[]},\{\"name\":\"Option.value_or\",\"